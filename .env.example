# ── Emprende180 — variables de entorno ────────────────────────────────────────
# Copia este archivo a `.env` y rellena los valores reales.
# En Vercel: Project Settings → Environment Variables (o `vercel env add`).

# Resend — envío del email de bienvenida del mini-curso y del aviso interno.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# A dónde llega el aviso de "nuevo lead" (tu bandeja).
NOTIFY_EMAIL_TO=hola@emprende180.com

# Remitente. El dominio debe estar verificado en Resend.
NOTIFY_EMAIL_FROM="Emprende180 <no-reply@emprende180.com>"

# Google Analytics 4. Público (llega al navegador) → prefijo PUBLIC_.
# Déjalo vacío para desactivar el script de analítica.
PUBLIC_GA4_ID=G-XXXXXXXXXX
