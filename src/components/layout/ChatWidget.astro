---
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import { copy, contacto } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * EL CHAT — el botón flotante de abajo a la derecha y su panel
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * DOS CHATS, Y CUÁL SE VE LO DECIDE EL CONSENTIMIENTO DE COOKIES:
 *
 *   · Si el visitante ACEPTA las cookies, se carga el widget de GoHighLevel
 *     (LeadConnector; el `<script>` lo pasó el cliente el 16-09-2026 y sus datos
 *     viven en `copy.ui.chat.ghl`). Es un chat de verdad, con su propia burbuja
 *     abajo a la derecha, y esta maqueta se esconde para no tener dos.
 *   · Si NO ha contestado o RECHAZA, se enseña esta maqueta: el botón redondo
 *     teal y un panel HONESTO —no finge que haya nadie al otro lado— con las
 *     dos salidas que funcionan sin terceros: el formulario y el correo.
 *
 * ⚠️ EL WIDGET DE GHL NO SE CARGA SIN CONSENTIMIENTO, Y NO ES OPCIONAL. Pone
 * cookies y carga de un dominio ajeno, igual que la analítica: es
 * exactamente lo que el aviso de cookies pregunta antes de hacer. Cargarlo
 * antes dejaría el aviso en papel mojado (ver `lib/consent.ts`). Quien rechaza
 * no se queda sin hablar con nosotros: se queda con la maqueta.
 *
 * El `<script>` se crea aquí con `document.createElement` y no está en el HTML:
 * así el navegador no puede descargarlo por su cuenta antes de tiempo. Se
 * carga una sola vez por página.
 *
 * ─── POR QUÉ LA MAQUETA NO SE VE MIENTRAS ESTÁ EL AVISO DE COOKIES ─────────
 *
 * El aviso ocupa el borde de abajo entero y sus botones caen a la derecha: el
 * chat encima taparía "Aceptar todas". El guion espera a que el visitante
 * conteste (o a que ya hubiera contestado) para enseñar lo que toque.
 *
 * ⚠️ ES UN `<dialog>` NO MODAL (`show()`, no `showModal()`): el chat no puede
 * secuestrar la página. Escape lo cierra, el foco vuelve al botón.
 */

const { chat } = copy.ui;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);
---

<div
  data-chat
  data-ghl-loader={chat.ghl.loader}
  data-ghl-recursos={chat.ghl.recursos}
  data-ghl-widget={chat.ghl.widgetId}
  data-ghl-source={chat.ghl.source}
  class="fixed bottom-5 right-5 z-[54] hidden sm:bottom-6 sm:right-6"
  data-chat-visible="false"
>
  <dialog
    data-chat-panel
    aria-label={chat.titulo[lang]}
    data-aria-es={chat.titulo.es}
    data-aria-en={chat.titulo.en}
    class="absolute bottom-[calc(100%+0.75rem)] right-0 m-0 w-[min(22rem,calc(100vw-2.5rem))] rounded-3xl border border-line bg-surface p-0 text-ink shadow-2xl open:block"
  >
    <div class="flex items-center gap-3 rounded-t-3xl bg-primary-950 px-5 py-4 text-ink-inverse">
      <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-secondary-500 text-primary-950">
        <Icono nombre="conversacion" class="size-5" grosor={2} />
      </span>
      <p class="text-lg font-extrabold leading-tight">
        <T v={chat.titulo} />
      </p>
    </div>
    <div class="p-5">
      <p class="text-base font-medium leading-relaxed text-pretty text-ink-muted">
        <T v={chat.texto} />
      </p>
      <div class="mt-5">
        <BotonRelieve href="/#empezar" class="boton-pildora-md w-full" trackId="chat-datos">
          <T v={chat.cta} />
        </BotonRelieve>
      </div>
      <a
        href={`mailto:${contacto.email}`}
        class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-ink-brand underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        {contacto.email}
      </a>
      {/* La letra pequeña dice por qué este chat es el que es: el de verdad
          solo se carga si se aceptan las cookies. */}
      <p class="mt-4 border-t border-line pt-3 text-xs font-medium text-ink-subtle">
        <T v={chat.aviso} />
      </p>
    </div>
  </dialog>

  <button
    type="button"
    data-chat-boton
    aria-expanded="false"
    aria-label={chat.abrir[lang]}
    data-abrir-es={chat.abrir.es}
    data-abrir-en={chat.abrir.en}
    data-cerrar-es={chat.cerrar.es}
    data-cerrar-en={chat.cerrar.en}
    class="grid size-14 place-items-center rounded-full bg-cta text-ink-inverse shadow-xl transition-transform duration-200 ease-out-soft hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus motion-safe:active:scale-95"
  >
    <Icono nombre="conversacion" class="size-6" grosor={2} data-chat-icono-abrir />
    <Icono nombre="cruz" class="hidden size-6" grosor={2} data-chat-icono-cerrar />
  </button>
</div>

<script>
  import { leerConsentimiento, EVENTO_CONSENTIMIENTO } from "@lib/consent";

  const raiz = document.querySelector<HTMLElement>("[data-chat]");
  const boton = raiz?.querySelector<HTMLButtonElement>("[data-chat-boton]");
  const panel = raiz?.querySelector<HTMLDialogElement>("[data-chat-panel]");

  if (raiz && boton && panel) {
    const claveIdioma = (base: string) =>
      document.documentElement.lang === "en" ? `${base}En` : `${base}Es`;

    const pintar = () => {
      const abierto = panel.open;
      boton.setAttribute("aria-expanded", String(abierto));
      const etiqueta = boton.dataset[claveIdioma(abierto ? "cerrar" : "abrir")];
      if (etiqueta) boton.setAttribute("aria-label", etiqueta);
      boton.querySelector("[data-chat-icono-abrir]")?.classList.toggle("hidden", abierto);
      boton.querySelector("[data-chat-icono-cerrar]")?.classList.toggle("hidden", !abierto);
      const titulo = panel.dataset[claveIdioma("aria")];
      if (titulo) panel.setAttribute("aria-label", titulo);
    };

    boton.addEventListener("click", () => {
      if (panel.open) panel.close();
      else panel.show();
      pintar();
    });

    panel.addEventListener("close", pintar);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.open) {
        panel.close();
        boton.focus();
      }
    });

    window.addEventListener("e180:idioma", pintar);

    /* Lo que se enseña, según el consentimiento. Ver la cabecera. */
    const ghl = raiz.dataset;
    let ghlCargado = false;

    const mostrarMaqueta = () => {
      raiz.classList.remove("hidden");
      raiz.dataset.chatVisible = "true";
    };
    const esconderMaqueta = () => {
      if (panel.open) panel.close();
      raiz.classList.add("hidden");
      raiz.dataset.chatVisible = "false";
    };
    const cargarGhl = () => {
      if (ghlCargado || !ghl.ghlLoader || !ghl.ghlWidget) return;
      ghlCargado = true;
      const script = document.createElement("script");
      script.src = ghl.ghlLoader;
      script.dataset.resourcesUrl = ghl.ghlRecursos ?? "";
      script.dataset.widgetId = ghl.ghlWidget;
      if (ghl.ghlSource) script.dataset.source = ghl.ghlSource;
      script.async = true;
      document.body.append(script);
      esconderMaqueta();
    };

    const decidir = (estado: string) => {
      if (estado === "aceptado") cargarGhl();
      else if (estado === "rechazado") mostrarMaqueta();
      /* "sin-respuesta": nada a la vista hasta que conteste. */
    };

    decidir(leerConsentimiento());
    window.addEventListener(EVENTO_CONSENTIMIENTO, (e) => {
      decidir((e as CustomEvent).detail);
    });
  }
</script>
