---
import T from "@components/i18n/T.astro";
import { sitio, cta, copy } from "@config/curso.config";
import Button from "@components/ui/Button.astro";
import LanguageSwitch from "@components/i18n/LanguageSwitch";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * Header de la landing.
 *
 * ES ESTÁTICO EN EL SENTIDO LITERAL: `position: static`
 * ─────────────────────────────────────────────────────
 * La barra vive en el flujo normal, arriba del documento, y SE VA con el scroll
 * como cualquier otro contenido. No se pega, no reaparece, no se encoge, no
 * cambia de fondo. Ni un listener de scroll: el componente no sabe por dónde va
 * la página y no necesita saberlo.
 *
 * Pasó por tres versiones y conviene dejar constancia para no volver atrás sin
 * querer: era `sticky` con fondo translúcido y desenfoque; luego `fixed` con
 * fondo opaco; ahora estático. Lo pidió el cliente, con estas palabras: que la
 * barra se quede en su lugar y no baje con nosotros.
 *
 * QUÉ SE GANA. La primera pantalla es del hero entero y de nadie más, y al
 * bajar no hay una franja blanca comiéndose 64 px de cada sección. En una
 * página de una sola columna con el argumento en orden, eso es aire.
 *
 * QUÉ SE PIERDE, PARA QUE ESTÉ DICHO. En escritorio el botón "Inscribirme al
 * curso" deja de estar disponible en cuanto se pasa el hero: quien decide
 * comprar en mitad del temario tiene que seguir bajando hasta la sección de
 * precio o subir del todo. En móvil no pasa, porque ahí manda el CTA fijo
 * inferior (`StickyCta`), que sigue apareciendo al dejar atrás el hero. Si algún
 * día se quiere tapar ese hueco sin resucitar el header pegajoso, lo correcto es
 * extender esa misma barra inferior a escritorio, no volver a `fixed`.
 *
 * El fondo es OPACO y no translúcido con desenfoque. Ya no hace falta para
 * convivir con el vídeo (la barra deja de montarse encima al bajar), pero un
 * `backdrop-blur` a pantalla completa cuesta compositing en cada scroll y aquí
 * no compra nada.
 *
 * El alto sale del token `--header-h` y no de una utilidad de Tailwind: el mismo
 * número lo usa el hero para calcular su altura, de modo que header + hero suman
 * exactamente una pantalla. Escrito en un solo sitio, no pueden desincronizarse.
 *
 * Sin menú de navegación más allá de tres anclas: en una página de conversión
 * cada enlace es una salida, y los tres que hay llevan HACIA la compra.
 *
 * El CTA del header se oculta en móvil: ya está el CTA fijo inferior, y dos
 * botones idénticos a la vez compiten entre sí.
 */
const logo = sitio.logoHorizontal;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* El alt del logo lleva el claim, así que también se traduce. Los data-alt-*
   los usa el script del layout para actualizarlo al cambiar de idioma. */
const logoAlt = {
  es: `${sitio.nombre}: ${sitio.claim.es}`,
  en: `${sitio.nombre}: ${sitio.claim.en}`,
};
---

{/* Sin `position`, sin `z-index` y sin `inset`: está en el flujo. El único
    motivo por el que queda un `relative` es que el logo y el CTA necesitan
    contexto de apilamiento propio si algún día se les pone un adorno encima. */}
<header class="relative border-b border-line bg-surface">
  <div
    class="container-page flex h-[var(--header-h)] items-center justify-between gap-4 lg:h-[var(--header-h-lg)]"
  >
    {/* shrink-0: sin esto, en móvil el flex del header comprimía el enlace y
        el logo salía deformado (115×32 sobre un arte de 573×120). */}
    <a
      href="#inicio"
      class="flex min-h-11 shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    >
      <img
        src={logo.src}
        alt={logoAlt[lang]}
        data-alt-es={logoAlt.es}
        data-alt-en={logoAlt.en}
        width={logo.w}
        height={logo.h}
        class="h-8 w-auto shrink-0 sm:h-9"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    {/* Menú. Solo de `lg` para arriba, y el breakpoint está medido, no elegido:
        con `md` el menú aparecía a 768 px, donde el header ya lleva logo,
        selector de idioma y CTA. Los tres enlaces no cabían y el header
        desbordaba 31 px, o sea scroll horizontal en toda la página justo en el
        ancho de una tablet en vertical. A 1024 sí caben los cuatro bloques.
        Los tres llevan HACIA la compra: temario y preguntas son justo las dos
        objeciones que hacen volver arriba a buscar. */}
    <nav
      aria-label={copy.ui.menuPrincipal[lang]}
      data-aria-es={copy.ui.menuPrincipal.es}
      data-aria-en={copy.ui.menuPrincipal.en}
      class="hidden lg:flex lg:items-center lg:gap-1"
    >
      {
        cta.navegacion.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center rounded-full px-3 text-sm font-semibold text-ink-muted transition-colors duration-200 hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <T v={item.texto} />
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      {/* El selector va SIEMPRE visible, también en móvil: si alguien llega
          con ?lang= equivocado tiene que poder corregirlo sin buscar. */}
      <LanguageSwitch client:load lang={lang} />

      {/* `max-md:hidden` y no `hidden md:inline-flex`: la base del botón ya
          trae `inline-flex`, y entre dos utilidades del mismo grupo gana la que
          Tailwind ordena después, no la que escribes al final. El resultado era
          un CTA que nunca se ocultaba y desbordaba el header en móvil. Con una
          variante responsive no hay ambigüedad posible.

          `md` y no `sm`, para que case con el CTA fijo de móvil: la barra fija
          existe por debajo de 48rem (768). Con el corte en `sm` (640) había una
          franja de 640 a 767 con los DOS CTA a la vez, que es justo lo que el
          comentario de arriba dice que no puede pasar. Ahora el relevo es
          exacto: por debajo de 768 manda la barra fija, por encima el header. */}
      <Button
        href={cta.primario.href}
        variant="primary"
        size="md"
        trackId="header"
        class="max-md:hidden"
      >
        <T v={cta.primario.texto} />
      </Button>
    </div>
  </div>
</header>
