---
import T from "@components/i18n/T.astro";
import { sitio, cta, copy } from "@config/curso.config";
import Button from "@components/ui/Button.astro";
import Icono from "@components/ui/Icono.astro";
import LanguageSwitch from "@components/i18n/LanguageSwitch";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * Header de la landing.
 *
 * SE PEGA ARRIBA Y TIENE DOS TAMAÑOS
 * ──────────────────────────────────
 * Alta mientras no se ha bajado nada; compacta en cuanto se empieza a bajar. Se
 * queda visible todo el rato (`sticky`).
 *
 * ⚠️ ESTO REVIERTE UNA DECISIÓN ANTERIOR DEL PROPIO CLIENTE, y las dos quedan
 * escritas porque la historia importa más que la última versión:
 *
 *   · Antes fue `sticky` con desenfoque, luego `fixed`, y luego ESTÁTICA. Lo
 *     pidió él, con estas palabras: "que la barra se quede en su lugar y no
 *     baje con nosotros".
 *   · Ahora ha pedido lo contrario: grande al principio y que encoja al hacer
 *     scroll. Eso solo tiene sentido si la barra sigue ahí mientras se baja, o
 *     sea pegajosa.
 *
 * QUÉ SE RECUPERA. El botón de comprar vuelve a estar disponible en escritorio
 * durante toda la página. Ese hueco estaba anotado como el coste de la versión
 * estática: quien decidía comprar en mitad del temario tenía que seguir bajando
 * hasta el precio o subir del todo.
 *
 * QUÉ SE PAGA, PARA QUE ESTÉ DICHO. La franja se come alto en cada pantalla al
 * bajar, que es exactamente lo que molestaba antes. Se compensa con el segundo
 * tamaño: compacta ocupa 4rem, no 6,5.
 *
 * El fondo es OPACO y no translúcido con desenfoque: un `backdrop-blur` a
 * pantalla completa cuesta compositing en CADA scroll, y ahora que la barra
 * viaja con la página eso se pagaría todo el rato.
 *
 * LAS CUATRO ALTURAS SALEN DE TOKENS y no de utilidades sueltas, porque el hero
 * resta la altura GRANDE a la pantalla para que barra + hero sumen una pantalla
 * exacta al cargar. Escritas en un solo sitio, no pueden desincronizarse.
 *
 * Sin menú de navegación más allá de tres anclas: en una página de conversión
 * cada enlace es una salida, y los tres que hay llevan HACIA la compra.
 *
 * El CTA del header se oculta en móvil: ya está el CTA fijo inferior, y dos
 * botones idénticos a la vez compiten entre sí.
 */
interface Props {
  /**
   * `completo` es la barra de la landing. `minimo` deja el logotipo y el
   * selector de idioma, y nada más.
   *
   * Lo usa `/login`. Ahí la barra de venta sobra por dos motivos, y el segundo
   * es el fuerte:
   *
   *  1. Quien llega a la pantalla de acceso ya compró. Enseñarle el temario y
   *     el precio es mandarle de vuelta a decidir algo que ya decidió.
   *  2. "Inscribirme al curso" es un botón teal, y el de "Entrar" también. El
   *     sistema de diseño tiene UN color de acción, así que dos botones teal en
   *     la misma pantalla no son dos llamadas: son una llamada rota en dos.
   */
  variante?: "completo" | "minimo";
  /**
   * ─── LA BARRA FLOTA SOBRE LA FOTO ──────────────────────────────────
   *
   * Solo en la portada, que es la única página con un hero fotográfico
   * detrás. La barra no ocupa sitio: se pinta ENCIMA de la imagen, sin
   * fondo y con el logotipo en blanco. Cuando el hero se acaba, se pega
   * arriba y se pone navy.
   *
   * En cualquier otra página (`/login`, el blog, lo legal) sigue siendo la
   * barra blanca de siempre: ahí no hay foto sobre la que flotar y una
   * cabecera transparente quedaría sobre el fondo del cuerpo.
   */
  sobreHero?: boolean;
}

const { variante = "completo", sobreHero = false } = Astro.props;
const minimo = variante === "minimo";

/* Sobre la foto y sobre el navy, el logotipo va en blanco. Es el mismo
   arte, no una versión recoloreada a mano: existe en `/identidad`. */
const logo = sobreHero ? sitio.logoHorizontalBlanco : sitio.logoHorizontal;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * ⚠️ LAS ANCLAS SOLO SON ANCLAS EN LA PORTADA.
 *
 * Los enlaces de esta barra son `#temario`, `#precio`, `#faq`, y el logotipo era
 * `#inicio`. En la portada eso está bien. En CUALQUIER otra página —`/login`,
 * los avisos legales— un `href="#inicio"` no lleva a ninguna parte: el navegador
 * busca ese id en la página actual, no lo encuentra, y lo único que pasa es que
 * la URL se queda con la coletilla pegada. De ahí salía
 * `/login?signedout=1#inicio`, y de ahí que pulsar el logotipo no volviera al
 * inicio.
 *
 * Fuera de la portada se anteponen a `/`, así que navegan a la página y bajan al
 * sitio. Dentro de ella se quedan como estaban, que es lo que evita una recarga
 * al pulsar el menú.
 */
const enPortada = Astro.url.pathname === "/";
const enlace = (href: string) =>
  enPortada || !href.startsWith("#") ? href : `/${href}`;
const hrefLogo = enPortada ? "#inicio" : "/";

/* El alt del logo lleva el claim, así que también se traduce. Los data-alt-*
   los usa el script del layout para actualizarlo al cambiar de idioma. */
const logoAlt = {
  es: `${sitio.nombre}: ${sitio.claim.es}`,
  en: `${sitio.nombre}: ${sitio.claim.en}`,
};
---

{/* ⚠️ EL CENTINELA. Un píxel invisible justo encima de la barra. Mientras se
    ve, estamos arriba del todo y la barra va alta; en cuanto sale de pantalla,
    la barra se compacta. Un IntersectionObserver sobre esto cuesta cero; un
    listener de `scroll` se dispara decenas de veces por segundo. */}
<div data-tope-centinela aria-hidden="true" class="h-px w-full"></div>

<header
  data-cabecera
  data-compacta="false"
  data-fija="false"
  class:list={[
    "group z-40 transition-[background-color,border-color] duration-300 ease-[var(--ease-out-soft)]",
    sobreHero
      ? /* ─── ARRIBA FLOTA SOBRE LA FOTO; EN CUANTO SE MUEVE, SE ANCLA ───
           En reposo va en el flujo de su envoltorio —el que la portada pinta
           encima del hero— y sin fondo, para que se vea la foto por detrás. No
           se posiciona ella sola: en `top-0` por su cuenta se montaría sobre la
           cinta de precio, que ocupa esos píxeles.

           `data-fija` la despega y la ancla arriba en navy, y se enciende en
           cuanto el scroll pasa la cinta, no al final del hero. Es lo que hace
           que la barra BAJE CONTIGO en vez de quedarse arriba: a partir del
           primer dedo de scroll está siempre a la vista.

           Y no se esconde al bajar. Llegó a hacerlo, para ganar 80 px de
           pantalla, pero eso es justo lo contrario de tenerla siempre. */
        "relative border-b border-transparent bg-transparent " +
        "data-[fija=true]:fixed data-[fija=true]:inset-x-0 data-[fija=true]:top-0 " +
        "data-[fija=true]:border-primary-800 " +
        "data-[fija=true]:bg-primary-950 data-[fija=true]:shadow-lg"
      : "sticky top-0 border-b border-line bg-surface",
  ]}
>
  {/* ─── EL HEADER A 320 PX ─────────────────────────────────────────────────
      Con el acceso de alumnos dentro, la fila pasó a pedir 347 px en un
      teléfono de 320: 27 px de desbordamiento, o sea scroll horizontal en toda
      la página. Se recuperan repartidos y sin quitar nada de la barra —el
      hueco entre bloques, el ancho del logotipo y el acolchado del acceso—,
      porque los tres elementos que hay tienen que seguir estando: la marca, el
      idioma y la puerta de quien ya pagó.

      ─── TRES COLUMNAS DE `lg` PARA ARRIBA ────────────────────────────────
      Navegación a la izquierda, logotipo en el centro, acciones a la derecha.
      Es una rejilla de tres y no un flex con `justify-between` porque el
      logotipo tiene que quedar en el CENTRO DE LA PANTALLA, no en el centro del
      hueco que dejen los otros dos: con flex, en cuanto un lado pesa más que el
      otro, el logo se desplaza y deja de estar centrado.

      Por debajo de `lg` no hay menú, así que la rejilla de tres dejaría la
      columna izquierda vacía y el logo centrado contra nada. Ahí se vuelve al
      reparto de siempre: marca a la izquierda, acciones a la derecha. */}
  <div
    class:list={[
      "container-page flex h-[var(--header-h-grande)] items-center justify-between gap-2 transition-[height] duration-300 ease-[var(--ease-out-soft)] group-data-[compacta=true]:h-[var(--header-h)] max-[359px]:gap-1 sm:gap-4 lg:h-[var(--header-h-grande-lg)] lg:group-data-[compacta=true]:h-[var(--header-h-lg)]",
      /* Con logo centrado: rejilla de tres. Con logo a la izquierda (el
         rediseño): flex, que es lo que ya trae la clase de arriba. */
      !sobreHero && "lg:grid lg:grid-cols-[1fr_auto_1fr]",
    ]}
  >
    {/* ─── IZQUIERDA: la navegación ──────────────────────────────────────
        En móvil este bloque no existe, y por eso el logo va antes en el
        marcado: el orden de lectura tiene que empezar por la marca. En `lg` la
        rejilla lo coloca en su columna con `order`. */}
    {
      !minimo && (
        <nav
          aria-label={copy.ui.menuPrincipal[lang]}
          data-aria-es={copy.ui.menuPrincipal.es}
          data-aria-en={copy.ui.menuPrincipal.en}
          class:list={[
            "hidden lg:flex lg:items-center lg:gap-1",
            sobreHero ? "lg:order-2" : "lg:order-1 lg:justify-self-start",
          ]}
        >
          {cta.navegacion.map((item) => (
            <a
              href={enlace(item.href)}
              class:list={[
                "inline-flex min-h-11 items-center rounded-full px-3 text-sm font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2",
                sobreHero
                  ? "text-white/85 hover:text-white focus-visible:outline-focus-inverse"
                  : "text-ink-muted hover:bg-surface-muted hover:text-ink focus-visible:outline-focus",
              ]}
            >
              <T v={item.texto} />
            </a>
          ))}
        </nav>
      )
    }

    {/* ─── CENTRO: la marca ──────────────────────────────────────────────
        shrink-0: sin esto, en móvil el flex del header comprimía el enlace y
        el logo salía deformado (115×32 sobre un arte de 573×120).

        El logotipo encoge con la barra. Se anima con `height` y no con
        `transform: scale`, que sería más barato, porque un logotipo escalado se
        ve borroso a mitad de la transición: es un dibujo con texto fino, y aquí
        la nitidez manda sobre el ahorro de un fotograma. */}
    <a
      href={hrefLogo}
      class:list={[
        "flex min-h-11 shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-2",
        /* Centrado en la barra blanca (lo pidió el cliente en su día) y a la
           IZQUIERDA cuando flota sobre el hero, que es lo que pide el
           rediseño. Sin este `order-1`, el logotipo empata en orden con el
           menú y gana el que va antes en el marcado, que es el menú. */
        sobreHero
          ? "lg:order-1 focus-visible:outline-focus-inverse"
          : "lg:order-2 lg:justify-self-center focus-visible:outline-focus",
      ]}
    >
      <img
        src={logo.src}
        alt={logoAlt[lang]}
        data-alt-es={logoAlt.es}
        data-alt-en={logoAlt.en}
        width={logo.w}
        height={logo.h}
        class="h-9 w-auto shrink-0 transition-[height] duration-300 ease-[var(--ease-out-soft)] group-data-[compacta=true]:h-8 max-[359px]:h-7 sm:h-11 lg:h-14 lg:group-data-[compacta=true]:h-9"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    {/* ─── DERECHA: idioma, acceso y compra ──────────────────────────────
        El menú (que ahora vive arriba, en su columna) solo aparece de `lg` para
        arriba, y el punto de corte está medido, no elegido: con `md` salía a
        768 px, donde la barra ya lleva logo, selector de idioma y CTA. Los tres
        enlaces no cabían y el header desbordaba 31 px, o sea scroll horizontal
        en toda la página justo en el ancho de una tablet en vertical. */}
    <div class:list={[
        "flex shrink-0 items-center gap-2 sm:gap-3 lg:order-3",
        !sobreHero && "lg:justify-self-end",
      ]}>
      {/* El selector va SIEMPRE visible, también en móvil: si alguien llega
          con ?lang= equivocado tiene que poder corregirlo sin buscar. */}
      <LanguageSwitch client:load lang={lang} tono={sobreHero ? "oscuro" : "claro"} />

      {/* ─── ACCESO DE ALUMNOS ────────────────────────────────────────────────
          Va SIEMPRE visible, también en móvil, y ese es el punto: quien ya pagó
          no viene a leer la página, viene a entrar. Si el acceso solo aparece
          en escritorio, en el teléfono tiene que recorrer una landing de venta
          entera para encontrar la puerta de su propio curso.

          Es un enlace de texto y no un botón: en esta barra el único elemento
          con peso de botón es el de comprar. Dos botones sólidos compiten, y el
          que tiene que ganar la mirada de un visitante nuevo es el de comprar.

          En móvil se queda solo el icono y el rótulo se va a `sr-only`: a
          320 px, con logo, selector de idioma y esto, la palabra no cabe sin
          apretar el logo. El `aria-label` lleva el rótulo largo para que quien
          lo escuche no oiga solo "acceso" sin contexto. */}
      {
        !minimo && (
      <a
        href={enlace(cta.acceso.href)}
        aria-label={cta.acceso.textoLargo[lang]}
        data-aria-es={cta.acceso.textoLargo.es}
        data-aria-en={cta.acceso.textoLargo.en}
        data-track="header-acceso"
        class:list={[
          "inline-flex min-h-11 items-center gap-2 rounded-full px-2.5 text-sm font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 max-[359px]:px-1 sm:px-3",
          sobreHero
            ? "text-white/85 hover:text-white focus-visible:outline-focus-inverse"
            : "text-ink-muted hover:bg-surface-muted hover:text-ink focus-visible:outline-focus",
        ]}
      >
        <Icono nombre="usuario" class="size-5 shrink-0" grosor={1.8} />
        <span class="max-sm:sr-only"><T v={cta.acceso.texto} /></span>
      </a>
        )
      }

      {/* `max-md:hidden` y no `hidden md:inline-flex`: la base del botón ya
          trae `inline-flex`, y entre dos utilidades del mismo grupo gana la que
          Tailwind ordena después, no la que escribes al final. El resultado era
          un CTA que nunca se ocultaba y desbordaba el header en móvil. Con una
          variante responsive no hay ambigüedad posible.

          `md` y no `sm`, para que case con el CTA fijo de móvil: la barra fija
          existe por debajo de 48rem (768). Con el corte en `sm` (640) había una
          franja de 640 a 767 con los DOS CTA a la vez, que es justo lo que el
          comentario de arriba dice que no puede pasar. Ahora el relevo es
          exacto: por debajo de 768 manda la barra fija, por encima el header. */}
      {/* ⚠️ SOBRE EL HERO NO HAY BOTÓN DE COMPRA, y es una decisión del
          rediseño: la barra son enlaces de texto y ya está. El hero tiene
          su propio botón tres centímetros más abajo, y la barra flotante
          de móvil sigue llevándolo en todas las pantallas, así que la
          acción no desaparece de la vista en ningún momento. */}
      {
        !minimo && !sobreHero && (
      <Button
        href={enlace(cta.primario.href)}
        variant="primary"
        size="md"
        trackId="header"
        class="max-md:hidden"
      >
        <T v={cta.primario.texto} />
      </Button>
        )
      }
    </div>
  </div>
</header>

{/* ═══════════════════════════════════════════════════════════════════════════
    LA BARRA SE COMPACTA AL BAJAR
    ═══════════════════════════════════════════════════════════════════════════

    Once líneas y ningún listener de `scroll`. El centinela es un píxel encima
    de la barra: mientras se ve, estamos arriba del todo; en cuanto sale de
    pantalla, la barra pasa a `data-compacta="true"` y el CSS hace el resto.

    ⚠️ POR QUÉ NO UN LISTENER DE SCROLL. Se dispara decenas de veces por segundo
    y en cada una hay que leer `scrollY`, que fuerza al navegador a recalcular
    la maqueta. El observador solo avisa cuando la respuesta CAMBIA, que son dos
    veces en toda la visita.

    ⚠️ SIN JAVASCRIPT LA BARRA SE QUEDA ALTA, y es la degradación correcta: alta
    es como se ve al cargar, que es el estado en el que el logotipo se lee mejor.
    No hay ningún caso en el que la barra desaparezca o tape nada. */}
<script is:inline>
  (() => {
    const centinela = document.querySelector("[data-tope-centinela]");
    const cabecera = document.querySelector("[data-cabecera]");
    if (!centinela || !cabecera) return;

    new IntersectionObserver(
      ([entrada]) => {
        cabecera.dataset.compacta = String(!entrada.isIntersecting);
      },
      { threshold: 0 },
    ).observe(centinela);

    /* ─── Y CUÁNDO SE ANCLA ARRIBA ───────────────────────────────────────

       Solo en la portada, que es la única donde la barra empieza flotando
       sobre la foto. En reposo va transparente y dentro del flujo; en cuanto
       el scroll pasa de su propia posición, se despega, se ancla arriba y se
       pinta de navy. A partir de ahí ESTÁ SIEMPRE: baja contigo hasta el pie.

       ⚠️ EL UMBRAL ES SU PROPIO `offsetTop`, o sea el alto de la cinta de
       precio que tiene encima. No es un número elegido a ojo: en ese punto
       exacto la barra ya está tocando el borde de arriba de la pantalla, así
       que al pasar a `fixed` se queda donde ya estaba y no hay salto. Con
       cualquier otro valor, la barra pega un brinco al cambiar de modo.

       Llegó a esconderse al bajar y volver al subir, para ganar 80 px de
       pantalla. Se quitó: lo que se pidió es tenerla siempre, y una barra que
       aparece y desaparece es justo lo contrario aunque ocupe menos.

       ⚠️ AQUÍ SÍ HAY UN LISTENER DE SCROLL, y es la excepción a la nota de
       arriba. Un IntersectionObserver sobre un centinela habría valido, pero
       el centinela tendría que estar exactamente a la altura de la cinta, y
       eso es un píxel más que mantener sincronizado con un alto que cambia
       con el idioma y con el tamaño de pantalla. El listener es `passive` y
       no hace trabajo en cada evento: apunta y deja que
       `requestAnimationFrame` lo resuelva una vez por fotograma.

       Sin JavaScript la barra se queda flotando y transparente, que es como se
       ve al cargar: no tapa nada ni desaparece. */
    let pendiente = false;
    let tope = cabecera.offsetTop;

    const revisar = () => {
      pendiente = false;
      /* El tope solo se vuelve a medir MIENTRAS ESTÁ EN REPOSO. Anclada es
         `fixed`, y ahí `offsetTop` vale 0: releerlo en ese estado dejaría el
         umbral en cero y la barra no volvería a soltarse nunca. Medido así, un
         cambio de tamaño de pantalla se recoge solo la próxima vez que se llega
         arriba, que es justo cuando importa. */
      if (cabecera.dataset.fija !== "true") tope = cabecera.offsetTop;
      cabecera.dataset.fija = String(window.scrollY > tope);
    };

    revisar();

    window.addEventListener(
      "scroll",
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(revisar);
      },
      { passive: true },
    );
  })();
</script>
