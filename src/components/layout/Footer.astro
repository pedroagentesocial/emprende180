---
import { resolverIdiomaServidor } from "@i18n/idioma";
import T from "@components/i18n/T.astro";
import { sitio, contacto, legal, copy, cta } from "@config/curso.config";
import { construirTxt } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";
import { privacidad, terminos } from "@config/legal.config";
import CookiePreferences from "@components/legal/CookiePreferences";
import RedesMarca from "@components/layout/RedesMarca.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import Icono from "@components/ui/Icono.astro";
import { getCollection } from "astro:content";
import { articulosPublicados, blogCopy } from "@lib/blog";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * PIE
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ─── ERA GRIS Y ESTABA MEDIO VACÍO ─────────────────────────────────────────
 *
 * El pie anterior tenía dos bloques: el logo con una frase a la izquierda y una
 * columna de dos enlaces (correo y WhatsApp) empujada al borde derecho por un
 * `justify-between`. Entre los dos, 700 px de gris sin nada. Y el teléfono, que
 * es la vía por la que hoy se puede pagar de verdad, no estaba.
 *
 * Ahora son cuatro columnas con nombre: la marca, la página, el contacto y lo
 * legal. Un pie es el último sitio donde alguien busca algo concreto —"¿cómo
 * les llamo?", "¿dónde estaba el temario?"— y para eso hace falta que esté.
 *
 * ─── Y SE FUE A NAVY ───────────────────────────────────────────────────────
 *
 * Venía de `bg-surface-muted`, un gris claro, justo debajo de la sección de
 * cierre, que es navy. El corte entre los dos partía la página en dos justo al
 * final. En navy, el cierre y el pie se leen como un solo bloque oscuro que
 * remata, y el logo puede ir en blanco, que es su versión buena.
 *
 * ─── LA MARCA, POR FIN, EN MÁS DE UN SITIO ─────────────────────────────────
 *
 * Va el lockup horizontal blanco arriba y el isotipo de marca de agua detrás.
 * Ver `MarcaAgua.astro`: el `relative isolate` de aquí es lo que hace que la
 * marca de agua se quede DETRÁS del contenido y no debajo del fondo.
 */

/**
 * ⚠️ MISMO CASO QUE EN EL HEADER: los enlaces de "La página" son anclas de la
 * portada (`#temario`, `#precio`, `#faq`). En cualquier otra página —el acceso,
 * los avisos legales— un ancla que no existe no navega: solo deja la coletilla
 * pegada en la URL. Fuera de la portada se anteponen a `/`.
 *
 * Está escrito dos veces, aquí y en `Header.astro`, y es a propósito: son tres
 * líneas y compartirlas obligaría a un archivo nuevo que solo sabe de esto. Si
 * aparece un tercer sitio con anclas, entonces sí.
 */
const enPortada = Astro.url.pathname === "/";
const enlace = (href: string) =>
  enPortada || !href.startsWith("#") ? href : `/${href}`;

const anio = new Date().getFullYear();

/* El mensaje prerrellenado de WhatsApp va en el idioma activo: abrir el chat
   con un texto en otro idioma es de las cosas que más cantan. */
const whatsappUrl = contacto.whatsapp
  ? construirTxt(
      (l) =>
        `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(contacto.whatsappMensaje[l])}`,
    )
  : null;

const copyright = construirTxt((l) =>
  interpolar(copy.ui.copyright[l], { anio, razonSocial: contacto.razonSocial }),
);

/* El lockup horizontal y no el cuadrado: en una fila de pie, la versión alta
   obligaba a `h-24` y empujaba la columna entera. */
const logo = sitio.logoHorizontalBlanco;

/* Idioma de ESTA petición. Las islas de React lo necesitan como prop: en
   el servidor no pueden leerlo del DOM, así que sin esto se renderizarían
   siempre en español aunque la URL pida inglés. */
const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* ¿Hay algo publicado en el blog? Ver la nota del enlace, más abajo. */
const hayBlog = (await articulosPublicados(getCollection)).length > 0;
---

{/* ─── EL HUECO DE LA BARRA FLOTANTE LO RESERVA EL PIE ────────────────────────
    `BarraFlotante` es `position: fixed`, así que no ocupa sitio en el flujo y
    tapaba los últimos ~70 px de la página: el copyright quedaba debajo de ella
    y no había forma de leerlo. (La reserva existía en `global.css`, pero un
    segundo bloque `body` heredado de cuando la barra era solo de móvil volvía a
    declarar `padding-bottom` y la anulaba. Ver el comentario de allí.)

    Se reserva aquí y no en el `body` por el color: el pie es navy y el body es
    blanco, así que 80 px de `padding` en el body eran una franja blanca
    asomando por debajo del pie. En el `<footer>` el hueco es del mismo color y
    no se ve.

    Y se reserva SIEMPRE, no solo mientras la barra está visible: alternarlo con
    una clase cambia el layout a mitad de scroll, y eso son 0,15 de CLS.

    6,5rem y no 5: la barra mide 69 px en escritorio y 65 en móvil, así que con
    5rem el copyright quedaba a 11 px de ella —descubierto, pero pegado, que se
    lee como si siguiera tapado a medias—. Con 104 px quedan 35 de aire. */}
<footer
  class="relative isolate overflow-hidden border-t border-primary-800 bg-primary-950 pb-[calc(6.5rem+env(safe-area-inset-bottom))] text-secondary-200"
>
  <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-8">
      <!-- ── La marca ──────────────────────────────────────────────────────── -->
      <div>
        <img
          src={logo.src}
          alt={sitio.nombre}
          width={logo.w}
          height={logo.h}
          class="h-12 w-auto"
          loading="lazy"
          decoding="async"
        />

        {/* `max-w-sm` y no `max-w-xs`: en una columna de 1.6fr, 20rem partía la
            frase en siete renglones cortos. */}
        <p class="mt-5 max-w-sm text-sm text-pretty">
          <T v={sitio.descripcion} />
        </p>

        <p class="mt-6 text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
          <T v={copy.ui.pieRedes} />
        </p>
        <RedesMarca
          class="mt-3"
          tono="oscuro"
          pendingLabel={lang === "es" ? "Próximamente" : "Coming soon"}
        />
      </div>

      <!-- ── La página ─────────────────────────────────────────────────────── -->
      {/* Los mismos enlaces del menú de arriba. En el pie sí caben los cuatro:
          quien llega hasta aquí ya ha leído, y volver a una sección concreta es
          justo lo que va a querer hacer. */}
      <nav aria-label={copy.ui.pieNavegar[lang]}>
        <h2 class="text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
          <T v={copy.ui.pieNavegar} />
        </h2>
        <ul class="mt-3 grid text-sm">
          {
            cta.navegacion.map((n) => (
              <li>
                <a
                  href={enlace(n.href)}
                  class="inline-flex min-h-11 items-center transition-colors hover:text-ink-inverse"
                >
                  <T v={n.texto} />
                </a>
              </li>
            ))
          }

          {/* ⚠️ EL BLOG SOLO APARECE CUANDO HAY ALGO QUE LEER, y esa condición
              es la mitad de la decisión de tener blog. Un enlace a una sección
              vacía —o peor, a un "próximamente"— le dice al visitante que el
              proyecto está a medio hacer justo donde intentas que se fíe para
              pagar. Vacío no resta si NO EXISTE. Ver `/blog`, que devuelve 404
              mientras no hay artículos publicados. */}
          {
            hayBlog && (
              <li>
                <a
                  href="/blog"
                  class="inline-flex min-h-11 items-center transition-colors hover:text-ink-inverse"
                >
                  <T v={blogCopy.titulo} />
                </a>
              </li>
            )
          }
        </ul>
      </nav>

      <!-- ── El contacto ───────────────────────────────────────────────────── -->
      {/* EL TELÉFONO ENTRA EN EL PIE. Mientras no haya pasarela es la única vía
          por la que se puede pagar, y estaba en la barra flotante, en el cierre
          y en preguntas — en todas menos en el sitio donde la gente busca un
          teléfono cuando ya ha decidido. */}
      <div>
        <h2 class="text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
          <T v={copy.ui.pieContacto} />
        </h2>
        <ul class="mt-3 grid text-sm">
          {
            contacto.telefono && (
              <li>
                <a
                  href={`tel:${contacto.telefono}`}
                  class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-ink-inverse"
                >
                  <span aria-hidden="true" class="marca-linea shrink-0">
                    <Icono nombre="telefono" class="size-4" grosor={2} />
                  </span>
                  {contacto.telefonoVisible}
                </a>
              </li>
            )
          }

          <li>
            <a
              href={`mailto:${contacto.email}`}
              class="inline-flex min-h-11 items-center gap-2 break-all transition-colors hover:text-ink-inverse"
            >
              <span aria-hidden="true" class="marca-linea shrink-0">
                <Icono nombre="conversacion" class="size-4" grosor={2} />
              </span>
              {contacto.email}
            </a>
          </li>

          {
            whatsappUrl && (
              <li>
                <a
                  href={whatsappUrl.es}
                  data-wa-es={whatsappUrl.es}
                  data-wa-en={whatsappUrl.en}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-ink-inverse"
                >
                  <span aria-hidden="true" class="marca-linea shrink-0">
                    <Icono nombre="bocadillos" class="size-4" grosor={2} />
                  </span>
                  WhatsApp
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- ── Lo legal ──────────────────────────────────────────────────────── -->
      {/* `data-legal` hace que se abran en modal sin salir de la landing. Sin
          JS siguen siendo enlaces normales a páginas reales e indexables. */}
      <nav
        aria-label={copy.ui.enlacesLegales.es}
        data-aria-es={copy.ui.enlacesLegales.es}
        data-aria-en={copy.ui.enlacesLegales.en}
      >
        <h2 class="text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
          <T v={copy.ui.pieLegal} />
        </h2>
        <ul class="mt-3 grid text-sm">
          <li>
            <a
              href={legal.privacidad}
              data-legal="privacidad"
              class="inline-flex min-h-11 items-center transition-colors hover:text-ink-inverse"
            >
              <T v={privacidad.titulo} />
            </a>
          </li>
          <li>
            <a
              href={legal.terminos}
              data-legal="terminos"
              class="inline-flex min-h-11 items-center transition-colors hover:text-ink-inverse"
            >
              <T v={terminos.titulo} />
            </a>
          </li>
          <li class="flex min-h-11 items-center">
            <CookiePreferences client:visible lang={lang} />
          </li>
        </ul>
      </nav>
    </div>

    {/* Aquí llegó a haber un isotipo pequeño a la derecha del copyright. Se fue:
        la marca de agua ya ocupa esa esquina, y dos veces el mismo símbolo en
        el mismo rincón no es marca, es repetición. */}
    <div class="mt-12 border-t border-primary-800 pt-6 text-sm text-secondary-200/80">
      <p><T v={copyright} /></p>
    </div>
  </div>
</footer>
