---
/**
 * The brand's five social marks (Facebook, Instagram, TikTok, YouTube,
 * LinkedIn). A profile with a url renders as a link; one without renders as a
 * muted, non-clickable mark — the five are part of the brand even before the
 * accounts exist, but we never ship a dead profile link.
 *
 * Glyphs inlined from Simple Icons (CC0): no icon dependency, no CDN request.
 */
import { redesMarca } from '@config/curso.config';
import { RUTAS_REDES } from '@lib/redes';

interface Props {
  /** Label shown on a profile that does not exist yet (e.g. "Próximamente"). */
  pendingLabel: string;
  /** Which background it sits on. `oscuro` for the navy footer. */
  tono?: 'claro' | 'oscuro';
  class?: string;
}
const { pendingLabel, tono = 'claro', class: className = '' } = Astro.props;

/* `size-11` and not `size-10`: 44px is the WCAG 2.5.8 minimum, and today these
   render as spans (no profile urls yet) so the touch-target audit skips them.
   The day a url lands here they become links, and 40px links would fail. */
const ESTILOS = {
  claro: {
    enlace: 'border-line text-ink-muted hover:border-ink hover:text-ink',
    pendiente: 'border-line text-ink-subtle/60',
  },
  oscuro: {
    enlace:
      'border-primary-700 text-secondary-200 hover:border-secondary-400 hover:text-ink-inverse',
    pendiente: 'border-primary-700 text-secondary-200/50',
  },
} as const;

const estilo = ESTILOS[tono];

/* Los glifos viven en `@lib/redes` y no aquí: los usan también el botón que
   se abre (`BotonRed.astro`) y, con él, el pie y la sección del blog. Tres
   copias del mismo SVG es la forma garantizada de acabar con tres versiones
   distintas del logo de TikTok. */
const paths = RUTAS_REDES;
const profiles = redesMarca;
---

<ul role="list" class={`flex flex-wrap gap-2.5 ${className}`}>
  {
    profiles.map((p) =>
      p.url ? (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={p.label}
            title={p.label}
            class={`grid size-11 place-items-center rounded-full border transition-colors ${estilo.enlace}`}
          >
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[p.key]} /></svg>
          </a>
        </li>
      ) : (
        <li>
          <span
            aria-label={`${p.label} — ${pendingLabel}`}
            title={`${p.label} — ${pendingLabel}`}
            class={`grid size-11 cursor-default place-items-center rounded-full border border-dashed ${estilo.pendiente}`}
          >
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[p.key]} /></svg>
          </span>
        </li>
      ),
    )
  }
</ul>
