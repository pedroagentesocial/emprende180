---
import T from "@components/i18n/T.astro";
import type { Testimonio } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * TARJETA DE TESTIMONIO — horizontal, con la foto de protagonista
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Sustituye al formato anterior: un avatar circular de 44 px con las iniciales
 * y el texto debajo. Aquí la foto ocupa el 38 % de la tarjeta y todo su alto.
 *
 * ⚠️ Y HOY NO HAY NINGUNA FOTO. Los seis testimonios tienen `foto: null` y
 * `/public/imagenes/testimonios/` está vacía. Por eso la columna de la foto es
 * CONDICIONAL y no un hueco con iniciales dentro: una tarjeta con dos letras
 * gigantes donde debería haber una cara resta credibilidad justo en la sección
 * que existe para darla. Sin foto, el texto ocupa la tarjeta entera y se lee
 * como una cita, que es lo que es.
 *
 * En cuanto alguien deje los archivos en esa carpeta y los apunte desde
 * `testimonios[].foto`, la columna aparece sola. No hay que tocar esto.
 *
 * ⚠️ LA CITA VA EN FRAUNCES ITÁLICA, Y ES UNA EXCEPCIÓN CONSCIENTE. tokens.css
 * dice que esa familia no se usa para párrafos, y tiene razón para el texto
 * corrido de la página. Una cita es otra cosa: es la convención tipográfica de
 * toda la vida para la voz de otra persona, y es lo que la separa de lo que
 * decimos nosotros. Se queda en ~18 px y en cuatro renglones como mucho; si
 * alguien mete una cita de diez líneas, esta excepción deja de valer.
 */

interface Props {
  testimonio: Testimonio;
  /**
   * La versión del carrusel: una sola tarjeta a la vista, así que puede ser
   * más alta y con la cita un cuerpo mayor. En la banda —varias en fila— se
   * queda en el tamaño normal.
   */
  grande?: boolean;
  class?: string;
}

const { testimonio: t, grande = false, class: className = "" } = Astro.props;

/**
 * ⚠️ EL AVATAR SON LAS INICIALES MIENTRAS NO HAYA FOTO REAL, Y NO UNA FOTO DE
 * BANCO. El cliente pidió el 16-09-2026 "imagen en círculo de la persona,
 * búscalas tú": buscar caras de banco y ponerlas junto al nombre real de un
 * alumno sería enseñar como Carlos Ramírez a alguien que no es Carlos
 * Ramírez. Un testimonio con nombre real y cara ajena es un testimonio
 * falseado, y la FTC (16 CFR 255) lo trata como endoso engañoso. Las
 * iniciales en el círculo de marca dan el peso visual del avatar sin
 * afirmar nada que no sea verdad; el día que llegue la foto de cada uno
 * (`foto` en el config), entra sola en el mismo hueco.
 */
const iniciales = t.nombre
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0]!.toUpperCase())
  .join("");
---

<article
  class:list={[
    /* `overflow-hidden` es lo que hace que la foto respete las esquinas: sin
       él, la imagen sale por las cuatro puntas del radio. */
    "flex h-full flex-col overflow-hidden rounded-lg border-[0.5px] border-line bg-surface",
    grande ? "min-h-[320px] lg:min-h-[380px]" : "min-h-[260px]",
    className,
  ]}
>
  <div class:list={["flex flex-1 flex-col justify-center gap-5", grande ? "p-7 sm:p-10 lg:p-12" : "p-6 sm:p-7"]}>
    <blockquote>
      <p
        class:list={[
          "font-acento leading-relaxed text-pretty text-ink italic",
          grande ? "text-xl sm:text-2xl lg:text-3xl lg:leading-snug" : "text-lg",
        ]}
      >
        <T v={t.cita} />
      </p>
    </blockquote>

    {/* `cite` dentro de `footer` y no dentro del `blockquote`: la
        especificación dice que el contenido de `blockquote` es LA CITA, y la
        atribución no forma parte de lo que la persona dijo. */}
    <footer class="flex items-center gap-3.5">
      {/* El avatar: la foto si existe; si no, las iniciales sobre el navy de
          marca. Ver la nota del frontmatter. */}
      {
        t.foto ? (
          <img
            src={t.foto}
            alt=""
            width={96}
            height={96}
            loading="lazy"
            decoding="async"
            class:list={["shrink-0 rounded-full object-cover", grande ? "size-14" : "size-12"]}
          />
        ) : (
          <span
            aria-hidden="true"
            class:list={[
              "grid shrink-0 place-items-center rounded-full bg-primary-900 font-bold tracking-wide text-secondary-300",
              grande ? "size-14 text-base" : "size-12 text-sm",
            ]}
          >
            {iniciales}
          </span>
        )
      }
      <div class="min-w-0">
        <p class:list={["font-semibold text-ink", grande ? "text-lg" : "text-base"]}>{t.nombre}</p>
        <p class:list={["mt-0.5 text-ink-subtle", grande ? "text-sm sm:text-base" : "text-[0.8125rem]"]}>
          <T v={t.contexto} />
        </p>
      </div>
    </footer>
  </div>
</article>
