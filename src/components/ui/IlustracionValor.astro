---
/**
 * ═══════════════════════════════════════════════════════════════════════════
 * ILUSTRACIONES DE LOS VALORES
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Cuatro dibujos para el bloque "en qué creemos" de /about.
 *
 * ─── POR QUÉ NO SON LOS ICONOS DE `Icono.astro` ────────────────────────────
 *
 * Ahí primero fueron iconos de línea, los mismos que usa el resto del sitio, y
 * quedaron pobres: a 40 px, un trazo de 1,5 sobre un bloque grande se ve
 * escuálido y parece un icono de interfaz metido donde no toca. Un icono señala
 * una función; una ilustración acompaña una idea, y estos acompañan cuatro
 * frases que son lo que la marca promete.
 *
 * ─── QUÉ LOS HACE UNA FAMILIA ──────────────────────────────────────────────
 *
 * Los cuatro comparten exactamente lo mismo, y por eso se ven del mismo juego:
 *
 *   · Lienzo de 64×64 y una mancha redondeada de fondo, siempre la misma.
 *   · Dos tintas y solo dos: el teal claro de la mancha y el navy del dibujo.
 *   · Formas macizas, sin trazos finos: a este tamaño el relleno se lee y la
 *     línea se pierde.
 *   · Nada de detalle pequeño. Si un dibujo necesita tres elementos, sobra uno.
 *
 * ⚠️ SON DECORATIVOS. Van `aria-hidden` y sin título: todo lo que dicen está
 * escrito en la frase de al lado. Un dibujo que aporta información que no está
 * en el texto es información que media audiencia no recibe.
 *
 * ⚠️ Y NO SON FOTOS. Cuando haya sesión de fotos de verdad, esto sigue
 * valiendo: son ideas abstractas —una promesa que no se hace, un límite, un
 * horario— y de eso no hay fotografía honesta.
 */

interface Props {
  /** Cuál de los cuatro. */
  nombre:
    | "cifra"
    | "limites"
    | "parte"
    | "horario"
    | "inventario"
    | "casa"
    | "volver";
  class?: string;
}

const { nombre, class: className = "" } = Astro.props;

/* La mancha de fondo, idéntica en los cuatro: es el ancla visual de la serie. */
const MANCHA =
  '<path d="M31.6 3.4c9.4-1 18.6 2.6 23.9 9.6 5.3 7 6.7 17.3 3.8 26-2.9 8.7-10.1 15.8-18.7 18.4-8.6 2.6-18.6.8-25.4-4.9C8.4 46.8 4.8 37.6 5.4 28.8 6 20 10.8 11.6 17.6 7.3c3.5-2.2 8-3.5 14-3.9Z" fill="var(--color-secondary-100)"/>';

const DIBUJOS = {
  /* Etiqueta de precio con una barra encima: la cifra que no se promete. */
  cifra: `${MANCHA}<path d="M33.4 17.4h11.9a2.4 2.4 0 0 1 2.4 2.4v11.9a2.4 2.4 0 0 1-.7 1.7L32.3 48.1a2.4 2.4 0 0 1-3.4 0L15.2 34.4a2.4 2.4 0 0 1 0-3.4l14.7-14.7a2.4 2.4 0 0 1 1.7-.7Z" fill="var(--color-primary-900)"/><circle cx="40.6" cy="24.2" r="2.6" fill="var(--color-secondary-100)"/><path d="M14.4 49.6 49.6 14.4" stroke="var(--color-secondary-500)" stroke-width="4.2" stroke-linecap="round"/>`,

  /* Dos fichas: una con palomita y otra con aspa. Lo que sí y lo que no. */
  limites: `${MANCHA}<rect x="14" y="18.6" width="36" height="10.4" rx="5.2" fill="var(--color-primary-900)"/><rect x="14" y="35" width="36" height="10.4" rx="5.2" fill="var(--color-primary-900)" opacity="0.35"/><path d="m18.8 23.8 2.6 2.6 5-5.2" stroke="var(--color-secondary-300)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="m19.2 38.6 5.6 5.6M24.8 38.6l-5.6 5.6" stroke="var(--color-secondary-300)" stroke-width="3.2" stroke-linecap="round" fill="none"/>`,

  /* Un banderín clavado: hasta aquí llega tu parte. */
  parte: `${MANCHA}<path d="M20.6 12.4v39.2" stroke="var(--color-primary-900)" stroke-width="4.4" stroke-linecap="round"/><path d="M23.4 15.2h22.4l-5.4 8 5.4 8H23.4Z" fill="var(--color-primary-900)"/><circle cx="20.6" cy="12.4" r="3.4" fill="var(--color-secondary-500)"/>`,

  /* Luna y dos destellos: a la hora que se pueda, también de noche. */
  horario: `${MANCHA}<path d="M47.4 36.8A15.6 15.6 0 0 1 28 17.4a16.4 16.4 0 1 0 19.4 19.4Z" fill="var(--color-primary-900)"/><circle cx="43.2" cy="17.6" r="3" fill="var(--color-secondary-500)"/><circle cx="49.4" cy="26.4" r="1.9" fill="var(--color-secondary-500)"/>`,

  /* Caja tachada: no hay nada que comprar para revender. Repite la barra de
     `cifra` a propósito: las dos dicen "esto no", y que compartan el gesto las
     agrupa sin necesidad de explicarlo. */
  inventario: `${MANCHA}<path d="M15.4 22.6 32 16.4l16.6 6.2v18.8L32 47.6l-16.6-6.2V22.6Z" fill="var(--color-primary-900)"/><path d="M15.4 22.6 32 28.8l16.6-6.2M32 28.8v18.8" stroke="var(--color-secondary-100)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M14.4 49.6 49.6 14.4" stroke="var(--color-secondary-500)" stroke-width="4.2" stroke-linecap="round"/>`,

  /* Una casa: la suya, que sigue siendo suya. */
  casa: `${MANCHA}<path d="M32 13.6 51.4 29v18.4a2.6 2.6 0 0 1-2.6 2.6H15.2a2.6 2.6 0 0 1-2.6-2.6V29L32 13.6Z" fill="var(--color-primary-900)"/><path d="M26.6 50V37.8a2 2 0 0 1 2-2h6.8a2 2 0 0 1 2 2V50" fill="var(--color-secondary-300)"/>`,

  /* Flecha que da la vuelta: se para y se vuelve donde lo dejaste. */
  volver: `${MANCHA}<path d="M46.6 32a14.6 14.6 0 1 1-4.3-10.3" stroke="var(--color-primary-900)" stroke-width="5.4" stroke-linecap="round" fill="none"/><path d="M44.2 12.8v9.8h-9.8" stroke="var(--color-secondary-500)" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
} as const;
---

<svg
  viewBox="0 0 64 64"
  width="64"
  height="64"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={DIBUJOS[nombre]}
/>
