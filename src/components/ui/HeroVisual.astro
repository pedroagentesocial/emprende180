---
import T from "@components/i18n/T.astro";
import { curso, copy } from "@config/curso.config";

/**
 * Visual del hero cuando todavía no hay foto ni video.
 *
 * Antes aquí había una caja punteada vacía que ocupaba media pantalla y no
 * decía nada. Esto la sustituye por algo construido con DATOS REALES del curso
 * —10 videos, un quiz por video, certificación al final— dibujado en CSS.
 *
 * No es una foto falsa ni un mockup de stock: no promete una interfaz que no
 * existe, enseña la estructura del curso. Y en cuanto se deje una `portada` de
 * verdad en `/public/imagenes/curso/`, el hero la usa y esto desaparece solo.
 *
 * Es el LCP de la página, así que va todo en CSS: cero peticiones, cero espera.
 * `aspect-ratio` fijo para que no haya salto de layout.
 */
const { videos } = curso.formato;
const modulos = Array.from({ length: videos }, (_, i) => i + 1);
---

<div
  class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl bg-primary-900 shadow-xl"
>
  <!-- Trama de puntos: el patrón gráfico de la guía de marca. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.18]"
    style="background-image:radial-gradient(currentColor 1px,transparent 1px);background-size:14px 14px;color:var(--color-secondary-300)"
  >
  </div>

  <div class="relative flex h-full flex-col justify-between p-5 sm:p-7">
    <!-- Cabecera: el curso y su formato -->
    <div>
      <p
        class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-secondary-300 sm:text-xs"
      >
        <T v={curso.nombre} />
      </p>
      <p
        class="mt-2 text-lg font-bold text-balance text-ink-inverse sm:text-xl"
      >
        <T v={curso.subtitulo} />
      </p>
    </div>

    <!-- Los 10 videos, como barras de progreso. La primera, "en curso". -->
    <div>
      <ul class="flex items-end gap-1.5" aria-hidden="true">
        {
          modulos.map((n) => (
            <li
              class:list={[
                "h-1.5 flex-1 rounded-full",
                n === 1 ? "bg-secondary-400" : "bg-primary-700",
              ]}
            />
          ))
        }
      </ul>

      <!-- Los tres hechos del curso. Nada aquí es decorativo. -->
      <dl class="mt-5 grid grid-cols-3 gap-2 sm:gap-3">
        <div class="rounded-xl bg-primary-950/50 px-2.5 py-3 text-center sm:px-3">
          <dt class="text-2xl font-extrabold leading-none text-secondary-300 sm:text-3xl">
            {videos}
          </dt>
          <dd class="mt-1.5 text-[0.65rem] font-medium leading-tight text-secondary-200 sm:text-xs">
            <T v={copy.heroVisual.videos} />
          </dd>
        </div>
        <div class="rounded-xl bg-primary-950/50 px-2.5 py-3 text-center sm:px-3">
          <dt class="text-2xl font-extrabold leading-none text-secondary-300 sm:text-3xl">
            {videos}
          </dt>
          <dd class="mt-1.5 text-[0.65rem] font-medium leading-tight text-secondary-200 sm:text-xs">
            <T v={copy.heroVisual.quizzes} />
          </dd>
        </div>
        <div class="rounded-xl bg-primary-950/50 px-2.5 py-3 text-center sm:px-3">
          <dt
            class="grid place-items-center text-secondary-300"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="none" class="size-7 sm:size-8" stroke-width="1.8">
              <circle cx="12" cy="9" r="5.5" stroke="currentColor"></circle>
              <path
                d="m9 13.5-1 7 4-2.2 4 2.2-1-7"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </dt>
          <dd class="mt-1.5 text-[0.65rem] font-medium leading-tight text-secondary-200 sm:text-xs">
            <T v={copy.heroVisual.certificacion} />
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>
