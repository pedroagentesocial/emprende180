---
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import { curso, copy, garantia } from "@config/curso.config";
import {
  construirTxt,
  LOCALES,
  resolverIdiomaServidor,
  type Txt,
} from "@i18n/idioma";
import { formatMoney, interpolar } from "@i18n/formato";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * TIRA DE ANUNCIOS — navy, de lado a lado, sin parar
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Sustituye a las cintas de hover que había entre secciones. Aquellas tenían
 * tres problemas a la vez: escondían el detalle detrás del cursor (o sea, no
 * existía en móvil), eran cajas quietas que se saltaban igual que un banner, y
 * cada una decía una sola cosa.
 *
 * Esta dice SEIS cosas —precio, subida, plazo, contenido, garantía, cuotas— y
 * las va pasando. No hay nada que descubrir: todo está a la vista, solo que por
 * turnos.
 *
 * ─── EL MOVIMIENTO ES EL MISMO QUE EL DE LA BANDA DE TESTIMONIOS ───────────
 *
 * Reutiliza `[data-banda]` / `[data-banda-pista]` de global.css, y eso no es
 * pereza: significa que hay UN solo comportamiento de "algo que se desplaza" en
 * toda la página, con un solo sitio donde ajustar la velocidad, un solo bucle
 * sin costura y una sola regla de `prefers-reduced-motion`. Dos implementaciones
 * distintas de lo mismo acaban desincronizándose.
 *
 * La lista se pinta dos veces y la pista se desplaza un -50 % exacto: el
 * fotograma en que reinicia es idéntico al de salida y no se ve la costura.
 *
 * ─── AHORA SÍ LLEVA BOTÓN DE PAUSA ─────────────────────────────────────────
 *
 * Aquí decía que no hacía falta: que son seis frases cortas en bucle y que si
 * una se pasa, vuelve. Estaba mal, y el fallo era de móvil.
 *
 * La tira se paraba con `:hover` y con `:focus-within`. En un teléfono no
 * existe ninguna de las dos: no hay cursor que pasar y nadie tabula. Así que en
 * la pantalla por la que entra el 73 % de esta audiencia había TRES tiras de
 * texto desplazándose sin parar y ninguna manera de detenerlas. La WCAG 2.2.2
 * (nivel A) pide exactamente lo contrario, y no es un tecnicismo: una frase que
 * se mueve no la lee quien lee despacio, quien tiene dislexia o quien va en el
 * autobús. Que las frases sean cortas no arregla nada — se repiten en bucle, o
 * sea que el movimiento no termina nunca.
 *
 * El mando es el MISMO que el de la banda de testimonios (`@lib/banda`), y eso
 * importa: un solo comportamiento de "parar lo que se mueve", con un solo sitio
 * donde arreglarlo. `prefers-reduced-motion` sigue apagándola entera antes de
 * que el botón haga falta.
 *
 * ─── TODO SALE DEL CONFIG ──────────────────────────────────────────────────
 *
 * Ni una cifra escrita a mano. Si mañana cambia el precio, la fecha o el número
 * de videos, cambian las seis frases. Y si `precio.urgencia.fechaCierre` se pone
 * a `null`, las dos que hablan del plazo desaparecen solas y quedan las otras.
 */
interface Props {
  /**
   * Versión estrecha, para la barra flotante: la tira va dentro de una píldora
   * de 40 px y el mando de 44 px no cabe. Ahí baja a 32, que sigue por encima
   * del mínimo de 24 px que pide la WCAG 2.5.8. Es la única excepción al
   * objetivo táctil de 44 px del proyecto, y solo aplica de `lg` para arriba,
   * que es donde vive esa barra con teletipo.
   */
  compacta?: boolean;
  class?: string;
}

const { compacta = false, class: className = "" } = Astro.props;

const { precio } = curso;
const { fechaCierre, tipo } = precio.urgencia;

const ms = fechaCierre ? new Date(fechaCierre).getTime() : NaN;
/* Sin precio público no hay plazo que anunciar: el plazo ERA la subida de
   precio, y anunciar que sube algo que no se dice cuánto vale no informa de
   nada. Ver `curso.precio.publico`. */
const conPlazo =
  precio.publico && tipo === "fecha" && Number.isFinite(ms) && ms > Date.now();

/** Cada anuncio ya resuelto en los dos idiomas. */
const frase = (plantilla: Txt, extra: Record<string, string | number> = {}) =>
  construirTxt((l) =>
    interpolar(plantilla[l], {
      actual: formatMoney(precio.actual, l, precio.moneda),
      referencia: formatMoney(precio.referencia, l, precio.moneda),
      videos: curso.formato.videos,
      garantiaDias: garantia.dias,
      cuotas: precio.cuotas?.numero ?? 0,
      fecha: fechaCierre
        ? new Intl.DateTimeFormat(LOCALES[l], {
            day: "numeric",
            month: "long",
          }).format(new Date(fechaCierre))
        : "",
      ...extra,
    }),
  );

const a = copy.anuncios;

/**
 * El orden alterna urgencia y contenido a propósito. Seis frases seguidas de
 * precio se leen como un cartel de rebajas; intercaladas con lo que entra en el
 * curso, se leen como información.
 */
/* ⚠️ LAS DOS PRIMERAS SON DE DINERO Y SE CAEN SIN PRECIO PÚBLICO.

   "Precio de lanzamiento: $490" era la primera frase de la tira, o sea la
   cifra más visible de la página entera —cruza la pantalla sola, cada cinco
   segundos, en la barra que va siempre delante—. Dejarla mientras el resto
   del sitio manda a preguntar el precio no sería un descuido, sería la
   contradicción más grande del sitio.

   En su lugar entra la frase de por qué no hay cifra. La tira sigue teniendo
   qué contar: qué incluye, la garantía, el acceso y las mensualidades. */
const anuncios: { texto: Txt; dias?: boolean }[] = [
  { texto: precio.publico ? frase(a.precio) : frase(copy.informes.anuncio) },
  { texto: frase(a.curso) },
  ...(conPlazo ? [{ texto: frase(a.sube) }] : []),
  { texto: frase(a.garantia) },
  ...(conPlazo ? [{ texto: frase(a.dias, { dias: "—" }), dias: true }] : []),
  { texto: frase(a.acceso) },
  ...(precio.cuotas ? [{ texto: frase(a.cuotas) }] : []),
];

/** Velocidad constante: cinco segundos por anuncio. */
const duracion = `${anuncios.length * 5}s`;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);
---

<div
  data-banda
  data-pausada="false"
  class:list={["relative overflow-hidden bg-primary-900 py-3.5", className]}
  data-cierre={conPlazo ? fechaCierre : undefined}
  data-dias-es={a.dias.es}
  data-dias-en={a.dias.en}
  data-hoy-es={a.ultimoDia.es}
  data-hoy-en={a.ultimoDia.en}
>
  {/* El hueco del mando se reserva al FINAL DE LA PISTA y no con un `padding`
      del contenedor: la pista se desplaza por debajo, así que cualquier
      acolchado del padre lo cruzaría el texto igual. Con la reserva dentro, el
      último anuncio nunca llega a meterse debajo del botón. */}
  <ul
    data-banda-pista
    class:list={[
      "flex w-max items-center gap-8 sm:gap-12",
      compacta ? "pr-12" : "pr-16 sm:pr-20",
    ]}
    style={`--duracion:${duracion}`}
    aria-label={copy.anuncios.etiqueta[lang]}
    data-aria-es={copy.anuncios.etiqueta.es}
    data-aria-en={copy.anuncios.etiqueta.en}
  >
    {
      [0, 1].map((copia) =>
        anuncios.map((item) => (
          <li
            class="flex shrink-0 items-center gap-8 sm:gap-12"
            aria-hidden={copia === 1 ? "true" : undefined}
            data-banda-clon={copia === 1 ? "" : undefined}
          >
            <span
              class="text-sm font-bold whitespace-nowrap text-secondary-100 sm:text-base"
              data-anuncio-dias={item.dias ? "" : undefined}
            >
              <T v={item.texto} />
            </span>

            {/* Separador. Un punto teal, que es el acento de la marca: sin él
                las frases se leen como una sola tirada de palabras. */}
            <span
              aria-hidden="true"
              class="size-1.5 shrink-0 rounded-full bg-secondary-500"
            />
          </li>
        )),
      )
    }
  </ul>

  {/* ─── EL MANDO DE PARADA · WCAG 2.2.2, NIVEL A ──────────────────────────
      Ver la nota de la cabecera: sin esto, en un teléfono no había forma de
      detener la tira. El velo de detrás es un degradado del MISMO navy de la
      tira, no una caja: un rectángulo opaco se leería como un botón pegado
      encima, y el degradado hace que el texto se desvanezca antes de llegar.

      `pointer-events-none` en el velo, o se comería los clics del botón. */}
  <div
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute inset-y-0 right-0 z-10",
      compacta ? "w-16" : "w-20 sm:w-28",
    ]}
    style="background-image:linear-gradient(to right, transparent, var(--color-primary-900) 60%)"
  >
  </div>

  <button
    type="button"
    data-banda-pausa
    aria-pressed="false"
    aria-label={copy.anuncios.pausar[lang]}
    data-aria-es={copy.anuncios.pausar.es}
    data-aria-en={copy.anuncios.pausar.en}
    data-etiqueta-pausar-es={copy.anuncios.pausar.es}
    data-etiqueta-pausar-en={copy.anuncios.pausar.en}
    data-etiqueta-reanudar-es={copy.anuncios.reanudar.es}
    data-etiqueta-reanudar-en={copy.anuncios.reanudar.en}
    class:list={[
      "absolute top-1/2 z-20 inline-grid -translate-y-1/2 place-items-center rounded-full",
      "border border-primary-700 bg-primary-950/80 text-secondary-200",
      "transition-colors duration-200 hover:border-secondary-400 hover:text-ink-inverse",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-inverse",
      compacta ? "right-1.5 size-8" : "right-3 size-11 sm:right-4",
    ]}
  >
    <Icono
      nombre="pausa"
      class:list={[compacta ? "size-3.5" : "size-4"]}
      grosor={2}
      data-icono-pausa
    />
    <Icono
      nombre="play"
      class:list={["hidden", compacta ? "size-3.5" : "size-4"]}
      grosor={1}
      data-icono-play
    />
  </button>
</div>

<script>
  import { montarBandas } from "@lib/banda";

  /**
   * Rellena los días que faltan en las tiras.
   *
   * El servidor no los pinta: una página cacheada diría "quedan 12 días" tres
   * días después. La fecha en sí sí va desde el servidor (esa no caduca) y es
   * la frase que sostiene el argumento; esto solo añade la cuenta.
   */
  function pintarDiasAnuncio() {
    document.querySelectorAll<HTMLElement>("[data-banda][data-cierre]").forEach((tira) => {
      const cierre = tira.dataset.cierre;
      const huecos = tira.querySelectorAll<HTMLElement>("[data-anuncio-dias]");
      if (!cierre || !huecos.length) return;

      const restante = new Date(cierre).getTime() - Date.now();
      const idioma = document.documentElement.lang === "en" ? "en" : "es";

      /* Si la fecha ya pasó, se quitan las frases del plazo en vez de dejarlas
         mintiendo. Las demás siguen: la tira no desaparece entera. */
      if (!Number.isFinite(restante) || restante <= 0) {
        huecos.forEach((h) => h.closest("li")?.remove());
        return;
      }

      /* Hacia ABAJO: a 25 horas del cierre, "queda 1 día", no "quedan 2". */
      const dias = Math.floor(restante / 86_400_000);
      const plantilla =
        dias === 0
          ? tira.dataset[idioma === "en" ? "hoyEn" : "hoyEs"]
          : tira.dataset[idioma === "en" ? "diasEn" : "diasEs"];
      if (!plantilla) return;

      huecos.forEach((h) => {
        h.textContent = plantilla.replace("{dias}", String(dias));
      });
    });
  }

  pintarDiasAnuncio();
  window.addEventListener("e180:idioma", pintarDiasAnuncio);

  /* El mando de parada, compartido con la banda de testimonios. Es idempotente,
     así que da igual que los dos componentes lo llamen en la misma página. */
  montarBandas();
</script>
