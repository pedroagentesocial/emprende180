---
/**
 * Iconos de línea del proyecto.
 *
 * POR QUÉ NO HAY UNA LIBRERÍA DE ICONOS. Meter un paquete de iconos por seis
 * dibujos son 40 KB de dependencia y un estilo que no es el de la marca. El
 * logotipo de Emprende180 es de trazo redondeado y grosor uniforme, así que
 * todos estos comparten `stroke-width` y remates redondos: se ven de la misma
 * familia que el isotipo, no pegados de otra web.
 *
 * REGLAS PARA AÑADIR UNO:
 *  · Lienzo 24×24 y trazo, nunca relleno. El color lo pone `currentColor`.
 *  · Nada de detalle fino: a 20 px se pierde y solo ensucia.
 *  · El icono ILUSTRA, no informa. Todo lo que hay que entender está en el
 *    texto de al lado, y por eso van todos `aria-hidden`. Un icono que aporta
 *    información que no está escrita es un icono que media audiencia no recibe.
 */
const ICONOS = {
  /** Nodos conectados: una red de contactos. */
  red: `<circle cx="6" cy="6.5" r="2.4"/><circle cx="18" cy="6.5" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M8.4 6.5h7.2M7.2 8.6l3.6 7.2M16.8 8.6l-3.6 7.2"/>`,
  /** Ojo: reconocer, ver venir. */
  ojo: `<path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.6"/>`,
  /** Teléfono: a quién llamar. */
  telefono: `<path d="M6.6 3.2h2.9l1.5 3.9-2 1.4a12.3 12.3 0 0 0 5.5 5.5l1.4-2 3.9 1.5v2.9a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.4a2 2 0 0 1 2-2.2Z"/>`,
  /** Bocadillo: la conversación que cuesta abrir. */
  conversacion: `<path d="M20.5 12.2c0 3.9-3.8 7-8.5 7a10 10 0 0 1-2.6-.34L4.5 20.5l1.3-3.5a6.5 6.5 0 0 1-2.3-4.8c0-3.9 3.8-7 8.5-7s8.5 3.1 8.5 7Z"/>`,
  /** Calendario con la racha cortada: empezar y dejarlo. */
  calendario: `<rect x="3.3" y="5.2" width="17.4" height="15.5" rx="2.6"/><path d="M3.3 10.1h17.4M8.2 3.3v3.8M15.8 3.3v3.8M8 14.5h3"/>`,
  /* ── Los seis resultados de la sección 03 ──────────────────────────────── */
  /** Brújula: saber dónde estás y dónde encajas. */
  brujula: `<circle cx="12" cy="12" r="8.75"/><path d="m15.4 8.6-2.2 4.6-4.6 2.2 2.2-4.6 4.6-2.2Z"/>`,
  /** Diana: reconocer una oportunidad cuando la tienes delante. */
  diana: `<circle cx="12" cy="12" r="8.75"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="1.1"/>`,
  /** Dos bocadillos: la conversación que va y viene, pedir un referido. */
  bocadillos: `<path d="M14.8 10.6c0 2.6-2.5 4.7-5.6 4.7a7 7 0 0 1-1.7-.2L3.8 16.4l1-2.5a4.4 4.4 0 0 1-1.4-3.3c0-2.6 2.5-4.7 5.6-4.7s5.8 2.1 5.8 4.7Z"/><path d="M16.4 8.2c2.3.6 3.9 2.3 3.9 4.3 0 1.2-.6 2.3-1.5 3.2l.9 2.3-2.9-1.2a7.6 7.6 0 0 1-2 .3"/>`,
  /** Lista ordenada: los contactos con su estado al día. */
  lista: `<rect x="3.4" y="4" width="17.2" height="16" rx="2.6"/><path d="M7.6 9h8.8M7.6 12.8h8.8M7.6 16.6h5.4"/>`,
  /** Megáfono: publicar para que te escriban. */
  megafono: `<path d="M3.6 10.4v3.2a1.6 1.6 0 0 0 1.6 1.6h2.1l7.5 4.3V4.5L7.3 8.8H5.2a1.6 1.6 0 0 0-1.6 1.6Z"/><path d="M18.4 9.3a4.2 4.2 0 0 1 0 5.4M7.3 15.2v3.4a1.4 1.4 0 0 0 2.7.4"/>`,
  /** Escudo: ética y cumplimiento, qué se puede decir y qué no. */
  escudo: `<path d="M12 3.2 4.6 6v6c0 4.3 3.1 7.9 7.4 8.8 4.3-.9 7.4-4.5 7.4-8.8V6L12 3.2Z"/><path d="m9.2 12 2 2 3.6-3.8"/>`,

  /** Play: marca los videos del temario. Triángulo macizo para que se lea a
   *  12 px, que es donde vive (dentro de una insignia). */
  play: `<path d="M8.4 5.9v12.2l10-6.1-10-6.1Z" fill="currentColor" stroke-linejoin="round"/>`,

  /* ── Lo que entra además del temario ───────────────────────────────────── */
  /** Escarapela: la Certificación de Embajador. */
  certificado: `<circle cx="12" cy="9" r="5.6"/><path d="m8.7 13.5-1.2 7.3 4.5-2.5 4.5 2.5-1.2-7.3"/>`,
  /** Infinito: el acceso de por vida. */
  infinito: `<path d="M7.4 15.3c-1.9 0-3.4-1.5-3.4-3.3s1.5-3.3 3.4-3.3c3.1 0 6.1 6.6 9.2 6.6 1.9 0 3.4-1.5 3.4-3.3s-1.5-3.3-3.4-3.3c-3.1 0-6.1 6.6-9.2 6.6Z"/>`,
  /** Flecha circular: las actualizaciones futuras. */
  actualizar: `<path d="M20.3 12a8.3 8.3 0 1 1-2.7-6.1"/><path d="M20.6 4.2v4.4h-4.4"/>`,
  /** Palomita. */
  check: `<path d="m4.5 12.5 5 5 10-11"/>`,
  /** Aspa. Marca lo que el curso NO cubre. */
  cruz: `<path d="M18 6 6 18M6 6l12 12"/>`,
  /** Pausa. Macizo, como el play, para que se lea a 16 px. */
  pausa: `<path d="M8 5.5h2.6v13H8zM13.4 5.5H16v13h-2.6z" fill="currentColor" stroke-linejoin="round"/>`,
  /** Flecha hacia la derecha. */
  flecha: `<path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5"/>`,
  /**
   * Persona. Es el acceso de alumnos del header.
   *
   * Una PERSONA y no un candado a propósito: el candado dice "esto está
   * cerrado" y la silueta dice "esto es tuyo". Para quien ya pagó, lo segundo
   * es lo cierto; para quien no, el candado sería una puerta en la cara en la
   * primera barra de la página.
   */
  usuario: `<circle cx="12" cy="8.2" r="3.9"/><path d="M4.8 20.2a7.2 7.2 0 0 1 14.4 0"/>`,
} as const;

export type NombreIcono = keyof typeof ICONOS;

interface Props {
  nombre: NombreIcono;
  class?: string;
  /** Grosor del trazo. 1.75 es el de uso general; 2.5 para tamaños pequeños. */
  grosor?: number;
  /** Cualquier otro atributo (`data-*`, `id`…) pasa al <svg>. */
  [key: string]: unknown;
}

const {
  nombre,
  class: className = "size-6",
  grosor = 1.75,
  ...rest
} = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={grosor}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  {...rest}
  set:html={ICONOS[nombre]}
/>
