---
/**
 * ═══════════════════════════════════════════════════════════════════════════
 * BOTÓN — el hero, la cabecera, la lista y la captura
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Desde el 15-09-2026 es la misma píldora que el resto del sitio: el estilo
 * vive en `boton-pildora` (global.css) y aquí solo se decide el tamaño y el
 * foco. Ver la nota de esa utilidad para el porqué de cada cosa.
 *
 * ─── LO QUE ERA Y YA NO ES ─────────────────────────────────────────────────
 *
 * Este componente tenía cuatro variantes —`primary` teal relleno, `secondary`,
 * `ghost` e `inverse` de contorno blanco para el hero— y un pequeño relieve al
 * pasar el cursor. Todo eso se fue cuando el cliente pidió UN solo botón para
 * toda la web. La prop `variant` se conserva para no tocar a quien la pasa,
 * pero ya no cambia nada: todas las variantes son la píldora.
 *
 * ⚠️ Y CON ELLAS SE FUE LA REGLA DE "UN SOLO COLOR DE ACCIÓN". Antes el hero
 * tenía un botón relleno y otro de contorno para que el ojo eligiera sin
 * dudar. Ahora los dos serían iguales. Hoy el hero lleva un solo botón, así
 * que no hay conflicto; el día que vuelva a llevar dos, hay que volver a
 * pensar esto.
 *
 * ─── `size` ────────────────────────────────────────────────────────────────
 *
 *   md — la cabecera: más corto y con la letra un punto menor.
 *   lg / xl — el resto. Son iguales: la píldora tiene un solo tamaño de
 *             cuerpo, y `xl` se conserva para que el hero no tenga que
 *             cambiar su llamada.
 */
interface Props {
  /** Se conserva por compatibilidad; ya no cambia el dibujo. */
  variant?: "primary" | "secondary" | "ghost" | "inverse";
  size?: "md" | "lg" | "xl";
  /** Sobre qué fondo va: decide el color del foco y si lleva filete. */
  sobre?: "claro" | "oscuro";
  href?: string;
  type?: "button" | "submit";
  block?: boolean;
  disabled?: boolean;
  /** Se envía a GA4 como `cta_click`. */
  trackId?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  size = "lg",
  sobre = "claro",
  href,
  type = "button",
  block = false,
  disabled = false,
  trackId,
  class: className = "",
  variant: _variant,
  ...rest
} = Astro.props;

const focos = {
  claro: "focus-visible:outline-focus",
  oscuro: "focus-visible:outline-focus-inverse",
} as const;

const classes = [
  "boton-pildora focus-visible:outline-2 focus-visible:outline-offset-2",
  size === "md" && "boton-pildora-md",
  focos[sobre],
  block && "w-full",
  className,
];

const Tag = href ? "a" : "button";
---

<Tag
  class:list={classes}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? "true" : undefined}
  data-track={trackId}
  data-sobre={sobre}
  {...rest}
>
  <slot />
</Tag>
