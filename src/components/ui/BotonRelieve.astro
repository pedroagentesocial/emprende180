---
/**
 * ═══════════════════════════════════════════════════════════════════════════
 * BOTÓN DE LAS SECCIONES
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Es la píldora del sitio, la misma que el hero y los formularios. El estilo
 * vive en `boton-pildora` (global.css) y NO aquí: desde el 15-09-2026 hay un
 * solo botón en toda la web, y tener su CSS en un único sitio es lo que
 * garantiza que siga siendo uno.
 *
 * ─── POR QUÉ SIGUE EXISTIENDO ESTE COMPONENTE ──────────────────────────────
 *
 * Porque lo llaman una docena de secciones con sus props —`href`, `sobre`,
 * `trackId`— y porque el nombre cuenta la historia: este botón fue "en
 * relieve" (levantado, con pila de sombras y una trama de puntos en bucle)
 * durante dos rondas, hasta que el cliente lo cambió por la píldora. El
 * nombre se queda para no tocar doce archivos por un renombre; el relieve se
 * fue.
 *
 * ─── `sobre` ───────────────────────────────────────────────────────────────
 *
 * Solo decide una cosa: sobre blanco el botón lleva un filete fino, porque una
 * píldora blanca sobre una sección blanca no se ve; sobre navy no lo lleva.
 * Ver la nota de `boton-pildora`.
 */

interface Props {
  href?: string;
  type?: "button" | "submit";
  /** Sobre qué fondo se apoya. Ver la cabecera. */
  sobre?: "claro" | "oscuro";
  /** Se envía a GA4 como `cta_click`, igual que `Button.astro`. */
  trackId?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = "button",
  sobre = "claro",
  trackId,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-track={trackId}
  data-sobre={sobre}
  class:list={[
    "boton-pildora focus-visible:outline-2 focus-visible:outline-offset-2",
    sobre === "oscuro" ? "focus-visible:outline-focus-inverse" : "focus-visible:outline-focus",
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
