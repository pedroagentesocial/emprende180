---
import T from "@components/i18n/T.astro";
import { studentCopy } from "@config/studentArea";
import { proveedoresActivos, type Proveedor } from "@lib/oauth";
import { construirTxt } from "@i18n/idioma";

interface Props {
  /** A dónde iba antes de que le mandáramos a identificarse. */
  next?: string;
}

const { next = "" } = Astro.props;

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * ENTRAR CON GOOGLE / CON FACEBOOK
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * SI NO HAY PROVEEDORES CONFIGURADOS, ESTO NO PINTA NADA. Ni el separador ni
 * un hueco: la página de acceso se queda exactamente como estaba. Así se puede
 * publicar el código antes de tener las credenciales sin que nadie vea un botón
 * que no lleva a ningún sitio. Ver `@lib/oauth`.
 *
 * ─── SON ENLACES, NO BOTONES ───────────────────────────────────────────────
 *
 * Un `<a>` a `/api/auth/<proveedor>/start`. Nada de JavaScript: el flujo es una
 * navegación de toda la vida, funciona con el teclado, se puede abrir en otra
 * pestaña y no depende de que hidrate ninguna isla. El servidor genera el
 * `state` y redirige.
 *
 * ─── VAN ARRIBA DEL FORMULARIO ─────────────────────────────────────────────
 *
 * Quien tiene la cuenta enlazada entra en un clic y no debería tener que
 * saltarse dos campos para descubrirlo. Y quien va a teclear su correo pierde
 * medio segundo en leerlos, que es lo que cuesta la alternativa.
 *
 * ⚠️ LOS LOGOTIPOS SON LOS OFICIALES Y NO SE RECOLOREAN. Las guías de marca de
 * Google y de Meta lo piden expresamente, y su cumplimiento se revisa cuando se
 * pide la verificación de la app. Por eso el SVG va en color y el botón es
 * blanco con borde: es el único de la página que no usa la paleta.
 */

/* Los que hoy tienen sus dos variables de entorno. */
const activos = proveedoresActivos();

const NOMBRES: Record<Proveedor, string> = {
  google: "Google",
  facebook: "Facebook",
};

const etiqueta = (p: Proveedor) =>
  construirTxt((l) => studentCopy.entrarCon[l].replace("{proveedor}", NOMBRES[p]));

const href = (p: Proveedor) =>
  next ? `/api/auth/${p}/start?next=${encodeURIComponent(next)}` : `/api/auth/${p}/start`;
---

{
  activos.length > 0 && (
    <div class="mb-6">
      <div class="grid gap-3">
        {activos.map((p) => (
          <a
            href={href(p)}
            rel="nofollow"
            data-track={`acceso-${p}`}
            class="inline-flex min-h-11 w-full items-center justify-center gap-3 rounded-full border border-line-strong bg-surface px-5 py-3 text-base font-semibold text-ink transition-colors duration-200 hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            {p === "google" ? (
              <svg
                aria-hidden="true"
                viewBox="0 0 48 48"
                class="size-5 shrink-0"
                focusable="false"
              >
                <path
                  fill="#4285F4"
                  d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17Z"
                />
                <path
                  fill="#34A853"
                  d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46Z"
                />
                <path
                  fill="#FBBC05"
                  d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34A21.99 21.99 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7Z"
                />
                <path
                  fill="#EA4335"
                  d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07Z"
                />
              </svg>
            ) : (
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="size-5 shrink-0"
                focusable="false"
              >
                <path
                  fill="#1877F2"
                  d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07Z"
                />
              </svg>
            )}
            <T v={etiqueta(p)} />
          </a>
        ))}
      </div>

      {/* El separador. Es una raya con una palabra encima, no un "o" suelto:
          sin la raya, la palabra parece el título del formulario de abajo. */}
      <div class="mt-6 flex items-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 bg-line" />
        <span class="text-xs font-medium tracking-wide text-ink-subtle uppercase">
          <T v={studentCopy.oBien} />
        </span>
        <span class="h-px flex-1 bg-line" />
      </div>
    </div>
  )
}
