---
import T from "@components/i18n/T.astro";
import Icono, { type NombreIcono } from "@components/ui/Icono.astro";
import { plataformas } from "@config/curso.config";
import { studentCopy } from "@config/studentArea";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * LAS HERRAMIENTAS DEL ALUMNO: el CRM y la Academia (rehechas el 12-11-2026)
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Eran dos bloques enormes de color que ocupaban la pantalla entera y, sin
 * dirección todavía, se pintaban apagados con "Próximamente": lo único que
 * veía el alumno era una pantalla vacía con dos cajas. Ahora son dos tarjetas
 * compactas, una al lado de la otra, debajo de su cuenta de Embajador, que es
 * lo que de verdad mira cada día.
 *
 * Cada una conserva su color de marca en el icono (navy el CRM, teal la
 * Academia), así la mano sabe a cuál va sin leer.
 *
 * ⚠️ LA QUE NO TIENE DIRECCIÓN NO ES UN ENLACE: un botón que lleva a `#` se
 * pulsa, no pasa nada, y el alumno concluye que el portal está roto. Se dice
 * "Próximamente" en una pastilla y la tarjeta no se puede pulsar.
 */

const t = studentCopy.dashboard;

const doors: { data: (typeof plataformas)["crm"] | (typeof plataformas)["academia"]; icon: NombreIcono; tile: string }[] = [
  { data: plataformas.crm, icon: "agenda", tile: "bg-primary-900 text-white" },
  { data: plataformas.academia, icon: "play", tile: "bg-secondary-600 text-white" },
];
---

<section class="mt-8">
  <h2 class="px-1 text-base font-bold text-ink"><T v={t.toolsTitle} /></h2>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {
      doors.map(({ data, icon, tile }) => {
        const abierta = !!data.url;
        const fuera = abierta && data.externo;
        const Tag = abierta ? "a" : "div";
        return (
          <li>
            <Tag
              href={abierta ? data.url : undefined}
              target={fuera ? "_blank" : undefined}
              rel={fuera ? "noopener noreferrer" : undefined}
              data-track={abierta ? `alumno-${data.icono}` : undefined}
              class:list={[
                "group flex h-full items-start gap-5 rounded-3xl border border-line bg-surface p-6 sm:p-7",
                abierta && "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus",
              ]}
            >
              <span
                aria-hidden="true"
                class:list={[
                  "grid size-14 shrink-0 place-items-center rounded-2xl transition-transform duration-300 ease-out",
                  tile,
                  abierta ? "group-hover:-rotate-6" : "opacity-60",
                ]}
              >
                <Icono nombre={icon} class="size-7" grosor={1.9} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-3">
                  <span class="text-xl font-bold text-ink"><T v={data.titulo} /></span>
                  {abierta ? (
                    <span class="inline-flex items-center gap-1 text-sm font-bold text-ink-brand">
                      <T v={t.go} />
                      <Icono nombre="flecha" class="size-4 transition-transform group-hover:translate-x-0.5" grosor={2.5} />
                      {fuera && <span class="sr-only"> <T v={t.opensOutside} /></span>}
                    </span>
                  ) : (
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-bold text-ink-muted">
                      <Icono nombre="reloj" class="size-3.5" grosor={2.2} />
                      <T v={t.comingSoon} />
                    </span>
                  )}
                </span>
                <span class="mt-1 block text-sm text-pretty text-ink-muted"><T v={data.texto} /></span>
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>
