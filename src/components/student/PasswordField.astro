---
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import { studentCopy } from "@config/studentArea";
import { resolverIdiomaServidor, type Txt } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * PASSWORD FIELD, WITH AN EYE TO REVEAL IT
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ─── WHY THE EYE ISN'T A LUXURY ────────────────────────────────────────────
 *
 * The project's rule is a ten-character minimum (`MIN_PASSWORD`), and it is the
 * right rule: NIST says what matters is length, not odd symbols. But typing ten
 * characters BLIND on a phone keyboard is exactly where people get it wrong, try
 * three times and leave. The eye is what makes that rule tolerable — the cheap
 * half of a decision whose expensive half was already taken.
 *
 * ─── WHAT IT DOES AND WHAT IT DOESN'T ──────────────────────────────────────
 *
 * It toggles `type="password"` and `type="text"`. It stores nothing, sends
 * nothing and remembers nothing between pages: on reload the password is hidden
 * again, which is correct — nobody wants their password left in plain sight
 * because three screens ago they tapped an eye.
 *
 * ─── THE BEHAVIOUR DOESN'T LIVE HERE ───────────────────────────────────────
 *
 * The listener is a single delegated one, in `BaseLayout`. It has to be that way
 * because the page's password fields live in two worlds: this Astro template and
 * the React island in `LoginForm`. One listener on the document covers both with
 * the same logic; a script per component would be two copies that eventually
 * drift apart.
 *
 * ⚠️ WHICH IS WHY THE MARKUP MATTERS: `aria-controls` has to point at the input's
 * `id`, and the two icons carry `data-icon-show` / `data-icon-hide`. Change it
 * here and it has to change in `LoginForm.tsx` too.
 *
 * ─── ACCESSIBILITY ─────────────────────────────────────────────────────────
 *
 * It is a `<button type="button">` — without `type`, a button inside a form
 * SUBMITS — with `aria-pressed` for the state and an `aria-label` that changes
 * with it. `aria-controls` says what it affects. The field keeps its `pr-12` so
 * long text doesn't run underneath the eye.
 */
interface Props {
  id: string;
  name: string;
  label: Txt;
  /** `new-password` when setting one, `current-password` when signing in. */
  autocomplete: "new-password" | "current-password";
  minlength?: number;
  autofocus?: boolean;
  required?: boolean;
}

const {
  id,
  name,
  label,
  autocomplete,
  minlength,
  autofocus = false,
  required = true,
} = Astro.props;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const c = studentCopy.password;
---

<div>
  <label for={id} class="block text-sm font-semibold text-ink">
    <T v={label} />
  </label>

  <div class="relative mt-2">
    {/* The padlock marks the field without anybody having to read the label,
        exactly as in `LoginForm`. The project's two password forms have to look
        like the same form. */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-ink-subtle"
    >
      <Icono nombre="candado" class="size-5" grosor={1.8} />
    </span>

    {/* `pr-12` reserves the eye's slot: without it, a long password runs under
        the button and can't be read exactly when it was tapped to be read.
        `pl-11` is the padlock's slot. */}
    <input
      id={id}
      name={name}
      type="password"
      required={required}
      minlength={minlength}
      autocomplete={autocomplete}
      autofocus={autofocus}
      class="min-h-12 w-full rounded-xl border border-line-strong bg-surface py-3 pr-12 pl-11 text-base text-ink placeholder:text-ink-subtle transition-colors focus:border-secondary-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    />

    <button
      type="button"
      data-toggle-password
      aria-controls={id}
      aria-pressed="false"
      aria-label={c.show[lang]}
      data-aria-es={c.show.es}
      data-aria-en={c.show.en}
      data-label-show-es={c.show.es}
      data-label-show-en={c.show.en}
      data-label-hide-es={c.hide.es}
      data-label-hide-en={c.hide.en}
      class="absolute inset-y-0 right-0 grid w-12 place-items-center rounded-r-xl text-ink-subtle transition-colors hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus"
    >
      <Icono nombre="ojo" class="size-5" grosor={1.8} data-icon-show />
      <Icono
        nombre="ojoTachado"
        class="hidden size-5"
        grosor={1.8}
        data-icon-hide
      />
    </button>
  </div>
</div>
