---
import T from "@components/i18n/T.astro";
import type { MonthRow } from "@lib/ambassadorStats";
import type { Txt } from "@i18n/idioma";
import { money, monthLong, monthShort, moneyAxis } from "@lib/ambassadorFormat";
import { ambassadorCopy } from "@config/ambassadorArea";

/**
 * La gráfica larga del Embajador: una barra por mes desde que abrió su cuenta
 * (lo ganado ese mes) y encima la línea de lo acumulado, con su propia escala
 * a la derecha. SVG pintado en el servidor: sin librerías y sin JavaScript.
 *
 * ⚠️ SIN DATOS NO SE INVENTA ESCALA: con todo en cero queda la línea de base.
 */
interface Props {
  months: MonthRow[];
  aria: Txt;
}

const { months, aria } = Astro.props;
const c = ambassadorCopy.stats;

const W = 640;
const H = 200;
const TOP = 14;
const LEFT = 44;
const RIGHT = 44;
const BOTTOM = 26;
const plotW = W - LEFT - RIGHT;
const plotH = H - TOP - BOTTOM;

const maxBar = Math.max(0, ...months.map((m) => m.earnedCents));
const maxCum = Math.max(0, ...months.map((m) => m.cumulativeCents));
const slot = plotW / Math.max(1, months.length);
const bar = Math.min(34, slot * 0.58);

/* Tres líneas de guía con cifras redondas. */
const nice = (v: number) => {
  if (v <= 0) return 0;
  const p = 10 ** Math.floor(Math.log10(v));
  const n = v / p;
  const step = [1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].find((x) => n <= x) ?? 10;
  return step * p;
};
const topBar = nice(maxBar);
const topCum = nice(maxCum);
const y = (v: number, top: number) => TOP + plotH - (top > 0 ? (v / top) * plotH : 0);
const grid = [0, 0.5, 1];

const points = months.map((m, i) => `${LEFT + slot * i + slot / 2},${y(m.cumulativeCents, topCum)}`).join(" ");
const area = months.length
  ? `M${LEFT + slot / 2},${TOP + plotH} L${points.replaceAll(" ", " L")} L${LEFT + slot * (months.length - 1) + slot / 2},${TOP + plotH} Z`
  : "";
const labelEvery = months.length > 12 ? 3 : months.length > 7 ? 2 : 1;
---

<figure class="m-0">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-muted">
    <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-primary-300"></span><T v={c.legendEarned} /></span>
    <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-secondary-500"></span><T v={c.legendCurrent} /></span>
    <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-primary-900"></span><T v={c.legendCumulative} /></span>
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 h-auto w-full" role="img">
    <title data-t="es">{aria.es}</title>
    <title data-t="en">{aria.en}</title>
    <defs>
      <linearGradient id="cum-area" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--color-primary-900)" stop-opacity="0.12" />
        <stop offset="1" stop-color="var(--color-primary-900)" stop-opacity="0" />
      </linearGradient>
    </defs>

    {grid.map((g) => (
      <g>
        <line x1={LEFT} x2={W - RIGHT} y1={TOP + plotH - g * plotH} y2={TOP + plotH - g * plotH} class="stroke-line" stroke-width="1" stroke-dasharray={g === 0 ? undefined : "3 4"} />
        {topBar > 0 && (
          <text x={LEFT - 8} y={TOP + plotH - g * plotH + 3} text-anchor="end" class="fill-ink-subtle text-[10px] tabular-nums">{moneyAxis(topBar * g)}</text>
        )}
        {topCum > 0 && g > 0 && (
          <text x={W - RIGHT + 8} y={TOP + plotH - g * plotH + 3} text-anchor="start" class="fill-primary-700 text-[10px] tabular-nums">{moneyAxis(topCum * g)}</text>
        )}
      </g>
    ))}

    {months.map((m, i) => {
      const h = topBar > 0 ? (m.earnedCents / topBar) * plotH : 0;
      const x = LEFT + slot * i + (slot - bar) / 2;
      const last = i === months.length - 1;
      return (
        <g class="mes">
          <title data-t="es">{`${monthLong(m.monthStart).es}: ${money(m.earnedCents).es}`}</title>
          <title data-t="en">{`${monthLong(m.monthStart).en}: ${money(m.earnedCents).en}`}</title>
          <rect x={LEFT + slot * i} y={TOP} width={slot} height={plotH} fill="transparent" />
          <rect
            x={x}
            y={TOP + plotH - Math.max(h, m.earnedCents > 0 ? 3 : 0)}
            width={bar}
            height={Math.max(h, m.earnedCents > 0 ? 3 : 0)}
            rx="5"
            class:list={["barra", last ? "fill-secondary-500" : "fill-primary-300"]}
            style={`--i:${i}`}
          />
          {(i % labelEvery === 0 || last) && (
            <>
              <text data-t="es" x={LEFT + slot * i + slot / 2} y={H - 8} text-anchor="middle" class="fill-ink-subtle text-[10px]">{monthShort(m.monthStart).es}</text>
              <text data-t="en" x={LEFT + slot * i + slot / 2} y={H - 8} text-anchor="middle" class="fill-ink-subtle text-[10px]">{monthShort(m.monthStart).en}</text>
            </>
          )}
        </g>
      );
    })}

    {maxCum > 0 && (
      <>
        <path d={area} fill="url(#cum-area)" />
        <polyline points={points} fill="none" class="linea stroke-primary-900" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
        {months.map((m, i) => (
          <circle cx={LEFT + slot * i + slot / 2} cy={y(m.cumulativeCents, topCum)} r={i === months.length - 1 ? 4 : 2.5} class="fill-surface stroke-primary-900" stroke-width="2" />
        ))}
      </>
    )}
  </svg>
</figure>

<style>
  .barra {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: crece 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 40ms + 120ms);
    transition: opacity 0.2s ease;
  }
  .mes:hover .barra {
    opacity: 0.8;
  }
  .linea {
    stroke-dasharray: 2000;
    animation: traza 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }
  @keyframes crece {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes traza {
    from {
      stroke-dashoffset: 2000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .barra,
    .linea {
      animation: none;
    }
  }
</style>
