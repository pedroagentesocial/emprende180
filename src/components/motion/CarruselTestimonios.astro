---
import TarjetaTestimonio from "@components/ui/TarjetaTestimonio.astro";
import Icono from "@components/ui/Icono.astro";
import { copy, type Testimonio } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * EL CARRUSEL DE TESTIMONIOS — una galería de tres, que avanza de uno en uno
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Tres tarjetas a la vista en escritorio (dos en tablet, una en el teléfono)
 * y cada paso mueve UNA: la de la izquierda sale, entra una nueva por la
 * derecha. Es lo que el cliente pidió el 16-09-2026 —"3 y 3 cards movidas
 * automáticamente o por arrows, que pase una por una, como galería"— y
 * sustituye a la versión anterior de una sola tarjeta grande con fundido.
 *
 * ─── CÓMO SE MUEVE ──────────────────────────────────────────────────────────
 *
 * Una pista (`data-pista`) con todas las tarjetas en fila, cada una con el
 * ancho de su fracción (100 %, 50 % o 33,3 %), y la pista se desplaza con
 * `translateX(-índice × fracción)`. La transición la hace el CSS; el guion
 * solo cambia el índice. Nada se clona ni se reordena: en el último paso, el
 * siguiente vuelve al principio.
 *
 * El índice va de 0 a (total − visibles), y los puntos son tantos como
 * posiciones posibles, no como tarjetas: con seis testimonios y tres a la
 * vista hay cuatro posiciones, y cuatro puntos. Cuántas tarjetas caben lo
 * decide `matchMedia` en el navegador, con los mismos cortes que las clases
 * de ancho (`sm`, `lg`).
 *
 * ─── LO QUE SE CONSERVA DE LA VERSIÓN ANTERIOR ──────────────────────────────
 *
 * Avance automático cada 7 s; se retiene con el cursor o el foco dentro y se
 * reanuda al salir; botón de pausa (WCAG 2.2.2: contenido que se mueve más de
 * cinco segundos tiene que poder pararse); flechas del teclado; se para con la
 * pestaña escondida y con `prefers-reduced-motion`; rótulos que cambian con el
 * idioma (`e180:idioma`); posición anunciada solo al mover a mano.
 *
 * ⚠️ LAS TARJETAS FUERA DE LA VISTA VAN `aria-hidden` E `inert`: un lector de
 * pantalla no tiene por qué recorrer seis citas cuando ve tres, y el teclado
 * no debe poder enfocar un enlace que está fuera del marco.
 */

interface Props {
  items: Testimonio[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
const { banda } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const irA = (i: number) =>
  construirTxt((l) => interpolar(banda.irA[l], { n: i + 1 }));
const posicion = (i: number) =>
  construirTxt((l) => interpolar(banda.posicion[l], { n: i + 1, total: items.length }));
---

<section
  data-carrusel-testimonios
  aria-roledescription="carousel"
  aria-label={banda.etiqueta[lang]}
  data-aria-es={banda.etiqueta.es}
  data-aria-en={banda.etiqueta.en}
  class:list={["relative", className]}
>
  {/* El marco recorta; la pista se desplaza dentro. El aire entre tarjetas
      lo pone el relleno de cada celda y no un `gap`, para que la fracción de
      ancho sea exacta y el desplazamiento caiga siempre en el borde. */}
  <div class="overflow-hidden">
    <ul
      role="list"
      data-pista
      class="flex transition-transform duration-[650ms] ease-out-expo motion-reduce:transition-none"
    >
      {
        items.map((t, i) => (
          <li
            data-tarjeta={i}
            role="group"
            aria-roledescription="slide"
            aria-label={posicion(i)[lang]}
            data-aria-es={posicion(i).es}
            data-aria-en={posicion(i).en}
            class="w-full flex-none px-2 sm:w-1/2 sm:px-3 lg:w-1/3"
          >
            <TarjetaTestimonio testimonio={t} />
          </li>
        ))
      }
    </ul>
  </div>

  {/* Flecha, puntos, pausa, flecha. Centrados bajo las tarjetas y a 44 px cada
      uno. El rótulo de posición está solo para el lector de pantalla. */}
  {/* En el teléfono los puntos bajan a una segunda fila (`order-last` y
      `basis-full`): seis puntos de 44 px más las flechas y la pausa no caben
      en 320 px en una sola línea, y desbordaban la página. */}
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
    <button
      type="button"
      data-carrusel-antes
      aria-label={banda.anterior[lang]}
      data-aria-es={banda.anterior.es}
      data-aria-en={banda.anterior.en}
      class="grid size-11 place-items-center rounded-full border-[0.5px] border-line text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    >
      <Icono nombre="chevron" class="size-5 rotate-90" grosor={2} />
    </button>

    {/* Los puntos se pintan todos y el guion esconde los que sobran según
        cuántas tarjetas caben: con tres a la vista hay N − 2 posiciones. */}
    <ul role="list" data-puntos class="flex items-center justify-center gap-1 max-sm:order-last max-sm:basis-full">
      {
        items.map((_, i) => (
          <li>
            <button
              type="button"
              data-carrusel-punto={i}
              data-activo={i === 0 ? "true" : "false"}
              aria-label={irA(i)[lang]}
              data-aria-es={irA(i).es}
              data-aria-en={irA(i).en}
              class="group grid size-11 place-items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            >
              <span
                aria-hidden="true"
                class="block h-1.5 w-1.5 rounded-full bg-ink/20 transition-[background-color,width] duration-300 ease-out-soft group-data-[activo=true]:w-6 group-data-[activo=true]:bg-ink-brand"
              />
            </button>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-carrusel-pausa
      aria-pressed="false"
      aria-label={banda.pausar[lang]}
      data-aria-es={banda.pausar.es}
      data-aria-en={banda.pausar.en}
      data-etiqueta-pausar-es={banda.pausar.es}
      data-etiqueta-pausar-en={banda.pausar.en}
      data-etiqueta-reanudar-es={banda.reanudar.es}
      data-etiqueta-reanudar-en={banda.reanudar.en}
      class="grid size-11 place-items-center rounded-full border-[0.5px] border-line text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    >
      <Icono nombre="pausa" class="size-4" grosor={2} data-icono-pausa />
      <Icono nombre="play" class="hidden size-4" grosor={1} data-icono-play />
    </button>

    <button
      type="button"
      data-carrusel-despues
      aria-label={banda.siguiente[lang]}
      data-aria-es={banda.siguiente.es}
      data-aria-en={banda.siguiente.en}
      class="grid size-11 place-items-center rounded-full border-[0.5px] border-line text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    >
      <Icono nombre="chevron" class="size-5 -rotate-90" grosor={2} />
    </button>
  </div>

  <p data-carrusel-posicion class="sr-only" aria-live="polite">
    {posicion(0)[lang]}
  </p>
</section>

<script>
  function montarCarruseles() {
    document
      .querySelectorAll<HTMLElement>("[data-carrusel-testimonios]")
      .forEach((raiz) => {
        if (raiz.dataset.montado) return;
        raiz.dataset.montado = "1";

        const pista = raiz.querySelector<HTMLElement>("[data-pista]");
        const tarjetas = [...raiz.querySelectorAll<HTMLElement>("[data-tarjeta]")];
        const puntos = [...raiz.querySelectorAll<HTMLElement>("[data-carrusel-punto]")];
        const antes = raiz.querySelector<HTMLButtonElement>("[data-carrusel-antes]");
        const despues = raiz.querySelector<HTMLButtonElement>("[data-carrusel-despues]");
        const pausa = raiz.querySelector<HTMLButtonElement>("[data-carrusel-pausa]");
        const posicion = raiz.querySelector<HTMLElement>("[data-carrusel-posicion]");
        if (!pista || tarjetas.length < 2) return;

        const SEGUNDOS = 7;
        const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
        /* Los mismos cortes que las clases de ancho de las tarjetas. */
        const mqSm = window.matchMedia("(min-width: 40rem)");
        const mqLg = window.matchMedia("(min-width: 64rem)");
        const visibles = () => (mqLg.matches ? 3 : mqSm.matches ? 2 : 1);
        const posiciones = () => Math.max(1, tarjetas.length - visibles() + 1);

        let actual = 0;
        let temporizador: number | undefined;
        /* Parado por el botón (o por la preferencia del sistema). */
        let pausado = menosMovimiento.matches;
        /* Parado porque el cursor o el foco están encima: se reanuda solo. */
        let retenido = false;

        const idioma = () => (document.documentElement.lang.startsWith("en") ? "en" : "es");
        const clave = (base: string) => base + (idioma() === "en" ? "En" : "Es");

        const pintar = (i: number, anunciar: boolean) => {
          const n = posiciones();
          actual = ((i % n) + n) % n;
          const v = visibles();
          pista.style.transform = `translateX(-${(actual * 100) / v}%)`;
          tarjetas.forEach((el, k) => {
            const aLaVista = k >= actual && k < actual + v;
            if (aLaVista) {
              el.removeAttribute("aria-hidden");
              el.removeAttribute("inert");
            } else {
              el.setAttribute("aria-hidden", "true");
              el.setAttribute("inert", "");
            }
          });
          puntos.forEach((p, k) => {
            p.dataset.activo = String(k === actual);
            /* Solo hay tantos puntos como posiciones. */
            p.parentElement!.hidden = k >= n;
          });
          if (anunciar && posicion) {
            const texto = tarjetas[actual].dataset[clave("aria")];
            if (texto) posicion.textContent = texto;
          }
        };

        const arrancar = () => {
          clearInterval(temporizador);
          if (pausado || retenido) return;
          temporizador = window.setInterval(() => pintar(actual + 1, false), SEGUNDOS * 1000);
        };

        const pintarPausa = () => {
          if (!pausa) return;
          const etiqueta = pausa.dataset[clave(pausado ? "etiquetaReanudar" : "etiquetaPausar")];
          if (etiqueta) pausa.setAttribute("aria-label", etiqueta);
          pausa.setAttribute("aria-pressed", String(pausado));
          pausa.querySelector("[data-icono-pausa]")?.classList.toggle("hidden", pausado);
          pausa.querySelector("[data-icono-play]")?.classList.toggle("hidden", !pausado);
        };

        const aMano = (i: number) => {
          pintar(i, true);
          arrancar();
        };

        antes?.addEventListener("click", () => aMano(actual - 1));
        despues?.addEventListener("click", () => aMano(actual + 1));
        puntos.forEach((p, i) => p.addEventListener("click", () => aMano(i)));
        pausa?.addEventListener("click", () => {
          pausado = !pausado;
          pintarPausa();
          arrancar();
        });

        raiz.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            e.preventDefault();
            aMano(actual - 1);
          }
          if (e.key === "ArrowRight") {
            e.preventDefault();
            aMano(actual + 1);
          }
        });

        const retener = () => {
          retenido = true;
          arrancar();
        };
        const soltar = () => {
          retenido = false;
          arrancar();
        };
        raiz.addEventListener("pointerenter", retener);
        raiz.addEventListener("pointerleave", soltar);
        raiz.addEventListener("focusin", retener);
        raiz.addEventListener("focusout", (e) => {
          if (!raiz.contains(e.relatedTarget as Node | null)) soltar();
        });

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) clearInterval(temporizador);
          else arrancar();
        });

        /* Si cambia cuántas caben, se recoloca sin animar el salto. */
        const recolocar = () => pintar(actual, false);
        mqSm.addEventListener("change", recolocar);
        mqLg.addEventListener("change", recolocar);

        menosMovimiento.addEventListener("change", (e) => {
          if (e.matches) pausado = true;
          pintarPausa();
          arrancar();
        });

        window.addEventListener("e180:idioma", () => {
          pintarPausa();
          if (posicion) {
            const texto = tarjetas[actual].dataset[clave("aria")];
            if (texto) posicion.textContent = texto;
          }
        });

        pintar(0, false);
        pintarPausa();
        arrancar();
      });
  }

  montarCarruseles();
  document.addEventListener("astro:page-load", montarCarruseles);
</script>
