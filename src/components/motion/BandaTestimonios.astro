---
import TarjetaTestimonio from "@components/ui/TarjetaTestimonio.astro";
import Icono from "@components/ui/Icono.astro";
import { copy } from "@config/curso.config";
import type { Testimonio } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * BANDA DE TESTIMONIOS — cruza la pantalla sin parar
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Sustituye al carrusel de flechas. Un carrusel espera que alguien decida
 * pulsar; una banda enseña sola. En una página que se recorre bajando, la
 * segunda gana: el visitante ve pasar cinco testimonios sin hacer nada.
 *
 * ─── SIN JAVASCRIPT PARA MOVERSE ───────────────────────────────────────────
 *
 * El movimiento es una animación CSS, no una isla de React. Eso importa más de
 * lo que parece para algo que "nunca para": una animación CSS la lleva el
 * compositor, sigue fluida aunque el hilo principal esté ocupado y no cuesta ni
 * un kilobyte de hidratación. El carrusel anterior era una isla entera.
 *
 * El único JavaScript es el botón de pausa, y son diez líneas.
 *
 * ─── LA COPIA DUPLICADA NO ES UN ERROR ─────────────────────────────────────
 *
 * La lista se pinta DOS veces y la pista se desplaza un -50 % exacto. Así el
 * fotograma en el que la animación reinicia es idéntico al de salida y no se ve
 * la costura. La segunda copia va `aria-hidden`: para un lector de pantalla los
 * testimonios son los que son, no el doble.
 *
 * ⚠️ Las dos copias tienen que ser EXACTAMENTE iguales. Si alguien añade una
 * tarjeta a una y no a la otra, aparece un tirón en cada vuelta.
 *
 * ─── LOS DOS BORDES SE DESVANECEN ──────────────────────────────────────────
 *
 * Sin la máscara, la primera y la última tarjeta salen CORTADAS a cuchillo
 * contra el borde de la columna, y una tarjeta partida por la mitad se lee como
 * un fallo de maquetación, no como algo que está pasando de largo. Con el
 * degradado entran y salen, que es lo que hace que la banda parezca no tener
 * principio ni final.
 *
 * ─── LA TARJETA DE CABECERA ENTRA POR EL `slot` ────────────────────────────
 *
 * Lo que se le pase dentro se pinta como PRIMERA COLUMNA, quieta, con las
 * reseñas pasando a su derecha. La sección lo usa para su tarjeta azul: el
 * titular deja de ser una cabecera centrada y pasa a ser una tarjeta más de la
 * fila, del mismo tamaño que las otras.
 *
 * Y la coloca la banda, no la sección, por un motivo concreto: el mando de
 * parada TIENE que vivir dentro de `[data-banda]` —ahí lo busca `montarBandas`
 * y ahí lo alcanzan los selectores de pausa del CSS— pero no puede robarle
 * altura a la fila. Debajo de la pista, la celda medía las tarjetas MÁS el
 * botón, y la tarjeta azul, que se estira a la fila, salía 64 px más alta que
 * las blancas. Con dos filas el mando cae en la segunda, bajo la tarjeta azul,
 * y la primera mide exactamente lo que miden las reseñas.
 *
 * ─── SE PUEDE PARAR, Y ES OBLIGATORIO ──────────────────────────────────────
 *
 * WCAG 2.2.2 (nivel A) exige que todo lo que se mueve solo más de cinco
 * segundos se pueda parar. Aquí hay tres formas: el botón, pasar el cursor o
 * tabular dentro, y `prefers-reduced-motion`, que la apaga entera y convierte
 * la pista en una fila que se arrastra con el dedo.
 *
 * El botón es el que de verdad hace que esto cumpla, porque es el único que
 * funciona en un celular: ahí no hay cursor que pasar. La banda sigue sin
 * pararse nunca por su cuenta; lo que hay es un mando para quien lo necesite.
 *
 * ─── QUÉ NO PUEDE ENTRAR AQUÍ ──────────────────────────────────────────────
 *
 * Ninguna cifra de dinero. Un testimonio que dice cuánto ganó alguien es una
 * declaración de ingresos: la FTC exige poder documentar que es representativa
 * de lo que consigue un participante normal, y en un programa de referidos es
 * por donde más fácil se cae. Ver la cabecera de `testimonios.muestra.ts`.
 */
interface Props {
  items: Testimonio[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * Velocidad constante, no duración constante.
 *
 * Nueve segundos por tarjeta: lo bastante lento para leer una cita al vuelo y
 * lo bastante vivo para que no parezca colgado. Con una duración fija, seis
 * testimonios irían despacio y veinte a toda velocidad.
 */
const duracion = `${items.length * 9}s`;

/**
 * ⚠️ ¿HAY TARJETA DE CABECERA O NO?
 *
 * La rejilla reservaba SIEMPRE una columna de 22rem para el `slot`, viniera
 * algo dentro o no. El día que la sección de testimonios se llevó su tarjeta
 * azul al bloque de arriba, esa columna se quedó vacía: 22rem más 2,5 de hueco
 * de blanco a la izquierda de la banda, y las reseñas empujadas fuera del
 * borde. Se veía como un error de maquetación, y lo era.
 *
 * Con `Astro.slots.has` la rejilla solo se parte en dos cuando hay algo que
 * poner en la primera columna. Sin cabecera, la banda ocupa el ancho entero y
 * las tarjetas se ven completas desde el primer píxel.
 */
const conCabecera = Astro.slots.has("default");
---

<div data-banda data-pausada="false" class:list={["relative", className]}>
  <div
    class:list={[
      "grid items-stretch gap-8",
      conCabecera && "lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-x-10",
    ]}
  >
    {/* La tarjeta de cabecera, si la hay. Ver la nota de arriba: en móvil se
        apila encima, que es el único orden posible en una sola columna.

        `py-1` igual que la pista: sin él la tarjeta de cabecera empieza cuatro
        píxeles más arriba que las reseñas y las dos filas no casan. */}
    {
      conCabecera && (
        <div class="py-1 lg:col-start-1 lg:row-start-1">
          <slot />
        </div>
      )
    }

    {/* `overflow-hidden` recorta la pista sin sacar la banda del ancho de la
        página: nada de `100vw`, que incluye la barra de scroll y provoca scroll
        horizontal en toda la web.

        `min-w-0` no es opcional en una celda de rejilla que contiene algo más
        ancho que ella: sin él, la celda crece hasta el ancho de la pista y se
        lleva la rejilla por delante. */}
    <div
      data-banda-viewport
      class:list={[
        "min-w-0 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_2rem,black_calc(100%-2rem),transparent)]",
        conCabecera && "lg:col-start-2 lg:row-start-1",
      ]}
    >
      <ul
        data-banda-pista
        class="flex w-max gap-5 py-1"
        style={`--duracion:${duracion}`}
        aria-label={copy.banda.etiqueta[lang]}
        data-aria-es={copy.banda.etiqueta.es}
        data-aria-en={copy.banda.etiqueta.en}
      >
        {
          [0, 1].map((copia) =>
            items.map((t) => (
              /* ⚠️ MÁS ANCHA QUE ANTES, y no es un retoque: la tarjeta pasó de
                 vertical a HORIZONTAL. Con 22rem la foto y la cita se
                 repartirían 350 px y no cabría ninguna de las dos. A 30rem la
                 columna de texto se queda en unas 18rem, que es donde una cita
                 de cuatro renglones se lee. */
              <li
                class="w-[20rem] shrink-0 sm:w-[30rem]"
                aria-hidden={copia === 1 ? "true" : undefined}
                data-banda-clon={copia === 1 ? "" : undefined}
              >
                {/* ⚠️ LA TARJETA ES LA CLARA Y EL FONDO EL BLANCO, al revés que en
                    el resto de la página. Es a propósito y viene del rediseño:
                    con la sección en azul suave y las tarjetas en blanco, la
                    banda parecía una fila de papeles pegados encima; al
                    invertirlo, lo que se mueve es el color y el fondo se queda
                    quieto. Sin borde por lo mismo: el contraste de superficie ya
                    dibuja el canto. */}
                {/* ⚠️ LA TARJETA YA NO SE DIBUJA AQUÍ. Vivía en este archivo
                    —un `<figure>` de noventa líneas con su avatar circular, sus
                    estrellas y su pie— y ahora es `TarjetaTestimonio`, que es
                    la misma que usa la rejilla. Una sola tarjeta y dos formas
                    de presentarla.

                    El motivo es que se estaban separando: la banda tenía la
                    tarjeta clara sobre fondo blanco y la rejilla al revés, con
                    otro radio y otro avatar. Dos dibujos distintos para el
                    mismo contenido es cómo se acaba con dos diseños en la
                    misma página. */}
                <TarjetaTestimonio testimonio={t} />
              </li>
            )),
          )
        }
      </ul>
    </div>

    {/* El mando de parada. Ver la nota de la cabecera: es lo que hace que esto
        cumpla WCAG 2.2.2, es el único que sirve en un celular, y está en la
        SEGUNDA fila para no sumarle altura a la primera. */}
    <div class="mt-1 flex lg:col-start-1 lg:row-start-2 lg:mt-5">
      <button
        type="button"
        data-banda-pausa
        aria-pressed="false"
        aria-label={copy.banda.pausar[lang]}
        data-aria-es={copy.banda.pausar.es}
        data-aria-en={copy.banda.pausar.en}
        data-etiqueta-pausar-es={copy.banda.pausar.es}
        data-etiqueta-pausar-en={copy.banda.pausar.en}
        data-etiqueta-reanudar-es={copy.banda.reanudar.es}
        data-etiqueta-reanudar-en={copy.banda.reanudar.en}
        class="inline-grid size-11 place-items-center rounded-full border border-line bg-surface text-ink-muted transition-colors duration-200 hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        <Icono nombre="pausa" class="size-4" grosor={2} data-icono-pausa />
        <Icono nombre="play" class="hidden size-4" grosor={1} data-icono-play />
      </button>
    </div>
  </div>
</div>

<script>
  /* El mando de parada vive en `@lib/banda`, compartido con las tiras de
     anuncios: es una sola implementación para las dos cosas que se mueven
     solas, y es lo que hace que la página cumpla la WCAG 2.2.2. */
  import { montarBandas } from "@lib/banda";

  montarBandas();
</script>
