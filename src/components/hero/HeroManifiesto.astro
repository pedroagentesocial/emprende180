---
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import type { NombreIcono } from "@components/ui/Icono.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import type { Idioma, Txt } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * HERO · EL MANIFIESTO — qué significa ser Embajador
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * La tercera plantilla del slider, y la única que no va de una persona sino de
 * una IDENTIDAD. Una foto a pantalla completa, el manifiesto encima y tres
 * palabras con su icono debajo.
 *
 * ─── POR QUÉ NO ES UNA LISTA DE TAREAS ─────────────────────────────────────
 *
 * Es la diferencia entera entre esta pantalla y las otras dos, y se pierde muy
 * fácil. Las tres palabras NO son lo que un Embajador hace: son lo que un
 * Embajador ES. Por eso cada una lleva una micro-frase y no un párrafo, y por
 * eso la micro-frase no explica un procedimiento.
 *
 * ⚠️ SI ALGUIEN CONVIERTE ESTO EN "PASO 1, PASO 2, PASO 3" se rompe el
 * mecanismo: el método ya se cuenta más abajo en la página, con su sección
 * entera. Aquí lo que se juega es si la persona se quiere llamar así.
 *
 * ─── LO QUE NO LLEVA ───────────────────────────────────────────────────────
 *
 * ⚠️ NO LLEVA BOTÓN, y es deliberado. Solo la primera imagen pide algo; las
 * otras dos cuentan y dejan seguir bajando. Tres botones en tres pantallas que
 * rotan solas son la misma decisión repetida cada seis segundos.
 *
 * ─── EL CONTRASTE ──────────────────────────────────────────────────────────
 *
 * Aquí hay MÁS texto que en los dípticos —un párrafo y a veces las claves— así
 * que el velo no puede ser un degradado lateral: es un apagado de abajo arriba
 * que cubre la mitad inferior, más un tinte general suave.
 *
 * ⚠️ DESDE EL 16-09-2026 EL APAGADO LO PINTA EL SLIDER, no este componente. El
 * cliente quiso la misma sombra en las cuatro pantallas y mucho más suave, así
 * que se centralizó en `HeroSlider` para todo vídeo de fondo. Este lo sigue
 * pintando SOLO cuando le toca pintar su foto (sin vídeo detrás), que es el
 * único caso que el slider no cubre.
 */

interface Clave {
  /** Nombre de icono de `Icono.astro`. Tabla cerrada: ver ese archivo. */
  icono: NombreIcono;
  palabra: Txt;
  /** UNA frase corta. Si necesita dos, es que sobra la mitad. */
  frase: Txt;
}

interface Props {
  /** Si no viene, el fondo lo pone otro (un vídeo) y aquí no se pinta nada. */
  foto?: string;
  alt?: Txt;
  /**
   * El manifiesto, en renglones. Los saltos los decide el config.
   *
   * Un trozo puede llevar UNO de dos realces, nunca los dos:
   *
   *   acento — Fraunces itálica en el teal claro. Es el remate de la frase, el
   *            mismo recurso que usa toda la web (`Enfasis.astro`).
   *   azul   — el azul claro de la marca, en la misma Montserrat del resto.
   *            Para enumerar, no para rematar: cambia el color y nada más.
   *
   * ⚠️ SON DISTINTOS A PROPÓSITO. Si los dos fueran cursiva teal, el renglón
   * se leería como una sola frase enfatizada en vez de como una enumeración
   * que desemboca en un remate.
   */
  manifiesto: readonly (readonly {
    es: string;
    en: string;
    acento?: boolean;
    azul?: boolean;
  }[])[];
  /** El párrafo debajo del titular. */
  cuerpo?: Txt;
  /** El rótulo encima de las claves. */
  clavesTitulo?: Txt;
  claves?: readonly Clave[];
  /**
   * Dónde se apoya el bloque de texto en pantalla grande.
   *
   *   centro    — centrado, como siempre. El valor por defecto.
   *   izquierda — pegado al margen izquierdo, con el texto alineado a la
   *               izquierda. Las cuatro pantallas del slider alternan de
   *               lado: 1 izquierda, 2 derecha, 3 izquierda, 4 derecha.
   *   derecha   — el espejo.
   *
   * ⚠️ SOLO DE `lg` PARA ARRIBA. En un teléfono no hay sitio para desplazar
   * nada: el bloque ocupa el ancho entero y se queda centrado.
   */
  bloque?: "centro" | "izquierda" | "derecha";
  lang: Idioma;
  /** La sombra de texto del slider. */
  sombra: string;
  prioritaria?: boolean;
}

const {
  foto,
  alt,
  manifiesto,
  cuerpo,
  clavesTitulo,
  claves = [],
  bloque = "centro",
  lang,
  sombra,
  prioritaria = false,
} = Astro.props;
---

<div class="relative isolate size-full overflow-hidden">
  {/* La foto solo se pinta si nadie ha puesto un fondo antes. Con vídeo
      detrás, el `<img>` y su tinte sobran: los pone `HeroVideo`. */}
  {foto && alt && (
    <Fragment>
      <img
        src={foto}
        alt={alt[lang]}
        data-alt-es={alt.es}
        data-alt-en={alt.en}
        loading={prioritaria ? "eager" : "lazy"}
        fetchpriority={prioritaria ? "high" : "auto"}
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover object-top"
      />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-primary-950/45" />

      {/* El apagado de abajo SOLO cuando la foto es de este componente. Con
          vídeo detrás lo pinta el slider, igual y más suave para las cuatro
          pantallas. Ver la nota de la cabecera. */}
      <div
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 -z-10 h-3/5 bg-gradient-to-t from-primary-950 via-primary-950/80 to-transparent"
      />
    </Fragment>
  )}

  {/* ⚠️ `pb-24`/`lg:pb-32` NO ES AIRE: ES EL HUECO DE LOS MANDOS DEL SLIDER,
      que van centrados a 32 px del borde de abajo y ocupan 44 de alto. Ver la
      nota de `HeroSlider`.

      ⚠️ Y EL `pt` DEL MÓVIL ES LA ALTURA DE LA BANDA DE VÍDEO, no el hueco de
      la barra. Por debajo de `lg` el vídeo ocupa una franja 16:9 arriba
      —56,25vw— y este bloque empieza después; la barra flota sobre la banda,
      que es lo mismo que hace en un escritorio.

      ⚠️ ESTE BLOQUE VA ABAJO, APOYADO SOBRE LOS MANDOS, Y ASÍ SE QUEDA. El
      16-09-2026 se subió arriba por un malentendido: el cliente decía que los
      textos del hero "estaban muy abajo", pero hablaba de las pantallas 1 y
      2, que tenían un fallo de `align-self` (ver `HeroDiptico`). Al ver
      este arriba lo devolvió: "donde estaban antes estaba bien". De `lg` para
      arriba, `pt-24` es el hueco de la barra. */}
  <div
    class:list={[
      "flex size-full flex-col items-center justify-end px-[var(--gutter-page)] pb-24 pt-[calc(56.25vw+1rem)] text-center sm:pb-28 lg:pt-24",
      bloque === "centro" && "lg:pb-32",
      /* ⚠️ `pb-24` ES LA ALTURA COMÚN DE LAS CUATRO PANTALLAS. El cliente
         pidió el 16-09-2026 que el texto de todas estuviera a la misma
         altura, y este es el número que comparten con los dos dípticos (ver
         `HeroDiptico`). Dejan 20 px de aire sobre los mandos, que ocupan de
         32 a 76 px desde abajo. */
      bloque === "izquierda" && "lg:items-start lg:text-left lg:pb-24",
      bloque === "derecha" && "lg:items-end lg:text-right lg:pb-24",
    ]}
  >
    {/* El manifiesto. `h2` porque el `h1` de la página lo pone el hero en sus
        otras imágenes; aquí no hay ninguna frase que conteste "de qué va la
        página", solo qué significa una palabra. */}
    {/* ⚠️ LA CAJA HA IDO DE 52rem A 80rem Y EL CUERPO DE 28 A 44 PX, y las
        dos cosas van juntas porque una sin la otra no sirve. El renglón más
        largo es "trabajo, dedicación, autonomía y responsabilidad.": 49
        caracteres que NO se pueden partir sin romper la frase en dos ideas.

        El tope sale de dividir: 49 caracteres x 0,54 de avance = 26,5, así que
        el cuerpo máximo es la caja ÷ 26,5. Con 832 px eran 31 px; con 1280 son
        48, y la `clamp` se queda en 44 para dejar margen a la traducción
        inglesa y a una fuente que cargue distinto.

        A 1024 la caja real no es 1280 sino el ancho de página (936), y ahí el
        tope baja a 35: por eso la `clamp` da 34 y no 44 en esa pantalla.

        ⚠️ EL MÍNIMO ES 16 PX Y NO SUBE CON EL RESTO, y ese punto decide el alto
        del héroe entero. Esta es la pantalla MÁS CARGADA de las cuatro —el
        manifiesto MÁS las tres claves— así que es la que fija el suelo, no la
        de los titulares.

        A 18 px el primer renglón —"Ser Embajador de Emprende180 significa", 38
        caracteres— pedía 369 px y en un 375 hay 333: se partía en dos. A 16
        pide 328 y entra entero, así que el manifiesto pasa de cuatro renglones
        a tres. Con eso y las reservas ajustadas, la pantalla baja de 570 px a
        496 y el héroe puede encoger. Ver la cuenta completa en `HeroSlider`.

        Lo que crece es de `sm` y de `lg` en adelante: el teléfono se queda en
        el mínimo a propósito. */}
    {/* ⚠️ DESDE EL 16-09-2026 ESTO ES UN TITULAR, NO UN MANIFIESTO. El texto
        pasó a ser dos renglones cortos ("Tu Familia Primero / Tu Negocio
        También"), así que lleva la misma escala `portada` que los titulares de
        las otras dos pantallas —57 px a 1440, hasta 80— y el mismo reparto:
        primer renglón de apoyo, segundo grande en Fraunces. La cuenta de los
        49 caracteres de arriba ya no aplica; se deja porque explica de dónde
        viene la `clamp` pequeña si algún día vuelve una frase larga. */}
    <h2
      class="max-w-[80rem] text-balance text-[clamp(1.75rem,0.5rem+3.6vw,5rem)] font-extrabold leading-[1.02] tracking-[-0.03em]"
      style={`color:#ffffff;${sombra}`}
    >
      {
        manifiesto.map((linea, l) => (
          <span class:list={["block", l === 0 && "text-[0.87em] font-semibold"]}>
            {linea.map((seg, s) => (
              <>
                {s > 0 ? " " : null}
                {/* `resaltar` pinta en ámbar los `[COMPLETAR: …]` que aún
                    tenga el manifiesto, para que el hueco cante en pantalla en
                    vez de colarse en producción disfrazado de texto normal.
                    Ver `lib/pendientes.ts`. */}
                {seg.acento ? (
                  <Enfasis v={seg} tono="inverso" />
                ) : seg.azul ? (
                  /* `primary-300` (#AAC2E0) y no el navy de marca: el navy es el
                     FONDO de esta pantalla, así que escribir encima con él
                     sería escribir en tinta invisible. Este es su versión
                     clara, y da 8:1 sobre el navy. */
                  <span class="text-primary-300">
                    <T v={seg} resaltar />
                  </span>
                ) : (
                  <T v={seg} resaltar />
                )}
              </>
            ))}
          </span>
        ))
      }
    </h2>

    {/* ─── LAS TRES PALABRAS ────────────────────────────────────────────────
        En fila desde `sm`, apiladas en el teléfono. Sin tarjetas, sin fondo y
        sin recuadro: son tres columnas de texto con un icono encima, que es lo
        que las mantiene del lado de la tipografía editorial y lejos de la
        rejilla de tarjetas que PRODUCT.md prohíbe por nombre.

        El filete de arriba las separa del manifiesto sin meter una caja.

        ⚠️ EN EL TELÉFONO EL ICONO SE PONE AL LADO, NO ENCIMA, y no es un
        capricho: apiladas en columna las tres claves miden 361 px y esta
        pantalla ya lleva el manifiesto encima. Medido a 375x667, con el icono
        arriba el texto se sale por la barra de navegación; con el icono al
        lado la lista baja a 185 px y cabe con holgura. Desde `sm` hay sitio de
        sobra y vuelven a ser tres columnas centradas. */}
    {/* La caja sigue a la del manifiesto: si las tres columnas fueran más
        estrechas que el párrafo de encima, el filete de separación dejaría de
        medir lo mismo que la frase y se vería como un recuadro a medio hacer.

        Los huecos y el aire de arriba suben con el cuerpo de letra, por la
        misma razón que en el díptico: tres columnas más grandes con el mismo
        aire entre ellas se leen más apretadas que antes, no más presentes. */}
    {cuerpo && (
      <p
        class="mt-4 max-w-2xl text-balance text-sm font-medium leading-relaxed text-secondary-100 sm:mt-6 sm:text-lg lg:max-w-4xl lg:text-2xl"
        style={sombra}
      >
        {/* Igual que los renglones del titular: si el párrafo trae un
            [COMPLETAR: …], se resalta en ámbar hasta que se rellene. */}
        <T v={cuerpo} resaltar />
      </p>
    )}

    {/* ─── LO QUE NOS DEFINE ────────────────────────────────────────────────
        El rótulo y, debajo, las CINCO claves: en fila desde `lg`, en tres
        columnas en tablet (la cuarta y la quinta pasan a segunda fila) y
        apiladas en el teléfono con el icono al lado. Eran tres; el cliente
        dictó cinco el 16-09-2026 y con cinco en fila el aire entre columnas
        baja de 14 a 8 para que quepan a 1280. */}
    {clavesTitulo && claves.length > 0 && (
      <p
        class="mt-6 text-xs font-bold tracking-[0.18em] text-secondary-300 uppercase sm:mt-10 sm:text-sm lg:mt-12"
        style={sombra}
      >
        <T v={clavesTitulo} />
      </p>
    )}
    {claves.length > 0 && (
      <ul
        role="list"
        class="mt-4 grid w-full max-w-[80rem] gap-3 border-t border-white/25 pt-5 sm:mt-5 sm:grid-cols-3 sm:gap-8 sm:pt-8 lg:grid-cols-5 lg:gap-8 lg:pt-10"
      >
        {
          claves.map((clave) => (
            <li class="flex items-start gap-3.5 text-left sm:flex-col sm:items-center sm:gap-2.5 sm:text-center lg:gap-4">
              {/* ⚠️ EL ICONO CRECE CON EL TEXTO, NO AL REVÉS. Un icono de 32 px
                  encima de una palabra de 16 y una frase de 18 deja de ser el
                  remate de la columna y pasa a ser un adorno pequeño arriba. A
                  40 vuelve a pesar lo que tenía que pesar.
  
                  El `grosor` NO sube con el tamaño: es un trazo en unidades del
                  `viewBox`, así que engorda solo al escalar. Si alguna vez se ve
                  demasiado grueso, el número a bajar es este. */}
              <Icono
                nombre={clave.icono}
                class="mt-0.5 size-6 shrink-0 text-ink-on-inverse-brand sm:mt-0 sm:size-8 lg:size-12"
                grosor={1.6}
              />
              {/* El envoltorio solo existe para que en el móvil la palabra y la
                  frase queden una debajo de otra A LA DERECHA del icono. Desde
                  `sm` no estorba: el `li` ya es columna. */}
              <div class="min-w-0">
              <p
                class="text-sm font-bold uppercase tracking-[0.18em] lg:text-lg"
                style={`color:#ffffff;${sombra}`}
              >
                <T v={clave.palabra} />
              </p>
              {/* `max-w` en `ch` y no en `rem`: lo que hay que proteger es que la
                  micro-frase no pase de dos renglones, y eso es cuestión de
                  caracteres, no de píxeles. */}
              {/* ⚠️ EN EL TELÉFONO LA MICRO-FRASE NO SE PINTA, y es lo último que
                  se recortó para que el héroe cupiera. Las tres frases apiladas
                  son 99 px de los 384 que la sección reserva para el texto, y son
                  la única pieza del héroe que se puede quitar sin que falte una
                  idea: la palabra —AUTONOMÍA, CARISMA, SOLIDARIDAD— ya la dice.
                  Desde `sm` vuelven enteras.
  
                  ⚠️ `hidden sm:block` Y NO `sm:hidden` AL REVÉS: el `block` hace
                  falta porque el `p` lo es por defecto y `hidden` lo apaga; sin
                  él, de `sm` para arriba no volvería.
  
                  La medida en `ch` sube a 30 de `lg` para arriba porque ahí la
                  columna ha crecido de 277 a 394 px: con 28 la frase larga de las
                  tres —54 caracteres— se partía en tres renglones en vez de dos. */}
              <p
                class="mt-1.5 hidden max-w-[34ch] text-pretty text-[0.8125rem] font-medium leading-snug text-secondary-100 sm:mt-2 sm:block sm:max-w-[28ch] sm:text-base lg:max-w-[30ch] lg:text-lg"
                style={sombra}
              >
                <T v={clave.frase} resaltar />
              </p>
              </div>
            </li>
          ))
        }
      </ul>
    )}
  </div>
</div>
