---
import T from "@components/i18n/T.astro";
import Button from "@components/ui/Button.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Icono from "@components/ui/Icono.astro";
import HeroDiptico from "@components/hero/HeroDiptico.astro";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor, construirTxt, type Txt } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * HERO · TRES IMÁGENES QUE ROTAN
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * La segunda dirección visual: la foto ocupa la pantalla entera y el texto va
 * encima, cargado a la derecha. Sustituye al hero de isla navy + vídeo.
 *
 * ─── LA PRIMERA NO ES UNA FOTO, ES UN DÍPTICO ──────────────────────────────
 *
 * Y por eso el archivo dice "imágenes" y ya no dice "fotos". La que abre son
 * DOS fotos partidas por la mitad, con un titular en cada lado —uno le habla a
 * ella y otro a él— el botón en la costura y la promesa debajo. Se pinta con
 * su propio componente, `HeroDiptico.astro`, y lo que eso obliga a hacer aquí
 * está anotado en `esDiptico`, más abajo.
 *
 * Las otras dos siguen siendo lo de siempre: una foto y el texto en su
 * esquina. Las dos plantillas conviven; el slider no sabe de cuál es cada una
 * hasta que lo pregunta.
 *
 * ─── LO QUE SE PIERDE, Y HAY QUE DECIDIR DÓNDE VUELVE ──────────────────────
 *
 * ⚠️ AQUÍ ESTABA EL VÍDEO DE PEDRO. Noventa segundos con su cara y su voz, que
 * es el activo más fuerte de la página, y en este diseño no cabe. El archivo y
 * su componente (`VideoVsl.astro`) siguen en el repo intactos: hay que darle
 * un sitio en otra sección, no dejarlo perdido.
 *
 * ─── SIN VELO SOBRE LA FOTO, POR PETICIÓN EXPRESA ──────────────────────────
 *
 * No hay degradado ni capa oscura encima de la imagen. Eso deja el contraste
 * del texto en manos de UNA cosa: que la foto sea oscura donde va el texto. Las
 * tres están elegidas por luminosidad medida (30, 32 y 49 sobre 100 en su mitad
 * derecha), no por gusto.
 *
 * Si alguien cambia una foto por otra más clara, el texto blanco deja de
 * leerse y no va a haber ningún aviso: hay que volver a medirlo.
 *
 * ─── LOS SALTOS DE LÍNEA NO LOS DECIDE EL NAVEGADOR ────────────────────────
 *
 * Cada titular viene del config como una LISTA DE LÍNEAS. A pantalla completa,
 * dejar que el navegador reparta deja una palabra sola en el último renglón, y
 * eso es justo lo que hace que un titular grande parezca mal hecho.
 *
 * ─── SE PUEDE PARAR, Y NO ES UN EXTRA ──────────────────────────────────────
 *
 * Tres imágenes rotando cada seis segundos son contenido en movimiento de más
 * de cinco: la WCAG 2.2.2 (nivel A) exige poder detenerlo. De ahí el botón de
 * pausa y los tres puntos, que además sirven para elegir imagen. Con
 * `prefers-reduced-motion` no rota: se queda en la primera y los puntos siguen
 * funcionando a mano.
 */

const { heroSlider } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * ─── LA SOMBRA QUE SALVA EL CONTRASTE ────────────────────────────────────
 *
 * Medido sobre las tres fotos: el contraste MEDIO del blanco contra el fondo
 * es de 10:1, 8:1 y 5,9:1, que está bien. El problema es el PEOR PÍXEL —1,9,
 * 1,1 y 1,2 a uno— o sea que en los puntos claros de la foto (una lámpara, una
 * pared blanca) hay letras que caen sobre casi-blanco y ahí no se leen.
 *
 * La solución de manual es un velo oscuro sobre la foto, y está descartada por
 * petición expresa: la foto se ve limpia. Así que el contraste lo sostiene una
 * SOMBRA DEL TEXTO, que oscurece solo lo que hay justo detrás de cada letra y
 * deja el resto de la imagen intacto.
 *
 * Son dos: una corta y opaca que define el borde de la letra, y una amplia y
 * suave que apaga el fondo alrededor. El color no es negro, es el navy de la
 * marca, para que no aparezca un gris sucio sobre las fotos cálidas.
 *
 * ⚠️ NO ES UN SUSTITUTO EXACTO DE UN VELO. Ayuda mucho y es lo correcto
 * mientras las fotos sean estas; con una foto muy clara de lado a lado
 * seguiría sin bastar. Ver la nota de las fotos en el config.
 */
const SOMBRA_TEXTO =
  "text-shadow:0 1px 2px rgba(2,17,36,.55), 0 6px 28px rgba(2,17,36,.45)";

/**
 * ─── DÓNDE CAE EL BLOQUE DE TEXTO EN CADA FOTO ─────────────────────────────
 *
 * Tres pantallas con el texto en el mismo sitio se leen como UNA sola imagen a
 * la que le van cambiando las palabras: la rotación pasa desapercibida salvo
 * que la estés mirando fijo. Moviendo el bloque, el cambio se nota de reojo, que
 * es cuando de verdad se mira un hero.
 *
 * ⚠️ LA TABLA ES CERRADA Y LAS CLASES ESTÁN ESCRITAS ENTERAS. Tailwind lee el
 * código como TEXTO para decidir qué CSS genera: una clase montada al vuelo
 * —`items-${donde}`— no existe para él y no se genera nunca. Falla en
 * silencio, que es la peor forma de fallar. Si hace falta una posición nueva,
 * se añade aquí escrita completa.
 *
 * El `pt` deja pasar la barra de arriba y el `pb` deja sitio a los mandos de
 * abajo. Sin ellos, el titular de la posición alta se mete debajo del logo y el
 * de la baja se sienta encima de los puntos.
 */
const POSICIONES = {
  "derecha-arriba": "items-start justify-end pt-32 sm:pt-36",
  "derecha-centro": "items-center justify-end py-28",
  "derecha-abajo": "items-end justify-end pb-28 sm:pb-32",
  "izquierda-arriba": "items-start justify-start pt-32 sm:pt-36",
  "izquierda-centro": "items-center justify-start py-28",
  "izquierda-abajo": "items-end justify-start pb-28 sm:pb-32",
} as const;

/**
 * ─── EL VELO, Y POR QUÉ VUELVE ─────────────────────────────────────────────
 *
 * Este hero se hizo SIN velo por petición expresa: la foto limpia. El problema
 * es medible y estaba anotado ahí arriba: el peor píxel de las tres fotos deja
 * el blanco a 1,9:1, 1,1:1 y 1,2:1 de contraste. O sea que hay letras sobre
 * casi-blanco, y ahí no se lee nada por mucha sombra de texto que se le ponga.
 *
 * Lo que vuelve NO es el velo que se quitó. Aquel oscurecía la foto entera y la
 * dejaba turbia. Este es un degradado que arranca en el lado donde cae el texto
 * y se apaga del todo a media foto: la mitad que se mira sigue limpia, y la que
 * está debajo de las letras deja de competir con ellas.
 *
 * Por eso la dirección depende de la posición del texto y no es fija.
 */
const VELOS = {
  derecha: "bg-gradient-to-l from-primary-950/80 via-primary-950/35 to-transparent",
  izquierda: "bg-gradient-to-r from-primary-950/80 via-primary-950/35 to-transparent",
} as const;

type Posicion = keyof typeof POSICIONES;

/* Si un slide se queda sin `posicion`, cae en la de siempre en vez de romper. */
const posicionDe = (v: string | undefined): Posicion =>
  v && v in POSICIONES ? (v as Posicion) : "derecha-centro";

/**
 * ─── EL DÍPTICO ES OTRA COSA, Y POR ESO SE PREGUNTA ────────────────────────
 *
 * Las imágenes normales son UNA foto con el texto en una esquina. La primera
 * es un díptico: dos fotos partidas por la mitad, un texto en cada lado y el
 * botón en la costura. No cabe en la plantilla de las otras dos —no tiene
 * `posicion`, ni `kicker`, ni una foto sola— así que se pinta con su propio
 * componente. Ver `HeroDiptico.astro`.
 *
 * ⚠️ EL DÍPTICO SE PINTA ENTERO DENTRO DE LA CAPA DE FONDO, texto incluido, y
 * NO usa la capa de texto que usan las otras dos. El motivo es que su rejilla
 * decide a la vez dónde va cada foto y dónde va cada frase: repartirla entre
 * dos capas absolutas obligaría a mantener la misma rejilla escrita dos veces
 * y a que las dos coincidieran al píxel para siempre.
 *
 * Lo que eso obliga a hacer, y por qué está más abajo:
 *
 *   · La capa de fondo lleva `pointer-events-none` salvo la activa. Antes daba
 *     igual —eran imágenes— pero ahora tiene un botón dentro, y una capa
 *     invisible a `opacity-0` sigue tapando clics.
 *   · La capa de texto se sigue pintando VACÍA para el díptico. Es fea y es a
 *     propósito: el script empareja fondos, textos y puntos POR POSICIÓN en el
 *     array, así que saltarse un hueco desplazaría todos los siguientes.
 */
interface PanelDiptico {
  lado: string;
  foto: string;
  encuadre?: string;
  alt: Txt;
  voz: "editorial" | "directa";
  titulo: readonly { es: string; en: string; estilo?: "lead" | "acento" }[];
}

interface SlideDiptico {
  paneles: readonly PanelDiptico[];
  subtitulo: Txt;
  cta: { texto: Txt; href: string };
}

/* Se reconoce por `paneles`, que es lo único que ninguna imagen normal tiene.
   Preguntar por `tipo === "diptico"` obligaría a que las otras dos declararan
   un `tipo` que no usa nadie. */
const esDiptico = (slide: unknown): slide is SlideDiptico =>
  typeof slide === "object" && slide !== null && "paneles" in slide;

/** Una imagen de las normales: una foto y el texto en una esquina. */
interface SlideFoto {
  foto: string;
  alt: Txt;
  posicion?: string;
  kicker: Txt;
  titulo: readonly { es: string; en: string; enfasis?: boolean }[];
  subtitulo: Txt;
}

/**
 * ⚠️ ESTE CAST NO SE PUEDE QUITAR, y merece la línea. `esDiptico` sí estrecha
 * en la rama verdadera, pero en la FALSA TypeScript no descarta el díptico:
 * para hacerlo tendría que ver el objeto del config como asignable al tipo del
 * guard, y con `as const` viene con todo readonly y con los textos como tipos
 * literales, así que no encaja del todo y se queda en la unión.
 *
 * O sea que dentro del `else` seguiría creyendo que `slide` puede no tener
 * `foto`. Se afirma aquí, una vez, en lugar de repetir un cast en cada
 * atributo —que es lo que ya hacía la lectura de `posicion`.
 */
const comoFoto = (slide: unknown) => slide as SlideFoto;

/** "Ver la imagen 2", ya resuelto en los dos idiomas. */
const etiquetaPunto = (i: number) =>
  construirTxt((l) => interpolar(heroSlider.irASlide[l], { n: i + 1 }));
---

<section
  id="inicio"
  data-hero-slider
  class="relative isolate min-h-svh overflow-hidden bg-primary-950"
  aria-roledescription="carousel"
  aria-label={heroSlider.aria[lang]}
  data-aria-es={heroSlider.aria.es}
  data-aria-en={heroSlider.aria.en}
>
  {
    heroSlider.slides.map((slide, i) => (
      <div
        data-slide={i}
        data-activo={i === 0 ? "true" : "false"}
        class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-[1200ms] ease-out-soft data-[activo=true]:pointer-events-auto data-[activo=true]:opacity-100"
        aria-hidden={i === 0 ? undefined : "true"}
      >
        {/* ⚠️ `pointer-events-none` HASTA QUE LA IMAGEN ES LA ACTIVA. Mientras
            estas capas solo tenían un `<img>` dentro daba igual; desde que el
            díptico mete su botón aquí, no: una capa a `opacity-0` sigue
            ocupando la pantalla entera y se come los clics de la que sí se ve.

            El díptico se pinta ENTERO aquí dentro, texto y botón incluidos, y
            deja vacío su hueco en la capa de texto de más abajo. Ver la nota
            de `esDiptico`. */}
        {esDiptico(slide) ? (
          <HeroDiptico
            paneles={slide.paneles}
            subtitulo={slide.subtitulo}
            cta={slide.cta}
            lang={lang}
            sombra={SOMBRA_TEXTO}
            prioritaria={i === 0}
            trackId={`hero-${i + 1}`}
          />
        ) : (
          <Fragment>
            {/* `fetchpriority="high"` y `loading="eager"` SOLO en la primera:
                es la imagen más grande de la página y la que decide el LCP.
                Las otras dos no se ven hasta el segundo seis, así que
                esperan. */}
            <img
              src={comoFoto(slide).foto}
              alt={comoFoto(slide).alt[lang]}
              data-alt-es={comoFoto(slide).alt.es}
              data-alt-en={comoFoto(slide).alt.en}
              width={1600}
              height={900}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding="async"
              class="size-full object-cover"
            />

            {/* El velo va DENTRO de la foto y no encima de todo: así se
                desvanece con ella en el cruce en vez de quedarse fijo mientras
                la imagen de debajo cambia, que se vería como un parpadeo. */}
            <div
              aria-hidden="true"
              class:list={[
                "absolute inset-0",
                VELOS[
                  posicionDe(comoFoto(slide).posicion).startsWith("derecha")
                    ? "derecha"
                    : "izquierda"
                ],
              ]}
            />
          </Fragment>
        )}
      </div>
    ))
  }

  {/* ─── EL BLOQUE DE TEXTO, UNO POR FOTO ──────────────────────────────────
      Cada slide trae el suyo con su propia posición, y por eso el botón se
      repite dentro de los tres: si viviera fuera, se quedaría clavado en un
      sitio mientras el titular se mueve, y la mitad de las veces acabaría a
      media pantalla de distancia de su propio texto. Solo hay uno visible a la
      vez; los otros dos son `display: none`, así que ni se leen ni se tabulan.

      El texto va alineado a la IZQUIERDA dentro de su caja aunque la caja esté
      a la derecha. Alinear a la derecha tres líneas de titular obliga a buscar
      dónde empieza cada una. */}
  {
    heroSlider.slides.map((slide, i) =>
      esDiptico(slide) ? (
        /* El hueco del díptico, que ya se pintó entero arriba. Va vacío y
           siempre oculto, pero VA: el script empareja fondos, textos y puntos
           por su posición en el array, así que saltárselo correría un puesto
           todos los siguientes. Ver la nota de `esDiptico`. */
        <div data-texto={i} data-activo={i === 0 ? "true" : "false"} class="hidden" />
      ) : (
      <div
        data-texto={i}
        data-activo={i === 0 ? "true" : "false"}
        class:list={[
          "absolute inset-0 hidden data-[activo=true]:flex",
          POSICIONES[posicionDe(comoFoto(slide).posicion)],
        ]}
      >
        <div class="container-page w-full">
          {/* ⚠️ `max-w-2xl` Y EL TITULAR EN `6xl`: son las dos medidas que
              impiden la palabra huérfana. Medido a 1440 px, con la caja más
              ancha o el cuerpo más grande, la última línea de la segunda foto
              se parte y deja una palabra sola en su renglón.

              La regla es agrandar la caja o bajar el cuerpo, nunca acortar la
              idea. */}
          <div
            class:list={[
              "max-w-2xl",
              comoFoto(slide).posicion?.startsWith("derecha")
                ? "ml-auto"
                : "mr-auto",
            ]}
          >
            {/* El renglón que nombra al público. Va en minúsculas y pequeño
                a propósito: si compite en tamaño con el titular, deja de leerse
                como la entrada de una frase y pasa a ser un segundo titular.
                Ver la nota de `heroSlider.slides` en el config. */}
            <p
              class="mb-4 text-sm font-semibold text-secondary-200 sm:text-base"
              style={SOMBRA_TEXTO}
            >
              <T v={comoFoto(slide).kicker} />
            </p>

            <h1 class="text-4xl leading-[1.06] font-extrabold text-balance sm:text-5xl lg:text-6xl">
              {comoFoto(slide).titulo.map((linea) => (
                <span class="block" style={`color:#ffffff;${SOMBRA_TEXTO}`}>
                  {"enfasis" in linea && linea.enfasis ? (
                    <Enfasis v={linea} tono="inverso" />
                  ) : (
                    <T v={linea} />
                  )}
                </span>
              ))}
            </h1>

            {/* Blanco puro escrito a mano y no `text-ink-inverse`: a este
                tamaño, sobre foto, el token se ve gris. */}
            <p
              class="mt-5 max-w-md text-base sm:text-lg"
              style={`color:#ffffff;${SOMBRA_TEXTO}`}
            >
              <T v={comoFoto(slide).subtitulo} />
            </p>

            <div class="mt-8">
              <Button
                href={heroSlider.cta.href}
                variant="primary"
                size="lg"
                trackId={`hero-${i + 1}`}
              >
                <T v={heroSlider.cta.texto} />
              </Button>
            </div>
          </div>
        </div>
      </div>
      ),
    )
  }

  {/* ─── LOS MANDOS ─────────────────────────────────────────────────────────
      Abajo a la izquierda, lejos del texto y del botón. Los tres puntos dicen
      en qué imagen vas y dejan elegir; el botón para. Ver la nota de la
      cabecera: sin esto, el hero incumple la WCAG.

      ⚠️ `pointer-events-none` EN LA CAJA Y `pointer-events-auto` EN LO QUE SE
      PULSA. Esta caja es tan ancha como el contenedor de la página, pero lo
      que hay dentro ocupa 140 px a la izquierda: el resto es aire, y ese aire
      se pintaba POR ENCIMA del hero. Mientras el botón del hero estuvo a la
      derecha no se notó; el del díptico va centrado y a la misma altura, así
      que el clic caía en el aire de esta caja y no pasaba nada. */}
  <div
    class="container-page pointer-events-none absolute inset-x-0 bottom-6 flex items-center gap-4"
  >
    <ul role="list" class="pointer-events-auto flex items-center gap-2">
      {
        heroSlider.slides.map((_, i) => (
          <li>
            <button
              type="button"
              data-punto={i}
              data-activo={i === 0 ? "true" : "false"}
              aria-label={etiquetaPunto(i)[lang]}
              data-aria-es={etiquetaPunto(i).es}
              data-aria-en={etiquetaPunto(i).en}
              class="grid size-11 place-items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-inverse"
            >
              <span
                aria-hidden="true"
                class="block h-1 w-6 rounded-full bg-white/40 transition-[background-color,width] duration-300 ease-out-soft"
                data-barra
              />
            </button>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-hero-pausa
      aria-pressed="false"
      aria-label={heroSlider.pausar[lang]}
      data-aria-es={heroSlider.pausar.es}
      data-aria-en={heroSlider.pausar.en}
      data-etiqueta-pausar-es={heroSlider.pausar.es}
      data-etiqueta-pausar-en={heroSlider.pausar.en}
      data-etiqueta-reanudar-es={heroSlider.reanudar.es}
      data-etiqueta-reanudar-en={heroSlider.reanudar.en}
      class="pointer-events-auto grid size-11 place-items-center rounded-full border border-white/40 text-white transition-colors duration-200 hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-inverse"
    >
      <Icono nombre="pausa" class="size-4" grosor={2} data-icono-pausa />
      <Icono nombre="play" class="hidden size-4" grosor={1} data-icono-play />
    </button>
  </div>
</section>

<style>
  /* El punto de la imagen activa se alarga y se pone blanco. Va en CSS y no en
     clases porque depende de un atributo que mueve el script. */
  [data-punto][data-activo="true"] [data-barra] {
    width: 2.5rem;
    background-color: #ffffff;
  }
</style>

<script>
  /**
   * La rotación. Diez líneas y sin dependencias.
   *
   * ⚠️ NO ARRANCA CON `prefers-reduced-motion`. No es que vaya más despacio: no
   * empieza. Quien pide menos movimiento no quiere que la pantalla cambie sola
   * cada seis segundos, y los puntos siguen ahí para ver las otras dos.
   */
  const SEGUNDOS = 6;

  function montarHero() {
    const hero = document.querySelector<HTMLElement>("[data-hero-slider]");
    if (!hero || hero.dataset.montado) return;
    hero.dataset.montado = "1";

    const fondos = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
    const textos = [...hero.querySelectorAll<HTMLElement>("[data-texto]")];
    const puntos = [...hero.querySelectorAll<HTMLElement>("[data-punto]")];
    const boton = hero.querySelector<HTMLButtonElement>("[data-hero-pausa]");
    if (fondos.length < 2) return;

    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
    let actual = 0;
    let temporizador: number | undefined;
    let pausado = menosMovimiento.matches;

    const pintar = (i: number) => {
      actual = i;
      fondos.forEach((el, n) => {
        el.dataset.activo = String(n === i);
        /* El fondo que no se ve no lo anuncia el lector de pantalla. */
        if (n === i) el.removeAttribute("aria-hidden");
        else el.setAttribute("aria-hidden", "true");
      });
      textos.forEach((el, n) => (el.dataset.activo = String(n === i)));
      puntos.forEach((el, n) => (el.dataset.activo = String(n === i)));
    };

    const arrancar = () => {
      clearInterval(temporizador);
      if (pausado) return;
      temporizador = window.setInterval(
        () => pintar((actual + 1) % fondos.length),
        SEGUNDOS * 1000,
      );
    };

    puntos.forEach((p, i) =>
      p.addEventListener("click", () => {
        pintar(i);
        /* Elegir una imagen a mano reinicia la cuenta: si no, la siguiente
           podría llegar medio segundo después de haberla elegido. */
        arrancar();
      }),
    );

    const claveIdioma = (base: string) =>
      document.documentElement.lang === "en" ? `${base}En` : `${base}Es`;

    const pintarBoton = () => {
      if (!boton) return;
      const etiqueta =
        boton.dataset[claveIdioma(pausado ? "etiquetaReanudar" : "etiquetaPausar")];
      if (etiqueta) boton.setAttribute("aria-label", etiqueta);
      boton.setAttribute("aria-pressed", String(pausado));
      boton.querySelector("[data-icono-pausa]")?.classList.toggle("hidden", pausado);
      boton.querySelector("[data-icono-play]")?.classList.toggle("hidden", !pausado);
    };

    boton?.addEventListener("click", () => {
      pausado = !pausado;
      pintarBoton();
      arrancar();
    });

    window.addEventListener("e180:idioma", pintarBoton);

    /* Si la pestaña no está a la vista, no se gasta nada en rotar. */
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) clearInterval(temporizador);
      else arrancar();
    });

    pintarBoton();
    arrancar();
  }

  montarHero();
</script>
