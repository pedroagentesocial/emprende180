---
import { getCollection, render } from "astro:content";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import BotonRed from "@components/ui/BotonRed.astro";
import Icono from "@components/ui/Icono.astro";
import { copy, instructor } from "@config/curso.config";
import { articulosPublicados, formatearFecha, tituloBilingue } from "@lib/blog";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 08 · EL BLOG EN LA PORTADA
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Tres columnas: la lista de artículos y las redes a la izquierda, el retrato
 * en medio, el párrafo y la segunda foto a la derecha. Los títulos abren el
 * artículo ENTERO encima de la página, sin salir de ella.
 *
 * ─── EL DIÁLOGO ES UN `<dialog>` DE VERDAD ─────────────────────────────────
 *
 * No un `div` con `position: fixed` y una clase que lo esconde. `showModal()`
 * trae gratis lo que se tarda medio día en reimplementar mal: el foco atrapado
 * dentro, `Escape` que cierra, el resto de la página inerte para el lector de
 * pantalla y el fondo pintado por el navegador. Lo único que se escribe aquí es
 * abrir, cerrar y el clic fuera.
 *
 * ⚠️ EL ARTÍCULO VIAJA EN EL HTML DE LA PORTADA. Son tres textos cortos y por
 * eso se puede; con treinta artículos esto habría que traerlo al pulsar. Si
 * alguien ve la portada engordar, es por aquí.
 *
 * ─── Y AUN ASÍ TIENE SU DIRECCIÓN ──────────────────────────────────────────
 *
 * Dentro de cada diálogo hay un enlace al artículo de verdad. Un texto que solo
 * existe dentro de una ventana emergente no se puede compartir, ni enlazar, ni
 * abrir en otra pestaña. El diálogo es una comodidad, no un sustituto de la
 * página.
 *
 * ─── LOS TÍTULOS SON DE LOS ARTÍCULOS QUE HAY ──────────────────────────────
 *
 * `articulosPublicados` es la misma función que usan el listado y la página del
 * artículo: borradores fuera, fechas futuras fuera. La regla de qué se publica
 * es UNA, y esta sección no se inventa la suya.
 *
 * ─── DOS COLUMNAS, Y LA FOTO SE VA POR EL BORDE ────────────────────────────
 *
 * Esto fueron tres columnas: texto y redes a la izquierda, un retrato en el
 * centro y un párrafo con otra foto a la derecha. Se veía como tres cosas
 * puestas una al lado de otra, cada una en su caja, con aire muerto entre
 * ellas y sin que ninguna mandara.
 *
 * Ahora es lo que hace el bloque del podcast de la referencia: TODO el texto en
 * una columna y UNA foto que ocupa la otra mitad entera y se sale por el borde
 * derecho de la pantalla. La foto deja de ser una ilustración metida en una
 * caja y pasa a ser media sección.
 *
 * ⚠️ EL `max-w-[44rem] ml-auto` DE LA COLUMNA DE TEXTO NO ES UN NÚMERO AL AZAR.
 * La rejilla parte la pantalla por la mitad, así que 44rem pegadas al borde
 * derecho de esa mitad empiezan exactamente donde empezaría un contenedor
 * centrado de 88rem, que es el que usan las demás secciones del rediseño. El
 * texto queda alineado con el resto de la página en cualquier ancho, sin
 * cálculos ni `vw`.
 */

const { blogPortada } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Los tres últimos. Con más de tres, la columna de la izquierda se hace más
   alta que el retrato del medio y la fila se descuadra. */
const articulos = (await articulosPublicados(getCollection)).slice(0, 3);

/* El contenido renderizado de cada uno, para meterlo en su diálogo. Se resuelve
   aquí arriba porque `render` es asíncrono y dentro del marcado no se puede
   esperar. */
const conContenido = await Promise.all(
  articulos.map(async (articulo) => ({
    articulo,
    Contenido: (await render(articulo)).Content,
  })),
);

---

<Section id="blog" tono="surface" ariaLabel={blogPortada.aria} sinContenedor>
  {/* ─── UNA REJILLA ASIMÉTRICA, Y EL DESNIVEL LO DA LA FOTO ──────────────
      Dos columnas, 55/45, pero la de la derecha NO empieza a la altura del
      titular: arranca 96 px más abajo, justo donde termina el bloque de autor
      de la izquierda. Ese desnivel es lo único que hace asimétrica la sección,
      y vive en un margen de la imagen y no en la rejilla: así el texto sigue
      empezando arriba del todo, que es donde se empieza a leer.

      ⚠️ Y ES UNA SOLA FOTO, no dos superpuestas como en la sección de
      identidad. Repetir allí el mismo recurso convertiría una decisión en un
      tic: dos secciones con el mismo truco a media pantalla de distancia. */}
  <div class="container-page">
      {/* ⚠️ DOS COLUMNAS DESDE `md` Y NO DESDE `lg`, y esto era un agujero de
          verdad. Rompiendo en 1024, una tablet de 768 u 834 se llevaba el
          diseño de MÓVIL estirado: fotos de 700 px de ancho, titulares
          pequeños para ese hueco y una columna de texto con su medida en medio
          de una pantalla vacía. El punto donde fallan los diseños pensados
          para móvil y escritorio es justo ese, el de en medio. */}
    {/* ⚠️ 70 / 30, Y ANTES ERA 55 / 45. Lo pidió el cliente, igual que en la
        sección de identidad, y cambia el papel de la foto: de ser media
        sección pasa a ser el apoyo de la columna de texto.

        La foto es un vertical anclado a su columna, así que encoge sin
        recortarse mal; lo que gana es el texto, que a 1440 pasa de 675 a 859
        px y deja que el titular y la lista de artículos respiren. */}
    <div class="grid gap-10 md:grid-cols-[70fr_30fr] md:gap-10 lg:gap-16 xl:gap-20">
      {/* ─── IZQUIERDA ─────────────────────────────────────────────────── */}
      <div>
        <Reveal>
          <p class="text-sm font-semibold text-ink-brand sm:text-base">
            <T v={blogPortada.kicker} />
          </p>

          {/* Peso 600 y no extrabold: es el titular más grande de la sección,
              pero la sección no grita. Mismo criterio que en identidad, para
              que las dos se lean de la misma familia. */}
          <h2 class="mt-4 text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink sm:text-5xl">
            <T v={blogPortada.titulo[0]} />
          </h2>

          <p class="mt-2 text-3xl leading-[1.15] text-balance sm:text-4xl">
            <Enfasis v={blogPortada.titulo[1]} />
          </p>

          {/* ─── EL BLOQUE DE AUTOR ──────────────────────────────────────
              ⚠️ ESTO ERAN DOS COSAS SUELTAS Y AHORA ES UNA. El retrato vivía
              en la columna de la foto, a media pantalla de distancia, y el
              rótulo "Dónde publico" con sus cinco redes estaba abajo del todo,
              pegado al enlace del blog. Separados, ninguno de los dos decía lo
              que dicen juntos: que esto lo escribe una persona concreta y que
              se la puede seguir.

              No se duplica nada: el retrato y las redes SALIERON de donde
              estaban. Son los mismos enlaces de siempre. */}
          <div class="mt-9 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <div class="flex items-center gap-3">
        {/* ⚠️ ALTO FIJO EN MÓVIL Y COMPLETO EN ESCRITORIO, y son dos cosas
            distintas. Apilada no hay nada con lo que igualarse, así que la
            foto se queda en una franja de 260-320 px. En dos columnas sí lo
            hay: la rejilla estira las dos celdas al mismo alto, así que con
            `lg:h-full` la foto baja hasta la misma línea donde termina la
            lista de artículos de al lado.

            El `mt-24` de la celda sigue puesto, así que la foto NO empieza
            donde empieza el texto: arranca 96 px más abajo y acaba a su
            altura. Eso es lo que la hace larga sin perder el desnivel. */}
              <img
                src={instructor.foto}
                alt={blogPortada.autorAlt[lang]}
                data-alt-es={blogPortada.autorAlt.es}
                data-alt-en={blogPortada.autorAlt.en}
                width={800}
                height={1000}
                loading="lazy"
                decoding="async"
                class="size-10 shrink-0 rounded-full object-cover object-top"
              />
              <p class="text-[0.8125rem] font-medium text-ink">
                {instructor.nombre}
              </p>
            </div>

            <BotonRed etiquetaPendiente={copy.ui.proximamente[lang]} />
          </div>

          {/* El filete que separa al autor de lo que ha escrito. Medio píxel:
              tiene que notarse que hay un corte, no verse una raya. */}
          <div aria-hidden="true" class="mt-6 border-t-[0.5px] border-line"></div>
        </Reveal>

        {
          articulos.length === 0 ? (
            <p class="mt-8 text-base font-medium text-ink-muted sm:text-lg">
              <T v={blogPortada.vacio} />
            </p>
          ) : (
            <Reveal delay={0.1}>
              {/* ⚠️ LA FECHA VA ENCIMA DEL TÍTULO, al revés que antes. En una
                  lista de tres, la fecha es lo que ordena: dice de un vistazo
                  cuál es el último. Debajo del título había que buscarla. */}
              <ul class="mt-2">
                {articulos.map((a) => (
                  <li class="border-b-[0.5px] border-line last:border-b-0">
                    {/* El título ES el botón: uno aparte al lado duplica el
                        mismo destino en dos sitios y obliga a apuntar a la
                        diana pequeña. */}
                    <button
                      type="button"
                      data-abrir={a.id}
                      class="group flex w-full min-h-11 items-center gap-4 py-5 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                    >
                      <span class="min-w-0 flex-1">
                        <time
                          datetime={a.data.fecha.toISOString().slice(0, 10)}
                          class="block text-[0.8125rem] text-ink-subtle"
                        >
                          {formatearFecha(a.data.fecha, a.data.idioma)}
                        </time>
                        <span class="mt-1.5 block text-[17px] font-medium text-pretty text-ink group-hover:text-ink-brand">
                          <T v={tituloBilingue(a)} />
                        </span>
                      </span>
                      <Icono
                        nombre="flecha"
                        class="size-5 shrink-0 text-ink-subtle transition-transform duration-200 ease-out-soft group-hover:translate-x-1 group-hover:text-ink-brand"
                      />
                    </button>
                  </li>
                ))}
              </ul>

              {/* El botón de secciones, el mismo de identidad, academia y
                  recursos. Sin flecha: la llevaba cuando era un enlace de texto
                  subrayado, donde era lo único que decía que se podía pulsar.
                  Un botón ya lo dice por su forma.

                  El envoltorio lleva su compensación de 4 px: el botón vive
                  desplazado a la izquierda —ese hueco lo ocupa su pila de
                  sombras— y sin esto su borde no cuadra con el de la lista de
                  arriba. */}
              <div class="ml-1 mt-8">
                <BotonRelieve href="/blog" trackId="blog-todos">
                  <T v={blogPortada.verTodos} />
                </BotonRelieve>
              </div>
            </Reveal>
          )
        }
      </div>

      {/* ─── DERECHA: LA FOTO ──────────────────────────────────────────────
          ⚠️ EL MARGEN SUPERIOR ES EL ELEMENTO DE LA SECCIÓN, no un hueco. Son
          los 96 px que bajan la foto hasta la altura donde termina el bloque
          de autor de al lado. Quitarlo deja dos columnas empezando a la vez,
          que es justo la simetría que esta sección no quiere.

          En móvil no se aplica: apiladas, ese margen sería un hueco sin
          motivo. Y va la ÚLTIMA, después de la lista: en un teléfono, una
          cara antes del titular no dice quién escribe, solo tapa la entrada.

          ⚠️ Y NO ES LA FOTO QUE PEDÍA EL ENCARGO. Pedía a Pedro escribiendo
          de noche con un café y esa foto no existe. Se eligió su retrato de
          oficina —real, aunque corporativo y de día— antes que una de banco
          con la escena correcta y un desconocido dentro: la sección está
          firmada por él dos elementos más arriba. */}
      <Reveal delay={0.18} class="md:mt-24 md:self-stretch">
        <img
          src={instructor.fotoOficina}
          alt={blogPortada.foto[lang]}
          data-alt-es={blogPortada.foto.es}
          data-alt-en={blogPortada.foto.en}
          width={1800}
          height={1200}
          loading="lazy"
          decoding="async"
          class="h-[260px] w-full rounded-lg border border-line object-cover object-[center_28%] sm:h-[320px] md:h-full"
        />
      </Reveal>
    </div>
  </div>

  {/* ─── Los diálogos ─────────────────────────────────────────────────────
      Uno por artículo, al final de la sección y vacíos de estilo propio: el
      navegador los coloca en la capa de arriba, así que da igual dónde estén
      en el documento. */}
  {
    conContenido.map(({ articulo, Contenido }) => (
      <dialog
        id={`articulo-${articulo.id}`}
        aria-labelledby={`titulo-${articulo.id}`}
        class="m-auto w-[min(46rem,92vw)] rounded-3xl bg-surface p-0 text-ink backdrop:bg-primary-950/70"
      >
        <div class="max-h-[85vh] overflow-y-auto p-6 sm:p-10">
          <div class="flex items-start justify-between gap-6">
            <div>
              <time
                datetime={articulo.data.fecha.toISOString().slice(0, 10)}
                class="text-sm text-ink-subtle"
              >
                {formatearFecha(articulo.data.fecha, articulo.data.idioma)}
              </time>
              <h3
                id={`titulo-${articulo.id}`}
                class="mt-2 text-2xl font-extrabold text-balance text-ink sm:text-3xl"
              >
                <T v={tituloBilingue(articulo)} />
              </h3>
            </div>

            <button
              type="button"
              data-cerrar
              aria-label={blogPortada.cerrar[lang]}
              data-aria-es={blogPortada.cerrar.es}
              data-aria-en={blogPortada.cerrar.en}
              class="grid size-11 shrink-0 place-items-center rounded-full border border-line text-ink-muted hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            >
              <Icono nombre="cruz" class="size-5" />
            </button>
          </div>

          <div class="prosa mt-8" lang={articulo.data.idioma}>
            <Contenido />
          </div>

          <a
            href={`/blog/${articulo.id}`}
            class="mt-10 inline-flex min-h-11 items-center text-sm font-bold text-ink-brand underline underline-offset-4 hover:text-secondary-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <T v={blogPortada.verEnBlog} />
          </a>
        </div>
      </dialog>
    ))
  }
</Section>

<script>
  /**
   * Abrir, cerrar, y cerrar al pulsar fuera. Nada más: el resto lo hace
   * `<dialog>` solo.
   *
   * ⚠️ EL CLIC DE FUERA SE DETECTA POR EL DESTINO DEL EVENTO, no por
   * coordenadas. El fondo oscuro es el `::backdrop` del propio diálogo, así que
   * un clic en él llega con `target` igual al `<dialog>`; un clic en el
   * contenido llega con el elemento de dentro. Comparar cajas con
   * `getBoundingClientRect` falla en cuanto el diálogo tiene esquinas
   * redondeadas, que es el caso.
   */
  const dialogos = document.querySelectorAll<HTMLDialogElement>("dialog[id^='articulo-']");
  if (dialogos.length) {
    document.querySelectorAll<HTMLButtonElement>("[data-abrir]").forEach((boton) => {
      boton.addEventListener("click", () => {
        const d = document.getElementById(`articulo-${boton.dataset.abrir}`);
        if (d instanceof HTMLDialogElement) d.showModal();
      });
    });

    dialogos.forEach((d) => {
      d.querySelector<HTMLButtonElement>("[data-cerrar]")?.addEventListener("click", () =>
        d.close(),
      );
      d.addEventListener("click", (e) => {
        if (e.target === d) d.close();
      });
    });
  }
</script>
