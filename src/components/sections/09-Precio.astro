---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import BotonDetalle from "@components/ui/BotonDetalle.astro";
import LeadForm from "@components/ui/LeadForm";
import { Contador } from "@components/motion/Contador";
import Icono from "@components/ui/Icono.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { curso, cta, garantia, copy, contacto } from "@config/curso.config";
import { construirTxt, LOCALES, resolverIdiomaServidor } from "@i18n/idioma";
import { formatMoney } from "@i18n/formato";

/**
 * 09 · PRECIO — estrategia de ancla.
 *
 * CÓMO FUNCIONA EL ANCLA
 * Se enseña una cifra alta (la referencia) para que la real se lea en relación
 * a ella. La técnica funciona, pero solo si la cifra alta se sostiene: un ancla
 * que no se justifica no ancla nada, levanta sospechas. Por eso el desglose no
 * es decoración, es la mitad del argumento, y va a la izquierda del precio para
 * que se lea ANTES.
 *
 * FRAMING (decisión legal, no estética)
 *  · 'lanzamiento' — ACTIVO. La cifra alta es el precio FUTURO. Es verdad desde
 *    el día uno y no hay que demostrar ningún histórico.
 *  · 'descuento'   — la cifra alta es el precio anterior. PROFECO (México) y la
 *    FTC (EE. UU.) exigen que ese precio haya sido real y vigente.
 * Se cambia en `curso.precio.framing`.
 *
 * LA CUENTA ATRÁS. Sale de `precio.urgencia.fechaCierre` y solo si esa fecha
 * existe y no ha pasado. Cuenta hacia un instante FIJO, así que no se reinicia
 * al recargar: todo el mundo ve el mismo número. Cuando la fecha llega, el
 * contador se quita solo en vez de quedarse en cero o empezar otra vuelta.
 * El compromiso que viene con él está escrito en el config: llegada la fecha,
 * `precio.actual` tiene que subir de verdad.
 *
 * ─── EL DESGLOSE, DE PÁRRAFOS A BARRAS ─────────────────────────────────────
 *
 * Cada componente llevaba su título Y su justificación completa a la vista:
 * cuatro párrafos, unas 140 palabras, en la columna que hay que leer ANTES de
 * ver el precio. Se leían enteros pocos y se saltaban muchos.
 *
 * Ahora cada fila es título + cifra + una BARRA a escala de su parte de los
 * 3.990, y la justificación se despliega al pasar el cursor o, en táctil, al
 * tocar "Ver más" (ver `[data-revelar]` en global.css y `BotonDetalle.astro`).
 *
 * La barra no es adorno: el ancla se sostiene porque el visitante puede
 * recorrer la suma, y una barra hace ese recorrido de un vistazo — se VE que el
 * curso en sí es más de la mitad del total. Un ancla que se entiende en dos
 * segundos ancla; una que exige leer 140 palabras, no.
 *
 * ⚠️ Lo que NO se puede quitar es la justificación en sí. Está escondida, no
 * borrada: sin ella los 3.990 vuelven a ser un número puesto ahí, que es
 * exactamente lo que el comentario de `precio.desglose` prohíbe.
 */

const { precio } = curso;
const checkoutPendiente = precio.urlCheckout === "#";
const esLanzamiento = precio.framing === "lanzamiento";

/** Dinero formateado por Intl en cada idioma. Ni un "$" escrito a mano. */
const dinero = (n: number) => construirTxt((l) => formatMoney(n, l, precio.moneda));

const precioActual = dinero(precio.actual);
const precioReferencia = dinero(precio.referencia);

const ahorro = precio.referencia - precio.actual;
const porcentaje = Math.round((ahorro / precio.referencia) * 100);

/**
 * El desglose tiene que sumar la referencia. Si alguien toca un valor y deja de
 * cuadrar, la sección lo dice en pantalla en vez de enseñar un ancla rota.
 */
const sumaDesglose = precio.desglose.reduce((t, i) => t + i.valor, 0);
const desgloseCuadra = sumaDesglose === precio.referencia;

const textoAhorro = construirTxt((l) =>
  copy.precio.descuento.ahorras[l]
    .replace("{importe}", formatMoney(ahorro, l, precio.moneda))
    .replace("{porcentaje}", String(porcentaje)),
);

const textoSubira = construirTxt((l) =>
  copy.precio.lanzamiento.subira[l].replace(
    "{referencia}",
    formatMoney(precio.referencia, l, precio.moneda),
  ),
);

/**
 * El enganche: la diferencia entre lo que suma el desglose y lo que se paga.
 *
 * Solo se pinta si el desglose CUADRA. Si alguien toca un valor y la suma deja
 * de dar la referencia, esta frase pasaría a comparar contra un número que no
 * existe, y es justo la clase de afirmación que no puede salir mal. Prefiere no
 * decir nada antes que decir una cifra que no se sostiene.
 */
const textoFrenteAlDesglose = desgloseCuadra
  ? construirTxt((l) =>
      copy.precio.lanzamiento.frenteAlDesglose[l].replace(
        "{importe}",
        formatMoney(ahorro, l, precio.moneda),
      ),
    )
  : null;

const textoCuotas = precio.cuotas
  ? construirTxt((l) =>
      copy.precio.cuotas[l]
        .replace("{n}", String(precio.cuotas.numero))
        .replace("{importe}", formatMoney(precio.cuotas.importe, l, precio.moneda)),
    )
  : null;

/** Urgencia. Solo se pinta si el dato existe de verdad. */
const urgencia = (() => {
  const u = precio.urgencia;
  if (u.tipo === "ninguna") return null;

  if (u.tipo === "cupos" && u.cupos) {
    const n = u.cupos;
    return construirTxt((l) => copy.precio.urgencia.cupos[l].replace("{n}", String(n)));
  }

  if (u.tipo === "fecha" && u.fechaCierre) {
    const f = new Date(u.fechaCierre);
    return construirTxt((l) =>
      copy.precio.urgencia.fecha[l].replace(
        "{fecha}",
        new Intl.DateTimeFormat(LOCALES[l], { day: "numeric", month: "long" }).format(f),
      ),
    );
  }

  // 'lanzamiento', o un tipo sin dato real: nota honesta, sin contador.
  return esLanzamiento ? copy.precio.lanzamiento.nota : copy.precio.descuento.nota;
})();

/* ── Cuenta atrás ──────────────────────────────────────────────────────────
   Solo con `tipo: "fecha"` y una fecha válida. Si ya pasó, el contador no se
   pinta (lo decide él mismo en el cliente, que es quien conoce la hora del
   visitante) y aquí solo se levanta el aviso para quien edita el sitio. */
const fechaCierre =
  precio.urgencia.tipo === "fecha" ? precio.urgencia.fechaCierre : null;
const msCierre = fechaCierre ? new Date(fechaCierre).getTime() : NaN;
const fechaValida = Number.isFinite(msCierre);
const fechaCaducada = fechaValida && msCierre <= Date.now();

/** La frase que sí lee un lector de pantalla: fecha completa y precio futuro. */
const alternativaContador =
  fechaValida && !fechaCaducada
    ? construirTxt((l) =>
        copy.precio.contador.alternativa[l]
          .replace(
            "{fecha}",
            new Intl.DateTimeFormat(LOCALES[l], {
              day: "numeric",
              month: "long",
              hour: "numeric",
              minute: "2-digit",
            }).format(new Date(msCierre)),
          )
          .replace("{referencia}", formatMoney(precio.referencia, l, precio.moneda)),
      )
    : null;

/**
 * Lo que se puede decir de dinero SIN decir la cifra.
 *
 * Cada uno responde a un miedo distinto: "¿me van a cobrar todos los meses?",
 * "¿lo pierdo si no lo veo ya?", "¿tengo que pagarlo de golpe?" y "¿y si no es
 * para mí?". Que el precio no esté no significa que no haya nada que contar.
 *
 * Los dos últimos SALEN SOLOS si el dato no existe: sin `precio.cuotas` no se
 * promete pago fraccionado, y sin garantía activa no se promete devolución.
 */
const hechosInformes = [
  copy.informes.hechos[0]!,
  copy.informes.hechos[1]!,
  ...(precio.cuotas
    ? [
        construirTxt((l) =>
          copy.informes.hechos[2]![l].replace("{n}", String(precio.cuotas!.numero)),
        ),
      ]
    : []),
  ...(garantia.activa ? [garantia.titulo] : []),
];

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);
---

<Section id="precio" tono="sunken" ritmo="amplio" ariaLabel={copy.precio.aria}>
  {/* `max-w-6xl`: el desglose necesita que "El curso completo: los 10 videos,
      con acceso de por vida" entre en una línea, y con las dos islas separadas
      por su hueco eso pide 1.152 px. Más ancho no: el panel de la derecha se
      estiraría hasta que su contenido quedara nadando. */}
  <div class="mx-auto max-w-6xl">
    <Reveal>
      {/* ─── DOS ISLAS, NO UNA TARJETA PARTIDA POR LA MITAD ──────────────
          Era un solo bloque con dos mitades pegadas y un filete entre ellas, y
          encima un titular en su propia isla, a lo ancho, como cabecera. Tres
          piezas para dos ideas.

          Ahora son dos islas separadas por su hueco: qué te llevas a la
          izquierda —con el titular de la sección dentro, que es donde tenía que
          estar— y a la derecha lo que responde "¿cuánto cuesta?".

          `items-stretch` para que las dos midan lo mismo. */}
      <div class="grid items-stretch gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-8">
        {/* ─── ISLA 1 · QUÉ TE LLEVAS ─────────────────────────────────────
            Con precio público es el DESGLOSE que sostiene el ancla: cada parte
            con su valor y su barra. Sin precio público sigue siendo la misma
            lista —las mismas cuatro cosas, en el mismo orden— pero sin cifras
            y con la justificación de cada una a la vista.

            Las barras se van con las cifras porque sin ellas no significan
            nada: una barra a escala de un total que no se enseña es un adorno.
            Y el detalle deja de estar plegado: existía porque cuatro párrafos
            competían con las cuatro cifras por la misma mirada, y sin cifras no
            hay competencia. */}
        <div
          class="flex min-w-0 flex-col rounded-3xl border border-line bg-surface p-7 shadow-lg sm:p-9"
        >
          {/* ─── EL TITULAR DE LA SECCIÓN, DENTRO DE LA ISLA ───────────────
              Estaba arriba, en una isla teal a lo ancho, haciendo de cabecera.
              Aquí encabeza lo que de verdad encabeza —el desglose de lo que
              incluye— y la sección se queda en dos bloques en vez de tres.

              Y el `h2` sigue siendo el primero del marcado, así que el orden de
              los encabezados no cambia para quien navega por ellos. */}
          <h2 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
            <T v={copy.precio.titulo} />
          </h2>
          <p class="mt-4 text-base text-pretty text-ink-muted sm:text-lg">
            <T v={copy.precio.entradilla} />
          </p>

          <h3 class="mt-8 border-t border-line pt-7 text-lg font-bold text-ink">
            <T
              v={precio.publico
                ? copy.precio.desgloseTitulo
                : copy.precio.desgloseTituloSinPrecio}
            />
          </h3>

          {/* La pista solo existe si hay algo que desplegar y un cursor con el
              que pasar. */}
          {
            precio.publico && (
              <p data-pista-hover class="mt-1 text-xs text-ink-subtle">
                <T v={copy.ui.pistaHover} />
              </p>
            )
          }

          <ul class="mt-5 divide-y divide-line">
            {
              precio.desglose.map((item) => (
                <li data-revelar={precio.publico ? "" : undefined} class="group py-4 first:pt-0">
                  <div class="flex items-baseline justify-between gap-4">
                    <p class="min-w-0 font-semibold text-balance text-ink">
                      <T v={item.titulo} />
                    </p>
                    {precio.publico && (
                      <p class="shrink-0 text-sm font-bold tabular-nums text-ink">
                        <T v={dinero(item.valor)} />
                      </p>
                    )}
                  </div>

                  {/* LA BARRA. Cada componente ocupa su parte de la cifra
                      ancla, a escala. Es lo que convierte una lista de cuatro
                      precios en algo que se ENTIENDE de un vistazo: se ve que
                      el curso en sí es más de la mitad de los 3.990, y ese
                      reparto es justo lo que hace creíble el total.

                      `aria-hidden`: la cifra exacta ya está escrita al lado en
                      texto, así que la barra no aporta nada a quien la escucha
                      y solo añadiría ruido. */}
                  {precio.publico && (
                    <div
                      aria-hidden="true"
                      class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface-sunken"
                    >
                      <div
                        class="h-full rounded-full bg-secondary-400 transition-colors duration-200 ease-out-soft group-hover:bg-secondary-600"
                        style={`width:${((item.valor / precio.referencia) * 100).toFixed(1)}%`}
                      />
                    </div>
                  )}

                  {precio.publico ? (
                    <Fragment>
                      <div data-detalle>
                        <div>
                          <p class="mt-2.5 text-sm text-pretty text-ink-muted">
                            <T v={item.detalle} />
                          </p>
                        </div>
                      </div>

                      {/* Solo en táctil. Ver `BotonDetalle.astro`. */}
                      <BotonDetalle class="mt-0.5" />
                    </Fragment>
                  ) : (
                    <p class="mt-1.5 text-sm text-pretty text-ink-muted">
                      <T v={item.detalle} />
                    </p>
                  )}
                </li>
              ))
            }
          </ul>

          {/* La suma, explícita: convierte la cifra ancla en un total que el
              visitante puede recorrer, no en un número puesto ahí. Sin precio
              público no hay total que enseñar. */}
          {
            precio.publico && (
              <div class="mt-5 flex items-center justify-between gap-4 border-t-2 border-line-strong pt-5">
                <p class="font-bold text-ink">
                  <T v={copy.precio.desgloseTotal} />
                </p>
                <p class="text-lg font-extrabold tabular-nums text-ink">
                  <T v={precioReferencia} />
                </p>
              </div>
            )
          }

          {
            precio.publico && !desgloseCuadra && (
              <p class="mt-4 rounded-lg border-2 border-dashed border-warning-500 bg-warning-50 px-4 py-3 text-sm font-medium text-ink">
                ⚠ <T v={copy.precio.avisoDesglose} />{" "}
                <code class="font-mono">{sumaDesglose} ≠ {precio.referencia}</code>
              </p>
            )
          }
        </div>

        {/* ─── ISLA 2 · LO QUE RESPONDE "¿CUÁNTO CUESTA?" ─────────────────
            Con precio público, el panel de siempre: la cifra, la insignia
            contra el desglose, la cuenta atrás, el botón y la garantía.

            Sin precio público, el formulario de informes. Y el navy se queda
            igual en los dos casos: el lado donde se paga —o donde se pregunta
            cuánto— tiene que ganar la mirada, y dos superficies claras juntas
            no jerarquizan nada. */}
        <div
          class="relative isolate flex min-w-0 flex-col justify-center overflow-hidden rounded-3xl bg-primary-950 p-7 text-center shadow-xl sm:p-9"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-24 -right-16 -z-10 size-64 rounded-full bg-secondary-500/20 blur-3xl"
          ></span>

          {/* El isotipo detrás. Pequeño: el panel es estrecho y está lleno, así
              que aquí la marca acompaña, no decora. */}
          <MarcaAgua posicion="izquierda" tamano="pequeno" class="opacity-[0.07]" />

          {
            precio.publico ? (
              <Fragment>
                <p class="text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
                  <T
                    v={esLanzamiento
                      ? copy.precio.lanzamiento.kicker
                      : copy.precio.descuento.kicker}
                  />
                </p>

                {esLanzamiento ? (
                  <Fragment>
                    {/* El precio real manda y la referencia va DEBAJO, en
                        futuro: "subirá a", no un tachón que insinúa un pasado
                        que no fue. */}
                    <p class="mt-3 text-6xl font-extrabold tracking-tight text-ink-inverse">
                      <T v={precioActual} />
                    </p>
                    <p class="mt-1 text-sm font-medium text-secondary-200">
                      <T v={copy.precio.lanzamiento.etiquetaPrecio} />
                    </p>

                    {/* EL ENGANCHE. El desglose de al lado suma 3.990 y aquí se
                        paga 490: esta insignia pone la diferencia en una cifra
                        en vez de dejar que el visitante la calcule. */}
                    {textoFrenteAlDesglose && (
                      <p class="mt-4 inline-flex self-center rounded-full bg-secondary-500 px-4 py-1.5 text-sm font-bold text-balance text-primary-950">
                        <T v={textoFrenteAlDesglose} />
                      </p>
                    )}

                    <p class="mt-3 text-base font-semibold text-balance text-ink-inverse">
                      <T v={textoSubira} />
                    </p>
                  </Fragment>
                ) : (
                  <Fragment>
                    <p class="mt-3 text-base text-secondary-300">
                      <span class="line-through">
                        <T v={precioReferencia} />
                      </span>
                    </p>
                    <p class="text-6xl font-extrabold tracking-tight text-ink-inverse">
                      <T v={precioActual} />
                    </p>
                    <p class="mt-3 inline-flex self-center rounded-full bg-secondary-500 px-3 py-1 text-sm font-bold text-primary-950">
                      <T v={textoAhorro} />
                    </p>
                  </Fragment>
                )}

                {textoCuotas && (
                  <p class="mt-3 text-base font-medium text-secondary-200">
                    <T v={textoCuotas} />
                  </p>
                )}

                {/* La cuenta atrás va ENCIMA del botón, no debajo: es el último
                    argumento antes de la acción, y leerla después de haber
                    pasado de largo el botón no sirve de nada. */}
                {alternativaContador && fechaCierre && (
                  <Contador
                    client:visible
                    fechaCierre={fechaCierre}
                    alternativa={alternativaContador}
                    etiquetas={copy.precio.contador}
                    lang={lang}
                    tono="oscuro"
                  />
                )}

                <div class="mt-7">
                  {/* MIENTRAS NO HAYA PASARELA, EL BOTÓN LLAMA. Un botón
                      apagado y mudo en el punto exacto de la compra es peor que
                      no tener botón: el visitante no deduce "falta configurar
                      la pasarela", deduce que la página está rota. */}
                  <Button
                    href={
                      checkoutPendiente
                        ? contacto.telefono
                          ? `tel:${contacto.telefono}`
                          : undefined
                        : precio.urlCheckout
                    }
                    disabled={checkoutPendiente && !contacto.telefono}
                    variant="primary"
                    size="lg"
                    sobre="oscuro"
                    trackId="precio"
                    block
                  >
                    {checkoutPendiente && contacto.telefono && (
                      <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                    )}
                    <T
                      v={
                        checkoutPendiente && contacto.telefono
                          ? copy.precio.llamarParaInscribirse
                          : cta.primario.texto
                      }
                    />
                  </Button>
                </div>

                {urgencia && !fechaValida && (
                  <p class="mt-4 text-sm font-medium text-balance text-ink-inverse">
                    <T v={urgencia} />
                  </p>
                )}

                {/* 13 px en móvil. Es letra pequeña a propósito —impuestos y
                    formas de pago— pero es lo que evita la sorpresa en la
                    pasarela, y a 12 px sobre navy, en un teléfono, no se lee. */}
                <p class="mt-3 text-[0.8125rem] text-pretty text-secondary-200 sm:text-xs">
                  <T v={precio.nota} />
                </p>

                {garantia.activa && (
                  <div class="mt-5 rounded-xl border border-primary-700 bg-primary-900/70 p-4 text-center">
                    <p class="flex items-center justify-center gap-2 text-sm font-bold text-secondary-300">
                      <Icono nombre="escudo" class="size-5 shrink-0" />
                      <T v={garantia.titulo} />
                    </p>
                    <p class="mt-1.5 text-[0.8125rem] text-pretty text-secondary-200 sm:text-xs">
                      <T v={garantia.resumen} />
                    </p>
                  </div>
                )}
              </Fragment>
            ) : (
              <Fragment>
                {/* ─── PEDIR EL PRECIO ─────────────────────────────────────
                    Va alineado a la izquierda dentro de un panel centrado, y no
                    es un descuido: un formulario con las etiquetas centradas
                    sobre sus campos es ilegible. El `text-center` del panel lo
                    hereda el titular y lo pierde el formulario. */}
                <p class="inline-flex items-center gap-2 self-center rounded-full border border-primary-800 bg-primary-900 px-3 py-1 text-xs font-bold tracking-wide text-secondary-300 uppercase">
                  <span aria-hidden="true" class="marca-linea">
                    <span class="size-1.5 rounded-full bg-secondary-500"></span>
                  </span>
                  <T v={copy.informes.kicker} />
                </p>

                <h3 class="mt-4 text-2xl font-extrabold text-balance text-ink-inverse sm:text-3xl">
                  <T v={copy.informes.titulo} />
                </h3>

                {/* El PORQUÉ, y va antes que el formulario. Una página que
                    esconde la cifra sin explicarse se lee como "es caro y no te
                    lo quiero decir", que es justo la conclusión que hay que
                    evitar. */}
                <p class="mt-3 text-base text-pretty text-secondary-100">
                  <T v={copy.informes.porQue} />
                </p>

                {/* Lo que SÍ se puede decir de dinero sin dar la cifra. Que no
                    haya precio no significa que no haya nada que contar: un
                    solo pago, acceso que no caduca, se puede fraccionar y hay
                    garantía. Cuatro respuestas a cuatro miedos distintos. */}
                <ul class="mt-6 grid gap-2.5 border-t border-primary-800 pt-5 text-left text-sm text-secondary-100">
                  {hechosInformes.map((hecho) => (
                    <li class="flex items-start gap-2.5">
                      <span aria-hidden="true" class="marca-linea shrink-0 text-secondary-500">
                        <Icono nombre="check" class="size-4" grosor={3} />
                      </span>
                      <T v={hecho} />
                    </li>
                  ))}
                </ul>

                <div class="mt-6 text-left">
                  <LeadForm
                    client:visible
                    lang={lang}
                    variante="informes"
                    origen="informes"
                    cta={copy.informes.ctaBoton}
                    aviso={copy.informes.aviso}
                    exitoTitulo={copy.informes.exitoTitulo}
                    exitoTexto={copy.informes.exitoTexto}
                    tono="inverso"
                  />
                </div>

                {/* Y para quien no quiere escribir: el teléfono. El precio se
                    da hablando, así que la llamada no es la segunda opción, es
                    la misma por otra puerta. Solo si hay número. */}
                {contacto.telefono && (
                  <div class="mt-4">
                    <Button
                      href={`tel:${contacto.telefono}`}
                      variant="inverse"
                      sobre="oscuro"
                      trackId="informes-llamada"
                      block
                    >
                      <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                      <T v={copy.informes.llamar} />
                    </Button>
                  </div>
                )}
              </Fragment>
            )
          }
        </div>
      </div>
    </Reveal>

    {/* Solo para quien edita el sitio. El visitante no ve nada raro: el
        contador simplemente ya no está. */}
    {
      precio.publico && fechaCaducada && import.meta.env.DEV && (
        <p class="mt-6 rounded-lg border-2 border-dashed border-warning-500 bg-warning-50 px-4 py-3 text-center text-sm font-medium text-ink">
          ⚠ <T v={copy.precio.contador.avisoCaducado} />
        </p>
      )
    }
  </div>
</Section>
