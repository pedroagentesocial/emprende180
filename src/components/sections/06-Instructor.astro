---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Icono, { type NombreIcono } from "@components/ui/Icono.astro";
import PlaceholderImage from "@components/placeholder/PlaceholderImage.astro";
import { instructor, contacto, copy, cta, aliados } from "@config/curso.config";
import { logoAliado, fotoInstructor } from "@lib/assets";
import { resolverIdiomaServidor } from "@i18n/idioma";
import { MARCA_COMPLETAR, tienePendiente } from "@lib/pendientes";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 06 · INSTRUCTOR — «¿y tú quién eres para enseñarme esto?»
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Llega después del temario a propósito: primero se ve que hay contenido, luego
 * quién lo respalda.
 *
 * ─── POR QUÉ SE REHÍZO ─────────────────────────────────────────────────────
 *
 * Era la sección más larga de la página: una bio de párrafo entero más TRES
 * listas de cuatro elementos cada una —credenciales, "lo que enseño bien" y "lo
 * que no cubre"— apiladas. Doce puntos seguidos, todos del mismo tamaño y con
 * la misma palomita. Y encima no tenía un solo botón: el visitante llegaba al
 * punto en el que decide si se fía de la persona y no tenía dónde pulsar.
 *
 * ─── SE FUE "LO QUE ENSEÑO BIEN" ───────────────────────────────────────────
 *
 * Los cuatro puntos de `queEnsena` eran los mismos que la sección 03 ya cuenta
 * en seis: el Ecosistema, reconocer la oportunidad, pedir el referido, ética y
 * cumplimiento. Repetirlos aquí no añadía credibilidad, añadía scroll. Siguen
 * en el config por si algún día se separan de los resultados.
 *
 * ─── SE QUEDA "LO QUE NO CUBRE" ────────────────────────────────────────────
 *
 * Y no se toca. PRODUCT.md dice que la honestidad se usa como herramienta de
 * venta y que los límites llevan el mismo peso visual que las promesas: quien
 * admite lo que no hace resulta creíble en todo lo demás, y de paso no vende a
 * quien esperaba otra cosa (que es un reembolso y una reseña mala). Aquí es la
 * única lista que sobrevive, y por eso ahora se lee.
 *
 * ─── LO GRÁFICO ────────────────────────────────────────────────────────────
 *
 *  · La foto pasa a mandar: columna propia y pegajosa mientras se lee el resto.
 *  · Las credenciales dejan de ser una lista con palomitas y pasan a ser
 *    tarjetas con icono.
 *  · Entra el logotipo de su otra empresa. No es un anuncio: que la persona que
 *    da el curso dirija además un negocio real del sector es exactamente la
 *    credencial que esta sección tiene que demostrar, y un logotipo lo dice más
 *    rápido que una frase.
 *
 * ─── LOS BOTONES ───────────────────────────────────────────────────────────
 *
 * Dos siempre: entrar al curso y escribirle. El de WhatsApp aparece SOLO si
 * `contacto.whatsapp` tiene número; hoy está vacío, así que no se pinta. Un
 * botón de llamar que no lleva a ningún sitio es peor que no tenerlo.
 */

/* El nombre es un dato, no un texto traducible: si sigue siendo el de
   ejemplo, la sección lo avisa en pantalla en vez de fingir un instructor. */
/* El `alt` de la foto lleva texto traducible, y un `alt` es un atributo: no
   puede pasar por `<T>`. Se resuelve con el idioma del servidor y el script del
   layout lo actualiza al cambiar de idioma (data-alt-es / data-alt-en). */
const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const sinRellenar = instructor.nombre.includes(MARCA_COMPLETAR);

/** Un icono por credencial, emparejado por posición. */
const ICONOS: NombreIcono[] = ["brujula", "certificado", "escudo", "diana"];

/**
 * Las credenciales que ya son un hecho, separadas de las que faltan.
 *
 * Las confirmadas se pintan como tarjetas; la pendiente, aparte y en ámbar.
 * Mezcladas, un `[COMPLETAR:]` se lee como una credencial más y acaba
 * publicándose sin que nadie lo note.
 */
const credenciales = instructor.credenciales.filter((c) => !tienePendiente(c.dato));
const credencialesPendientes = instructor.credenciales.filter((c) =>
  tienePendiente(c.dato),
);

const noCubre = instructor.queNoCubre;

/** El logotipo de su otra empresa, si está. Ver `aliados` en el config. */
const otraMarca = aliados.marcas.find((m) => m.logo === "senordelascasas");
const logoOtraMarca = otraMarca ? logoAliado(otraMarca.logo) : null;

/** WhatsApp solo si hay número de verdad. */
const urlWhatsapp = contacto.whatsapp
  ? `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(contacto.whatsappMensaje.es)}`
  : null;
---

<Section id="instructor" ariaLabel={copy.instructor.aria}>
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
    <!-- ─── Foto + identidad ─────────────────────────────────────────────── -->
    <Reveal>
      <div class="lg:sticky lg:top-8">
        {/* La foto REAL si existe; si no, el hueco.
            Antes aquí solo estaba `PlaceholderImage`, que no comprueba nada y
            pinta el recuadro punteado siempre: la foto podía estar en su
            carpeta y la página seguía enseñando "aquí va la foto". Ver
            `fotoInstructor` en src/lib/assets.ts.

            `aspect-[4/5]` + `object-cover` y no `h-auto`: así el hueco mide lo
            mismo con foto y sin ella, y el layout no salta cuando llega. */}
        {
          fotoInstructor ? (
            <img
              src={fotoInstructor}
              alt={instructor.fotoAlt[lang]}
              data-alt-es={instructor.fotoAlt.es}
              data-alt-en={instructor.fotoAlt.en}
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full rounded-2xl object-cover shadow-lg"
            />
          ) : (
            <PlaceholderImage
              label={copy.placeholders.fotoInstructor}
              medidas={copy.placeholders.fotoInstructorDetalle}
              ruta={instructor.foto}
              ratio="4/5"
              class="rounded-2xl"
            />
          )
        }

        {/* El logotipo de su otra empresa, debajo de la foto. Que quien firma
            el curso dirija además un negocio real del sector es LA credencial
            de esta sección, y el logotipo lo dice antes que cualquier frase.

            Todo centrado: la tarjeta es más ancha que su contenido, y alineado
            a la izquierda dejaba un sobrante a la derecha que se leía como un
            hueco. Centrado, el aire queda repartido y parece intencionado. */}
        {
          logoOtraMarca && otraMarca && (
            <div class="mt-5 rounded-2xl border border-line bg-surface-muted px-5 py-5 text-center">
              <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-ink-subtle">
                <T v={copy.instructor.tambien} />
              </p>
              <a
                href={otraMarca.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="instructor-otra-marca"
                class="mx-auto mt-3 inline-flex min-h-11 items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
              >
                <img
                  src={logoOtraMarca}
                  alt={otraMarca.nombre}
                  loading="lazy"
                  decoding="async"
                  class="h-8 w-auto object-contain"
                />
              </a>
              <p class="mt-1 text-xs text-ink-subtle">
                <T v={otraMarca.rubro} />
              </p>
            </div>
          )
        }

        {/* ─── Credenciales, en 2×2 bajo el logo ────────────────────────────
            Estaban en la columna de texto, en una fila de tres tarjetas
            grandes: partían la lectura entre la bio y los límites, y la cuarta
            se quedaba sola en una segunda fila.

            Aquí abajo funcionan mejor por dos motivos. Uno: son credenciales de
            LA PERSONA, y pertenecen a la columna de la persona, junto a su foto
            y al logo de su otra empresa. Dos: en 2×2 y pequeñas se escanean de
            un vistazo, que es lo único que se hace con una lista de méritos —
            nadie las lee de corrido.

            Contenido centrado y `text-xs`: en media columna no caben grandes, y
            centradas no dejan el sobrante a la derecha de cada tarjeta. */}
        {
          credenciales.length > 0 && (
            <ul class="mt-4 grid grid-cols-2 gap-3">
              {credenciales.map((c, i) => (
                <li class="rounded-xl border border-line bg-surface-muted p-4 text-center">
                  <Icono
                    nombre={ICONOS[i] ?? "check"}
                    class="mx-auto size-6 text-secondary-600"
                  />
                  <p class="mt-2.5 text-xs font-semibold leading-snug text-pretty text-ink">
                    <T v={c.dato} resaltar />
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Reveal>

    <div>
      <Reveal delay={0.08}>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-ink-brand">
          <T v={copy.instructor.kicker} />
        </p>
        <h2 class="mt-3 text-4xl font-extrabold text-balance text-ink sm:text-5xl">
          {instructor.nombre}
        </h2>
        <p class="mt-2 text-lg font-medium text-ink-brand">
          <T v={instructor.rol} resaltar />
        </p>
        <p class="mt-6 max-w-2xl text-lg text-pretty text-ink-muted">
          <T v={instructor.bio} resaltar />
        </p>
      </Reveal>

      {/* ─── Para que no haya sorpresas ─────────────────────────────────────
          SUBE, y no es solo colocación. Las credenciales se fueron a la columna
          de la foto, así que esto queda pegado a la bio: se lee "quién soy" y
          justo después "y esto es lo que no hago". Ese es el orden en que
          convence — primero la persona, luego sus límites.

          Se rediseñó, no se recortó. Ver la nota de `noCubreTitulo` en el
          config: cuatro aspas ROJAS seguidas se leen como una lista de errores
          del producto, cuando lo que dicen es justo lo contrario —que aquí se
          juega limpio—. Ahora van en una caja tranquila, con un guion neutro en
          vez del aspa y el color de la marca en el título. */}
      <Reveal delay={0.14}>
        <div class="mt-9 rounded-2xl border border-line bg-surface-muted p-6 sm:p-7">
          <div class="flex items-start gap-3">
            <span aria-hidden="true" class="marca-linea text-secondary-600">
              <Icono nombre="escudo" class="size-5" />
            </span>
            <div class="min-w-0">
              <h3 class="text-base font-bold text-ink">
                <T v={copy.instructor.noCubreTitulo} />
              </h3>
              <p class="mt-1 text-sm text-ink-subtle">
                <T v={copy.instructor.noCubreNota} />
              </p>
            </div>
          </div>

          <ul class="mt-5 grid gap-x-10 gap-y-2.5 border-t border-line pt-5 text-sm sm:grid-cols-2">
            {
              noCubre.map((item) => (
                <li class="flex items-start gap-2.5">
                  {/* Un guion, no un aspa: marca el límite sin dramatizarlo. */}
                  <span
                    aria-hidden="true"
                    class="marca-linea text-ink-subtle"
                  >
                    <span class="block h-px w-3 bg-current" />
                  </span>
                  <span class="text-pretty text-ink-muted">
                    <T v={item} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </Reveal>

      {/* Los HECHOS que siguen sin rellenar, aparte y en ámbar. */}
      {
        credencialesPendientes.length > 0 && (
          <Reveal delay={0.2}>
            <ul class="mt-8 grid gap-2 rounded-xl border-2 border-dashed border-line-strong bg-surface-muted p-5 text-sm">
              {credencialesPendientes.map((c) => (
                <li class="text-pretty text-ink-muted">
                  <T v={c.dato} resaltar />
                </li>
              ))}
            </ul>
          </Reveal>
        )
      }

      {
        sinRellenar && (
          <p class="mt-6 rounded-lg border-2 border-dashed border-line-strong bg-surface-muted px-4 py-3 text-sm font-medium text-ink-muted">
            ⚠ <T v={copy.instructor.avisoPlaceholder} />
          </p>
        )
      }
    </div>
  </div>

  {/* ─── La acción ────────────────────────────────────────────────────────
      FUERA de las dos columnas, y ese es todo el arreglo. Dentro de la columna
      de texto los botones heredaban su borde izquierdo, o sea que arrancaban a
      un tercio de la página y quedaban escorados a la derecha: parecían
      colgando en vez de centrados.

      Aquí abajo, a todo el ancho, se centran de verdad respecto a la sección
      entera. Y funcionan mejor: cierran la sección para quien acaba de leer la
      bio Y para quien solo miró la foto y las credenciales.

      Este es el punto en el que se decide si uno se fía de la persona. El botón
      de WhatsApp solo existe si hay número en el config. */}
  <Reveal delay={0.26}>
    <div
      class="mt-12 flex flex-col items-center justify-center gap-3 border-t border-line pt-10 sm:flex-row sm:flex-wrap sm:gap-4"
    >
      <Button
        href={cta.primario.href}
        variant="primary"
        size="lg"
        trackId="instructor"
        class="w-full sm:w-auto"
      >
        <T v={cta.primario.texto} />
      </Button>

      {/* Solo si hay número. Un botón de llamar que no llama es peor que no
          tenerlo: se pulsa, no pasa nada, y se pierde la confianza justo en la
          sección que existe para ganarla. */}
      {
        contacto.telefono && (
          <Button
            href={`tel:${contacto.telefono}`}
            variant="secondary"
            size="lg"
            trackId="instructor-llamada"
            class="w-full sm:w-auto"
          >
            <T v={copy.instructor.llamame} />
          </Button>
        )
      }

      {
        urlWhatsapp && (
          <Button
            href={urlWhatsapp}
            variant="secondary"
            size="lg"
            trackId="instructor-whatsapp"
            class="w-full sm:w-auto"
            target="_blank"
            rel="noopener noreferrer"
          >
            <T v={copy.instructor.whatsapp} />
          </Button>
        )
      }
    </div>
  </Reveal>
</Section>
