---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import LeadForm from "@components/ui/LeadForm";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 03 · LAS GUÍAS — el formulario mínimo
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Dos campos, una casilla y un botón, con una foto que ocupa la otra mitad DE
 * BORDE A BORDE. No es una foto con marco dentro de una columna: es media
 * sección que es imagen, sin radio, sin sombra y sin aire alrededor.
 *
 * ─── LA FOTO SANGRA Y POR ESO LA SECCIÓN NO USA `container-page` ───────────
 *
 * `sinContenedor` en `Section` y el contenedor se pone solo en la mitad del
 * texto. Si la sección trajera su contenedor, la foto tendría el margen de la
 * página a su derecha y dejaría de sangrar, que es justo lo que la hace
 * distinta de las demás.
 *
 * ─── QUÉ SE PROMETE ────────────────────────────────────────────────────────
 *
 * ⚠️ Los artículos del blog y nada más. El reto de siete correos se retiró
 * como imán, así que aquí no se ofrece: prometer una secuencia que ya no es la
 * principal sería vender una cosa y entregar otra. Ver `copy.guias`.
 */

const { guias } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * ⚠️ FOTO PROVISIONAL, Y LA REGLA DE LA CASA DICE OTRA COSA.
 *
 * `public/imagenes/resultados/README.md` lo pone por escrito: nada de stock
 * genérico, y si no hay foto real es mejor no poner ninguna. Las seis que hay
 * en esa carpeta son de banco, y aquí una de ellas ocupa MEDIA SECCIÓN, que es
 * el sitio más visible que se le puede dar a una foto en toda la página.
 *
 * Se queda porque la maqueta se aprobó así y porque sin nada la fila se ve
 * coja, pero es lo primero que hay que cambiar cuando existan fotos de verdad:
 * Pedro trabajando, un Embajador, un momento del Ecosistema. Apaisada y de
 * 2400 px de ancho para arriba, que aquí se ve a tamaño completo.
 *
 * Y si llega el día en que no hay ninguna que valga, esto se pone a `null` y la
 * columna pinta el fondo de marca. Sin huecos y sin cajas rotas.
 *
 * ⚠️ SE REPITE, Y NO HAY FORMA DE QUE NO SE REPITA. Las seis fotos de esa
 * carpeta las usa ya la sección de resultados como fondo de sus tarjetas, así
 * que cualquiera de las seis sale dos veces en la misma página. Se eligió esta
 * porque la 03 es la del hero (repetirla ahí mismo, a tamaño grande y dos
 * pantallas más abajo, sí se nota) y porque las que llevan texto dentro se
 * leen mal recortadas a media sección.
 */
const FOTO: string | null = "/imagenes/resultados/01.webp";
---

<Section id="guias" tono="surface" ritmo="compacto" ariaLabel={guias.aria} sinContenedor>
  <div class="grid items-stretch gap-10 lg:grid-cols-2 lg:gap-0">
    {/* ─── El texto y el formulario ───────────────────────────────────────
        Su propio contenedor, alineado con el resto de la página. La foto de al
        lado no lo lleva: por eso llega hasta el borde. */}
    <div class="container-page flex flex-col justify-center lg:py-20">
      <Reveal>
        <h2 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
          {
            guias.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))
          }
        </h2>

        <p class="mt-4 max-w-md text-base text-pretty text-ink-muted sm:text-lg">
          <T v={guias.texto} />
        </p>

        <div class="mt-8 max-w-md">
          <LeadForm
            client:visible
            lang={lang}
            origen="guias"
            variante="lista"
            cta={guias.cta}
            aviso={guias.aviso}
            exitoTitulo={guias.exitoTitulo}
            exitoTexto={guias.exitoTexto}
          />
        </div>
      </Reveal>
    </div>

    {/* ─── La foto, de borde a borde ──────────────────────────────────────
        `h-full` con `object-cover` y sin radio: la imagen se corta contra el
        borde de la pantalla, que es el recurso de esta sección.

        En móvil no sangra a media pantalla —quedaría una tira rara encima del
        texto— sino que ocupa el ancho completo con una altura fija. */}
    <div class="relative order-first h-64 w-full bg-primary-950 sm:h-80 lg:order-none lg:h-auto">
      {
        FOTO && (
          <img
            src={FOTO}
            alt={guias.foto[lang]}
            data-alt-es={guias.foto.es}
            data-alt-en={guias.foto.en}
            width={800}
            height={600}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover"
          />
        )
      }

      {/* La trama de puntos de la guía de marca. Sin foto es el fondo entero;
          con foto, una textura mínima que la ata al resto de la página. Es la
          misma capa que llevan las tarjetas de resultados. */}
      <div
        aria-hidden="true"
        class:list={[
          "pointer-events-none absolute inset-0",
          FOTO ? "opacity-[0.08]" : "opacity-[0.14]",
        ]}
        style="background-image:radial-gradient(currentColor 1px,transparent 1px);background-size:16px 16px;color:var(--color-secondary-200)"
      >
      </div>
    </div>
  </div>
</Section>
