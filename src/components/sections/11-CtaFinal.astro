---
import { resolverIdiomaServidor } from "@i18n/idioma";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import LeadForm from "@components/ui/LeadForm";
import CintaPrecio from "@components/ui/CintaPrecio.astro";
import { curso, cta, leadMagnet, garantia, copy, contacto } from "@config/curso.config";
import Icono from "@components/ui/Icono.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { construirTxt } from "@i18n/idioma";
import { formatMoney, interpolar } from "@i18n/formato";

/**
 * 11 · CTA FINAL — cerrar sin obligar a subir.
 *
 * Quien llega hasta aquí ha leído la página entera. Se le dan las DOS salidas,
 * en el orden correcto de compromiso:
 *
 *  1. Comprar — el CTA primario, otra vez, para que no tenga que buscar.
 *  2. El email — segunda oportunidad para quien todavía no compra. Sin esto,
 *     todo el que llega al final sin decidirse se pierde del todo.
 *
 * Se recupera la promesa del hero para cerrar el círculo: lo último que se lee
 * es lo mismo que enganchó al principio.
 *
 * Nada de urgencia inventada. Si algún día hay fecha de cierre o plazas reales,
 * este es el sitio donde tienen sentido — pero solo si son verdad. Un contador
 * que se reinicia en cada visita destruye la confianza justo en el cierre.
 */

const checkoutPendiente = curso.precio.urlCheckout === "#";

const { precio } = curso;

/** El precio, formateado por Intl en cada idioma. Ni un "$" a mano. */
const precioActual = construirTxt((l) =>
  formatMoney(precio.actual, l, precio.moneda),
);

const textoCuotas = precio.cuotas
  ? construirTxt((l) =>
      copy.precio.cuotas[l]
        .replace("{n}", String(precio.cuotas.numero))
        .replace("{importe}", formatMoney(precio.cuotas.importe, l, precio.moneda)),
    )
  : null;

/**
 * Las tres razones para no dudar, en la última pantalla.
 *
 * Aquí solo estaba la garantía, en un párrafo suelto. Faltaban las otras dos
 * cosas que frenan en el último momento —"¿y si no me da tiempo?" y "¿tengo que
 * pagarlo de golpe?"— y las tres respuestas ya existen en el config. Puestas en
 * fila y con icono se leen de un vistazo; en prosa, no se leen.
 */
const tranquilidad = [
  ...(garantia.activa
    ? [{ icono: "escudo" as const, texto: garantia.titulo }]
    : []),
  { icono: "infinito" as const, texto: copy.anuncios.acceso },
  ...(precio.cuotas
    ? [
        {
          icono: "actualizar" as const,
          texto: construirTxt((l) =>
            interpolar(copy.anuncios.cuotas[l], {
              cuotas: precio.cuotas.numero,
            }),
          ),
        },
      ]
    : []),
];

/* Idioma de ESTA petición. Las islas de React lo necesitan como prop: en
   el servidor no pueden leerlo del DOM, así que sin esto se renderizarían
   siempre en español aunque la URL pida inglés. */
const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

---

{/* ─── DE FRANJA NAVY A DOS ISLAS SOBRE BLANCO ────────────────────────────────
    Antes de esto fue una sola columna centrada de 1.353 px de alto: el titular
    partido en tres renglones cortos, el precio flotando debajo y, tras un
    filete, el formulario. Después fueron dos columnas, y así estaba: la de
    comprar suelta sobre el azul de la sección y la del mini-curso en una
    tarjeta un poco más clara.

    El problema era el fondo. Con la sección entera en navy, la columna de la
    izquierda no tenía superficie —flotaba sobre el mismo color— y la de la
    derecha era un rectángulo apenas más claro que su fondo: dos bloques que no
    llegaban a ser dos bloques. Y era la última sección que quedaba con el
    tratamiento viejo.

    Ahora el lienzo es blanco y las DOS salidas son islas de verdad, cada una
    con su superficie: navy la de comprar, clara la del mini-curso gratis. El
    contraste dice lo que la sección hace —una cosa se paga y la otra no— sin
    escribirlo, y de paso el azul deja de ser el fondo para volver a ser lo que
    es en el resto de la página: el color de lo importante.

    `items-stretch`: las dos miden lo mismo, como en el precio y en las
    reseñas. */}
<Section id="empezar" tono="surface" ariaLabel={copy.cierre.aria}>
  <div
    class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-10"
  >
    {/* ─── SALIDA 1 · COMPRAR ───────────────────────────────────────────────
        La isla no lleva `Reveal` ella misma y sus dos bloques sí: lo que entra
        escalonado es el contenido, no la superficie. Una tarjeta que aparece
        desplazándose arrastra su sombra y su borde, y eso se ve como un salto,
        no como una entrada. */}
    <div
      class="relative isolate flex flex-col justify-center overflow-hidden rounded-3xl bg-primary-950 p-8 text-center sm:p-10 lg:text-left"
    >
      {/* El isotipo detrás del cierre. Es la última pantalla antes del pie, y
          lo último que conviene que se quede es de quién es el sello que se
          compra. */}
      <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

      <Reveal>
        {/* El distintivo hace dos cosas: da un punto de entrada a la columna
            —sin él, el titular arrancaba en el aire— y dice dónde está el
            visitante. "Último paso" después de una página entera es una
            indicación de sitio, no una frase de venta. */}
        <p class="inline-flex items-center gap-2 rounded-full border border-primary-800 bg-primary-900 px-3 py-1 text-xs font-bold tracking-wide text-secondary-300 uppercase">
          <span aria-hidden="true" class="marca-linea">
            <span class="size-1.5 rounded-full bg-secondary-500"></span>
          </span>
          <T v={copy.cierre.kicker} />
        </p>

        <h2 class="mt-4 text-4xl font-extrabold text-balance text-ink-inverse sm:text-5xl">
          <T v={curso.promesa} />
        </h2>

        {/* SE FUE `promesaApoyo`. Son cinco líneas que el visitante ya ha leído
            palabra por palabra en el hero: repetirlas en el cierre no cierra
            nada, alarga. Lo que sí hace falta aquí es el PRECIO, que hasta
            ahora no aparecía en toda la sección donde se decide pagarlo.

            La cifra y las mensualidades van en la MISMA línea, alineadas por la
            base. Apiladas, el "o 3 pagos de $164" quedaba colgando debajo de un
            número enorme y parecía una nota al pie; al lado, se lee como lo que
            es: la otra forma de pagar lo mismo. */}
        <p class="mt-6 flex flex-wrap items-baseline justify-center gap-x-4 gap-y-1 lg:justify-start">
          <span class="text-5xl font-extrabold tracking-tight text-ink-inverse sm:text-6xl">
            <T v={precioActual} />
          </span>
          {
            textoCuotas && (
              <span class="text-base font-medium text-secondary-200">
                <T v={textoCuotas} />
              </span>
            )
          }
        </p>
      </Reveal>

      <Reveal delay={0.1}>
        {/* La cabecera de este archivo decía: "si algún día hay fecha de cierre
            REAL, este es el sitio donde tiene sentido". Ya la hay, y sale del
            mismo `precio.urgencia.fechaCierre` que las tiras: no hay una
            segunda fecha que se pueda desincronizar. Sin enlace, porque el
            botón que lleva a comprar está tres centímetros más abajo.

            ⚠️ `variante="linea"` y ya no `"panel"`. El panel es un bloque con
            su borde y su radio, y aquí dentro sería una tarjeta dentro de una
            isla: los dos bordes redondeados concéntricos que la página tiene
            prohibidos desde la sección del instructor. La misma frase, sin
            caja, dice exactamente lo mismo. */}
        {/* La tira centra su contenido por dentro (`mx-auto justify-center`),
            que es lo que quiere cuando cruza la página entera. Aquí vive en una
            columna alineada a la izquierda, así que se le desactiva a partir de
            `lg`: una sola línea centrada entre un titular, unos botones y unas
            píldoras alineados a la izquierda se lee como un descuadre. */}
        <CintaPrecio
          variante="linea"
          inverso
          conEnlace={false}
          class="mt-6 lg:[&>span]:mx-0 lg:[&>span]:justify-start"
        />

        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4 lg:justify-start">
          {/* Mientras no haya pasarela, el botón lleva a la sección de precio
              en lugar de a un href="#" que saltaría al inicio de la página. */}
          <Button
            href={checkoutPendiente ? cta.primario.href : curso.precio.urlCheckout}
            variant="primary"
            size="lg"
            sobre="oscuro"
            trackId="cierre"
            class="w-full sm:w-auto"
          >
            <T v={cta.primario.texto} />
          </Button>

          {/* El botón de llamar, aquí también: quien llega al final y no compra
              suele tener UNA duda concreta, y una llamada la resuelve en el
              momento mientras que un correo la enfría. Solo si hay número. */}
          {
            contacto.telefono && (
              <Button
                href={`tel:${contacto.telefono}`}
                variant="inverse"
                size="lg"
                sobre="oscuro"
                trackId="cierre-llamada"
                class="w-full sm:w-auto"
              >
                <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                <T v={copy.instructor.llamame} />
              </Button>
            )
          }
        </div>

        {/* Las tres razones para no dudar, en una línea y con icono. Sustituyen
            al párrafo suelto de la garantía: dicen lo mismo más lo que faltaba
            (que el acceso no caduca y que se puede pagar a plazos), y se leen
            de un vistazo en vez de en una frase.

            Son píldoras, no fichas, y por eso siguen valiendo dentro de la
            isla: lo que la página prohíbe anidar son las tarjetas —bordes
            redondeados concéntricos—, no una etiqueta redonda de una línea.

            `items-start` en cada una y no `items-center`: llevan dentro un
            `marca-linea`, cuyo trabajo es centrar el icono en la PRIMERA línea
            del texto. Con `items-center` esa caja de una interlínea se centraba
            a su vez en la píldora entera, así que en cuanto la frase pasaba a
            dos renglones —cosa que en un teléfono estrecho pasa— el icono
            acababa entre los dos.

            (Y el comentario va AQUÍ y no dentro del `.map()`: un comentario JSX
            suelto al lado del nodo raíz que devuelve una expresión rompe el
            parser de Astro. Mismo caso que la nota de `BandaTestimonios`.) */}
        <ul class="mt-8 flex flex-wrap justify-center gap-2 text-sm lg:justify-start">
          {
            tranquilidad.map((t) => (
              <li class="flex items-start gap-2 rounded-full border border-primary-800 bg-primary-900 px-3.5 py-2 text-secondary-200">
                <span aria-hidden="true" class="marca-linea shrink-0 text-secondary-300">
                  <Icono nombre={t.icono} class="size-4" />
                </span>
                <T v={t.texto} />
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>

    {/* ─── SALIDA 2 · EL MINI-CURSO GRATIS ──────────────────────────────────
        Para quien llega al final y todavía no compra. Sin esto, ese visitante
        se pierde entero.

        La isla es CLARA, y es la única de la página que se apoya en el
        contraste con su pareja: al lado del navy de comprar, el blanco dice
        "esto es lo otro, y no cuesta nada" sin escribirlo. Antes era un azul
        casi igual al del fondo, o sea la alternativa disfrazada de lo mismo.

        Se fue el `sticky`. Acompañaba mientras se leía la columna de al lado, y
        ahora las dos islas miden lo mismo y terminan a la vez: no hay nada que
        acompañar. Y se fue también el halo teal de detrás, que existía para
        despegar la tarjeta del azul; sobre blanco no despega nada, solo
        ensucia. */}
    <Reveal delay={0.16} class="lg:h-full">
      <div
        class="flex h-full flex-col justify-center rounded-3xl border border-line bg-surface p-6 shadow-lg sm:p-8"
      >
        <p class="text-center text-lg font-semibold text-balance text-ink">
          <T v={copy.cierre.dudaTitulo} />
        </p>
        <p class="mt-2 text-center text-base text-pretty text-ink-muted">
          <T v={copy.cierre.dudaTexto} vars={{ formato: leadMagnet.formato }} />
        </p>

        <div class="mt-7">
          <LeadForm
            client:visible lang={lang}
            origen="cierre"
            cta={leadMagnet.cta}
            aviso={leadMagnet.aviso}
            exitoTitulo={leadMagnet.exito.titulo}
            exitoTexto={leadMagnet.exito.texto}
          />
        </div>
      </div>
    </Reveal>
  </div>
</Section>
