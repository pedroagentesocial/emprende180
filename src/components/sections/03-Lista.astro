---
import { getCollection } from "astro:content";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import LeadForm from "@components/ui/LeadForm";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";
import { articulosPublicados, tituloBilingue } from "@lib/blog";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 04 · LA LISTA — el teléfono con los correos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Tarjeta navy de esquinas RECTAS —a diferencia de todo el resto del sitio, y
 * fue una petición explícita— con el texto a un lado y un teléfono al otro en
 * el que pasan los correos en bucle.
 *
 * ─── LOS ASUNTOS SON LOS ARTÍCULOS DE VERDAD ───────────────────────────────
 *
 * ⚠️ ESTO ES LO ÚNICO QUE NO SE PUEDE FALSEAR AQUÍ. La maqueta traía asuntos
 * inventados de ejemplo; aquí se leen de la colección del blog con
 * `getCollection`. Enseñar en un teléfono correos que nadie ha escrito es
 * exactamente la clase de detalle que, si alguien lo comprueba, tira abajo todo
 * lo demás que dice la página.
 *
 * Si algún día hay diez artículos, pasan los seis más recientes y ya está: la
 * lista se corta sola.
 *
 * ─── EL BUCLE ES CSS, NO JAVASCRIPT ────────────────────────────────────────
 *
 * La tira se pinta DOS VECES y la animación la desplaza un -50 % exacto, así
 * que el fotograma en el que reinicia es idéntico al de salida. Es el mismo
 * mecanismo de la banda de testimonios, y por el mismo motivo: lo lleva el
 * compositor y sigue fluido aunque el hilo principal esté ocupado.
 *
 * La copia va `aria-hidden`: para quien escucha, los artículos son los que son,
 * no el doble.
 *
 * ─── EN EL TELÉFONO, EL TELÉFONO VA PRIMERO ────────────────────────────────
 *
 * `order` invertido por debajo de `lg`. El mockup explica de un vistazo qué es
 * esto —correos— y el texto tarda tres renglones en decir lo mismo.
 */

const { lista } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Los seis últimos publicados, con la MISMA regla que el listado y que la
   página del artículo: borradores fuera y fechas futuras fuera. Esta sección
   la tenía copiada a mano; ahora llama a la función compartida, que es donde
   esa regla tiene que vivir una sola vez. */
const articulos = (await articulosPublicados(getCollection)).slice(0, 6);

/* Sin artículos publicados no hay teléfono que enseñar: la sección se queda
   con su texto y su formulario, que es lo que de verdad hace falta. */
const hayArticulos = articulos.length > 0;
---

<Section id="lista" tono="muted" ariaLabel={lista.aria} sinContenedor>
  <div class="container-page">
  {/* Las esquinas estuvieron RECTAS a propósito durante un tiempo: era la
      única tarjeta de la página sin radio y se pidió así. Se ha pedido lo
      contrario después, así que vuelve al `rounded-3xl` del resto del sitio y
      deja de ser la excepción. */}
  <div class="relative isolate overflow-hidden rounded-3xl bg-primary-950">
    <div class="grid items-center gap-10 p-8 sm:p-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:p-16">
      {/* ─── El texto ─────────────────────────────────────────────────────
          Centrado, y con una entrada que lo trae desde un poco más pequeño.
          Es la única animación de entrada de la sección: si se moviera también
          el teléfono, competirían. */}
      {/* ⚠️ CENTRADO, Y ANTES IBA A LA IZQUIERDA EN ESCRITORIO. El motivo de
          entonces era que un titular centrado al lado de un teléfono deja el
          eje de lectura partido en dos. Se ha pedido centrarlo y aquí sale
          bien porque el texto vive en su propia mitad: lo que se centra es una
          columna, no una línea suelta en una pantalla vacía.

          Los párrafos llevan `mx-auto` porque conservan su medida: sin él, una
          caja con `max-w` dentro de un contenedor centrado se queda pegada a
          la izquierda y el texto se ve centrado DENTRO de un bloque
          descentrado. */}
      <div class="order-2 text-center lg:order-1">
        <p class="mb-3 text-sm font-semibold text-secondary-300">
          <T v={lista.kicker} />
        </p>

        <h2
          data-entrada
          class="text-3xl font-extrabold text-balance text-ink-inverse sm:text-4xl lg:text-5xl"
        >
          {
            lista.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} tono="inverso" />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))
          }
        </h2>

        <p class="mx-auto mt-4 max-w-md text-lg font-medium text-pretty text-secondary-100 sm:text-xl">
          <T v={lista.texto} />
        </p>

        <p class="mt-3 text-lg font-bold text-ink-inverse sm:text-xl">
          <T v={lista.remate} />
        </p>

        {/* Los dos campos en una fila, no uno debajo del otro: el brief pedía
            que el formulario se leyera como una franja y no como una columna.
            El botón sí baja a su renglón. Tres cosas en fila dentro de media
            tarjeta dejan tres cajas de 160 px, y ahí ya no cabe ni el
            marcador de posición. */}
        <div class="mx-auto mt-8 max-w-xl">
          <LeadForm
            client:visible
            lang={lang}
            origen="lista"
            variante="lista"
            compacto
            sinEtiquetas
            cta={lista.cta}
            aviso={lista.aviso}
            exitoTitulo={lista.exitoTitulo}
            exitoTexto={lista.exitoTexto}
            tono="inverso"
          />
        </div>
      </div>

      {/* ─── LA TABLET Y EL TELÉFONO ─────────────────────────────────────
          Dos marcos dibujados con CSS, no fotos de un iPad y un iPhone: pesan
          cero, se ven nítidos en cualquier pantalla y no atan la marca a dos
          modelos concretos que dentro de dos años se vean viejos.

          ⚠️ LA TABLET NO SALE EN EL TELÉFONO DEL VISITANTE, y es una cuenta, no
          un descarte estético. Los dos juntos miden unos 480 px contando el
          solape; dentro de la tarjeta, a 375 px de pantalla y con su `p-8`,
          quedan 269 px útiles. No es que se vea apretado: se sale. Desde `sm`
          hay 602 px y entran los dos.

          ⚠️ Y LA TABLET VA `aria-hidden`, NO CON SU PROPIO RÓTULO. Enseña la
          misma lista que el teléfono, que ya se anuncia con `role="img"` y su
          descripción: dos rótulos para la misma cosa obligan a quien navega a
          ciegas a escuchar dos veces lo mismo sin ganar nada. */}
      {
        hayArticulos && (
          <div class="order-1 flex justify-center lg:order-2">
            <div class="relative flex items-end justify-center">
              {/* ─── LA TABLET ───────────────────────────────────────────
                  Más alta y más ancha, con el radio y el marco más finos EN
                  PROPORCIÓN: es eso, y no el tamaño, lo que distingue de un
                  vistazo una tablet de un teléfono grande. Va DETRÁS. */}
              <div
                aria-hidden="true"
                class="relative hidden h-[27rem] w-[20rem] shrink-0 overflow-hidden rounded-[1.5rem] border-[0.5rem] border-primary-800 bg-primary-900 shadow-2xl sm:block"
              >
                {/* La cámara va arriba y centrada, que es donde la lleva una
                    tablet en vertical. Redonda y pequeña, no la muesca ancha
                    del teléfono. */}
                <span
                  aria-hidden="true"
                  class="absolute top-2.5 left-1/2 z-10 size-1.5 -translate-x-1/2 rounded-full bg-primary-800"
                />

                {/* Su propia `data-pista`: la misma animación, pero como la
                    columna es más ancha los correos ocupan menos alto y la tira
                    avanza a otro ritmo. Que las dos NO vayan sincronizadas es
                    lo que evita que se lean como una pantalla clonada. */}
                <div data-pista class="flex flex-col gap-2.5 p-4 pt-9">
                  {[0, 1].map((copia) =>
                    articulos.map((a) => (
                      <article
                        aria-hidden={copia === 1 ? "true" : undefined}
                        class="flex shrink-0 items-start gap-3 rounded-xl bg-primary-950/70 p-3"
                      >
                        <span
                          aria-hidden="true"
                          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg bg-secondary-500 text-xs font-extrabold text-primary-950"
                        >
                          E1
                        </span>
                        <span class="min-w-0">
                          <span class="block text-[0.8125rem] font-bold tracking-wide text-secondary-300 uppercase">
                            <T v={lista.remitente} />
                          </span>
                          {/* Por `<T>` y no como texto plano: si no, con la web
                              en inglés los asuntos eran lo único de la sección
                              que seguía en español. Ver `tituloBilingue`. */}
                          <span class="mt-0.5 block text-[0.8125rem] leading-snug text-pretty text-secondary-100">
                            <T v={tituloBilingue(a)} />
                          </span>
                        </span>
                      </article>
                    )),
                  )}
                </div>

                {/* El degradado de arriba y el de abajo: sin ellos, los correos
                    aparecen y desaparecen de golpe contra el borde del marco. */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-primary-900 to-transparent"
                />
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-primary-900 to-transparent"
                />
              </div>

              {/* ─── EL TELÉFONO ─────────────────────────────────────────
                  Delante y montado sobre la esquina de la tablet. El `-ml` es
                  el solape y el `-mb` lo baja un punto: dos aparatos con la
                  base a la misma altura se leen como un escaparate de tienda.

                  ⚠️ EL ANILLO ES DEL COLOR DEL FONDO DE LA TARJETA, no del
                  marco. Es lo único que separa un aparato del otro donde se
                  montan: sin él se ven dos rectángulos pegados y no uno delante
                  del otro. Mismo recurso que el filete de las fotos que se
                  solapan en identidad y en el cierre. */}
              <div
                class="relative z-10 h-[30rem] w-[15rem] shrink-0 overflow-hidden rounded-[2.5rem] border-[0.6rem] border-primary-800 bg-primary-900 shadow-2xl sm:-mb-8 sm:-ml-24 sm:ring-4 sm:ring-primary-950"
                role="img"
                aria-label={lista.telefonoAlt[lang]}
                data-aria-es={lista.telefonoAlt.es}
                data-aria-en={lista.telefonoAlt.en}
              >
                {/* La muesca de arriba. Decorativa y ya está. */}
                <span
                  aria-hidden="true"
                  class="absolute top-2 left-1/2 z-10 h-1.5 w-16 -translate-x-1/2 rounded-full bg-primary-800"
                />

                <div data-pista class="flex flex-col gap-3 p-3 pt-8">
                  {[0, 1].map((copia) =>
                    articulos.map((a) => (
                      <article
                        aria-hidden={copia === 1 ? "true" : undefined}
                        class="flex shrink-0 items-start gap-3 rounded-xl bg-primary-950/70 p-3"
                      >
                        <span
                          aria-hidden="true"
                          class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg bg-secondary-500 text-xs font-extrabold text-primary-950"
                        >
                          E1
                        </span>
                        <span class="min-w-0">
                          <span class="block text-[0.8125rem] font-bold tracking-wide text-secondary-300 uppercase">
                            <T v={lista.remitente} />
                          </span>
                          {/* Por `<T>` y no como texto plano: si no, con la web
                              en inglés los asuntos eran lo único de la sección
                              que seguía en español. Ver `tituloBilingue`. */}
                          <span class="mt-0.5 block text-xs leading-snug text-pretty text-secondary-100">
                            <T v={tituloBilingue(a)} />
                          </span>
                        </span>
                      </article>
                    )),
                  )}
                </div>

                {/* El degradado de arriba y el de abajo: sin ellos, los correos
                    aparecen y desaparecen de golpe contra el borde del marco. */}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-primary-900 to-transparent"
                />
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-primary-900 to-transparent"
                />
              </div>
            </div>
          </div>
        )
      }
      </div>
    </div>
  </div>
</Section>

<style>
  /* La tira sube sin parar. La lista está duplicada, así que al llegar al -50 %
     el fotograma es idéntico al inicial y no se ve la costura. */
  @keyframes lista-subir {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  [data-pista] {
    animation: lista-subir 24s linear infinite;
  }

  /* La entrada del titular: aparece y crece un punto. Nada más. */
  @keyframes lista-entrar {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-entrada] {
    animation: lista-entrar 700ms var(--ease-out-soft) both;
  }

  /* ⚠️ Quien pide menos movimiento no ve NADA de esto: ni el bucle ni la
     entrada. Los correos se quedan quietos y legibles, que es lo que importa. */
  @media (prefers-reduced-motion: reduce) {
    [data-pista],
    [data-entrada] {
      animation: none;
    }
  }
</style>
