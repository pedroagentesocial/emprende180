---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { leadMagnet, copy, cta } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 04 · PRIMERA CAPTURA DE LEAD — pronto, a propósito
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Va aquí y no al final porque a estas alturas el lector ya se ha reconocido en
 * el problema (sección 2) y ha visto qué se lleva (sección 3): está en el punto
 * más caliente de la página. Esperar a la sección 11 significa perder a todo el
 * que se va antes de llegar, que son la mayoría.
 *
 * El imán es un MINI-CURSO POR EMAIL, no un PDF. Un PDF se descarga y se olvida
 * el mismo día; una secuencia de 7 correos crea el hábito de abrirte, y quien
 * lleva 7 días leyéndote llega al precio ya convencido.
 *
 * ─── POR QUÉ SE REHÍZO, Y POR QUÉ NO COMO LAS OTRAS ────────────────────────
 *
 * Tenía los siete días con su título Y su párrafo completo: unas 210 palabras
 * en fila para pedir un email. Demasiado.
 *
 * Pero la solución NO podía ser la de las secciones 02 y 03. Si el temario, los
 * dolores, los resultados y el mini-curso son todos la misma rejilla que se
 * despliega al pasar el cursor, el mecanismo deja de ser un recurso y pasa a
 * ser un tic: el visitante baja por cuatro bloques que se leen igual y empieza
 * a sospechar que se le esconde algo en todos.
 *
 * Así que aquí el mecanismo es otro, y sale del propio producto: son SIETE DÍAS
 * EN ORDEN, o sea una línea de tiempo. El raíl la dibuja literalmente —
 * horizontal en escritorio, vertical en móvil — y cada día enseña solo su
 * título de tres palabras.
 *
 * ─── UNA MUESTRA EN LUGAR DE SIETE ─────────────────────────────────────────
 *
 * El contenido completo se enseña de UN día, el primero, en una tarjeta aparte.
 * Lo que convence no es leer los siete: es comprobar que el primero entrega
 * algo concreto de verdad. Si el día 1 es real, los otros seis se dan por
 * buenos. Y es el único que el visitante puede verificar mañana.
 *
 * De ~210 palabras a ~60, sin quitar ni un día del programa y sin esconder
 * nada detrás de un gesto: aquí no hay hover, todo lo que hay está a la vista.
 *
 * Los `entrega` de los otros seis siguen en `leadMagnet.dias`, porque son el
 * guion de los correos. Que no se pinten no significa que sobren.
 */

const dias = leadMagnet.dias;
const primerDia = dias[0]!;
---

<Section id="gratis" tono="surface" ariaLabel={copy.captura.aria}>
  {/* ─── DE FRANJA NAVY A LIENZO BLANCO CON UNA ISLA ───────────────────────
      Esta sección era una franja navy entera con la cabecera centrada encima
      de dos tarjetas. Ahora el fondo es claro y el navy se concentra en UNA
      isla: el texto a un lado, la oferta al otro.

      Lo que se gana no es solo aire. En la franja, todo era navy —la cabecera,
      la muestra, el formulario, el raíl— así que nada destacaba sobre nada. Con
      el fondo claro, el único bloque oscuro de la sección es exactamente aquel
      en el que hay que actuar, y el ojo va ahí solo.

      ⚠️ LA CINTA DE PRECIO DE ARRIBA NO SE TOCA. Sigue siendo navy y sigue
      moviéndose: es una franja de paso, no parte de esta sección, y el corte de
      color entre ella y el blanco de aquí es justo lo que la separa. */}
  {/* `items-start` y no `items-center`: centrada, la isla quedaba flotando a
      media altura de una columna de texto mucho más alta, sin apoyarse en nada.
      Arrancando las dos a la misma línea, el titular y la acción se leen como
      un par. */}
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
    {/* ─── EL LADO DEL TEXTO ──────────────────────────────────────────────
        A la izquierda y sin centrar. Antes iba centrado a todo el ancho porque
        estaba encima de las dos tarjetas; ahora que es una columna, centrarlo
        obligaría al ojo a buscar el principio de cada línea. */}
    <Reveal>
      <div>
        <p class="text-xs font-bold tracking-[0.16em] text-ink-brand uppercase">
          <T v={copy.captura.kicker} />
        </p>
        <h2 class="mt-3 text-3xl font-bold text-balance text-ink sm:text-4xl">
          <T v={leadMagnet.nombre} />
        </h2>
        <p class="mt-4 max-w-xl text-lg text-pretty text-ink-muted">
          <T v={leadMagnet.promesa} />
        </p>

        {/* LA MUESTRA. Un solo día, entero, para que se vea que el contenido
            es específico y no un folleto.

            Se queda en el lado del texto y SIN caja propia: es contenido para
            leer, no una acción. Metida en la isla navy habría hecho falta una
            caja dentro de otra caja, que es lo que no se hace. Aquí la separa
            una raya y el número del día, que basta. */}
        <div class="mt-8 border-t border-line pt-6">
          <p class="flex items-center gap-2.5 text-xs font-bold tracking-[0.12em] text-ink-subtle uppercase">
            <span
              aria-hidden="true"
              class="grid size-6 shrink-0 place-items-center rounded-full bg-secondary-500 text-[0.7rem] font-extrabold text-ink-inverse"
            >
              {primerDia.dia}
            </span>
            <T v={copy.captura.muestraTitulo} />
          </p>

          <p class="mt-4 text-2xl font-bold text-balance text-ink">
            <T v={primerDia.titulo} />
          </p>
          <p class="mt-2 max-w-xl text-base text-pretty text-ink-muted">
            <T v={primerDia.entrega} />
          </p>
        </div>
      </div>
    </Reveal>

    {/* ─── LA ISLA DE LA ACCIÓN ───────────────────────────────────────────
        Navy, el color que tenía la sección entera, ahora concentrado donde se
        pulsa. Sin tarjetas dentro: lo que antes eran dos cajas navy sobre navy
        (que apenas se distinguían del fondo) es ahora una sola isla sobre
        blanco, que se ve desde el otro lado de la pantalla. */}
    <Reveal delay={0.1}>
      <div
        class="relative isolate overflow-hidden rounded-3xl bg-primary-900 p-8 text-center sm:p-10"
      >
        <MarcaAgua posicion="derecha" class="opacity-[0.07]" />

        <h3 class="text-2xl font-bold text-balance text-ink-inverse">
          <T v={leadMagnet.titularFormulario} />
        </h3>
        <p class="mt-2 text-sm text-secondary-200">
          <T v={leadMagnet.formato} />
        </p>

        <div class="mt-7">
          <Button
            href={cta.secundario.href}
            variant="primary"
            size="lg"
            trackId="captura"
            block
          >
            <T v={cta.secundario.texto} />
          </Button>
        </div>

        {/* 13 px en móvil. Es letra pequeña, sí, pero es la que dice "sin spam
            y te das de baja en un clic": lo que hay que leer justo antes de
            dejar el correo. A 12 px sobre navy, en un teléfono, no se lee. */}
        <p class="mt-3 text-[0.8125rem] text-secondary-200 sm:text-xs">
          <T v={leadMagnet.aviso} />
        </p>
      </div>
    </Reveal>
  </div>

  {/* ─── EL RAÍL DE LOS SIETE DÍAS ──────────────────────────────────────────
      Ancho completo, por debajo de las dos columnas: una línea de tiempo
      necesita recorrido, y en media columna no lo tiene.

      En escritorio son siete columnas con la línea pasando por detrás de los
      números. En móvil el mismo raíl gira: la línea baja por la izquierda y los
      días se apilan. Es el MISMO marcado en los dos casos, sin duplicar nada:
      lo único que cambia es la dirección del flex y de dónde cuelga la línea. */}
  <div class="mt-14 border-t border-line pt-10 lg:mt-20">
    <Reveal>
      <h3
        class="text-xs font-bold tracking-[0.16em] text-ink-subtle uppercase"
      >
        <T v={copy.captura.railTitulo} />
      </h3>
    </Reveal>

    <ol class="mt-7 flex flex-col gap-y-1 sm:flex-row sm:gap-x-2">
      {
        dias.map((d, i) => (
          <Reveal as="li" delay={i * 0.05} class="relative flex-1">
            {/* La línea que une los días. `absolute` para que no ocupe sitio, y
                recortada en los extremos (`first`/`last`) para que el raíl no
                sobresalga por delante del día 1 ni por detrás del 7. */}
            <span
              aria-hidden="true"
              class:list={[
                "pointer-events-none absolute bg-line",
                // Móvil: vertical, pegada a la izquierda, a la altura del número.
                "left-[0.6875rem] top-0 h-full w-px",
                i === 0 && "top-[0.6875rem] h-[calc(100%-0.6875rem)]",
                i === dias.length - 1 && "h-[0.6875rem]",
                // Escritorio: horizontal, centrada en la fila de números.
                "sm:left-0 sm:top-[0.6875rem] sm:h-px sm:w-full",
                i === 0 && "sm:left-1/2 sm:w-1/2",
                i === dias.length - 1 && "sm:w-1/2",
              ]}
            />

            <div class="relative flex items-start gap-3 pb-4 sm:block sm:pb-0">
              <span
                aria-hidden="true"
                class="grid size-[1.375rem] shrink-0 place-items-center rounded-full bg-secondary-50 text-[0.65rem] font-extrabold text-secondary-700 ring-2 ring-secondary-200"
              >
                {d.dia}
              </span>
              <p class="text-sm font-semibold text-balance text-ink sm:mt-3 sm:pr-3">
                <T v={d.titulo} />
              </p>
            </div>
          </Reveal>
        ))
      }
    </ol>
  </div>
</Section>
