---
import Button from "@components/ui/Button.astro";
import Reveal from "@components/motion/Reveal.astro";
import HeroVideo from "@components/ui/HeroVideo";
import HeroVisual from "@components/ui/HeroVisual.astro";
import T from "@components/i18n/T.astro";
import { curso, cta, cifras, sitio, copy } from "@config/curso.config";
import { heroVideo, portadaCurso } from "@lib/assets";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import { formatNumber, interpolar } from "@i18n/formato";

/**
 * 01 · HERO — relevancia en 8 segundos.
 *
 * QUÉ consigue, PARA QUIÉN es y QUÉ hacer ahora. Un solo CTA visible.
 *
 * El CTA lleva al mini-curso GRATIS, no a comprar: quien lleva ocho segundos
 * en la página no está listo para pagar. La compra se pide en la sección 9.
 *
 * El visual es el LCP: nada de `loading="lazy"` aquí.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/** "Para ti si…" en minúscula inicial, en cada idioma. */
const primerPerfil = curso.paraQuien[0]!;
const paraQuien = construirTxt(
  (l) => primerPerfil[l].charAt(0).toLowerCase() + primerPerfil[l].slice(1),
);

/** Los números también se localizan: el separador de miles es del locale. */
const pruebaSocial = construirTxt((l) =>
  interpolar(copy.hero.pruebaSocial[l], {
    alumnos: formatNumber(cifras.alumnos, l),
    nota: cifras.valoracionMedia,
    n: formatNumber(cifras.numeroValoraciones, l),
  }),
);
---

<section id="inicio" class="relative scroll-mt-20 overflow-hidden bg-surface">
  <div class="container-page py-12 sm:py-20 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div>
        <Reveal>
          <p
            class="inline-flex items-center gap-2 rounded-full bg-secondary-100 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-secondary-700"
          >
            <T v={sitio.claim} />
          </p>
        </Reveal>

        <Reveal delay={0.08}>
          {/* `text-hero` va de 2.25 a 4.5rem: el h1 de una landing de marca
              tiene permiso para ser grande. Es la única línea que todos leen. */}
          <h1 class="mt-5 text-hero font-extrabold text-balance text-ink">
            <T v={curso.promesa} />
          </h1>
        </Reveal>

        <Reveal delay={0.16}>
          <p class="mt-5 max-w-xl text-lg text-pretty text-ink-muted sm:text-xl">
            <T v={curso.promesaApoyo} />
          </p>
        </Reveal>

        <Reveal delay={0.24}>
          <div class="mt-8">
            <!-- UN solo CTA. Va al mini-curso gratis, no a comprar. -->
            <Button
              href={cta.secundario.href}
              variant="primary"
              size="lg"
              trackId="hero"
              class="w-full sm:w-auto"
            >
              <T v={cta.secundario.texto} />
            </Button>

            <p class="mt-3 text-sm text-ink-subtle">
              <T v={copy.hero.microCta} />
              <span aria-hidden="true">·</span>
              <T v={curso.formato.idioma} />
              <span aria-hidden="true">·</span>
              <T v={curso.formato.nivel} />
            </p>
          </div>
        </Reveal>

        <!-- "Para quién es", en una línea. Cualifica sin ocupar pantalla. -->
        <Reveal delay={0.32}>
          <div class="mt-8 flex items-start gap-3 border-l-2 border-secondary-500 pl-4">
            <p class="text-base text-ink-muted">
              <span class="font-semibold text-ink"><T v={copy.hero.paraTiSi} /></span>
              {" "}<T v={paraQuien} />.
            </p>
          </div>
        </Reveal>

        {
          cifras.sonReales && (
            <Reveal delay={0.4}>
              <p class="mt-6 text-sm font-medium text-ink-muted">
                <T v={pruebaSocial} />
              </p>
            </Reveal>
          )
        }
      </div>

      <!-- Vídeo si existe, si no el mockup del curso -->
      <Reveal delay={0.12}>
        {
          heroVideo.disponible ? (
            <HeroVideo
              client:load
              webm={heroVideo.webm!}
              mp4={heroVideo.mp4!}
              poster={heroVideo.poster}
            />
          ) : portadaCurso ? (
            /* El LCP de la página: sin lazy-load, con prioridad alta y con
               dimensiones fijas para que no salte el layout al cargar. */
            <img
              src={portadaCurso}
              alt={curso.subtitulo[lang]}
              data-alt-es={curso.subtitulo.es}
              data-alt-en={curso.subtitulo.en}
              width="1200"
              height="900"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
            />
          ) : (
            <HeroVisual />
          )
        }
      </Reveal>
    </div>
  </div>
</section>
