---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Reveal from "@components/motion/Reveal.astro";
import BandaTestimonios from "@components/motion/BandaTestimonios.astro";
import Estrellas from "@components/ui/Estrellas.astro";
import MarcaGoogle from "@components/ui/MarcaGoogle.astro";
import { testimonios, cifras, copy, curso, garantia } from "@config/curso.config";
/* En su propio módulo, y no dentro de `curso.config`, para que Rollup pueda
   descartarlo entero del build de producción: allí `import.meta.env.DEV` se
   pliega a `false` al compilar, la referencia desaparece y con ella el import.
   Que las seis citas de maquetación ni siquiera existan en el servidor
   publicado es más garantía que cualquier aviso en pantalla. */
import { testimoniosMuestra } from "@config/testimonios.muestra";
import { construirTxt } from "@i18n/idioma";
import { faltaPorRellenar } from "@lib/pendientes";
import { formatNumber, formatMoney, formatNota, interpolar } from "@i18n/formato";

/**
 * 07 · PRUEBA SOCIAL — «¿le funciona a gente como yo?»
 *
 * El instructor ya dijo que funciona; aquí lo dicen terceros, que es lo que
 * pesa de verdad. Y lo que convierte no son los elogios ("muy buen curso, lo
 * recomiendo") sino los RESULTADOS con contexto: de dónde partía esa persona y
 * a dónde llegó. El lector busca a alguien que empezaba donde empieza él.
 *
 * ⚠ CERO TESTIMONIOS INVENTADOS EN PRODUCCIÓN.
 *
 * LA SECCIÓN TIENE TRES ESTADOS Y ELIGE SOLA
 * ──────────────────────────────────────────
 *   1. `testimonios` con citas reales  → carrusel con esas citas. Publicado.
 *   2. Sin citas reales, en desarrollo → carrusel con `testimoniosMuestra`,
 *      seis tarjetas de maquetación. Sirve para ver y ajustar el carrusel sin
 *      esperar a tener alumnos. NO se publica.
 *
 *      Sin cartel de "solo en desarrollo" encima: la garantía de que esas seis
 *      citas no se publican no es un aviso que alguien tenga que leer, es que
 *      `import.meta.env.DEV` las deja fuera del bundle. El cartel solo ensuciaba
 *      la vista previa de una página que tiene que poder enseñarse.
 *   3. Sin citas reales, publicado     → el bloque "todavía no hay
 *      testimonios", que dice la verdad y la convierte en el argumento del
 *      precio de lanzamiento.
 *
 * El estado 3 existe porque las dos alternativas son peores: dejar tarjetas
 * vacías con `[COMPLETAR:]` a la vista deja la página a medio hacer justo donde
 * el lector decide si se fía, e inventarse las citas es publicidad engañosa
 * (FTC 16 CFR 465 en EE. UU., PROFECO en México) además de notarse.
 *
 * La frontera entre el 2 y el 3 es `import.meta.env.DEV`, que se evalúa al
 * compilar: las tarjetas de muestra ni siquiera llegan al bundle de producción.
 * No depende de que nadie se acuerde de quitar nada.
 */

/* Esta sección ya no necesita saber el idioma de la petición: la banda de
   testimonios es Astro puro y todo su texto pasa por `<T>`. Lo necesitaba el
   carrusel de React, que era una isla y no podía leerlo del DOM en el
   servidor. */

/* Basta con que UNO de los dos idiomas siga en placeholder para dar la sección
   por vacía: publicar con el español real y el inglés sin traducir es justo el
   fallo que esta comprobación existe para evitar. */
const hayReales = !testimonios.some((x) => faltaPorRellenar(x.cita));

/* `import.meta.env.DEV` va PRIMERO y literal, no a través de una variable. Vite
   lo sustituye por `false` al compilar, así que en producción queda
   `false ? … : []`, que Rollup sí pliega. Escrito al revés
   (`!hayReales && import.meta.env.DEV`) no lo plegaba, y las seis citas de
   muestra acababan dentro de la función del servidor: muertas y sin poder
   renderizarse, pero ahí. */
const lista = hayReales
  ? testimonios
  : import.meta.env.DEV
    ? testimoniosMuestra
    : [];

/**
 * ─── LA NOTA MEDIA SE CUENTA, NO SE ESCRIBE ─────────────────────────────────
 *
 * Sale de las `estrellas` de las reseñas que se están enseñando, sumadas y
 * divididas aquí mismo. Eso importa por dos motivos:
 *
 *   · NO PUEDE DESCUADRAR. Un "4.9" escrito a mano en `cifras` se queda viejo en
 *     cuanto alguien añade o quita una reseña, y entonces la cabecera dice una
 *     cosa y las tarjetas de debajo otra. Aquí la cifra y las tarjetas son el
 *     mismo dato: quien no se la crea puede contar las estrellas y le sale.
 *   · ES LA ÚNICA VERSIÓN QUE SE PUEDE SOSTENER. La nota de la cabecera es una
 *     afirmación sobre lo que opinan los alumnos. Calculada, es verdad por
 *     construcción; escrita a mano, es una cifra que alguien decidió.
 *
 * `cifras.valoracionMedia` sigue existiendo como respaldo para el día en que
 * haya un agregado de verdad (cientos de valoraciones de las que solo se
 * publican seis). Mientras las reseñas traigan su puntuación, manda el recuento.
 */
const estrelladas = lista.filter((t) => typeof t.estrellas === "number");
const hayEstrellas = estrelladas.length > 0;

const notaMedia = hayEstrellas
  ? estrelladas.reduce((s, t) => s + (t.estrellas ?? 0), 0) / estrelladas.length
  : cifras.valoracionMedia;

const numResenas = hayEstrellas ? estrelladas.length : cifras.numeroValoraciones;

/* Con cero reseñas no hay resumen que pintar, y sin estrellas solo se pinta si
   `cifras` está declarado verificable. Nunca un "0 de 5 en 0". */
const hayResumen = numResenas > 0 && (hayEstrellas || cifras.sonReales);

/* Los números también se localizan: el separador de miles lo decide el locale,
   no un `toLocaleString("es")` fijo que dejaba la cifra en español aunque la
   página estuviera en inglés. */
const numAlumnos = construirTxt((l) => formatNumber(cifras.alumnos, l));

/**
 * ¿Se puede pintar la insignia de Google en el resumen?
 *
 * Solo si TODAS las reseñas que se están enseñando salen de Google Y llevan el
 * enlace a la reseña publicada. Basta con que una no lo cumpla para que el
 * resumen deje de decir "reseñas de Google": la insignia habla de la lista
 * entera, así que o vale para todas o miente sobre alguna.
 *
 * `lista.length > 0` va en la condición porque `every()` sobre un array vacío
 * devuelve `true`, y eso pondría el logotipo de Google encima de cero reseñas.
 */
const todasEnGoogle =
  lista.length > 0 && lista.every((t) => t.fuente === "google" && !!t.url);

/** "4.8 de 5 en 37 reseñas de Google" */
const resumenReseñas = construirTxt((l) =>
  interpolar(copy.pruebaSocial.resumenGoogle[l], {
    nota: formatNota(notaMedia, l),
    n: formatNumber(numResenas, l),
  }),
);

/** La misma frase sin nombrar a Google, para reseñas recogidas en directo. */
const resumenSinFuente = construirTxt((l) =>
  interpolar(copy.pruebaSocial.resumenDirecto[l], {
    nota: formatNota(notaMedia, l),
    n: formatNumber(numResenas, l),
  }),
);

/* ── Estado "todavía no hay testimonios" ───────────────────────────────────
   Los tres puntos citan cifras que ya viven en el config (precio, garantía,
   número de videos). Se interpolan en vez de escribirse a mano para que no
   puedan quedarse desfasadas: si mañana el precio cambia, este texto cambia
   con él. Es el mismo motivo por el que la sección 09 verifica su desglose. */
const fundador = copy.pruebaSocial.fundador;

const puntos = fundador.puntos.map((p) => ({
  titulo: p.titulo,
  texto: construirTxt((l) =>
    interpolar(p.texto[l], {
      actual: formatMoney(curso.precio.actual, l, curso.precio.moneda),
      referencia: formatMoney(curso.precio.referencia, l, curso.precio.moneda),
      dias: garantia.dias,
      videos: curso.formato.videos,
    }),
  ),
}));
---

{/* `sinContenedor`: la banda tiene que cruzar de borde a borde, así que la
    sección suelta su `container-page` y cada bloque de dentro pone el suyo. */}
<Section
  id="testimonios"
  tono="muted"
  ariaLabel={copy.pruebaSocial.aria}
  sinContenedor={lista.length > 0}
>
  {
    lista.length > 0 ? (
      <>
        <div class="container-page">
          <SectionHeading align="center" class="mx-auto" titulo={copy.pruebaSocial.titulo} />
        </div>

        {/* ─── EL RESUMEN DE LA PUNTUACIÓN ───────────────────────────────────
            Va antes de la banda porque responde la pregunta de la sección de un
            vistazo: cuántos, qué nota y dónde se puede comprobar. Quien no lea
            ni una cita se lleva eso.

            LA NOTA VA ESCRITA, no solo dibujada. Las estrellas son el atajo
            visual; la cifra al lado es lo que lee un lector de pantalla y lo que
            hace que la fila ámbar no tenga que pasar ningún umbral de contraste
            para que la sección se entienda.

            LA INSIGNIA DE GOOGLE SOLO SI LAS RESEÑAS SON DE GOOGLE Y TIENEN
            ENLACE. `resenasGoogle` lo comprueba arriba, testimonio a testimonio.
            Sobre citas recogidas por WhatsApp la insignia sería una credencial
            prestada que nadie puede ir a verificar; ver `MarcaGoogle.astro`. */}
        {hayResumen && (
          <Reveal class="container-page block">
            <div class="mx-auto mt-10 flex max-w-2xl flex-col items-center gap-4 rounded-2xl border border-line bg-surface px-6 py-6 sm:flex-row sm:justify-center sm:gap-7 sm:py-5">
              <div class="flex flex-col items-center gap-1.5 sm:items-start">
                <Estrellas valor={notaMedia} tamano="md" sinTexto />
                <p class="text-sm text-pretty text-ink-muted">
                  {todasEnGoogle ? (
                    <T v={resumenReseñas} />
                  ) : (
                    <T v={resumenSinFuente} />
                  )}
                </p>
              </div>

              {todasEnGoogle && (
                <MarcaGoogle class="size-8 shrink-0 sm:order-first" />
              )}

              {cifras.sonReales && cifras.alumnos > 0 && (
                <span
                  aria-hidden="true"
                  class="h-px w-16 bg-line sm:h-10 sm:w-px"
                />
              )}

              {cifras.sonReales && cifras.alumnos > 0 && (
                <p class="text-center text-sm text-ink-muted sm:text-left">
                  <span class="font-bold text-ink">
                    <T v={numAlumnos} />
                  </span>{" "}
                  <T v={copy.pruebaSocial.etiquetaAlumnos} />
                </p>
              )}
            </div>
          </Reveal>
        )}

        {/* La banda va FUERA de `Reveal`: el fundido de entrada empieza con el
            bloque desplazado 24 px y eso, en algo que ya se está moviendo solo,
            se ve como un tirón al aparecer. */}
        <div class="mt-12">
          <BandaTestimonios items={lista} />
        </div>
      </>
    ) : (
      <div class="container-page">
        <SectionHeading
          align="center"
          titulo={fundador.titulo}
          entradilla={fundador.entradilla}
        />

        {/* Deliberadamente NO son tres tarjetas iguales. Una rejilla de
            tarjetas gemelas es lo que el lector ya ha aprendido a saltarse, y
            aquí el contenido es un argumento seguido, no tres elementos
            comparables. Una lista con filete entre puntos se lee. */}
        <dl class="mx-auto mt-12 max-w-read">
          {puntos.map((p, i) => (
            <Reveal delay={i * 0.08}>
              <div class="flex gap-5 border-t border-line py-6 first:border-t-0 first:pt-0">
                <span
                  aria-hidden="true"
                  class="mt-1 grid size-8 shrink-0 place-items-center rounded-full bg-secondary-100 text-sm font-bold text-secondary-700"
                >
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <dt class="text-lg font-bold text-ink">
                    <T v={p.titulo} />
                  </dt>
                  <dd class="mt-1.5 text-base text-pretty text-ink-muted">
                    <T v={p.texto} />
                  </dd>
                </div>
              </div>
            </Reveal>
          ))}
        </dl>

        <Reveal delay={0.28}>
          <p class="mx-auto mt-10 max-w-read border-l-2 border-secondary-500 pl-5 text-base font-medium text-pretty text-ink">
            <T v={fundador.remate} />
          </p>
        </Reveal>
      </div>
    )
  }
</Section>
