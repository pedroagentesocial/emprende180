---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Reveal from "@components/motion/Reveal.astro";
import { TestimoniosCarrusel } from "@components/motion/TestimoniosCarrusel";
import { testimonios, cifras, copy, curso, garantia } from "@config/curso.config";
/* En su propio módulo, y no dentro de `curso.config`, para que Rollup pueda
   descartarlo entero del build de producción: allí `import.meta.env.DEV` se
   pliega a `false` al compilar, la referencia desaparece y con ella el import.
   Que las seis citas de maquetación ni siquiera existan en el servidor
   publicado es más garantía que cualquier aviso en pantalla. */
import { testimoniosMuestra } from "@config/testimonios.muestra";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import { faltaPorRellenar } from "@lib/pendientes";
import { formatNumber, formatMoney, interpolar } from "@i18n/formato";

/**
 * 07 · PRUEBA SOCIAL — «¿le funciona a gente como yo?»
 *
 * El instructor ya dijo que funciona; aquí lo dicen terceros, que es lo que
 * pesa de verdad. Y lo que convierte no son los elogios ("muy buen curso, lo
 * recomiendo") sino los RESULTADOS con contexto: de dónde partía esa persona y
 * a dónde llegó. El lector busca a alguien que empezaba donde empieza él.
 *
 * ⚠ CERO TESTIMONIOS INVENTADOS EN PRODUCCIÓN.
 *
 * LA SECCIÓN TIENE TRES ESTADOS Y ELIGE SOLA
 * ──────────────────────────────────────────
 *   1. `testimonios` con citas reales  → carrusel con esas citas. Publicado.
 *   2. Sin citas reales, en desarrollo → carrusel con `testimoniosMuestra`,
 *      seis tarjetas de maquetación. Sirve para ver y ajustar el carrusel sin
 *      esperar a tener alumnos. NO se publica.
 *
 *      Sin cartel de "solo en desarrollo" encima: la garantía de que esas seis
 *      citas no se publican no es un aviso que alguien tenga que leer, es que
 *      `import.meta.env.DEV` las deja fuera del bundle. El cartel solo ensuciaba
 *      la vista previa de una página que tiene que poder enseñarse.
 *   3. Sin citas reales, publicado     → el bloque "todavía no hay
 *      testimonios", que dice la verdad y la convierte en el argumento del
 *      precio de lanzamiento.
 *
 * El estado 3 existe porque las dos alternativas son peores: dejar tarjetas
 * vacías con `[COMPLETAR:]` a la vista deja la página a medio hacer justo donde
 * el lector decide si se fía, e inventarse las citas es publicidad engañosa
 * (FTC 16 CFR 465 en EE. UU., PROFECO en México) además de notarse.
 *
 * La frontera entre el 2 y el 3 es `import.meta.env.DEV`, que se evalúa al
 * compilar: las tarjetas de muestra ni siquiera llegan al bundle de producción.
 * No depende de que nadie se acuerde de quitar nada.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Basta con que UNO de los dos idiomas siga en placeholder para dar la sección
   por vacía: publicar con el español real y el inglés sin traducir es justo el
   fallo que esta comprobación existe para evitar. */
const hayReales = !testimonios.some((x) => faltaPorRellenar(x.cita));

/* `import.meta.env.DEV` va PRIMERO y literal, no a través de una variable. Vite
   lo sustituye por `false` al compilar, así que en producción queda
   `false ? … : []`, que Rollup sí pliega. Escrito al revés
   (`!hayReales && import.meta.env.DEV`) no lo plegaba, y las seis citas de
   muestra acababan dentro de la función del servidor: muertas y sin poder
   renderizarse, pero ahí. */
const lista = hayReales
  ? testimonios
  : import.meta.env.DEV
    ? testimoniosMuestra
    : [];

/* Los números también se localizan: el separador de miles lo decide el locale,
   no un `toLocaleString("es")` fijo que dejaba la cifra en español aunque la
   página estuviera en inglés. */
const numAlumnos = construirTxt((l) => formatNumber(cifras.alumnos, l));
const numValoraciones = construirTxt((l) =>
  formatNumber(cifras.numeroValoraciones, l),
);

/* ── Estado "todavía no hay testimonios" ───────────────────────────────────
   Los tres puntos citan cifras que ya viven en el config (precio, garantía,
   número de videos). Se interpolan en vez de escribirse a mano para que no
   puedan quedarse desfasadas: si mañana el precio cambia, este texto cambia
   con él. Es el mismo motivo por el que la sección 09 verifica su desglose. */
const fundador = copy.pruebaSocial.fundador;

const puntos = fundador.puntos.map((p) => ({
  titulo: p.titulo,
  texto: construirTxt((l) =>
    interpolar(p.texto[l], {
      actual: formatMoney(curso.precio.actual, l, curso.precio.moneda),
      referencia: formatMoney(curso.precio.referencia, l, curso.precio.moneda),
      dias: garantia.dias,
      videos: curso.formato.videos,
    }),
  ),
}));
---

<Section id="testimonios" tono="muted" ariaLabel={copy.pruebaSocial.aria}>
  {
    lista.length > 0 ? (
      <>
        <SectionHeading align="center" titulo={copy.pruebaSocial.titulo} />

        {cifras.sonReales && (
          <Reveal>
            <dl class="mx-auto mt-10 grid max-w-2xl grid-cols-2 gap-6 sm:grid-cols-3">
              <div class="text-center">
                <dt class="text-sm text-ink-muted">
                  <T v={copy.pruebaSocial.etiquetaAlumnos} />
                </dt>
                <dd class="text-3xl font-extrabold text-ink">
                  <T v={numAlumnos} />
                </dd>
              </div>
              <div class="text-center">
                <dt class="text-sm text-ink-muted">
                  <T v={copy.pruebaSocial.etiquetaValoracion} />
                </dt>
                <dd class="text-3xl font-extrabold text-ink">
                  {cifras.valoracionMedia}
                  <span class="text-lg text-ink-subtle">/5</span>
                </dd>
              </div>
              <div class="col-span-2 text-center sm:col-span-1">
                <dt class="text-sm text-ink-muted">
                  <T v={copy.pruebaSocial.etiquetaNumValoraciones} />
                </dt>
                <dd class="text-3xl font-extrabold text-ink">
                  <T v={numValoraciones} />
                </dd>
              </div>
            </dl>
          </Reveal>
        )}

        {/* `client:visible`: el carrusel está a media página y no hace falta
            que su JS compita con el LCP. Hasta que hidrata, la pista ya es
            desplazable con el dedo porque el scroll es nativo. */}
        <Reveal>
          <TestimoniosCarrusel
            client:visible
            items={lista}
            etiquetas={copy.pruebaSocial.carrusel}
            lang={lang}
          />
        </Reveal>
      </>
    ) : (
      <>
        <SectionHeading
          align="center"
          titulo={fundador.titulo}
          entradilla={fundador.entradilla}
        />

        {/* Deliberadamente NO son tres tarjetas iguales. Una rejilla de
            tarjetas gemelas es lo que el lector ya ha aprendido a saltarse, y
            aquí el contenido es un argumento seguido, no tres elementos
            comparables. Una lista con filete entre puntos se lee. */}
        <dl class="mx-auto mt-12 max-w-read">
          {puntos.map((p, i) => (
            <Reveal delay={i * 0.08}>
              <div class="flex gap-5 border-t border-line py-6 first:border-t-0 first:pt-0">
                <span
                  aria-hidden="true"
                  class="mt-1 grid size-8 shrink-0 place-items-center rounded-full bg-secondary-100 text-sm font-bold text-secondary-700"
                >
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <dt class="text-lg font-bold text-ink">
                    <T v={p.titulo} />
                  </dt>
                  <dd class="mt-1.5 text-base text-pretty text-ink-muted">
                    <T v={p.texto} />
                  </dd>
                </div>
              </div>
            </Reveal>
          ))}
        </dl>

        <Reveal delay={0.28}>
          <p class="mx-auto mt-10 max-w-read border-l-2 border-secondary-500 pl-5 text-base font-medium text-pretty text-ink">
            <T v={fundador.remate} />
          </p>
        </Reveal>
      </>
    )
  }
</Section>
