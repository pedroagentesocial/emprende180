---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Icono from "@components/ui/Icono.astro";
import { faqs, contacto, copy, cta } from "@config/curso.config";
import { resolverIdiomaServidor, LOCALES, construirTxt } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";
import { faltaPorRellenar, resaltarPendientes } from "@lib/pendientes";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 10 · FAQ — la última duda
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * No es documentación: cada pregunta corresponde a un motivo real por el que
 * alguien NO compra (tiempo, dinero, nivel, país, acceso, soporte). Si una
 * pregunta no desactiva una objeción, sobra.
 *
 * Va después del precio porque las objeciones que quedan vivas a estas alturas
 * son justo las que nacen al ver la cifra.
 *
 * ─── SE FUE LA ISLA DE REACT ───────────────────────────────────────────────
 *
 * El acordeón era un componente de React con estado, `aria-expanded` a mano y
 * altura animada con Motion. Ahora son `<details name="faq">`: el atributo
 * `name` compartido hace que abrir una cierre las demás, que es exactamente lo
 * que hacía la isla, y lo hace el navegador.
 *
 * Se gana más que los kilobytes. El teclado, el rol de botón y el anuncio de
 * "contraído/expandido" los pone el navegador y los pone bien: una
 * implementación a mano tiene que acordarse de las cinco cosas, y esta no puede
 * olvidarse de ninguna. Y hay algo que un acordeón de JavaScript no puede
 * hacer: buscar con Ctrl+F encuentra el texto dentro de un `<details>` cerrado
 * y lo abre solo.
 *
 * La animación de altura vive en global.css, con `interpolate-size` y
 * `::details-content`. Donde no estén soportadas, abre y cierra de golpe.
 *
 * ─── LA PRIMERA VA ABIERTA ─────────────────────────────────────────────────
 *
 * Antes arrancaban las trece cerradas: una columna de barras grises que no
 * enseñaba ni una respuesta, y que obligaba a pulsar para descubrir si esto
 * contesta de verdad o son cuatro líneas de relleno. Con la primera abierta se
 * ve el TONO de las respuestas sin hacer nada, y las demás se leen sabiendo que
 * merece la pena abrirlas.
 *
 * Va la primera y no otra porque `faqs[0]` es la objeción más común: "no tengo
 * experiencia en el sector". Si algún día se reordena la lista, el que quede
 * primero será el que se enseñe, y así debe ser.
 *
 * ─── POR QUÉ `resaltar` SE HACE AQUÍ Y NO CON `<T>` ────────────────────────
 *
 * `<T resaltar>` pinta con `set:html` dentro de un `<span>`. Aquí la respuesta
 * es un párrafo completo, así que el marcado se genera directo sobre el `<p>`
 * para no meter un inline donde va un bloque.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * Sigue mandando sobre el JSON-LD, pero ya no pinta nada en la página: el aviso
 * de "quedan respuestas por rellenar" era una nota para quien edita el sitio
 * puesta donde la leía el visitante. Si falta un dato, el rich snippet no se
 * emite y punto; el que edita se entera abriendo el config, no el cliente
 * enterándose de que la página está a medias.
 */
const hayPlaceholders = faqs.some((f) => faltaPorRellenar(f.respuesta));

const cuantas = construirTxt((l) =>
  interpolar(copy.faq.cuantas[l], { n: faqs.length }),
);

const schemaFaq = hayPlaceholders
  ? null
  : {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      // El JSON-LD se emite SOLO en el idioma servido: mezclar dos idiomas
      // en el mismo bloque no es válido.
      inLanguage: LOCALES[lang],
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.pregunta[lang],
        acceptedAnswer: { "@type": "Answer", text: f.respuesta[lang] },
      })),
    };
---

{/* ─── EL REPARTO EN DOS COLUMNAS ─────────────────────────────────────────────
    Preguntas a la izquierda, título a la derecha y más abajo que la primera
    pregunta. No es un capricho de maqueta: una columna de trece barras a lo
    ancho de la lectura es un muro: en cuanto se estrecha a la mitad, cada
    pregunta se lee de un golpe de vista y las trece caben en menos pantalla.

    El título baja para que no arranque a la misma altura que la primera
    pregunta. Dos bloques que empiezan en la misma línea compiten; desfasados,
    se lee primero la lista y el título hace de rótulo al lado.

    ORDEN DEL DOM ≠ ORDEN VISUAL. El encabezado va PRIMERO en el marcado y se
    manda a la derecha con `order`. Al revés —marcado con trece preguntas antes
    del <h2>— un lector de pantalla recorrería toda la lista sin saber todavía
    de qué sección le están hablando.

    El `sticky` es lo que hace que la columna derecha valga la pena: el rótulo y
    el recuento acompañan mientras se recorren las trece. Sin él sería un título
    solo, con dos pantallas de blanco debajo. */}
<Section id="faq" tono="muted" ritmo="compacto" ariaLabel={copy.faq.aria}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-x-16 xl:gap-x-20">
    <aside class="lg:order-2 lg:pt-24">
      <div class="lg:sticky lg:top-10">
        <Reveal>
          <p class="inline-flex items-center gap-2 rounded-full border border-secondary-200 bg-secondary-50 px-3 py-1 text-xs font-bold tracking-wide text-secondary-700 uppercase">
            <span aria-hidden="true" class="marca-linea">
              <span class="size-1.5 rounded-full bg-secondary-500"></span>
            </span>
            <T v={cuantas} />
          </p>

          {/* El ancho de la columna es lo que mide este titular, no un
              `text-*` más pequeño. A 20rem salía en cinco renglones con un
              "que" suelto en medio; a 22rem entra en tres limpios al mismo
              cuerpo. (Y bajarlo con `lg:text-3xl` no habría funcionado:
              Tailwind emite `text-4xl` DESPUÉS de `text-3xl`, así que con la
              misma especificidad gana el 4xl aunque el `lg:` sea más
              específico de intención. Se cambia el ancho, no el cuerpo.) */}
          <h2 class="mt-4 text-3xl font-extrabold text-balance text-ink sm:text-4xl">
            <T v={copy.faq.titulo} />
          </h2>

          <p class="mt-4 text-base text-pretty text-ink-muted">
            <T v={copy.faq.entradilla} />
          </p>
        </Reveal>
      </div>
    </aside>

    {/* `gap-2.5` en vez de filetes pegados: cada pregunta es una tarjeta suelta
        y el aire entre ellas es lo que hace que trece no parezcan un muro. */}
    <div class="grid content-start gap-2.5 lg:order-1">
      {
        faqs.map((f, i) => (
          <Reveal delay={Math.min(i, 6) * 0.03}>
            <details
              data-faq
              name="faq"
              open={i === 0}
              class="group rounded-2xl border border-line bg-surface transition-colors duration-200 ease-out-soft open:border-secondary-300 open:bg-secondary-50/40 hover:border-line-strong open:hover:border-secondary-300"
            >
              {/* `list-none` + el `::-webkit-details-marker` de global.css:
                  entre los dos quitan el triángulo por defecto en todos los
                  navegadores. */}
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus sm:px-6 sm:py-5">
                <h3 class="text-base font-semibold text-balance text-ink sm:text-lg">
                  <T v={f.pregunta} />
                </h3>

                {/* El "+" gira 45° y se convierte en "×". Ver global.css. */}
                <span
                  aria-hidden="true"
                  data-faq-icono
                  class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-muted text-ink-muted group-open:bg-secondary-500 group-open:text-ink-inverse"
                >
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke-width="2.5">
                    <path
                      d="M12 5v14M5 12h14"
                      stroke="currentColor"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="px-5 pb-5 sm:px-6 sm:pb-6">
                <p
                  class="border-t border-line pt-4 text-base text-pretty text-ink-muted"
                  data-t="es"
                  lang="es"
                  set:html={resaltarPendientes(f.respuesta.es)}
                />
                <p
                  class="border-t border-line pt-4 text-base text-pretty text-ink-muted"
                  data-t="en"
                  lang="en"
                  set:html={resaltarPendientes(f.respuesta.en)}
                />
              </div>
            </details>
          </Reveal>
        ))
      }
    </div>

    {/* ─── LA DUDA QUE NO ESTÁ EN LA LISTA ──────────────────────────────────
        Cierra la sección a lo ancho de las dos columnas: es la salida para
        quien ha recorrido las trece y sigue con una duda, así que no puede
        vivir dentro de la columna estrecha de las preguntas.

        Los dos botones son LLAMAR y DEJAR LOS DATOS. El `mailto:` que había
        aquí se fue: abre un cliente de correo que en móvil muchas veces ni
        está configurado, y cuando funciona la respuesta llega un día después.
        El formulario deja el contacto en el sistema; el teléfono lo resuelve
        en el momento. El correo sigue escrito debajo para quien lo prefiera.

        El de llamar solo existe si hay número en `contacto.telefono`. */}
    {/* Las clases de rejilla van en el `Reveal` y no en el `div` de dentro:
        `Reveal` renderiza su propia etiqueta, así que el ítem de la rejilla es
        ÉL. Puestas en el hijo, `order` y `col-span` no las lee nadie —el
        bloque se colaba en la primera columna y empujaba el título abajo. */}
    <Reveal delay={0.1} class="lg:order-3 lg:col-span-2">
      <div class="rounded-2xl border border-line bg-surface p-6 text-center sm:p-8">
        <p class="text-lg font-bold text-balance text-ink sm:text-xl">
          <T v={copy.faq.quedaDuda} />
        </p>
        <p class="mx-auto mt-2 max-w-md text-base text-pretty text-ink-muted">
          <T v={copy.faq.quedaDudaTexto} />
        </p>

        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
          {
            contacto.telefono && (
              <Button
                href={`tel:${contacto.telefono}`}
                variant="primary"
                size="lg"
                trackId="faq-llamada"
                class="w-full sm:w-auto"
              >
                <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                <T v={copy.instructor.llamame} />
              </Button>
            )
          }

          <Button
            href={cta.secundario.href}
            variant="secondary"
            size="lg"
            trackId="faq-contacto"
            class="w-full sm:w-auto"
          >
            <Icono nombre="conversacion" class="size-4 shrink-0" grosor={2} />
            <T v={copy.faq.contactar} />
          </Button>
        </div>

        {/* El correo, escrito. Un `mailto:` no dice a dónde va hasta que se
            pulsa, y hay quien prefiere copiarlo y escribir desde su cuenta. */}
        <p class="mt-4 text-sm text-ink-subtle">{contacto.email}</p>
      </div>
    </Reveal>

    {/* AQUÍ TERMINA LA SECCIÓN, A PROPÓSITO.

        Debajo había dos bloques más: "Y después de Fundamentos" (los dos cursos
        que todavía no existen) y el aviso de respuestas por rellenar. Los dos
        fuera.

        El de próximos cursos porque la última impresión de la sección de dudas
        no puede ser "esto que compras es solo el primero de tres, y los otros
        dos ni están": justo después de desactivar trece objeciones, abría una
        nueva. Y el aviso porque era una nota para quien edita el sitio impresa
        para el cliente. El JSON-LD lo sigue vigilando `hayPlaceholders`, en
        silencio y sin decírselo a quien viene a comprar. */}
  </div>

  {schemaFaq && <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} is:inline />}
</Section>
