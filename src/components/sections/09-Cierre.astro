---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import LeadForm from "@components/ui/LeadForm";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 09 · EL CIERRE — el formulario
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lo último de la página, y lo más simple que hay en ella: un titular, dos
 * campos, la casilla y un botón. La foto ocupa la otra mitad y se sale por el
 * borde derecho.
 *
 * ─── AQUÍ SE QUITAN COSAS, NO SE AÑADEN ────────────────────────────────────
 *
 * Esta sección llegó a tener cuatro campos, una lista de cuatro frases sobre el
 * pago, un enlace para llamar y otro para entrar al portal. Cada cosa por
 * separado tenía sentido; juntas convertían el remate de la página en un
 * formulario de trámite, que es lo que nadie rellena.
 *
 * ⚠️ LO QUE SE QUITÓ NO SE PERDIÓ, Y CONVIENE SABER DÓNDE ESTÁ ANTES DE
 * ECHARLO DE MENOS:
 *
 *   · el teléfono ....... en el pie, en su columna de contacto.
 *   · entrar al portal .. en la barra de arriba ("Acceso"), en todas las
 *                         páginas y también en móvil.
 *   · el teléfono y el
 *     "quién te recomendó" del formulario ... se preguntan en la llamada, que
 *                         es donde se cierra de verdad.
 *
 * Si alguien vuelve a añadir un enlace aquí, que sea porque no está en ninguno
 * de esos sitios, no porque "conviene tenerlo a mano".
 *
 * ─── LOS CAMPOS NO LLEVAN RÓTULO ENCIMA ────────────────────────────────────
 *
 * El nombre del campo vive dentro del recuadro. Escondido de la VISTA, no del
 * documento: el \`<label>\` sigue ahí en \`sr-only\`, porque un \`placeholder\`
 * desaparece en cuanto se escribe y quien usa un lector de pantalla se queda
 * sin saber qué campo es. Ver \`sinEtiquetas\` en \`LeadForm\`.
 *
 * ─── Y EL ANCLA ES \`#empezar\` ──────────────────────────────────────────────
 *
 * Aquí llegan los botones de las tarjetas de "cómo se trabaja" y el CTA
 * primario del config. Si alguien cambia ese \`id\`, esos botones se quedan sin
 * destino.
 */

const { informes } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* ⚠️ Foto de banco, como el resto de la página, pero elegida por dos motivos
   concretos: es la única de la carpeta en la que se ve una mano de mujer, que
   es a quien le habla la página entera, y lo que hace es justo lo que dice el
   titular de al lado, escribir su semana. Aguanta bien el recorte vertical de
   media pantalla porque no hay ninguna cara que cortar. */
const FOTO = "/imagenes/resultados/04.webp";
---

<Section id="empezar" tono="surface" ariaLabel={copy.cierre.aria} sinContenedor>
  <div class="grid items-stretch lg:grid-cols-2">
    {/* ─── La mitad que se lee ────────────────────────────────────────────
        ⚠️ AQUÍ HABÍA UN "lg:max-w-[44rem]" y se ha ido con la regla del ancho:
        eran 44rem pegadas a la costura para cuadrar con un contenedor centrado
        de 88rem que ya no existe. Ahora esta mitad se llena entera.

        Los dos márgenes NO son el mismo y no deben serlo: el de FUERA es
        "--gutter-page", el mismo de toda la página, para que este titular
        quede a plomo con el de las demás secciones; el de DENTRO es el aire de
        la costura, y solo aparece cuando hay dos columnas. */}
    <div class="w-full px-[var(--gutter-page)] lg:py-6 lg:pr-14">
      <Reveal>
        <p class="text-sm font-semibold text-ink-brand">
          <T v={informes.kicker} />
        </p>

        <h2 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance text-ink sm:text-5xl">
          {
            informes.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))
          }
        </h2>

        <p class="mt-5 max-w-prose text-base text-pretty text-ink-muted sm:text-lg">
          <T v={informes.porQue} />
        </p>

        <div class="mt-8 max-w-xl">
          <LeadForm
            client:visible
            lang={lang}
            origen="informes"
            variante="informes"
            minimo
            sinEtiquetas
            compacto
            cta={informes.ctaBoton}
            aviso={informes.aviso}
            exitoTitulo={informes.exitoTitulo}
            exitoTexto={informes.exitoTexto}
          />
        </div>
      </Reveal>
    </div>

    {/* ─── La foto, hasta el borde ────────────────────────────────────────
        En móvil no sangra a media pantalla —quedaría una tira rara— sino que
        ocupa el ancho completo con una altura fija, y va debajo del formulario:
        en un teléfono, lo primero tiene que ser lo que hay que rellenar. */}
    <div class="relative order-last h-64 w-full bg-primary-950 sm:h-80 lg:h-auto lg:min-h-[32rem]">
      <img
        src={FOTO}
        alt={copy.cierre.foto[lang]}
        data-alt-es={copy.cierre.foto.es}
        data-alt-en={copy.cierre.foto.en}
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    </div>
  </div>
</Section>
