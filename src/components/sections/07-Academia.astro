---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Button from "@components/ui/Button.astro";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 07 · LA ACADEMIA
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * La puerta de quien ya compró. Va después del blog y antes de los recursos:
 * entre lo que es gratis de leer y lo que es gratis de descargar, esta es la
 * única que pide haber pagado.
 *
 * ─── ESPEJO DEL BLOG, Y A PROPÓSITO ────────────────────────────────────────
 *
 * Misma estructura que la sección de arriba —una columna de texto y una foto
 * que ocupa media pantalla y se sale por el borde— pero VOLTEADA: aquí la foto
 * va a la izquierda. Dos secciones seguidas con la foto del mismo lado se leen
 * como una sola cosa larga; alternando, la página avanza en zigzag y cada una
 * se lee como lo que es.
 *
 * ⚠️ EL `max-w-[44rem]` DE LA COLUMNA DE TEXTO NO ES UN NÚMERO AL AZAR. La
 * rejilla parte la pantalla por la mitad, así que 44rem pegadas al borde
 * izquierdo de su mitad terminan exactamente donde terminaría un contenedor
 * centrado de 88rem, que es el que usan las demás secciones del rediseño. El
 * texto queda alineado con el resto de la página en cualquier ancho, sin
 * cálculos ni `vw`.
 *
 * ─── LO QUE ESTA SECCIÓN NO DICE ───────────────────────────────────────────
 *
 * Ni el CRM ni el Ecosistema, que tienen su sitio en "cómo se trabaja". Y no
 * promete cursos futuros. Ver la nota de `copy.academia`.
 */

const { academia } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* ⚠️ Foto de banco, como el resto de la página. Esta es de las pocas que no
   desentona con lo que dice el texto —alguien trabajando de noche en su
   cocina—, pero sigue sin ser una alumna. Ver el README de /public/imagenes. */
const FOTO = "/imagenes/secciones/temario.webp";
---

<Section id="academia" tono="muted" ariaLabel={academia.aria} sinContenedor>
  <div class="grid items-stretch lg:grid-cols-2">
    {/* ─── La foto, hasta el borde izquierdo ──────────────────────────────
        En móvil no sangra a media pantalla —quedaría una tira rara— sino que
        ocupa el ancho completo con una altura fija, y va delante del texto. */}
    <div class="relative order-first h-72 w-full bg-primary-950 sm:h-96 lg:h-auto lg:min-h-[32rem]">
      <img
        src={FOTO}
        alt={academia.foto[lang]}
        data-alt-es={academia.foto.es}
        data-alt-en={academia.foto.en}
        width={1000}
        height={800}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    </div>

    {/* ─── El texto ───────────────────────────────────────────────────────── */}
    <div class="w-full px-5 sm:px-8 lg:max-w-[44rem] lg:py-6">
      <Reveal>
        <p class="text-sm font-semibold text-ink-brand">
          <T v={academia.kicker} />
        </p>

        <h2 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance text-ink sm:text-5xl">
          {
            academia.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))
          }
        </h2>

        {
          academia.texto.map((parrafo) => (
            <p class="mt-5 max-w-prose text-base text-pretty text-ink-muted sm:text-lg">
              <T v={parrafo} />
            </p>
          ))
        }

        <div class="mt-8">
          {/* A `/login`, el mismo sitio que "Acceso" en la barra. Quien ya
              compró entra; quien no, ve la pantalla de acceso y comprueba que
              esto existe de verdad y tiene puerta. */}
          <Button href="/login" trackId="academia-entrar">
            <T v={academia.cta} />
          </Button>
        </div>
      </Reveal>
    </div>
  </div>
</Section>
