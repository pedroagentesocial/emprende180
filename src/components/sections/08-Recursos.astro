---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Button from "@components/ui/Button.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { copy } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 08 · LOS RECURSOS
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Franja navy entre dos secciones con foto. Es la más corta de la página y así
 * tiene que quedarse: lo único que hace es abrir la puerta de `/recursos`.
 *
 * ─── EL COLOR ES EL DESCANSO ───────────────────────────────────────────────
 *
 * Va entre la Academia y el cierre, que son las dos de foto a media pantalla.
 * Sin este corte oscuro, la página termina en tres bloques fotográficos
 * seguidos y el último deja de contar como final.
 *
 * ─── PERO YA NO ESTÁ CENTRADA ──────────────────────────────────────────────
 *
 * Antes era un bloque centrado de `max-w-5xl`: titular al medio, párrafo al
 * medio y botón al medio. Se leía como el aviso de una plantilla. Ahora el
 * texto va a la izquierda y el botón se separa al otro extremo de la fila, que
 * es lo que hace una franja de acción de verdad: el ojo entra por el titular y
 * sale por el botón, sin volver al centro por el camino.
 *
 * En móvil se apila y el botón queda debajo, que es el único orden posible
 * cuando no hay ancho que repartir.
 */

const { recursos } = copy;
---

<Section id="recursos" tono="inverse" ritmo="compacto" ariaLabel={recursos.aria} sinContenedor>
  <div class="mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <div class="relative isolate overflow-hidden">
      <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

      <Reveal>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
          <div>
            <p class="text-sm font-semibold text-secondary-300">
              <T v={recursos.kicker} />
            </p>

            <h2 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance text-ink-inverse sm:text-5xl">
              {
                recursos.titulo.map((linea) => (
                  <span class="block">
                    {"enfasis" in linea && linea.enfasis ? (
                      <Enfasis v={linea} tono="inverso" />
                    ) : (
                      <T v={linea} />
                    )}
                  </span>
                ))
              }
            </h2>

            <p class="mt-5 max-w-lg text-base text-pretty text-secondary-100 sm:text-lg">
              <T v={recursos.texto} />
            </p>
          </div>

          {/* `shrink-0` para que el botón no se comprima cuando el titular
              ocupa toda la línea: sin él, en anchos intermedios el texto del
              botón se partía en dos renglones. */}
          <div class="shrink-0">
            <Button href="/recursos" sobre="oscuro" trackId="recursos-ver">
              <T v={recursos.cta} />
            </Button>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</Section>
