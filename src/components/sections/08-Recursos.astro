---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Button from "@components/ui/Button.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { copy } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 13 · LOS RECURSOS
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Franja navy, todo centrado, una frase y un botón. Es la sección más corta de
 * la página y así tiene que quedarse: lo único que hace es abrir la puerta de
 * `/recursos`.
 *
 * ─── EL CONTENEDOR ES ANCHO A PROPÓSITO ────────────────────────────────────
 *
 * `max-w-5xl` y no la medida de lectura. El titular son tres frases cortas que
 * TIENEN que caer una por línea, y en una columna estrecha la segunda se parte
 * por la mitad y deja una palabra sola. Aquí el ancho no es para leer más
 * cómodo, es para que el corte de línea caiga donde debe.
 */

const { recursos } = copy;
---

<Section id="recursos" tono="inverse" ritmo="compacto" ariaLabel={recursos.aria}>
  <div class="relative isolate overflow-hidden">
    <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

    <Reveal class="mx-auto max-w-5xl text-center">
      <h2 class="text-3xl leading-tight font-extrabold text-balance text-ink-inverse sm:text-4xl lg:text-5xl">
        {
          recursos.titulo.map((linea) => (
            <span class="block">
              {"enfasis" in linea && linea.enfasis ? (
                <Enfasis v={linea} tono="inverso" />
              ) : (
                <T v={linea} />
              )}
            </span>
          ))
        }
      </h2>

      <p class="mx-auto mt-5 max-w-md text-base text-pretty text-secondary-100 sm:text-lg">
        <T v={recursos.texto} />
      </p>

      <div class="mt-8">
        <Button href="/recursos" sobre="oscuro" trackId="recursos-ver">
          <T v={recursos.cta} />
        </Button>
      </div>
    </Reveal>
  </div>
</Section>
