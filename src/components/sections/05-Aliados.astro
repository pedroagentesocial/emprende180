---
import T from "@components/i18n/T.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import { aliados, copy } from "@config/curso.config";
import { logoAliado, medidasAliado } from "@lib/assets";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 01 · LOS NEGOCIOS DEL ECOSISTEMA — una banda que no para
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Va JUSTO DESPUÉS DEL HERO, y esa posición es todo el argumento. El hero acaba
 * de prometer un rol ("conviértete en Embajador") y la primera pregunta que se
 * hace cualquiera es si eso existe o es una idea en un papel. Enseñar negocios
 * reales antes de contar el problema responde esa duda mientras todavía hay
 * atención, en vez de dejarla trabajando en contra durante seis secciones.
 *
 * ─── DE OCHO TARJETAS A UNA BANDA ──────────────────────────────────────────
 *
 * Antes era una rejilla de tarjetas con logo, rubro y enlace, más un titular y
 * una entradilla encima. Con ocho marcas ocupaba dos filas y media pantalla, y
 * eso es demasiado peso para lo que esta franja tiene que hacer: es una PRUEBA,
 * no un capítulo. Si pesa como el hero, le roba sitio a la promesa.
 *
 * Ahora es un rótulo corto y los logos cruzando la pantalla. Ocupa un tercio,
 * se lee en un vistazo y se mueve, que es lo que hace que el ojo se pare en
 * ella al bajar.
 *
 * ⚠️ SE PIERDE EL RUBRO DE CADA MARCA, y conviene saberlo antes de echarlo de
 * menos: en una banda en movimiento no hay tiempo para leer "Financiamiento
 * inmobiliario" debajo de un logo. Lo que queda es lo que de verdad hace el
 * trabajo aquí, que es el reconocimiento: son ocho, son reales y son de sectores
 * distintos. Quien quiera saber qué hace cada una, pulsa.
 *
 * ─── LA MECÁNICA NO ES NUEVA ───────────────────────────────────────────────
 *
 * Reusa la de `BandaTestimonios`: los atributos `data-banda*` y su animación
 * viven en `global.css`. Eso trae gratis lo que cuesta hacer bien:
 *
 *   · La lista se pinta DOS veces y la pista se mueve un -50 % exacto, así el
 *     fotograma del reinicio es idéntico al de salida y no se ve la costura.
 *     ⚠️ Las dos copias tienen que ser IGUALES; si alguien añade una marca a
 *     una y no a la otra, aparece un tirón en cada vuelta.
 *   · La segunda copia va `aria-hidden`: para un lector de pantalla las marcas
 *     son ocho, no dieciséis.
 *   · Se puede parar de tres formas (el botón, el cursor o el tabulador, y
 *     `prefers-reduced-motion`). WCAG 2.2.2 lo exige para todo lo que se mueve
 *     solo más de cinco segundos, y el botón es el único que sirve en un
 *     teléfono, donde no hay cursor que pasar.
 *
 * ─── LO QUE NO SE HACE NUNCA ───────────────────────────────────────────────
 *
 * Rellenar. `aliados.marcas` es una lista de HECHOS: cada marca afirma una
 * relación real. Un muro de logos repetidos, o con marcas con las que no hay
 * relación, es el truco más viejo del sector y se nota. Con ocho la banda va
 * sobrada; con tres habría que volver a la fila estática, porque una banda con
 * tres logos deja ver el ciclo y se lee como que no hay más.
 */

const marcas = aliados.marcas.map((m) => ({
  ...m,
  logo: logoAliado(m.logo),
  medidas: medidasAliado(m.logo),
}));

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * El nombre partido en dos renglones para las marcas que aún no tienen archivo
 * de logo: todo menos la última palabra arriba, la última abajo. "Wise Power
 * HVAC" se lee WISE POWER / HVAC.
 *
 * ⚠️ ES TEXTO Y NO UNA IMAGEN A PROPÓSITO. Un SVG dentro de un `<img>` es un
 * documento aislado que no puede usar la tipografía de la página, así que
 * saldría en la fuente que tenga el sistema de cada visitante. Esto se pinta con
 * la Montserrat de verdad, pesa cero y desaparece solo el día que llegue el
 * logo real: basta dejar el archivo en `/public/imagenes/aliados/`.
 */
const lockup = (nombre: string) => {
  const palabras = nombre.trim().split(/\s+/);
  if (palabras.length === 1) return { arriba: palabras[0]!, abajo: null };
  return {
    arriba: palabras.slice(0, -1).join(" "),
    abajo: palabras[palabras.length - 1]!,
  };
};

/**
 * La duración sale del NÚMERO DE MARCAS, no de un número fijo.
 *
 * Con una duración fija, añadir marcas acelera la banda: la pista se hace más
 * larga y tiene que recorrerla en el mismo tiempo. Cinco segundos por marca
 * mantiene la velocidad de lectura constante pase lo que pase con la lista.
 */
const duracion = `${marcas.length * 5}s`;
---

{/* ─── ESTO YA NO ES UNA SECCIÓN, ES UN BLOQUE ───────────────────────────
    Vivía en su propia `<Section>`, con su fondo y su ritmo vertical. Ahora se
    pinta DENTRO de la de testimonios, y por eso no trae ni envoltorio ni color
    propio: los hereda de quien la incluye.

    El motivo no es de código, es de lectura. Los logos y las reseñas dicen lo
    mismo —que esto existe de verdad y que ya hay gente dentro— y separados por
    un cambio de fondo se leían como dos temas distintos que no se respaldan.

    ⚠️ CON EL ENVOLTORIO SE FUE EL `id="aliados"`. Nadie enlazaba a ese ancla;
    si hace falta una, la que vale es la de la sección que lo contiene. */}
{
  aliados.activa && marcas.length > 0 && (
    <div>
  {/* ─── EL RÓTULO VA EN LÍNEA CON LOS LOGOS, NO ENCIMA ────────────────────
      Centrado y arriba, "Confían en nosotros" se leía como el titular de una
      sección y devolvía a la franja el peso que se le acababa de quitar. A la
      izquierda y a la misma altura, es lo que de verdad es: una etiqueta que
      presenta la fila, como el "Síguenos" de un pie.

      En móvil se apila, y no es una concesión: el rótulo mide unos 170 px y con
      la banda al lado dejaría 200 px para los logos, donde no cabe ni uno
      entero. Debajo, la banda recupera el ancho completo.

      La banda sigue sangrando hasta el borde derecho (`sinContenedor` en la
      sección) mientras el rótulo respeta el margen de la página: por eso el
      padding va en el rótulo y no en el contenedor común. */}
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-10">
        {/* ⚠️ EL MARGEN VA A MANO PERO CON EL TOKEN DE LA PÁGINA, no con un
            número escrito aquí. Aquí solo hace falta el margen IZQUIERDO —la
            banda tiene que seguir sangrando hasta el borde derecho— y
            `container-page` pone los dos, así que no sirve.

            Antes eran `pl-5 sm:pl-8` a mano, y eso funcionaba mientras la
            página tuviera ese margen fijo. Con la regla del ancho el margen
            crece con la pantalla (ver global.css): dejarlo en 2rem clavados
            habría desalineado este rótulo de todos los titulares de la página
            a partir de 1024 px, sin que salte nada. */}
        <Reveal class="shrink-0 pl-[var(--gutter-page)]">
          <p class="text-xs font-bold tracking-[0.18em] text-ink-subtle uppercase">
            <T v={copy.aliados.rotulo} />
          </p>
        </Reveal>

        <div data-banda data-pausada="false" class="relative min-w-0 flex-1">
        {/* `overflow-hidden` recorta la pista sin sacar la banda del ancho de
            la página: nada de `100vw`, que incluye la barra de desplazamiento y
            provoca scroll horizontal en toda la web. */}
        <div data-banda-viewport class="overflow-hidden">
          <ul
            data-banda-pista
            class="flex w-max items-center gap-12 py-2 sm:gap-16"
            style={`--duracion:${duracion}`}
            aria-label={copy.aliados.rotulo[lang]}
            data-aria-es={copy.aliados.rotulo.es}
            data-aria-en={copy.aliados.rotulo.en}
          >
            {[0, 1].map((copia) =>
              marcas.map((m) => (
                <li
                  class="shrink-0"
                  aria-hidden={copia === 1 ? "true" : undefined}
                  data-banda-clon={copia === 1 ? "" : undefined}
                >
                  {/* Con enlace es un `<a>`; sin él, un `<span>`. Una marca sin
                      `url` sigue apareciendo porque la relación es real, pero no
                      se publica un enlace roto. */}
                  {m.url ? (
                    <a
                      href={m.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track={`aliado-${m.logo}`}
                      class="flex min-h-11 items-center opacity-80 transition-opacity duration-[var(--duration-base)] ease-[var(--ease-out-soft)] hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus"
                    >
                      {m.logo ? (
                        <img
                          src={m.logo}
                          alt={m.nombre}
                          width={m.medidas?.w}
                          height={m.medidas?.h}
                          loading="lazy"
                          decoding="async"
                          class="h-8 w-auto object-contain sm:h-10"
                        />
                      ) : (
                        <span class="flex h-8 flex-col justify-center text-center sm:h-10">
                          <span class="text-sm font-extrabold tracking-[0.06em] text-ink uppercase sm:text-base">
                            {lockup(m.nombre).arriba}
                          </span>
                          {lockup(m.nombre).abajo && (
                            <span class="mt-0.5 text-[0.6875rem] font-semibold tracking-[0.18em] text-ink-brand uppercase">
                              {lockup(m.nombre).abajo}
                            </span>
                          )}
                        </span>
                      )}
                    </a>
                  ) : (
                    <span class="flex min-h-11 items-center opacity-80">
                      {m.logo ? (
                        <img
                          src={m.logo}
                          alt={m.nombre}
                          width={m.medidas?.w}
                          height={m.medidas?.h}
                          loading="lazy"
                          decoding="async"
                          class="h-8 w-auto object-contain sm:h-10"
                        />
                      ) : (
                        <span class="flex h-8 flex-col justify-center text-center sm:h-10">
                          <span class="text-sm font-extrabold tracking-[0.06em] text-ink uppercase sm:text-base">
                            {lockup(m.nombre).arriba}
                          </span>
                          {lockup(m.nombre).abajo && (
                            <span class="mt-0.5 text-[0.6875rem] font-semibold tracking-[0.18em] text-ink-brand uppercase">
                              {lockup(m.nombre).abajo}
                            </span>
                          )}
                        </span>
                      )}
                    </span>
                  )}
                </li>
              )),
            )}
          </ul>
        </div>

        {/* Los bordes se desvanecen en vez de cortar en seco: sin esto, un logo
            aparece y desaparece de golpe en el filo y el ojo lo lee como un
            fallo de maquetación. El color del degradado es el de ESTA sección
            (`tono="muted"`), así que si alguien le cambia el tono hay que
            cambiarlo aquí también. */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-surface-muted to-transparent sm:w-12"
        />
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-surface-muted to-transparent sm:w-28"
        />
        </div>
      </div>

      {/* El botón es lo que hace que esto cumpla WCAG en un teléfono, donde no
          hay cursor con el que pausar. Discreto y centrado: es un mando, no una
          llamada a la acción. */}
      <div class="container-page mt-6 flex justify-center">
        <button
          type="button"
          data-banda-pausa
          aria-pressed="false"
          aria-label={copy.banda.pausar[lang]}
          data-aria-es={copy.banda.pausar.es}
          data-aria-en={copy.banda.pausar.en}
          data-etiqueta-pausar-es={copy.banda.pausar.es}
          data-etiqueta-pausar-en={copy.banda.pausar.en}
          data-etiqueta-reanudar-es={copy.banda.reanudar.es}
          data-etiqueta-reanudar-en={copy.banda.reanudar.en}
          class="inline-grid size-11 place-items-center rounded-full border border-line bg-surface text-ink-subtle transition-colors duration-200 hover:bg-surface-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <Icono nombre="pausa" class="size-4" grosor={2} data-icono-pausa />
          <Icono nombre="play" class="hidden size-4" grosor={1} data-icono-play />
        </button>
      </div>
    </div>
  )
}
