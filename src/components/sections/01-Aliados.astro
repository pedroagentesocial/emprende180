---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import { aliados } from "@config/curso.config";
import { logoAliado, medidasAliado } from "@lib/assets";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 01 · LOS NEGOCIOS DEL ECOSISTEMA
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Va JUSTO DESPUÉS DEL HERO, y esa posición es todo el argumento. El hero acaba
 * de prometer un rol ("conviértete en Embajador") y la primera pregunta que se
 * hace cualquiera es si eso existe o es una idea en un papel. Enseñar negocios
 * reales antes de contar el problema responde esa duda mientras todavía hay
 * atención, en vez de dejarla trabajando en contra durante seis secciones.
 *
 * Es una FRANJA, no una sección con peso: ritmo compacto, sin CTA y sin más
 * texto que un titular y una línea. Si esto pesa como el hero, le roba sitio a
 * la promesa, que es lo que de verdad tiene que quedarse.
 *
 * ─── QUÉ SE PINTA CUANDO NO HAY LOGO ───────────────────────────────────────
 *
 * El nombre de la marca como logotipo tipográfico: versalitas anchas, navy,
 * dentro del mismo marco que los logos de verdad. No es un hueco ni una caja
 * rota; se lee como una decisión. En cuanto aparezca el archivo en
 * `/public/imagenes/aliados/`, esa marca lo usa sin tocar código.
 *
 * Hoy pasa con Broker Lenders: su web responde 403 a las descargas automáticas
 * y no se ha podido sacar el logo. Ver la nota en `aliados.marcas` del config.
 *
 * ─── LO QUE ESTA SECCIÓN NO PUEDE HACER ────────────────────────────────────
 *
 * Inventar. `aliados.marcas` es una lista de HECHOS: cada marca afirma una
 * relación real y cada rubro sale de lo que esa empresa dice de sí misma en su
 * propia web. Un muro de logos repetidos, o con marcas con las que no hay
 * relación, es el truco más viejo del sector y se nota.
 *
 * Lo que sí hace sola es acomodarse: la fila se reparte según cuántas marcas
 * haya, así que añadir una al config no descoloca nada. Ver `columnas`.
 */
const marcas = aliados.marcas.map((m) => ({
  ...m,
  logo: logoAliado(m.logo),
  medidas: medidasAliado(m.logo),
}));

/**
 * ─── CUÁNTAS CABEN POR FILA ────────────────────────────────────────────────
 *
 * ⚠️ ESTO NO ES UN CAPRICHO: ES EL ARREGLO DE UN FALLO QUE SE VE. Con las
 * tarjetas a ancho fijo, cuatro marcas se partían en 3 + 1 —faltaban ocho
 * píxeles para que cupieran las cuatro— y una tarjeta sola en la segunda fila no
 * se lee como "cuatro marcas": se lee como una que sobra o como un hueco donde
 * falta la quinta. En una sección cuyo único trabajo es dar confianza, eso resta.
 *
 * Así que el ancho de tarjeta sale de una división, no de un número fijo, y las
 * columnas las decide la CANTIDAD de marcas:
 *
 *   hasta 4 → tantas columnas como marcas (una fila limpia)
 *   5, 9…   → 3 columnas, porque con 4 quedaría una huérfana (5 = 4+1)
 *   resto   → 4 columnas (6 = 4+2, 7 = 4+3, 8 = 4+4)
 *
 * El resultado es que añadir una marca al config NUNCA deja una tarjeta sola al
 * final. Se puede seguir añadiendo sin volver aquí.
 */
const columnas = marcas.length <= 4 ? marcas.length : marcas.length % 4 === 1 ? 3 : 4;
---

{
  aliados.activa && marcas.length > 0 && (
    <Section id="aliados" tono="muted" ritmo="compacto">
      <Reveal>
        <div class="mx-auto max-w-read text-center">
          <h2 class="text-2xl font-bold text-balance text-ink sm:text-3xl">
            <T v={aliados.titulo} />
          </h2>
          <p class="mt-3 text-base text-pretty text-ink-muted">
            <T v={aliados.entradilla} />
          </p>
        </div>
      </Reveal>

      {/* `flex-wrap` centrado y NO una rejilla, aunque el ancho salga de una
          división: en una rejilla, la última fila incompleta deja el hueco a la
          derecha —se lee como una marca que falta— mientras que aquí se centra
          sola. Ver el cálculo de `columnas` arriba. */}
      <ul
        class="aliados-fila mt-10 flex flex-wrap items-stretch justify-center gap-4 sm:gap-6"
        style={`--cols:${columnas}`}
      >
        {marcas.map((m, i) => (
          <Reveal as="li" delay={i * 0.08} class="w-full sm:w-auto">
            {/* ─── CON URL ENLAZA; SIN URL, NO ────────────────────────────────
                Una marca sin `url` sigue apareciendo —la relación es real— pero
                se pinta como tarjeta muerta en vez de como enlace. Es la misma
                regla de `redesMarca`: no se publica un enlace roto.

                Hoy la usa Broker Lenders, cuyo sitio devuelve 403 y tiene el
                certificado caducado. Ver el comentario de `aliados.marcas`.

                `rel="noopener"` no es opcional con `target="_blank"`: sin él la
                página de destino recibe una referencia a esta y puede
                reescribirla. `noreferrer` porque tampoco hace falta mandarles
                de dónde viene el clic. */}
            <Fragment>
            {(() => {
              const Tarjeta = m.url ? "a" : "div";
              return (
            <Tarjeta
              href={m.url ?? undefined}
              target={m.url ? "_blank" : undefined}
              rel={m.url ? "noopener noreferrer" : undefined}
              data-track={m.url ? `aliado-${m.logo}` : undefined}
              class:list={[
                "group flex h-full min-h-11 min-w-0 flex-col items-center justify-center gap-3 rounded-2xl border border-line bg-surface px-6 py-7 transition-colors duration-200 ease-out-soft",
                m.url &&
                  "hover:border-secondary-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus",
              ]}
            >
              {m.logo ? (
                /* `h-10 w-auto`: los logos vienen con proporciones distintas, así
                   que se igualan por ALTO. Igualarlos por ancho haría que uno
                   apaisado se viera el doble de grande que uno cuadrado. */
                <img
                  src={m.logo}
                  alt={m.nombre}
                  width={m.medidas?.w}
                  height={m.medidas?.h}
                  loading="lazy"
                  decoding="async"
                  class="h-9 w-auto object-contain sm:h-10"
                />
              ) : (
                /* Logotipo tipográfico mientras no llega el archivo. */
                <span
                  class="flex h-9 items-center text-center text-lg font-extrabold uppercase leading-tight tracking-[0.08em] text-balance text-ink sm:h-10 sm:text-xl"
                >
                  {m.nombre}
                </span>
              )}

              {/* `text-sm` y no `text-xs`: es lo único que explica QUÉ es cada
                  marca. A 12 px sobre gris claro, en móvil, no se lee — y sin
                  ese renglón la sección es un par de logos sin contexto. */}
              <span class="text-sm font-medium text-ink-subtle">
                <T v={m.rubro} resaltar />
              </span>
            </Tarjeta>
              );
            })()}
            </Fragment>
          </Reveal>
        ))}
      </ul>
    </Section>
  )
}

<style is:global>
  /**
   * El ancho de cada tarjeta sale de dividir la fila, no de un número fijo.
   *
   * ⚠️ ESTO NO SE PUEDE ESCRIBIR CON UTILIDADES DE TAILWIND porque depende de
   * `--cols`, que se calcula en el servidor a partir de cuántas marcas hay. Una
   * clase por cada número posible de columnas sería peor de mantener que estas
   * seis líneas.
   *
   * ⚠️ `is:global` NO ES PEREZA, ES OBLIGATORIO AQUÍ, y costó un rato entenderlo:
   * los `<li>` los pinta `Reveal`, que es OTRO componente, así que no llevan el
   * `data-astro-cid-…` de este y una regla con ámbito no los alcanza. Comprobado
   * en el navegador: el `<ul>` tenía el atributo y los `<li>` no, y el
   * `flex-basis` calculado salía `auto`. El riesgo de globalizar se acota con
   * `.aliados-fila`, una clase que solo existe en esta sección.
   *
   * Tres escalones, y el de en medio importa: en tableta se fuerzan DOS por
   * fila, sin mirar `--cols`. Con cuatro columnas a 640 px cada tarjeta se
   * quedaría en 140 px y el logo saldría del tamaño de un sello.
   */
  @media (min-width: 640px) {
    .aliados-fila > li {
      flex: 0 1 calc((100% - 1.5rem) / 2);
      /* Tope para cuando hay pocas marcas: con dos, media fila cada una serían
         tarjetas de 560 px con un logo diminuto flotando en el centro. */
      max-width: 20rem;
    }
  }

  @media (min-width: 1024px) {
    .aliados-fila > li {
      flex: 0 1 calc((100% - (var(--cols) - 1) * 1.5rem) / var(--cols));
    }
  }
</style>
