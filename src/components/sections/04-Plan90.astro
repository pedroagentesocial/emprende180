---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import { copy, cta, leadMagnet } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 04 · EL PLAN DE 90 DÍAS — «vale, ¿y qué hago yo exactamente?»
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Ocupa el sitio donde estaba "Tu red en 7 días", la sección del imán gratuito.
 * Lo pidió el cliente y tenía razón: dos plazos compitiendo en la misma página
 * —7 días y 90 días— hacen que ninguno signifique nada, y el que de verdad
 * describe el trabajo es el de 90.
 *
 * El imán no se pierde, cambia de rango: el reto de 7 correos deja de ser una
 * sección con su titular y pasa a ser el ÚLTIMO BLOQUE de esta, que es lo que
 * de verdad es — la forma de empezar hoy algo que dura tres meses.
 *
 * ⚠️ Y DE PASO ARREGLA UN BOTÓN QUE NO LLEVABA A NINGÚN SITIO. En la sección
 * vieja, el botón del imán apuntaba a `#gratis`… que era la propia sección en
 * la que estaba. O sea que pulsar "Quiero el reto de 7 días" desde el hero te
 * dejaba delante de un botón que no hacía nada. Ahora ese `id` vive en el
 * bloque de abajo y el botón lleva al formulario del cierre.
 *
 * ─── LA BARRA ES EL CALENDARIO A ESCALA ────────────────────────────────────
 *
 * Las cuatro fases NO duran lo mismo: 20, 25, 25 y 20 días, y la rejilla las
 * reparte con esa proporción exacta. Con cuatro columnas iguales quedaría más
 * ordenado y estaría mintiendo un poco.
 *
 * ─── ESCRITA PARA MIRARSE, NO PARA LEERSE ──────────────────────────────────
 *
 * Todas las frases caben en una o dos líneas. No es un capricho: la sección es
 * una rejilla de piezas cortas, y en cuanto una frase pasa a tres renglones su
 * vecina se queda corta y la fila se descuadra. Ver el aviso de `copy.plan90`.
 */

const { plan90 } = copy;

/**
 * ⚠️ LA PROPORCIÓN DE LA BARRA VA ESCRITA A MANO, Y TIENE QUE SER ASÍ.
 *
 * `lg:grid-cols-[20fr_25fr_25fr_20fr]` son los días de cada fase. Da la
 * tentación de construirla desde el config y NO FUNCIONA: Tailwind lee las
 * clases como texto al compilar, así que una clase armada a trozos no llega a
 * existir en el CSS. Y no avisa —sale una rejilla de columnas iguales, que es
 * justo la mentira que esta barra evita—, así que lo comprueba el aviso.
 */
const PROPORCION = "20fr_25fr_25fr_20fr";

if (import.meta.env.DEV) {
  const real = plan90.fases.map((f) => `${f.dias}fr`).join("_");
  if (real !== PROPORCION) {
    console.warn(
      `[04-Plan90] Los días de las fases cambiaron (${real}) y la barra sigue ` +
        `repartida como ${PROPORCION}. Hay que actualizar la clase ` +
        `lg:grid-cols-[…] a mano: Tailwind no puede construirla sola.`,
    );
  }
}

/** El color de cada tramo, de más claro a más oscuro. Ver la nota de arriba. */
const TRAMOS = [
  "bg-secondary-200",
  "bg-secondary-400",
  "bg-secondary-600",
  "bg-primary-900",
];
---

<Section id="plan" tono="surface" ariaLabel={plan90.aria}>
  {/* ─── FILA 1 · LA ISLA QUE ABRE, Y EL DÍA A DÍA AL LADO ───────────────── */}
  <div class="grid items-stretch gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-8">
    <div
      class="relative isolate flex flex-col justify-center overflow-hidden rounded-3xl bg-primary-950 p-8 sm:p-10"
    >
      <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

      <Reveal>
        <p class="inline-flex items-center gap-2 rounded-full border border-primary-800 bg-primary-900 px-3 py-1 text-xs font-bold tracking-wide text-secondary-300 uppercase">
          <span aria-hidden="true" class="marca-linea">
            <span class="size-1.5 rounded-full bg-secondary-500"></span>
          </span>
          <T v={plan90.kicker} />
        </p>

        <h2 class="mt-4 text-3xl font-extrabold text-balance text-ink-inverse sm:text-4xl">
          <T v={plan90.titulo} />
        </h2>

        <p class="mt-3 max-w-xl text-base text-pretty text-secondary-100 sm:text-lg">
          <T v={plan90.entradilla} />
        </p>

        {/* ─── LAS DOS HORAS, SOLAS Y GRANDES ────────────────────────────
            Es el dato que más cualifica de toda la página: espanta a quien no
            puede darlas y tranquiliza a quien sí. Un curso que no dice cuánto
            tiempo pide obliga a suponerlo, y quien supone, supone lo peor. */}
        <div class="mt-7 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-primary-800 pt-6">
          <p class="text-3xl font-extrabold tracking-tight text-ink-inverse sm:text-4xl">
            <T v={plan90.compromiso.valor} />
          </p>
          <p class="text-xs font-bold tracking-[0.14em] text-secondary-300 uppercase">
            <T v={plan90.compromiso.etiqueta} />
          </p>
          <p class="text-sm text-secondary-200">
            <T v={plan90.compromiso.nota} />
          </p>
        </div>

        <p class="mt-5 text-base font-semibold text-ink-inverse">
          <T v={plan90.regla} />
        </p>
        <p class="text-base font-semibold text-ink-inverse">
          <T v={plan90.limite} />
        </p>
        <p class="mt-1.5 text-sm text-secondary-100">
          <T v={plan90.acompanamiento} />
        </p>
      </Reveal>
    </div>

    {/* ─── EL DÍA, EN TRES BLOQUES ──────────────────────────────────────
        Los minutos van en su propia columna y alineados: tres cifras en
        columna se leen como un reparto, y metidas dentro de la frase se leen
        como texto. */}
    <Reveal delay={0.08} class="lg:h-full">
      <div
        class="flex h-full flex-col justify-center rounded-3xl border border-line bg-surface p-7 shadow-lg sm:p-8"
      >
        <h3 class="text-lg font-bold text-balance text-ink">
          <T v={plan90.dia.titulo} />
        </h3>

        <ul class="mt-5 grid gap-3.5">
          {
            plan90.dia.bloques.map((b) => (
              <li class="grid grid-cols-[4rem_minmax(0,1fr)] items-baseline gap-x-4 border-t border-line pt-3.5 first:border-t-0 first:pt-0">
                <p class="text-base font-extrabold tabular-nums text-ink-brand">
                  <T v={b.minutos} />
                </p>
                <div class="min-w-0">
                  <p class="font-semibold text-ink">
                    <T v={b.nombre} />
                  </p>
                  <p class="mt-0.5 text-sm text-pretty text-ink-muted">
                    <T v={b.para} />
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mt-5 border-t border-line pt-4 text-sm text-pretty text-ink-muted">
          <T v={plan90.dia.cambia} />
        </p>
      </div>
    </Reveal>
  </div>

  {/* ─── FILA 2 · LAS CUATRO FASES, A ESCALA ─────────────────────────────── */}
  <Reveal delay={0.12}>
    <div class="mt-12">
      <h3 class="text-xs font-bold tracking-[0.16em] text-ink-subtle uppercase">
        <T v={plan90.fasesTitulo} />
      </h3>

      <ol class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-[20fr_25fr_25fr_20fr] lg:gap-5">
        {
          plan90.fases.map((fase, i) => (
            <li>
              {/* El tramo de barra. `aria-hidden` porque el rango de días está
                  escrito justo debajo: la barra es la misma información en
                  forma de proporción, y repetirla en voz alta es ruido. */}
              <div
                aria-hidden="true"
                class:list={["h-1.5 rounded-full", TRAMOS[i] ?? "bg-secondary-400"]}
              />
              <p class="mt-3 text-xs font-bold tracking-wide text-ink-subtle uppercase">
                <T v={fase.rango} />
              </p>
              <p class="mt-1 text-lg font-bold text-balance text-ink">
                <T v={fase.nombre} />
              </p>
              <p class="mt-1 text-sm text-pretty text-ink-muted">
                <T v={fase.objetivo} />
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </Reveal>

  {/* ─── FILA 3 · LOS TRES HITOS, Y LA PUERTA DE ENTRADA ───────────────────
      Los hitos a la izquierda, en una línea cada uno: son lo que hace creíble
      todo lo demás —un plan que admite que a la mitad te puede decir "esto no
      es para ti" no está vendiendo humo— y para eso no hacen falta párrafos.

      Y el imán a la derecha, que es donde tiene sentido: acabas de leer que
      esto son 90 días, y nadie empieza 90 días desde una página de venta. Los
      primeros siete, gratis y por correo, sí se empiezan hoy. */}
  <Reveal delay={0.16}>
    <div class="mt-12 grid items-stretch gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-8">
      <div class="rounded-3xl bg-surface-muted p-7 ring-1 ring-line ring-inset sm:p-8">
        <h3 class="text-lg font-bold text-balance text-ink">
          <T v={plan90.hitosTitulo} />
        </h3>

        <ol class="mt-4 grid gap-3">
          {
            plan90.hitos.map((h) => (
              <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-t border-line pt-3 first:border-t-0 first:pt-0">
                <p class="text-sm font-extrabold tracking-wide text-ink-brand uppercase">
                  <T v={h.dia} />
                </p>
                <p class="text-sm text-pretty text-ink-muted">
                  <T v={h.texto} />
                </p>
              </li>
            ))
          }
        </ol>
      </div>

      {/* ⚠️ AQUÍ VIVE EL `id="gratis"`, y es el ancla a la que apunta el botón
          del hero. Si esto se mueve o se quita, ese botón deja de llevar a
          ninguna parte — que es exactamente lo que pasaba antes. */}
      <div
        id="gratis"
        class="relative isolate flex scroll-mt-24 flex-col justify-center overflow-hidden rounded-3xl bg-primary-900 p-7 text-center sm:p-8"
      >
        <MarcaAgua posicion="derecha" class="opacity-[0.07]" />

        <h3 class="text-xl font-bold text-balance text-ink-inverse">
          <T v={plan90.gratisTitulo} />
        </h3>
        <p class="mt-2 text-sm text-secondary-200">
          <T v={leadMagnet.formato} />
        </p>

        {/* Al formulario del cierre, que es donde se deja el correo. Antes este
            botón apuntaba a la propia sección: ver la nota de la cabecera. */}
        <div class="mt-6">
          <Button href="#empezar" variant="primary" trackId="plan-gratis" block>
            <T v={cta.secundario.texto} />
          </Button>
        </div>

        <p class="mt-3 text-[0.8125rem] text-secondary-200 sm:text-xs">
          <T v={leadMagnet.aviso} />
        </p>
      </div>
    </div>
  </Reveal>
</Section>
