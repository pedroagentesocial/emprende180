---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Button from "@components/ui/Button.astro";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 05 · QUÉ ES UN EMBAJADOR
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Dos fotos montadas a la izquierda, la definición a la derecha. Es la sección
 * de identidad: no explica qué se compra, explica en quién te conviertes.
 *
 * ─── EL COLLAGE NO LLEVA MARCO, Y ESO ES EL DISEÑO ─────────────────────────
 *
 * Sin borde, sin sombra y sin radio: dos fotos que se pisan y ya está. En
 * cuanto una de las dos lleva marco, las dos se leen como tarjetas, y dos
 * tarjetas concéntricas es exactamente lo que DESIGN.md prohíbe.
 *
 * La chica se sale por la izquierda a propósito. Encajada dentro de la grande
 * parece un error de recorte; saliéndose, se lee como lo que es, dos fotos
 * puestas una encima de otra.
 *
 * ⚠️ EL MONTAJE SOLO EXISTE DE `lg` PARA ARRIBA. Por debajo, la foto chica se
 * esconde: en 390 px de ancho, una foto encima de otra tapa la mitad de la de
 * abajo y no se entiende ninguna de las dos.
 *
 * ─── ADÓNDE VA EL BOTÓN ────────────────────────────────────────────────────
 *
 * A `#instructor`, que es la sección donde ya se cuenta quién está detrás, y
 * es adonde manda "Quiénes somos" en el menú. La maqueta apuntaba a `/about`,
 * una página que no existe: un botón de identidad que lleva a un 404 hace
 * exactamente el daño contrario al que busca esta sección.
 */

const { embajador } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Las dos fotos del montaje. Ver la nota de `03-Guias.astro`: son de banco y
   se repiten con otras partes de la página, y es lo primero que hay que
   cambiar cuando haya una sesión de fotos de verdad. */
const FOTO_GRANDE = "/imagenes/secciones/resultados.webp";
const FOTO_CHICA = "/imagenes/resultados/03.webp";
---

<Section id="embajador" tono="muted" ariaLabel={embajador.aria}>
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    {/* ─── El montaje ─────────────────────────────────────────────────────
        `pl-*` en escritorio para dejarle sitio a la foto chica, que se sale
        por la izquierda. Sin ese hueco se comería el margen de la página. */}
    <Reveal class="relative lg:pl-16">
      <img
        src={FOTO_GRANDE}
        alt={embajador.fotoGrande[lang]}
        data-alt-es={embajador.fotoGrande.es}
        data-alt-en={embajador.fotoGrande.en}
        width={1000}
        height={800}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover"
      />

      {/* La chica, montada abajo a la izquierda. `aria-hidden` no: tiene alt y
          se lee, pero va después de la grande en el orden del documento, que
          es el orden en que se miran. */}
      <img
        src={FOTO_CHICA}
        alt={embajador.fotoChica[lang]}
        data-alt-es={embajador.fotoChica.es}
        data-alt-en={embajador.fotoChica.en}
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
        class="absolute bottom-[-2.5rem] left-0 hidden aspect-[4/3] w-44 object-cover lg:block xl:w-52"
      />
    </Reveal>

    {/* ─── La definición ──────────────────────────────────────────────────── */}
    <Reveal>
      <p class="text-xs font-bold tracking-[0.18em] text-ink-brand uppercase">
        <T v={embajador.kicker} />
      </p>

      <h2 class="mt-4 text-3xl leading-tight font-extrabold text-balance text-ink sm:text-4xl lg:text-5xl">
        {
          embajador.titulo.map((linea) => (
            <span class="block">
              {"enfasis" in linea && linea.enfasis ? (
                <Enfasis v={linea} />
              ) : (
                <T v={linea} />
              )}
            </span>
          ))
        }
      </h2>

      {
        embajador.texto.map((parrafo) => (
          <p class="mt-5 max-w-prose text-base text-pretty text-ink-muted sm:text-lg">
            <T v={parrafo} />
          </p>
        ))
      }

      <div class="mt-8">
        <Button href="#instructor" trackId="embajador-quienes-somos">
          <T v={embajador.cta} />
        </Button>
      </div>
    </Reveal>
  </div>
</Section>
