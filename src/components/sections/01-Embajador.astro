---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Button from "@components/ui/Button.astro";
import ComoTrabajar from "@components/sections/02-ComoTrabajar.astro";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 01 · QUÉ ES UNA EMBAJADORA
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lo primero después del hero. No explica qué se compra: explica que lo que
 * ella ya hace tiene nombre.
 *
 * ─── ESTA SECCIÓN NO USA EL CONTENEDOR DE LA PÁGINA ────────────────────────
 *
 * El resto del sitio vive dentro de `container-page`, que son 72rem centradas.
 * Aquí son 88rem: en una pantalla de 1440 eso deja el contenido a 16 px de cada
 * borde en vez de a 144. Es lo que se pidió mirando bossbabe, y no es capricho
 * de anchura: con 72rem, una fila de dos columnas deja tanto aire a los lados
 * que la sección entera se lee como una tarjeta centrada más.
 *
 * ⚠️ SI ALGUIEN LA DEVUELVE A `container-page`, la asimetría se pierde entera.
 * No es solo que se estreche: las dos columnas vuelven a parecerse y el bloque
 * de texto deja de tener sitio para caer donde cae.
 *
 * ─── LAS DOS COLUMNAS NO MIDEN LO MISMO NI EMPIEZAN A LA MISMA ALTURA ──────
 *
 * La rejilla es 1,15 / 0,85, no 1 / 1, y va `items-end`: el texto se alinea con
 * el BORDE DE ABAJO de la foto en vez de centrarse contra ella. Las dos cosas
 * juntas son toda la asimetría de la sección, y las dos son deliberadas.
 *
 * Centrado y a partes iguales es lo que sale por defecto, y es justo lo que se
 * pidió quitar: "todo está muy estructurado".
 *
 * ─── EL COLLAGE NO LLEVA MARCO ─────────────────────────────────────────────
 *
 * Sin borde, sin sombra y sin radio: dos fotos que se pisan y ya está. En
 * cuanto una lleva marco, las dos se leen como tarjetas apiladas, y dos
 * tarjetas concéntricas es lo que DESIGN.md prohíbe.
 *
 * La chica se sale por la DERECHA de la grande, metiéndose en el hueco entre
 * columnas. Ese hueco es espacio muerto en cualquier rejilla de dos; usándolo,
 * las dos columnas dejan de ser dos bloques que conviven y pasan a ser una
 * sola composición.
 *
 * ⚠️ SOLO DE `lg` PARA ARRIBA. Por debajo no hay dos columnas ni hueco entre
 * ellas, así que la foto chica se esconde: encima de la grande taparía justo la
 * cara de las dos mujeres, que es lo único que esa foto tiene que enseñar.
 *
 * ─── Y AQUÍ DENTRO VIVE TAMBIÉN "CÓMO SE TRABAJA" ──────────────────────────
 *
 * Las dos eran secciones separadas, cada una con su fondo. Son la misma
 * respuesta partida en dos —qué es una Embajadora y con qué trabaja— y el
 * cambio de color en medio las convertía en dos temas que no se conocen.
 *
 * Van en la misma sección, sobre el mismo fondo y separadas solo por un filete.
 * Es lo mismo que se hizo con los testimonios y los logos, y por lo mismo.
 */

const { embajador } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Las dos fotos del montaje. Ver la nota de `09-Cierre.astro`: son de banco y
   se repiten con otras partes de la página, y es lo primero que hay que
   cambiar cuando haya una sesión de fotos de verdad. */
const FOTO_GRANDE = "/imagenes/resultados/03.webp";
const FOTO_CHICA = "/imagenes/resultados/06.webp";
---

<Section id="embajador" tono="muted" ariaLabel={embajador.aria} sinContenedor>
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-14">
      {/* ─── El montaje ─────────────────────────────────────────────────── */}
      <Reveal class="relative">
        <img
          src={FOTO_GRANDE}
          alt={embajador.fotoGrande[lang]}
          data-alt-es={embajador.fotoGrande.es}
          data-alt-en={embajador.fotoGrande.en}
          width={1000}
          height={800}
          loading="lazy"
          decoding="async"
          class="aspect-[5/4] w-full object-cover"
        />

        {/* Se sale por la derecha y por abajo. `translate-x` y no un `right`
            negativo: así el desbordamiento no cuenta para el ancho de la
            columna y la rejilla no se descuadra al reducir la ventana.

            ⚠️ EL DESPLAZAMIENTO ES FIJO Y NO UNA FRACCIÓN. Con `translate-x-1/3`
            el desbordamiento crecía con el ancho de la foto, así que en `xl`,
            donde la foto pasa a 192 px, se comía los primeros píxeles de cada
            renglón del párrafo de al lado. 32 px caben siempre en el hueco. */}
        <img
          src={FOTO_CHICA}
          alt={embajador.fotoChica[lang]}
          data-alt-es={embajador.fotoChica.es}
          data-alt-en={embajador.fotoChica.en}
          width={800}
          height={600}
          loading="lazy"
          decoding="async"
          class="absolute right-0 bottom-0 hidden aspect-[4/5] w-40 translate-x-8 translate-y-8 object-cover lg:block xl:w-48"
        />
      </Reveal>

      {/* ─── La definición ──────────────────────────────────────────────────
          `pb-4` de más en escritorio: con `items-end` a pelo, la última línea
          del botón quedaba clavada en el mismo píxel que el borde de la foto, y
          dos bordes que coinciden exactamente parecen un accidente. Un poco de
          desfase se lee como intención. */}
      <Reveal delay={0.1} class="lg:pb-4">
        <p class="text-sm font-semibold text-ink-brand">
          <T v={embajador.kicker} />
        </p>

        <h2 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance text-ink sm:text-5xl">
          {
            embajador.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))
          }
        </h2>

        {
          embajador.texto.map((parrafo) => (
            <p class="mt-5 max-w-prose text-base text-pretty text-ink-muted sm:text-lg">
              <T v={parrafo} />
            </p>
          ))
        }

        <div class="mt-8">
          {/* A `/about`, que es una página de verdad desde hoy. Antes esto
              apuntaba a `#instructor`, una sección que ya no existe. */}
          <Button href="/about" trackId="embajador-about">
            <T v={embajador.cta} />
          </Button>
        </div>
      </Reveal>
    </div>

    {/* El filete y el aire son toda la separación que hace falta: un cambio de
        fondo aquí volvería a partir en dos lo que es una sola idea. */}
    <div class="mt-16 border-t border-line pt-14 lg:mt-24 lg:pt-20">
      <ComoTrabajar />
    </div>
  </div>
</Section>
