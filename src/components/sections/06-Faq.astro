---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Icono from "@components/ui/Icono.astro";
import { faqs, contacto, copy, instructor } from "@config/curso.config";
import { resolverIdiomaServidor, LOCALES } from "@i18n/idioma";
import { faltaPorRellenar, resaltarPendientes } from "@lib/pendientes";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 06 · PREGUNTAS FRECUENTES — la última duda
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Vuelve a la portada el 15-09-2026, en el hueco que dejó el blog (que se mudó
 * a /resources). Es la misma sección que hubo hasta que se quitaron siete de
 * golpe, recuperada del historial y con tres cambios:
 *
 *   1. Las preguntas de precio, pago y garantía NO se pintan (`soloCurso`):
 *      la portada dejó de vender el curso y una pregunta sobre "pagar en
 *      partes" en una página sin precio es una pregunta que nadie se hizo.
 *   2. Los dos botones del cierre son la píldora del sitio.
 *   3. "Dejarme tus datos" lleva al formulario de Empezar, que es la única
 *      puerta que hay hoy.
 *
 * ─── SON `<details name="faq">`, NO UN ACORDEÓN DE JAVASCRIPT ──────────────
 *
 * El atributo `name` compartido hace que abrir una cierre las demás, y lo hace
 * el navegador: teclado, rol de botón y el anuncio de "contraído/expandido"
 * vienen puestos. Y algo que un acordeón a mano no puede: Ctrl+F encuentra el
 * texto dentro de un `<details>` cerrado y lo abre solo. La animación de
 * altura vive en global.css (`interpolate-size` + `::details-content`).
 *
 * ─── LA PRIMERA VA ABIERTA ─────────────────────────────────────────────────
 *
 * Con todas cerradas la sección era una columna de barras grises que no
 * enseñaba ni una respuesta. Con la primera abierta se ve el TONO sin hacer
 * nada, y las demás se leen sabiendo que merece la pena abrirlas. Es la
 * primera y no otra porque `faqs[0]` es la objeción más común: "no tengo
 * experiencia en el sector".
 *
 * ─── LAS RESPUESTAS A MEDIAS NO SALEN A LA CALLE ───────────────────────────
 *
 * En producción se filtra cualquier respuesta con `[COMPLETAR]`: la
 * respuesta a "¿hace falta licencia?" es un HECHO regulado, y una inventada no
 * es una errata, es una infracción. En desarrollo salen todas, resaltadas.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const enPortada = faqs.filter((f) => !f.soloCurso);
const faqsVisibles = import.meta.env.DEV
  ? enPortada
  : enPortada.filter((f) => !faltaPorRellenar(f.respuesta));

/* El JSON-LD se construye sobre lo que SE VE, en el idioma servido, y sin
   ninguna respuesta pendiente: el marcado tiene que corresponder al contenido
   visible, que es lo que Google pide. */
const paraSchema = faqsVisibles.filter((f) => !faltaPorRellenar(f.respuesta));
const schemaFaq =
  paraSchema.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: LOCALES[lang],
        mainEntity: paraSchema.map((f) => ({
          "@type": "Question",
          name: f.pregunta[lang],
          acceptedAnswer: { "@type": "Answer", text: f.respuesta[lang] },
        })),
      }
    : null;
---

{/* ─── UNA COLUMNA, CENTRADA ──────────────────────────────────────────────────
    El título centrado arriba, las preguntas en una lista numerada con filetes
    (sin cajas grises) y, debajo, el bloque de Pedro compacto. Es la TERCERA
    forma de esta sección en dos días y conviene dejar escrito por qué se
    fueron las dos anteriores:

      1. Título pegajoso a la derecha + preguntas en tarjetas a la izquierda +
         Pedro debajo del título. El cliente bajó a Pedro debajo de la lista.
      2. Lo mismo con Pedro en una franja gris de lado a lado debajo. El
         resultado dejaba media pantalla blanca bajo el título y una franja
         casi vacía abajo: "tan larga de extremo a extremo y con tanto espacio
         blanco no me gusta nada, el diseño de las cards muy feo".

    Una sola columna de 56rem resuelve las dos cosas: no hay columna vacía y no
    hay franja que llenar. Las preguntas dejan de ser tarjetas y pasan a ser
    filas de una lista —número, pregunta, "+"— separadas por filetes, que es
    la forma editorial de todo el sitio. Y Pedro va en una tarjeta pequeña
    centrada (avatar redondo, frase, dos botones), no a sangre.

    ─── LA ANIMACIÓN ───────────────────────────────────────────────────────────
    La respuesta se DESPLIEGA, no aparece de golpe: `::details-content` pasa de
    alto 0 a auto con `interpolate-size: allow-keywords` (Chrome y Edge desde
    la 129, Safari desde la 18.4), y el párrafo entra con un fundido y 6 px de
    subida. Donde el navegador no sabe interpolar a `auto` (Firefox hoy), la
    respuesta abre al instante y solo se ve el fundido: se degrada, no se
    rompe. El "+" gira 45° y se convierte en "×", y la pregunta abierta se
    pinta en teal. Todo respeta `prefers-reduced-motion`. */}
<Section id="faq" tono="surface" ariaLabel={copy.faq.aria}>
  {/* ⚠️ DOS COLUMNAS OTRA VEZ, Y ESTA VEZ SIN LA COLUMNA VACÍA. El cliente lo
      pidió el 16-09-2026 sobre el rediseño de una columna: "manda el título a
      la derecha y a la izquierda preguntas, y el otro elemento centrado entre
      los dos". Título pegajoso a la derecha (22rem), la lista a la izquierda,
      y la tarjeta de Pedro DEBAJO de las dos columnas, centrada en el ancho
      entero. Lo que antes dejaba media pantalla blanca era la franja de Pedro
      pegada bajo la lista mientras el título flotaba solo; ahora el título
      acompaña a la lista y la tarjeta cierra la sección en el centro.

      ORDEN DEL DOM ≠ ORDEN VISUAL. El título va PRIMERO en el marcado y se
      manda a la derecha con `order`: al revés, un lector de pantalla
      recorrería la lista entera sin saber de qué sección le hablan. */}
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-x-16 xl:gap-x-24">
    <aside class="lg:order-2">
      <div class="lg:sticky lg:top-28">
        <Reveal>
          <h2 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl lg:text-5xl">
            <T v={copy.faq.titulo} />
          </h2>
        </Reveal>
      </div>
    </aside>

    {/* La lista. Filete arriba y uno por pregunta; `name="faq"` hace que abrir
        una cierre la anterior, y el guion de abajo impide que se cierre la que
        está abierta: siempre hay una respuesta a la vista. */}
    <div class="border-t border-line lg:order-1">
      {
        faqsVisibles.map((f, i) => (
          <Reveal delay={Math.min(i, 4) * 0.05}>
            <details data-faq name="faq" open={i === 0} class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-baseline gap-5 py-5 pr-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus sm:gap-8 sm:py-6">
                <span
                  aria-hidden="true"
                  class="w-7 shrink-0 text-sm font-bold tabular-nums tracking-[0.12em] text-ink-brand sm:w-9 sm:text-base"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="flex-1 text-lg font-bold text-pretty text-ink transition-colors duration-300 ease-out-soft group-open:text-ink-brand sm:text-xl lg:text-2xl">
                  <T v={f.pregunta} />
                </h3>
                {/* El "+" gira 45° y se convierte en "×". */}
                <span aria-hidden="true" class="marca-linea">
                  <span class="grid size-8 place-items-center rounded-full border border-line text-ink-muted transition-[transform,background-color,color,border-color] duration-300 ease-out-expo group-open:rotate-45 group-open:border-cta group-open:bg-cta group-open:text-ink-inverse group-hover:border-line-strong">
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke-width="2.5">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" />
                    </svg>
                  </span>
                </span>
              </summary>
              <div class="faq-respuesta pb-6 pl-12 pr-12 sm:pb-7 sm:pl-[4.25rem] sm:pr-16">
                <p
                  class="max-w-prose text-base font-medium leading-relaxed text-pretty text-ink-muted sm:text-lg"
                  data-t="es"
                  lang="es"
                  set:html={resaltarPendientes(f.respuesta.es)}
                />
                <p
                  class="max-w-prose text-base font-medium leading-relaxed text-pretty text-ink-muted sm:text-lg"
                  data-t="en"
                  lang="en"
                  set:html={resaltarPendientes(f.respuesta.en)}
                />
              </div>
            </details>
          </Reveal>
        ))
      }
    </div>
  </div>

    {/* ─── LA DUDA QUE NO ESTÁ EN LA LISTA ─────────────────────────────────
        Tarjeta pequeña y centrada: el avatar redondo de Pedro (es quien
        contesta), la frase, los dos botones en fila y el correo. Llamar, si
        hay número, y dejar los datos en el formulario de Empezar. Con borde y
        sin fondo: sobre blanco, un bloque gris se leía como una franja. */}
  <Reveal delay={0.1}>
      <div class="mx-auto mt-12 flex max-w-3xl flex-col items-center gap-6 rounded-3xl border border-line p-6 text-center sm:flex-row sm:items-center sm:gap-8 sm:p-8 sm:text-left lg:mt-16">
        {/* El recorte cuadrado, que existe para los avatares: en un círculo
            de 96 px la foto apaisada del despacho dejaba la cara diminuta. */}
        <img
          src={instructor.fotoCuadrada}
          alt={instructor.fotoAlt[lang]}
          data-alt-es={instructor.fotoAlt.es}
          data-alt-en={instructor.fotoAlt.en}
          width={600}
          height={600}
          loading="lazy"
          decoding="async"
          class="size-24 shrink-0 rounded-full border-4 border-surface object-cover object-top shadow-lg sm:size-28"
        />
        <div class="min-w-0 flex-1">
          <p class="text-xl font-extrabold text-balance text-ink sm:text-2xl">
            <T v={copy.faq.quedaDuda} />
          </p>
          <p class="mt-1.5 text-base font-medium text-pretty text-ink-muted sm:text-lg">
            <T v={copy.faq.quedaDudaTexto} />
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3 sm:justify-start">
            {
              contacto.telefono && (
                <Button href={`tel:${contacto.telefono}`} size="md" trackId="faq-llamada">
                  <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                  <T v={copy.instructor.llamame} />
                </Button>
              )
            }
            {/* Con la barra: la sección vive en la portada y en /resources, y
                desde la segunda un ancla pelada no llevaría a ningún sitio. */}
            <Button href="/#empezar" size="md" trackId="faq-contacto">
              <Icono nombre="conversacion" class="size-4 shrink-0" grosor={2} />
              <T v={copy.faq.contactar} />
            </Button>
          </div>
          <p class="mt-3 text-sm font-medium text-ink-subtle">{contacto.email}</p>
        </div>
      </div>
  </Reveal>
</Section>

<style>
  /* La respuesta se despliega. `::details-content` es la caja que envuelve todo
     lo que no es el `summary`; con `interpolate-size` el navegador sabe ir de 0
     a `auto`. Donde no lo sepa, la transición no hace nada y abre al instante. */
  details[data-faq] {
    interpolate-size: allow-keywords;
  }
  details[data-faq]::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 420ms var(--ease-out-expo),
      content-visibility 420ms allow-discrete;
  }
  details[data-faq][open]::details-content {
    block-size: auto;
  }
  /* El párrafo entra con un fundido y una subida corta, a la vez que la caja
     crece. Solo al abrir: al cerrar, la caja se pliega y ya. */
  details[data-faq][open] .faq-respuesta {
    animation: faq-entra 480ms var(--ease-out-soft) both;
  }
  @keyframes faq-entra {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    details[data-faq]::details-content {
      transition: none;
    }
    details[data-faq][open] .faq-respuesta {
      animation: none;
    }
  }
</style>

{schemaFaq && <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />}

<script>
  /**
   * ⚠️ SIEMPRE HAY UNA PREGUNTA ABIERTA. Con `<details name="faq">` abrir una
   * cierra las demás, pero pulsar la que ya está abierta la cierra y deja la
   * lista sin ninguna respuesta a la vista, que es justo el muro de barras
   * grises que la primera abierta evita. Se pidió que nunca pase.
   *
   * La forma limpia es no dejar que la abierta se cierre desde su propio
   * `summary`: se intercepta el clic y se anula. Abrir otra sigue funcionando
   * como siempre, porque ese clic cae en un `summary` cerrado y no se toca.
   * El teclado va por el mismo camino: Enter y espacio sobre un `summary`
   * disparan `click`.
   */
  function montarFaq() {
    document.querySelectorAll<HTMLElement>("[data-faq] > summary").forEach((s) => {
      if (s.dataset.montado) return;
      s.dataset.montado = "1";
      s.addEventListener("click", (e) => {
        const d = s.parentElement as HTMLDetailsElement | null;
        if (d?.open) e.preventDefault();
      });
    });
  }
  montarFaq();
  document.addEventListener("astro:page-load", montarFaq);
</script>
