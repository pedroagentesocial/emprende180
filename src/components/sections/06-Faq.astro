---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Icono from "@components/ui/Icono.astro";
import { faqs, contacto, copy, instructor } from "@config/curso.config";
import { resolverIdiomaServidor, LOCALES } from "@i18n/idioma";
import { faltaPorRellenar, resaltarPendientes } from "@lib/pendientes";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 06 · PREGUNTAS FRECUENTES — la última duda
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Vuelve a la portada el 15-09-2026, en el hueco que dejó el blog (que se mudó
 * a /resources). Es la misma sección que hubo hasta que se quitaron siete de
 * golpe, recuperada del historial y con tres cambios:
 *
 *   1. Las preguntas de precio, pago y garantía NO se pintan (`soloCurso`):
 *      la portada dejó de vender el curso y una pregunta sobre "pagar en
 *      partes" en una página sin precio es una pregunta que nadie se hizo.
 *   2. Los dos botones del cierre son la píldora del sitio.
 *   3. "Dejarme tus datos" lleva al formulario de Empezar, que es la única
 *      puerta que hay hoy.
 *
 * ─── SON `<details name="faq">`, NO UN ACORDEÓN DE JAVASCRIPT ──────────────
 *
 * El atributo `name` compartido hace que abrir una cierre las demás, y lo hace
 * el navegador: teclado, rol de botón y el anuncio de "contraído/expandido"
 * vienen puestos. Y algo que un acordeón a mano no puede: Ctrl+F encuentra el
 * texto dentro de un `<details>` cerrado y lo abre solo. La animación de
 * altura vive en global.css (`interpolate-size` + `::details-content`).
 *
 * ─── LA PRIMERA VA ABIERTA ─────────────────────────────────────────────────
 *
 * Con todas cerradas la sección era una columna de barras grises que no
 * enseñaba ni una respuesta. Con la primera abierta se ve el TONO sin hacer
 * nada, y las demás se leen sabiendo que merece la pena abrirlas. Es la
 * primera y no otra porque `faqs[0]` es la objeción más común: "no tengo
 * experiencia en el sector".
 *
 * ─── LAS RESPUESTAS A MEDIAS NO SALEN A LA CALLE ───────────────────────────
 *
 * En producción se filtra cualquier respuesta con `[COMPLETAR]`: la
 * respuesta a "¿hace falta licencia?" es un HECHO regulado, y una inventada no
 * es una errata, es una infracción. En desarrollo salen todas, resaltadas.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const enPortada = faqs.filter((f) => !f.soloCurso);
const faqsVisibles = import.meta.env.DEV
  ? enPortada
  : enPortada.filter((f) => !faltaPorRellenar(f.respuesta));

/* El JSON-LD se construye sobre lo que SE VE, en el idioma servido, y sin
   ninguna respuesta pendiente: el marcado tiene que corresponder al contenido
   visible, que es lo que Google pide. */
const paraSchema = faqsVisibles.filter((f) => !faltaPorRellenar(f.respuesta));
const schemaFaq =
  paraSchema.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: LOCALES[lang],
        mainEntity: paraSchema.map((f) => ({
          "@type": "Question",
          name: f.pregunta[lang],
          acceptedAnswer: { "@type": "Answer", text: f.respuesta[lang] },
        })),
      }
    : null;
---

{/* ─── EL REPARTO EN DOS COLUMNAS ─────────────────────────────────────────────
    Preguntas a la izquierda, título a la derecha y fijo mientras se bajan. Una
    columna de once barras a lo ancho es un muro; a media anchura cada pregunta
    se lee de un golpe de vista.

    ORDEN DEL DOM ≠ ORDEN VISUAL. El encabezado va PRIMERO en el marcado y se
    manda a la derecha con `order`: al revés, un lector de pantalla recorrería
    la lista entera sin saber de qué sección le hablan. */}
<Section id="faq" tono="muted" ariaLabel={copy.faq.aria}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-x-16 xl:gap-x-24">
    <aside class="lg:order-2">
      <div class="lg:sticky lg:top-28">
        <Reveal>
          {/* Solo el título. El recuento de "11 dudas resueltas" y la
              entradilla se quitaron el 15-09-2026 a petición del cliente: la
              columna es el título y, debajo, la salida para quien no encuentra
              su duda. */}
          <h2 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl lg:text-5xl">
            <T v={copy.faq.titulo} />
          </h2>

          {/* ─── LA DUDA QUE NO ESTÁ EN LA LISTA ──────────────────────────
              Debajo del título y no cerrando la sección a lo ancho: así queda
              a la vista mientras se recorren las preguntas, que es cuando
              surge la que no está. Llamar, si hay número, y dejar los datos en
              el formulario de Empezar. El correo escrito debajo, para quien
              prefiera copiarlo. */}
          {/* Pedro, escuchando. Va justo encima de "¿te queda una duda?"
              porque es quien la contesta: la foto pone cara al "escríbeme".
              Es la de la mano en la barbilla, que es el gesto de escuchar; se
              añadió el 16-09-2026 con el resto de retratos que faltaban. */}
          <img
            src={instructor.retratos.sentado.src}
            alt={instructor.retratos.sentado.alt[lang]}
            data-alt-es={instructor.retratos.sentado.alt.es}
            data-alt-en={instructor.retratos.sentado.alt.en}
            width={instructor.retratos.sentado.ancho}
            height={instructor.retratos.sentado.alto}
            loading="lazy"
            decoding="async"
            class="mt-8 aspect-[3/2] w-full max-w-sm rounded-lg border border-line object-cover"
          />

          <p class="mt-6 text-lg font-bold text-balance text-ink sm:text-xl">
            <T v={copy.faq.quedaDuda} />
          </p>
          <p class="mt-2 text-base font-medium text-pretty text-ink-muted sm:text-lg">
            <T v={copy.faq.quedaDudaTexto} />
          </p>

          <div class="mt-6 flex flex-col items-start gap-3">
            {
              contacto.telefono && (
                <Button href={`tel:${contacto.telefono}`} trackId="faq-llamada">
                  <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                  <T v={copy.instructor.llamame} />
                </Button>
              )
            }

            {/* Con la barra: la sección vive en la portada y en /resources
                desde el 15-09-2026, y desde la segunda un ancla pelada no
                llevaría a ningún sitio. En la portada es el mismo salto. */}
            <Button href="/#empezar" trackId="faq-contacto">
              <Icono nombre="conversacion" class="size-4 shrink-0" grosor={2} />
              <T v={copy.faq.contactar} />
            </Button>
          </div>

          <p class="mt-4 text-sm text-ink-subtle">{contacto.email}</p>
        </Reveal>
      </div>
    </aside>

    {/* Aire entre preguntas en vez de filetes pegados: cada una es una tarjeta
        suelta, y eso es lo que hace que once no parezcan un muro. */}
    <div class="grid content-start gap-3 lg:order-1">
      {
        faqsVisibles.map((f, i) => (
          <Reveal delay={Math.min(i, 4) * 0.04}>
            <details
              data-faq
              name="faq"
              open={i === 0}
              class="group rounded-lg border-[0.5px] border-line bg-surface transition-colors duration-200 ease-out-soft open:border-secondary-300 open:bg-secondary-50/40 hover:border-line-strong open:hover:border-secondary-300"
            >
              {/* `items-start` y no `items-center`: con el "+" centrado sobre el
                  bloque, una pregunta de una línea y otra de tres lo dejaban a
                  alturas distintas. El cuerpo de letra vive en el `summary`
                  porque `marca-linea` mide `1lh` heredando la tipografía de su
                  PADRE. Ver global.css. */}
              <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-base focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus sm:px-6 sm:py-5 sm:text-lg">
                <h3 class="font-semibold text-balance text-ink">
                  <T v={f.pregunta} />
                </h3>

                {/* El "+" gira 45° y se convierte en "×". Ver global.css. */}
                <span aria-hidden="true" class="marca-linea">
                  <span
                    data-faq-icono
                    class="grid size-8 place-items-center rounded-full bg-surface-muted text-ink-muted group-open:bg-secondary-500 group-open:text-ink-inverse"
                  >
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke-width="2.5">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" />
                    </svg>
                  </span>
                </span>
              </summary>

              <div class="px-5 pb-5 sm:px-6 sm:pb-6">
                <p
                  class="border-t-[0.5px] border-line pt-4 text-base font-medium text-pretty text-ink-muted sm:text-lg"
                  data-t="es"
                  lang="es"
                  set:html={resaltarPendientes(f.respuesta.es)}
                />
                <p
                  class="border-t-[0.5px] border-line pt-4 text-base font-medium text-pretty text-ink-muted sm:text-lg"
                  data-t="en"
                  lang="en"
                  set:html={resaltarPendientes(f.respuesta.en)}
                />
              </div>
            </details>
          </Reveal>
        ))
      }
    </div>

  </div>
</Section>

{schemaFaq && <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />}

<script>
  /**
   * ⚠️ SIEMPRE HAY UNA PREGUNTA ABIERTA. Con `<details name="faq">` abrir una
   * cierra las demás, pero pulsar la que ya está abierta la cierra y deja la
   * lista sin ninguna respuesta a la vista, que es justo el muro de barras
   * grises que la primera abierta evita. Se pidió que nunca pase.
   *
   * La forma limpia es no dejar que la abierta se cierre desde su propio
   * `summary`: se intercepta el clic y se anula. Abrir otra sigue funcionando
   * como siempre, porque ese clic cae en un `summary` cerrado y no se toca.
   * El teclado va por el mismo camino: Enter y espacio sobre un `summary`
   * disparan `click`.
   */
  function montarFaq() {
    document.querySelectorAll<HTMLElement>("[data-faq] > summary").forEach((s) => {
      if (s.dataset.montado) return;
      s.dataset.montado = "1";
      s.addEventListener("click", (e) => {
        const d = s.parentElement as HTMLDetailsElement | null;
        if (d?.open) e.preventDefault();
      });
    });
  }
  montarFaq();
  document.addEventListener("astro:page-load", montarFaq);
</script>
