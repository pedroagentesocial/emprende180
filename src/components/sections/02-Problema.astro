---
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import FilaAlterna from "@components/ui/FilaAlterna.astro";
import Icono, { type NombreIcono } from "@components/ui/Icono.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Escena from "@components/visuales/Escena.astro";
import { curso, copy, cta } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 02 · EL PROBLEMA + PARA QUIÉN ES
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Dos trabajos encadenados: describir la situación del lector mejor de lo que
 * la describiría él (nadie compra una solución hasta que siente que le
 * entienden el problema), y que el lector correcto se reconozca.
 *
 * ─── POR QUÉ SE REHÍZO ─────────────────────────────────────────────────────
 *
 * Era una columna única de 42rem con cinco frases largas seguidas, una cita, y
 * debajo una tarjeta con cuatro frases largas más. Unas 190 palabras en fila
 * india, todas del mismo tamaño y del mismo color. El problema no era el texto:
 * era que no había NADA que mirar antes de decidir si merecía la pena leerlo.
 *
 * Ahora la sección tiene tres tiempos y un ritmo de lectura distinto en cada uno:
 *
 *   1. FILA — el titular y la entradilla, con el dibujo de la red al lado.
 *      Se entiende de qué va sin leer una frase entera.
 *   2. REJILLA — los cinco dolores, reducidos a un titular de cuatro palabras
 *      con su icono. Aquí es donde se recupera el tiempo: se escanean en dos
 *      segundos en vez de leerse en veinte. El detalle sigue estando, y
 *      aparece al pasar el cursor.
 *   3. FILA INVERTIDA — el coste de no hacer nada, con la línea del año al
 *      lado, y el reconocimiento + la primera acción de la página.
 *
 * Se eliminó la tarjeta grande de "Si te reconociste arriba": su contenido vive
 * ahora en la columna de texto de la fila 3. Era un bloque entero para repetir
 * lo que la rejilla acaba de decir.
 *
 * ─── SOBRE LA REJILLA Y LA PROHIBICIÓN DE DESIGN.md ────────────────────────
 *
 * DESIGN.md prohíbe "rejillas de tarjetas idénticas (icono + título + texto en
 * bucle)", y esto se le parece. La diferencia, y es lo que hay que mantener si
 * alguien la retoca: NO SON TARJETAS. No hay caja, ni borde, ni sombra, ni
 * fondo. Son cinco entradas de una lista repartidas en columnas, que es una
 * decisión de maquetación, no un adorno. Lo que la prohibición persigue es el
 * andamiaje de plantilla —la caja redondeada con su iconito de color que se
 * repite seis veces— y aquí no hay ninguna caja.
 *
 * Si alguien añade `rounded-2xl border bg-surface p-6` a estos `<li>`, la
 * sección pasa a ser exactamente lo que el documento prohíbe.
 *
 * ─── EL DETALLE AL PASAR EL CURSOR ─────────────────────────────────────────
 *
 * Solo se colapsa donde hay ratón de verdad. En móvil y en táctil el detalle se
 * ve siempre: ahí no hay cursor que pasar, y esconderlo detrás de un gesto
 * imposible en la pantalla que usa el 73 % de esta audiencia sería un error.
 * Ver el bloque `[data-revelar]` en global.css.
 *
 * La regla de contenido que lo sostiene: el titular tiene que entenderse SOLO.
 * El detalle amplía, nunca completa. Está en la cabecera de `dolores`.
 *
 * ─── LA COLUMNA "NO ES PARA TI SI…" ────────────────────────────────────────
 *
 * Se quitó hace tiempo por decisión del cliente: quiere que la página empuje a
 * comprar, no que descalifique. Los datos siguen en `curso.paraQuienNo`. Los
 * límites REALES (licencia, territorio, remuneración) viven en las FAQ, que es
 * donde se buscan cuando ya se quiere comprar.
 */

/**
 * El icono de cada dolor, emparejado POR POSICIÓN con `curso.problema.dolores`.
 *
 * Vive aquí y no en el config a propósito: qué dibujo acompaña a un texto es
 * maquetación, no contenido, y el config no tiene por qué saber qué iconos
 * existen. Si se añade un sexto dolor sin añadir su icono, `?? "red"` evita que
 * la página se rompa y simplemente repite uno.
 */
const ICONOS: NombreIcono[] = [
  "red",
  "ojo",
  "telefono",
  "conversacion",
  "calendario",
];

const dolores = curso.problema.dolores.map((d, i) => ({
  ...d,
  icono: ICONOS[i] ?? "red",
}));
---

<Section id="problema" tono="muted" ritmo="amplio" ariaLabel={copy.problema.aria}>
  {/* ─── 1 · De qué va ────────────────────────────────────────────────── */}
  <FilaAlterna>
    <div slot="texto">
      <SectionHeading
        titulo={curso.problema.titular}
        entradilla={curso.problema.entradilla}
      />
    </div>

    {/* La escena, no un diagrama: el mensaje que llega y se queda sin
        responder. Ver la nota de `Escena.astro`. */}
    <Reveal slot="visual" delay={0.12}>
      <Escena
        mensaje={copy.problema.escena.mensaje1}
        estado={copy.problema.escena.sinResponder}
        alt={copy.problema.escena.escena1Alt}
      />
    </Reveal>
  </FilaAlterna>

  {/* ─── 2 · Dónde se te escapa ───────────────────────────────────────── */}
  <div class="mt-16 lg:mt-24">
    <Reveal>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-4">
        <h3 class="text-2xl font-bold text-balance text-ink">
          <T v={copy.problema.doloresTitulo} />
        </h3>
        {/* Solo aparece si hay cursor con el que pasar. Ver global.css. */}
        <p data-pista-hover class="text-sm text-ink-subtle">
          <T v={copy.ui.pistaHover} />
        </p>
      </div>
    </Reveal>

    {/* El filete superior de cada entrada es lo que convierte cinco elementos
        en tres columnas en una REJILLA y no en cinco cosas flotando con un
        hueco al final. Con cinco entradas en tres columnas la última fila queda
        incompleta siempre; con las reglas horizontales eso se lee como el final
        de una lista, que es lo que es, en vez de como un fallo de maquetación.
        Y sigue sin haber ninguna caja: ver la nota de la cabecera. */}
    {/* FLEX Y NO GRID, por lo mismo que la rejilla del temario: cinco dolores
        en tres columnas dejan la última fila con dos elementos pegados a la
        izquierda y un hueco a la derecha que se lee como si faltara un tercero.
        `flex-wrap` + `justify-center` la centra.
        Los anchos llevan restada su parte del hueco: con `gap-x-10` (40 px) y
        tres columnas hay 2 huecos que repartir entre 3, o sea 26.67 px cada
        una; con dos columnas, 20 px. */}
    <ul class="mt-8 flex flex-wrap justify-center gap-x-10 gap-y-7">
      {
        dolores.map((d, i) => (
          <Reveal
            as="li"
            delay={i * 0.06}
            class="w-full sm:w-[calc(50%-1.25rem)] lg:w-[calc(33.333%-1.667rem)]"
          >
            {/* `data-revelar` marca el grupo; `data-detalle`, lo que se
                despliega al pasar el cursor. */}
            <div data-revelar class="group h-full border-t border-line pt-5">
              {/* El icono va SUELTO, sin recuadro de color. La caja redondeada
                  con iconito pastel es literalmente la anti-referencia del
                  "SaaS genérico" de PRODUCT.md, y con cinco seguidas se nota. */}
              <Icono
                nombre={d.icono}
                class="size-7 text-secondary-600 transition-colors duration-200 ease-out-soft group-hover:text-ink"
              />

              <p class="mt-3 text-lg font-bold text-balance text-ink">
                <T v={d.titulo} />
              </p>

              <div data-detalle>
                <div>
                  <p class="mt-2 text-base text-pretty text-ink-muted">
                    <T v={d.detalle} />
                  </p>
                </div>
              </div>
            </div>
          </Reveal>
        ))
      }
    </ul>
  </div>

  {/* ─── 3 · Lo que cuesta no hacer nada, y la primera acción ──────────── */}
  {/* Esta fila lleva SOLO el coste, no el coste más la lista más el CTA.
      Se probó todo junto en la columna de texto y en móvil salía mal: al
      apilarse, el gráfico quedaba por debajo del botón, o sea a ochocientos
      píxeles del párrafo que ilustra. Partido en dos bloques, el orden en móvil
      sale solo —coste, gráfico, reconocimiento, CTA— y en escritorio las dos
      columnas tienen alturas parecidas y se pueden centrar sin que el dibujo
      flote. */}
  <FilaAlterna invertir class="mt-16 lg:mt-24">
    <div slot="texto">
      <Reveal>
        <h3 class="text-2xl font-bold text-balance text-ink sm:text-3xl">
          <T v={copy.problema.costeTitulo} />
        </h3>
        <p class="mt-5 border-l-2 border-secondary-500 pl-5 text-lg text-pretty text-ink">
          <T v={curso.problema.coste} />
        </p>
      </Reveal>
    </div>

    {/* La segunda mitad de la misma escena: se resolvió, y sin ti. Va apagada
        porque el momento ya pasó, y eso es justo lo que dice el texto. */}
    <Reveal slot="visual" delay={0.12}>
      <Escena
        encabezado={copy.problema.escena.despues}
        mensaje={copy.problema.escena.mensaje2}
        estado={copy.problema.escena.sinTi}
        alt={copy.problema.escena.escena2Alt}
        apagado
      />
    </Reveal>
  </FilaAlterna>

  {/* ─── 4 · La primera acción de la página ────────────────────────────── */}
  {/*
    AQUÍ HABÍA UNA TARJETA GRANDE, "Si te reconociste arriba, esto es para ti",
    con las cuatro frases de `curso.paraQuien` en dos columnas. Se quitó porque
    repetía: la rejilla de cinco dolores que hay justo encima YA hace el trabajo
    de reconocimiento, y lo hace mejor, porque describe la situación en vez de
    pedirle al lector que se apunte a una lista. Frase por frase el solape era
    literal — "te trabas justo cuando toca pedir algo" contra el dolor "Pedir te
    da pena"— y `paraQuien[0]` además ya sale en el hero.

    Lo que NO se podía quitar es el botón. Este es el punto más caliente de la
    primera mitad de la página: el lector acaba de reconocerse en cinco cosas y
    de leer lo que le cuesta no hacer nada. Sin CTA aquí, la única salida es
    seguir bajando.

    Así que queda el puente y la acción, sin la lista. De unas 110 palabras a
    unas 30, y la sección pierde un bloque entero de altura.

    Los cuatro textos siguen en `curso.paraQuien` y se siguen usando (el primero
    en el hero). No hace falta borrar nada del config para recuperar la tarjeta.
  */}
  <Reveal>
    <div class="mx-auto mt-16 max-w-xl text-center lg:mt-20">
      <p class="text-lg font-semibold text-balance text-ink sm:text-xl">
        <T v={copy.problema.remate} />
      </p>
      <div class="mt-6">
        <Button
          href={cta.secundario.href}
          variant="primary"
          size="lg"
          trackId="problema"
          class="w-full sm:w-auto"
        >
          <T v={cta.secundario.texto} />
        </Button>
      </div>
      <p class="mt-3 text-sm text-ink-subtle">
        <T v={copy.hero.microCta} />
      </p>
    </div>
  </Reveal>
</Section>
