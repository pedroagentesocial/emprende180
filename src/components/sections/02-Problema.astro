---
import { resolverIdiomaServidor } from "@i18n/idioma";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Reveal from "@components/motion/Reveal.astro";
import StaggerList from "@components/motion/StaggerList";
import Button from "@components/ui/Button.astro";
import { curso, copy, cta } from "@config/curso.config";

/**
 * 02 · EL PROBLEMA + PARA QUIÉN ES.
 *
 * Dos trabajos encadenados:
 *
 *  a) Describir la situación del lector mejor de lo que la describiría él.
 *     Nadie compra una solución hasta que siente que le entienden el problema.
 *  b) Que el lector correcto se reconozca y se comprometa.
 *
 * AQUÍ HABÍA UNA SEGUNDA COLUMNA, "NO es para ti si…". Se quitó por decisión
 * del cliente: quiere que la página empuje a comprar, no que descalifique.
 * Los datos siguen en `curso.paraQuienNo` por si algún día se recupera; para
 * volver a pintarla basta con deshacer este bloque.
 *
 * Lo que sí se conserva en otro sitio son los límites REALES (licencia,
 * territorio, cómo se remunera): están en las FAQ, que es donde el lector los
 * busca cuando ya quiere comprar. Eso no es descalificar, es evitar vender a
 * quien literalmente no puede participar, que acaba en reembolso.
 *
 * Con una sola columna, el hueco lo ocupa un CTA. El lector acaba de
 * reconocerse en cinco dolores y de verse en la lista: es el punto más caliente
 * de toda la primera mitad, y hasta ahora no tenía dónde hacer clic. El CTA
 * pide el email, no la compra: a estas alturas todavía no ha visto el temario
 * ni el precio.
 */

const dolores = curso.problema.dolores.map((texto) => ({ texto }));
const paraSi = curso.paraQuien.map((texto) => ({ texto }));

/* Idioma de ESTA petición. Las islas de React lo necesitan como prop: en
   el servidor no pueden leerlo del DOM, así que sin esto se renderizarían
   siempre en español aunque la URL pida inglés. */
const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

---

<Section id="problema" tono="muted" ritmo="amplio" ariaLabel={copy.problema.aria}>
  <SectionHeading
    align="center"
    titulo={curso.problema.titular}
    entradilla={curso.problema.entradilla}
  />

  <div class="mx-auto mt-12 max-w-read">
    <StaggerList client:visible lang={lang} items={dolores} variante="bullet" />

    <Reveal delay={0.1}>
      <p
        class="mt-10 border-l-2 border-secondary-500 pl-5 text-lg font-medium text-balance text-ink"
      >
        <T v={curso.problema.coste} />
      </p>
    </Reveal>
  </div>

  <!-- Auto-reconocimiento + la primera acción de la página -->
  <Reveal>
    <div
      class="mx-auto mt-16 max-w-2xl rounded-2xl border border-line bg-surface p-7 shadow-sm sm:p-9"
    >
      <h3 class="text-xl font-bold text-balance text-ink sm:text-2xl">
        <T v={copy.problema.paraTiTitulo} />
      </h3>

      <div class="mt-6">
        <StaggerList client:visible lang={lang} items={paraSi} variante="check" />
      </div>

      <div class="mt-8 border-t border-line pt-7 text-center">
        <p class="text-base font-semibold text-balance text-ink">
          <T v={copy.problema.remate} />
        </p>
        <div class="mt-5">
          <Button
            href={cta.secundario.href}
            variant="primary"
            size="lg"
            trackId="problema"
            class="w-full sm:w-auto"
          >
            <T v={cta.secundario.texto} />
          </Button>
        </div>
        <p class="mt-3 text-sm text-ink-subtle">
          <T v={copy.hero.microCta} />
        </p>
      </div>
    </div>
  </Reveal>
</Section>
