---
import T from "@components/i18n/T.astro";
import { resolverIdiomaServidor } from "@i18n/idioma";
import Section from "@components/ui/Section.astro";
import Reveal from "@components/motion/Reveal.astro";
import Button from "@components/ui/Button.astro";
import Icono, { type NombreIcono } from "@components/ui/Icono.astro";
import CintaPrecio from "@components/ui/CintaPrecio.astro";
import { tienePendiente } from "@lib/pendientes";
import { temario, curso, copy, contacto, cta } from "@config/curso.config";
import { construirTxt } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";

/* El idioma de ESTA petición: hace falta para el `alt` de la foto, que es un
   atributo y no puede llevar los dos idiomas dentro como hace <T>. El cambio de
   idioma en caliente lo cubren los `data-alt-es` / `data-alt-en`, igual que en
   la foto del instructor. */
const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * 05 · TEMARIO — «¿qué incluye exactamente?»
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Después de la transformación (sección 3), aquí se demuestra que hay un plan
 * detrás y no una promesa suelta. Su trabajo es reducir incertidumbre.
 *
 * Sin duraciones: ver la regla 2 de curso.config.ts. La página no anuncia
 * cuánto dura el curso.
 *
 * ─── DE REJILLA DE CUATRO A RUTA DE DIEZ ───────────────────────────────────
 *
 * Antes de esto fue un acordeón de React; después, una rejilla de cuatro
 * columnas. La rejilla arreglaba lo de leer diez filas apiladas, pero rompía
 * justo lo que esta sección tiene que demostrar: el titular dice "EN EL ORDEN
 * en que hay que hacerlos" y luego los ponía en cuatro columnas, donde el 04 y
 * el 05 quedan en esquinas opuestas y el 01 se lee al lado del 04. Un orden que
 * hay que reconstruir con la vista no es un orden.
 *
 * Ahora es una sola columna de diez filas numeradas: se recorre 01 → 10 como se
 * va a hacer el curso. Y ocupa MENOS que la rejilla, no más, porque cada video
 * es una fila de una línea y no una tarjeta con su hueco.
 *
 * ─── SE FUERON LOS VEINTE DISTINTIVOS ──────────────────────────────────────
 *
 * Cada tarjeta llevaba "Video" y "Quiz". Diez veces cada uno, cuarenta palabras
 * para decir dos cosas que son iguales en las diez. Repetir un dato diez veces
 * no lo refuerza: lo convierte en fondo. Ahora se dice una vez, en la columna
 * del título, con `copy.temario.todosConQuiz`.
 *
 * ─── LA COLUMNA DE LA IZQUIERDA ────────────────────────────────────────────
 *
 * El título, el recuento, la promesa del quiz y los DOS BOTONES viven en un
 * rail `sticky`. Es lo que convierte una lista en una sección que vende: quien
 * está leyendo el video 08 tiene el botón de inscribirse a la altura de los
 * ojos, sin volver arriba ni esperar al final.
 *
 * Va a la IZQUIERDA a propósito, al revés que el de preguntas frecuentes. Las
 * dos secciones usan el mismo recurso; espejadas, no se leen como la misma
 * plantilla puesta dos veces.
 *
 * ⚠️ `TemarioAcordeon.tsx` NO se ha borrado. El día que el cliente pase el
 * guion de cada video y `lecciones` deje de estar vacío, el acordeón vuelve a
 * ser el componente correcto y esta lista, no.
 *
 * ─── SE FUE LA LÍNEA DE «QUÉ LOGRAS» ───────────────────────────────────────
 *
 * Cada fila mostraba además `logras`, unas 25 palabras por video: 250 palabras
 * en total, y REPETIDAS: la sección 03 es entera "qué sabrás hacer al
 * terminar". Aquí basta el título del video, que es el dato que el visitante
 * viene a buscar. `logras` sigue en el config, intacto.
 */

/** Un icono por cada extra, emparejado por posición con `copy.temario.extras`. */
const ICONOS_EXTRAS: NombreIcono[] = ["certificado", "infinito", "actualizar"];

/**
 * Los HECHOS de `formato.incluye` que siguen sin decidirse.
 *
 * Se separan de las tres cosas que sí se pueden prometer porque no son lo
 * mismo: una característica confirmada vende, y un hueco por rellenar es un
 * recordatorio para quien edita el sitio. Mezclados en la misma lista, un
 * `[COMPLETAR:]` acaba publicado sin que nadie lo note.
 *
 * Y por eso este bloque solo se pinta en DESARROLLO. Es una nota de obra: el
 * cliente no tiene por qué enterarse de que la página está a medias mientras
 * decide si compra. Cuando se rellenen en el config, desaparece del todo.
 */
const pendientes = curso.formato.incluye.filter(tienePendiente);

const cuantos = construirTxt((l) =>
  interpolar(copy.temario.cuantos[l], { n: temario.length }),
);

const todosConQuiz = construirTxt((l) =>
  interpolar(copy.temario.todosConQuiz[l], { n: temario.length }),
);
---

{/* ─── EL REPARTO ─────────────────────────────────────────────────────────────
    Rail a la izquierda (título + recuento + los dos botones, `sticky`) y la
    ruta de diez a la derecha. El `<h2>` va primero en el marcado y es también
    lo primero visualmente, así que aquí no hace falta `order`. */}
<Section id="temario" tono="muted" ariaLabel={copy.temario.aria}>
  <div class="grid gap-10 lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-x-16 xl:gap-x-20">
    <aside>
      <div class="lg:sticky lg:top-10">
        <Reveal>
          <p class="inline-flex items-center gap-2 rounded-full border border-secondary-200 bg-secondary-50 px-3 py-1 text-xs font-bold tracking-wide text-secondary-700 uppercase">
            <span aria-hidden="true" class="marca-linea">
              <span class="size-1.5 rounded-full bg-secondary-500"></span>
            </span>
            <T v={cuantos} />
          </p>

          <h2 class="mt-4 text-3xl font-extrabold text-balance text-ink sm:text-4xl">
            <T v={copy.temario.titulo} vars={{ n: temario.length }} />
          </h2>

          <p class="mt-4 text-base text-pretty text-ink-muted">
            <T v={copy.temario.entradilla} vars={{ n: temario.length }} />
          </p>

          {/* ─── LA FOTO DEL TEMARIO ──────────────────────────────────────────
              Va en la columna IZQUIERDA porque la sección anterior lleva su
              escena a la derecha: es la alternancia que hace que la página no
              se lea como una columna infinita. Ver `FilaAlterna`.

              ⚠️ LA FOTO NO ES DECORACIÓN, ES LA CUALIFICACIÓN DEL ALUMNO. No
              hay una oficina, ni un equipo, ni nadie señalando una pizarra:
              es una persona sola en la mesa de su cocina, de noche, con un
              café. Ese es literalmente el visitante que describe PRODUCT.md
              —tiene empleo, poco tiempo y estudia a ratos sueltos— y verse
              retratado hace más por la conversión que cualquier adjetivo.

              `width`/`height` y `aspect-[22/15]` van juntos a propósito: sin
              las dos cosas la foto reserva su hueco tarde y el bloque de abajo
              da un salto al cargar, que son décimas de CLS en la métrica y un
              brinco delante de los ojos en la práctica. */}
          <img
            src="/imagenes/secciones/temario.webp"
            alt={copy.temario.fotoAlt[lang]}
            data-alt-es={copy.temario.fotoAlt.es}
            data-alt-en={copy.temario.fotoAlt.en}
            width={880}
            height={620}
            loading="lazy"
            decoding="async"
            class="mt-6 aspect-[22/15] w-full rounded-2xl border border-line object-cover"
          />

          {/* Lo que antes eran veinte distintivos repartidos por las tarjetas. */}
          {
            curso.formato.conQuiz && (
              <p class="mt-4 flex items-start gap-2.5 text-sm font-medium text-ink">
                <span aria-hidden="true" class="marca-linea shrink-0 text-secondary-600">
                  <Icono nombre="check" class="size-4" grosor={3} />
                </span>
                <T v={todosConQuiz} />
              </p>
            )
          }

          {/* ─── LAS DOS SALIDAS, A LA ALTURA DE LOS OJOS ────────────────────
              Estaban al final de la sección, debajo de los diez videos: había
              que terminar de leer la lista entera para encontrar dónde pulsar.
              En el rail `sticky` acompañan durante toda la lectura.

              El segundo botón era un `mailto:` con el asunto puesto. Ahora
              llama: abrir el cliente de correo es una fricción que en móvil
              muchas veces ni funciona, y una duda sobre el temario se contesta
              en dos minutos por teléfono. Solo aparece si hay número.

              La línea "Eso es todo lo que incluye Fundamentos" NO va aquí: en
              escritorio el rail queda al lado de la lista y se lee después,
              pero en móvil todo se apila y esa frase caería ANTES de los diez
              videos. Es una frase de cierre; cerrar algo que aún no se ha
              enseñado no significa nada. Vive al final de la sección. */}

          {/* En el rail van APILADOS y a todo el ancho, no en fila. En una
              columna de 22rem, dos botones lado a lado dejan 10rem a cada uno y
              "Inscribirme al curso" se parte en dos renglones dentro de la
              píldora. Apilados caben enteros y el orden de arriba abajo es el
              orden de compromiso. */}
          <div class="mt-4 flex flex-col gap-3 sm:flex-row lg:flex-col">
            <Button
              href={cta.primario.href}
              variant="primary"
              trackId="temario"
              class="w-full sm:w-auto lg:w-full"
            >
              <T v={cta.primario.texto} />
            </Button>

            {
              contacto.telefono && (
                <Button
                  href={`tel:${contacto.telefono}`}
                  variant="secondary"
                  trackId="temario-llamada"
                  class="w-full sm:w-auto lg:w-full"
                >
                  <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                  <T v={copy.instructor.llamame} />
                </Button>
              )
            }
          </div>
        </Reveal>
      </div>
    </aside>

    {/* ─── LA RUTA ────────────────────────────────────────────────────────────
        `<ol>` de verdad, no una rejilla de tarjetas: el orden es el contenido.

        Cada fila es número + título en una línea. El número va en un círculo
        teal con `tabular-nums` para que el 01 y el 10 ocupen exactamente lo
        mismo y la columna de títulos quede a plomo.

        El hover no revela nada —no hay nada escondido— pero marca la fila que
        se está leyendo, que en una lista de diez ayuda a no perder el renglón.
        Solo con cursor: en táctil no existe. */}
    <ol class="grid content-start gap-2">
      {
        temario.map((m, i) => (
          <Reveal as="li" delay={Math.min(i, 6) * 0.04}>
            {/* ─── EL NÚMERO VA A LA PRIMERA LÍNEA, NO AL CENTRO DEL BLOQUE ──
                Estaba con `items-center`, y en escritorio daba igual porque los
                diez títulos entran en una línea. En un teléfono no: "Cómo se
                generan oportunidades con contactos y referidos" ocupa tres
                renglones, y con el círculo centrado sobre el bloque entero
                quedaba a la altura del segundo. Diez filas con el número a
                alturas distintas y la columna de títulos a plomo se leen como
                una lista descuadrada.

                `marca-linea` lo centra en la PRIMERA línea del título mida lo
                que mida, sin ningún `mt-` a ojo que se rompa al cambiar de
                idioma. El `text-base` sube a la FILA porque la caja hereda la
                interlínea de su padre; ver la nota en global.css.

                LA FACTURA, DICHA: con `items-center` la fila medía lo que el
                círculo (40 px) más el acolchado, o sea 68 px, aunque el título
                ocupara una línea de 26. Ahora la altura sale del TEXTO, que es
                de donde tiene que salir, y el acolchado sube de 3.5 a 4 para que
                el círculo no quede pegado al borde. En escritorio, donde los
                diez títulos entran en una línea, cada fila pierde unos 10 px: la
                lista queda más compacta, que en diez elementos que se escanean
                es mejor, no peor. En móvil no cambia nada, porque ahí los
                títulos ya ocupaban dos y tres renglones. */}
            <article class="flex items-start gap-4 rounded-2xl border border-line bg-surface px-4 py-4 text-base transition-colors duration-200 ease-out-soft hover:border-secondary-300 sm:px-5">
              <span aria-hidden="true" class="marca-linea">
                <span
                  class="grid size-10 place-items-center rounded-full bg-secondary-50 text-sm font-extrabold tabular-nums text-secondary-700 ring-1 ring-secondary-200 ring-inset"
                >
                  {String(m.numero).padStart(2, "0")}
                </span>
              </span>

              <h3 class="font-bold text-pretty text-ink">
                <T v={m.titulo} />
              </h3>
            </article>
          </Reveal>
        ))
      }
    </ol>
  </div>

  {/* ─── Y ADEMÁS · tres cosas, tres iconos ────────────────────────────────
      Esto era la lista de las seis frases de `formato.incluye` a dos columnas y
      a cuerpo pequeño: 90 palabras que casi nadie lee, y cuatro de las seis ya
      dichas dos veces más arriba (la franja del hero y los diez videos). Ahora
      son tres iconos y cuatro palabras cada uno.

      Va a lo ancho de las dos columnas y no dentro del rail: en el rail lo
      dejaría más alto que la pantalla en un portátil, y un `sticky` que no cabe
      deja de pegarse. */}
  <Reveal delay={0.1}>
    <div class="mt-14 border-t border-line pt-10">
      <h3 class="text-center text-xs font-bold tracking-[0.16em] text-ink-subtle uppercase">
        <T v={copy.temario.extrasTitulo} />
      </h3>

      <ul class="mx-auto mt-8 grid max-w-3xl gap-8 text-center sm:grid-cols-3">
        {
          copy.temario.extras.map((e, i) => (
            <li>
              <Icono
                nombre={ICONOS_EXTRAS[i] ?? "check"}
                class="mx-auto size-10 text-secondary-600"
                grosor={1.5}
              />
              <p class="mt-4 text-base font-bold text-balance text-ink">
                <T v={e.titulo} />
              </p>
              <p class="mt-1 text-sm text-pretty text-ink-subtle">
                <T v={e.nota} />
              </p>
            </li>
          ))
        }
      </ul>

      {/* El cierre, en su sitio: después de los diez videos Y de las tres
          cosas que entran además. Ahora la frase es verdad cuando se lee —ya
          se ha enseñado todo lo que incluye— y hace de puente a la tira de
          precio, que es la siguiente pregunta. */}
      <p class="mx-auto mt-10 max-w-read text-center text-lg font-semibold text-balance text-ink">
        <T v={copy.temario.cierre} />
      </p>
    </div>
  </Reveal>

  {/* Los HECHOS que siguen sin decidirse. Ver el comentario de `pendientes`:
      solo en desarrollo. */}
  {
    pendientes.length > 0 && import.meta.env.DEV && (
      <Reveal delay={0.15}>
        <div class="mx-auto mt-10 max-w-read rounded-xl border-2 border-dashed border-line-strong bg-surface p-5">
          <p class="text-xs font-bold tracking-[0.12em] text-warning-700 uppercase">
            ⚠ <T v={copy.temario.pendientesTitulo} />
          </p>
          <ul class="mt-3 grid gap-2 text-sm">
            {pendientes.map((item) => (
              <li class="text-pretty text-ink-muted">
                <T v={item} resaltar />
              </li>
            ))}
          </ul>
        </div>
      </Reveal>
    )
  }

  {/* Puente al precio: el visitante acaba de ver TODO lo que incluye y la
      siguiente pregunta es cuánto vale. */}
  <Reveal>
    <CintaPrecio variante="panel" class="mx-auto mt-12 max-w-read" />
  </Reveal>
</Section>
