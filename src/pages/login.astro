---
import BaseLayout from "@layouts/BaseLayout.astro";
import T from "@components/i18n/T.astro";
import LanguageSwitch from "@components/i18n/LanguageSwitch";
import Icono from "@components/ui/Icono.astro";
import LoginForm from "@components/student/LoginForm";
import { sitio, contacto, copy } from "@config/curso.config";
import { studentCopy } from "@config/studentArea";
import BotonesProveedor from "@components/auth/BotonesProveedor.astro";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import {
  currentStudent,
  signInWithPassword,
  sendMagicLink,
  internalPath,
} from "@lib/auth";
import { LOGIN_EMAIL } from "@lib/loginEmail";
import { consume, clientIp } from "@lib/rateLimit";
import { captchaSiteKey, verifyCaptcha, CAPTCHA_FIELD } from "@lib/captcha";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /login — the door to the student area
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ EMAIL AND PASSWORD, with "I forgot my password" inside the same form and
 * without changing page: whoever presses that link has already typed their
 * email, and making them type it again is friction at exactly the moment they
 * are already annoyed. See `LoginForm.tsx`.
 *
 * The emailed link is NOT the normal way in: it's for starting the account and
 * for recovering it, which are the same gesture underneath. See `src/lib/auth.ts`.
 *
 * ─── THE LAYOUT: TWO COLUMNS, ONE SCREEN ───────────────────────────────────
 *
 * This page used to be a single centred column: title, form, "I haven't bought
 * it", what's inside. Everything stacked, so getting in meant scrolling past
 * arguments written for somebody who ISN'T signing in.
 *
 * Now the screen is split by intent:
 *
 *   · RIGHT — the card. The only elevated, bordered, teal-carrying object on
 *     the page. Whoever came to sign in doesn't have to look for it.
 *   · LEFT  — everything else, in reading order: what this is, what's behind
 *     the door, and one quiet line for whoever pressed the wrong button.
 *
 * ⚠️ THE ORDER FLIPS ON MOBILE, AND IT IS NOT THE OBVIOUS FLIP. It isn't
 * "card first" — a form with no heading above it looks like a page that failed
 * to load. It is: heading, card, then the rest. The grid places the two left
 * blocks in rows 1 and 2 of the first column, so the DOM order (heading, card,
 * rest) is already the phone order and no `order` juggling is needed on the
 * one axis that matters, the reading one.
 *
 * ⚠️ THE CARD HOLDS THE FORM AND NOTHING ELSE. No heading repeating the h1 two
 * inches to its left, no reassurances, no third link. Everything a form asks
 * for that isn't a field is one more thing to read before typing.
 *
 * ─── IF THEY ARE ALREADY IN, THEY DON'T GET SHOWN THE DOOR ─────────────────
 *
 * With a session open this redirects to the dashboard. Showing a sign-in form to
 * somebody who is already inside is the fastest way to make them think their
 * session dropped.
 *
 * ─── `noindex` ─────────────────────────────────────────────────────────────
 *
 * A sign-in screen has no business in a search engine: it gives nothing to the
 * person searching, and it gives a crawler a list of doors.
 */
export const prerender = false;

/* Already identified: to the dashboard. Before anything is painted. */
if (await currentStudent(Astro.cookies)) return Astro.redirect("/student", 302);

/* ─── THE FORM ALSO WORKS WITHOUT JAVASCRIPT ──────────────────────────────
 *
 * ⚠️ THIS STARTED AS A SECURITY BUG, NOT AS AN IMPROVEMENT.
 *
 * The form used to be only a React island intercepting the submit. While the
 * island hadn't hydrated — slow network, a JS error, the script blocked — the
 * `<form>` was still a plain form with NO `method`, so submitting it did a GET
 * and the password ended up IN THE URL: in the address bar, in the history, and
 * in the `Referer` header of the next request.
 *
 * Now the form is `method="POST"` against this same page and is processed here.
 * The island still intercepts it to show errors without a reload, but if it
 * never arrives, the submit is a proper POST and nothing leaks. It is the same
 * thing the admin panel and the password screen already did.
 */
let postError: "credentials" | "limit" | "email" | "captcha" | null = null;
let postSent = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const mode = String(form.get("mode") ?? "signin");
  const email = String(form.get("email") ?? "").trim().toLowerCase();
  const ip = clientIp(Astro.request, Astro.clientAddress);

  /* ⚠️ THE CAPTCHA IS CHECKED HERE TOO, on the no-JavaScript path. If only the
     API routes checked it, this POST would be the unlocked door next to the
     locked one, and the easiest to find: it is written in the markup itself.
     With Turnstile switched off, `verifyCaptcha` answers `true` and nothing
     about this page changes. */
  const captchaOk = await verifyCaptcha(String(form.get(CAPTCHA_FIELD) ?? ""), ip);

  if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)) {
    postError = "email";
  } else if (!captchaOk) {
    postError = "captcha";
  } else if (mode === "reset") {
    if (!consume(`magic-link:${ip}`, 15, 10 * 60 * 1000).allowed) {
      /* The limit is NOT reported to the visitor as an error: saying "you have
         asked too many times" for that address would confirm it exists. They get
         the same "we've sent it" as everybody else. */
      postSent = true;
    } else {
      const requestLanguage = resolverIdiomaServidor(
        Astro.url,
        Astro.request.headers.get("accept-language"),
      );
      await sendMagicLink(email, requestLanguage, Astro.url, LOGIN_EMAIL);
      postSent = true;
    }
  } else if (!consume(`login-ip:${ip}`, 20, 10 * 60 * 1000).allowed) {
    postError = "limit";
  } else if (!consume(`login-email:${email}`, 10, 15 * 60 * 1000).allowed) {
    postError = "limit";
  } else {
    const student = await signInWithPassword(
      email,
      String(form.get("password") ?? ""),
      Astro.cookies,
      Astro.request.headers.get("user-agent"),
    );
    if (student) {
      return Astro.redirect(internalPath(String(form.get("next") ?? "")), 303);
    }
    postError = "credentials";
  }
}

const pageTitle = construirTxt((l) => `${studentCopy.title[l]} · ${sitio.nombre[l]}`);

/* Messages arriving through the URL from `/login/verify` and `/api/logout`. */
const error = Astro.url.searchParams.get("error");
const signedOut = Astro.url.searchParams.get("signedout") === "1";

/* `next` travels to the form so the visitor goes back where they were headed. It
   goes through the same filter as `/login/verify` — `internalPath` — because it
   ends up inside the link we email, and no other domain's URL can slip in there. */
const next = internalPath(Astro.url.searchParams.get("next"));

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* `?reset=1` starts the form in recovery mode. That is what keeps the "I forgot
   my password" link working without JavaScript. After a recovery POST the mode
   is kept, so the "we've sent it" message doesn't appear above the sign-in form. */
/* The POST comes back to this same page, and it has to come back in the SAME
   language: without carrying `?lang=`, somebody reading in Spanish gets the
   error in English. Only that parameter is preserved; the others (`error`,
   `signedout`) are answers and have no reason to survive a submit. */
const langParam = Astro.url.searchParams.get("lang");
const formAction = langParam
  ? `/login?lang=${encodeURIComponent(langParam)}`
  : "/login";

const initialMode =
  Astro.url.searchParams.get("reset") === "1" || postSent
    ? ("reset" as const)
    : ("signin" as const);

/* Any notice at all? It decides whether the card gets a gap above it, so an
   empty slot doesn't push the card off centre on a normal visit. */
const hasNotice = !!error || signedOut || !!postError || postSent;

/* La clave pública del captcha, o `null` si Turnstile está apagado. Decide dos
   cosas: si la isla pinta el widget y si esta página carga el script. */
const claveCaptcha = captchaSiteKey();

/* El logotipo horizontal de la marca, para la columna izquierda. */
const logo = lang === "en" ? sitio.logoHorizontalEn : sitio.logoHorizontal;

/* El enlace de vuelta al inicio, con las mismas palabras que /subscribe. */
const irA = lang === "en" ? "Go to" : "Ir a";
const irAlInicio = lang === "en" ? "Go to the home page" : "Ir al inicio";
---
<BaseLayout titulo={pageTitle} descripcion={studentCopy.intro} noindex>
  {/* ═══════════════════════════════════════════════════════════════════════
      LA PANTALLA DE ACCESO
      ═══════════════════════════════════════════════════════════════════════

      Rediseñada el 13-10-2026 con una referencia del cliente delante: el
      formulario a la izquierda y un patrón a la derecha.

      ⚠️ SE FUERON LA BARRA Y EL PIE, y es el mismo motivo que en /subscribe:
      aquí se llega con una intención única y cada enlace es una puerta para
      irse antes de terminar. Lo que SÍ se queda es lo que esa barra traía y
      aquí hace falta: el logotipo que vuelve al inicio y el selector de
      idioma.

      ⚠️ LA LISTA DE "QUÉ VAS A ENCONTRAR DENTRO" TAMBIÉN SE FUE. La sigue
      habiendo en `studentCopy.whatsInside` por si vuelve. Quien llega a esta
      pantalla ya sabe qué hay dentro: viene a entrar, no a que le convenzan.

      ⚠️ EL PATRÓN NO ES DECORACIÓN SUELTA. Son los iconos del sitio dentro de
      círculos de la paleta. Ni una cara, ni un avatar: inventar personas en la
      puerta de un producto que todavía tiene dos alumnos sería mentir con
      dibujos. Va `aria-hidden` y desaparece por debajo de `lg`, donde el sitio
      que ocuparía lo necesita el formulario.

      ⚠️ EL CHAT Y EL BOTÓN DE LLAMAR salen solos: viven en el Layout, no aquí.
      Son el icono de abajo a la derecha de la referencia. */}
  <div class="acceso">
    {/* Arriba: la vuelta al inicio y el idioma. El logotipo lleva "Ir a"
        delante por lo mismo que en /subscribe: una marca suelta en una esquina
        se lee como membrete y no como salida. */}
    <header class="acceso-barra">
      <a href="/" class="acceso-volver" aria-label={irAlInicio}>
        <span class="acceso-volver-texto">{irA}</span>
        <img
          src={logo.src}
          width={logo.w}
          height={logo.h}
          alt={sitio.nombre[lang]}
          fetchpriority="high"
        />
      </a>
      <LanguageSwitch client:load lang={lang} tono="claro" />
    </header>

    <main id="contenido" class="acceso-cuerpo">
      <section class="acceso-panel">
        {/* Los avisos van ENCIMA del formulario: quien vuelve con un enlace
            caducado necesita saber por qué antes de teclear otra vez su
            correo, y un mensaje que empuja los campos hacia abajo al aparecer
            es un formulario que se mueve mientras lo usas. */}
        {
          hasNotice && (
            <div class="mb-5 grid gap-3">
              {error && (
                <p
                  role="alert"
                  class="rounded-2xl border border-warning-500 bg-warning-50 px-4 py-3 text-sm text-pretty text-ink"
                >
                  <T
                    v={
                      error === "sin-cuenta"
                        ? studentCopy.errorSinCuenta
                        : error === "oauth"
                          ? studentCopy.errorOauth
                          : studentCopy.errorExpired
                    }
                  />
                </p>
              )}

              {signedOut && (
                <p
                  id="aviso-salida"
                  role="status"
                  class="flex items-center gap-2.5 rounded-2xl border border-secondary-300 bg-secondary-50 px-4 py-3 text-sm text-ink transition-opacity duration-[var(--duration-slow)] ease-[var(--ease-out-soft)]"
                >
                  <span aria-hidden="true" class="marca-linea text-secondary-600">
                    <Icono nombre="check" class="size-4" grosor={2.5} />
                  </span>
                  <T v={studentCopy.signedOut} />
                </p>
              )}

              {postError && (
                <p
                  role="alert"
                  class="rounded-2xl border border-error-500 bg-error-50 px-4 py-3 text-sm font-medium text-error-700"
                >
                  <T
                    v={
                      postError === "limit"
                        ? studentCopy.errorLimit
                        : postError === "email"
                          ? studentCopy.errorEmail
                          : postError === "captcha"
                            ? studentCopy.errorCaptcha
                            : studentCopy.errorCredentials
                    }
                  />
                </p>
              )}

              {postSent && (
                <p class="rounded-2xl border border-secondary-300 bg-secondary-50 px-4 py-3 text-sm text-pretty text-ink">
                  <T v={studentCopy.linkSent} />
                </p>
              )}
            </div>
          )
        }

        <LoginForm
          client:load
          lang={lang}
          next={next}
          initialMode={initialMode}
          action={formAction}
          captchaSiteKey={claveCaptcha}
        />

        {/* ⚠️ GOOGLE Y FACEBOOK VAN DEBAJO DEL CORREO, no encima. Hoy no se
            pinta ninguno —ninguna de las dos parejas de variables existe en
            producción, comprobado el 13-10-2026— pero el día que se
            configuren, el correo tiene que seguir siendo el camino principal:
            es con el que se dio de alta todo el mundo. */}
        <BotonesProveedor next={next} />

        {/* La pareja de "¿Ya tienes cuenta? Entrar" que vive en /subscribe.
            Las dos pantallas se señalan la una a la otra. */}
        <p class="acceso-sin-cuenta">
          <T v={studentCopy.sinCuenta.linea} />
          <a href="/subscribe" data-track="acceso-crear-cuenta">
            <T v={studentCopy.sinCuenta.cta} />
          </a>
        </p>
      </section>

      {/* ─── EL PATRÓN ───────────────────────────────────────────────────
          Nueve piezas colocadas a mano. No es una rejilla: una rejilla se lee
          como una tabla, y lo que esto tiene que parecer es constelación. */}
      <div class="patron" aria-hidden="true">
        <span class="p p1"><Icono nombre="diana" class="size-6" /></span>
        <span class="p p2"><Icono nombre="personas" class="size-7" /></span>
        <span class="p p3"><Icono nombre="grafica" class="size-6" /></span>
        <span class="p p4"><Icono nombre="giro" class="size-8" /></span>
        <span class="p p5"><Icono nombre="agenda" class="size-5" /></span>
        <span class="p p6"><Icono nombre="academia" class="size-6" /></span>
        <span class="punto d1"></span>
        <span class="punto d2"></span>
        <span class="punto d3"></span>
        <span class="punto d4"></span>
      </div>
    </main>
  </div>


  {/* ─── EL AVISO DE SALIDA ES UN MENSAJE, NO UN ESTADO ──────────────────────
      Llega en `?signedout=1`, y ese parámetro se queda en la URL: recargar, o
      volver a esta pantalla desde el historial, repetía "has salido de tu
      cuenta" a alguien que llevaba diez minutos ahí. Un aviso que sigue
      apareciendo deja de leerse como un aviso.

      Dos cosas, en este orden:
       1. Se limpia la URL con `replaceState`, sin recargar y sin dejar entrada
          nueva en el historial. A partir de ahí, F5 ya no lo trae de vuelta.
       2. Se desvanece a los seis segundos, que es de sobra para leer seis
          palabras. Se quita del flujo al terminar para que el formulario suba a
          su sitio en vez de dejar un hueco.

      Sin JavaScript no pasa ninguna de las dos y el aviso se queda ahí, que es
      exactamente el comportamiento de antes: nada se rompe, solo no mejora. */}
  <script is:inline>
    (function () {
      var aviso = document.getElementById("aviso-salida");
      if (!aviso) return;

      if (window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.delete("signedout");
        window.history.replaceState({}, "", url.pathname + url.search);
      }

      setTimeout(function () {
        aviso.style.opacity = "0";
        setTimeout(function () {
          aviso.remove();
        }, 450);
      }, 6000);
    })();
  </script>

  {/* El script del captcha, solo si Turnstile está encendido. `async` y sin
      `onload`: la isla lo espera por su cuenta (ver `LoginForm`), así que ni
      bloquea el pintado ni obliga a esta página a saber cuándo llegó. */}
  {
    claveCaptcha && (
      <script
        is:inline
        async
        defer
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      />
    )
  }
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     LA PANTALLA DE ACCESO
     ═══════════════════════════════════════════════════════════════════════
     Móvil primero: una columna con el formulario y sin patrón. A partir de
     `lg` se parte en dos y el patrón ocupa el lado derecho. */
  .acceso {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    padding: 1.25rem 1.25rem 3rem;
  }

  /* ─── ARRIBA: VOLVER E IDIOMA ───────────────────────────────────────── */
  .acceso-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .acceso-volver {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    color: var(--color-ink);
  }
  .acceso-volver-texto {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }
  .acceso-volver img {
    height: 2.25rem;
    width: auto;
  }
  .acceso-volver:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  /* ─── EL CUERPO ─────────────────────────────────────────────────────── */
  .acceso-cuerpo {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Sin tarjeta: el formulario se apoya en el blanco de la página, como en la
     referencia. La caja con borde y sombra competía con el patrón. */
  .acceso-panel {
    width: 100%;
    max-width: 23rem;
  }

  .acceso-sin-cuenta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-ink-subtle);
  }
  .acceso-sin-cuenta a {
    font-weight: 700;
    color: var(--color-ink-brand);
    text-decoration: none;
  }
  .acceso-sin-cuenta a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .acceso-sin-cuenta a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  /* ─── EL PATRÓN ─────────────────────────────────────────────────────── */
  .patron { display: none; }

  @media (min-width: 64rem) {
    .acceso { padding: 2rem 2.5rem 2.5rem; }
    .acceso-volver img { height: 2.5rem; }

    .acceso-cuerpo {
      display: grid;
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      align-items: center;
      gap: clamp(3rem, 8vw, 7rem);
      max-width: 78rem;
      width: 100%;
      margin-inline: auto;
    }

    .acceso-panel { max-width: none; }

    .patron {
      display: block;
      position: relative;
      aspect-ratio: 1 / 0.82;
      max-height: 32rem;
    }

    /* Cada pieza en porcentajes, así el conjunto se estira con su caja en vez
       de descolocarse al cambiar el ancho de la ventana. */
    .patron .p {
      position: absolute;
      display: grid;
      place-items: center;
      border-radius: 9999px;
      color: #fff;
      box-shadow: 0 10px 24px -12px oklch(0.287 0.0718 253.9 / 0.5);
      opacity: 0;
      animation: patron-entra 620ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .patron .punto {
      position: absolute;
      border-radius: 9999px;
      opacity: 0;
      animation: patron-entra 520ms ease-out forwards;
    }

    /* ⚠️ LOS COLORES SALEN DE LA PALETA, no de la referencia. Aquella era
       morada, naranja y amarilla; aquí son el navy y el teal con sus tintes.
       Un patrón con los colores de otra marca en la puerta de esta no es una
       referencia, es la marca de otro. */
    .p1 { top: 6%; left: 30%; width: 3.25rem; height: 3.25rem; background: var(--color-secondary-600); animation-delay: 80ms; }
    .p2 { top: 18%; left: 62%; width: 4rem; height: 4rem; background: var(--color-primary-900); animation-delay: 200ms; }
    .p3 { top: 40%; left: 12%; width: 3.5rem; height: 3.5rem; background: var(--color-secondary-700); animation-delay: 320ms; }
    .p4 { top: 52%; left: 74%; width: 4.75rem; height: 4.75rem; background: var(--color-primary-900); animation-delay: 150ms; }
    .p5 { top: 72%; left: 40%; width: 3rem; height: 3rem; background: var(--color-secondary-600); animation-delay: 420ms; }
    .p6 { top: 30%; left: 44%; width: 3.25rem; height: 3.25rem; background: var(--color-secondary-700); animation-delay: 260ms; }

    .d1 { top: 14%; left: 20%; width: 0.6rem; height: 0.6rem; background: var(--color-secondary-300); animation-delay: 360ms; }
    .d2 { top: 62%; left: 24%; width: 0.5rem; height: 0.5rem; background: var(--color-primary-900); animation-delay: 480ms; }
    .d3 { top: 34%; left: 86%; width: 0.7rem; height: 0.7rem; background: var(--color-secondary-300); animation-delay: 540ms; }
    .d4 { top: 84%; left: 66%; width: 0.55rem; height: 0.55rem; background: var(--color-secondary-600); animation-delay: 600ms; }

    @keyframes patron-entra {
      from { opacity: 0; transform: scale(0.6); }
      to { opacity: 1; transform: none; }
    }
  }

  /* El patrón aparece, no se mueve sin parar: es el fondo de una pantalla
     donde alguien teclea una contraseña. Con movimiento reducido, quieto. */
  @media (prefers-reduced-motion: reduce) {
    .patron .p,
    .patron .punto {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
