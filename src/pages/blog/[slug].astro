---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import Editorial from "@components/ui/Editorial.astro";
import {
  blogCopy,
  articulosPublicados,
  formatearFecha,
  minutosDeLectura,
} from "@lib/blog";
import { construirTxt } from "@i18n/idioma";
import { resolverIdiomaServidor } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";
import { sitio } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /blog/[slug] — el artículo
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ NO BUSCA EL ARTÍCULO POR SU CUENTA: lo pide a `articulosPublicados`, la
 * misma función que usa el listado. Es lo que garantiza que un borrador no sea
 * accesible escribiendo su URL a mano aunque no salga en la lista.
 *
 * ⚠️ Y NO LLEVA CTA DE COMPRA AL FINAL. Es deliberado y va contra el instinto:
 * quien llega a un artículo desde una búsqueda no viene a comprar, viene a
 * resolver una duda. Un botón de 490 dólares debajo de un texto que acaba de
 * ayudarte convierte el favor en un anzuelo. Lo que sí hay es una salida al
 * blog y el pie de siempre, con todo lo demás a un clic.
 */
export const prerender = false;

const { slug } = Astro.params;

const articulos = await articulosPublicados(getCollection);
const articulo = articulos.find((a) => a.id === slug);

if (!articulo) {
  return new Response(null, { status: 404, statusText: "Artículo no encontrado" });
}

const { Content } = await render(articulo);

const idiomaLector = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);
const enOtroIdioma = articulo.data.idioma !== idiomaLector;

const minutos = minutosDeLectura(articulo.body ?? "");

const tituloPagina = construirTxt(
  () => `${articulo.data.titulo} · ${sitio.nombre}`,
);
const descripcion = construirTxt(() => articulo.data.resumen);
---

<BaseLayout titulo={tituloPagina} descripcion={descripcion}>
  <Header />

  <main id="contenido" class="section-y">
    <div class="container-page">
      {/* ─── LA COLUMNA ES ANCHA Y LA MEDIDA LA PONE EL TEXTO ─────────────
          Y no al revés, que es como estaba. Con la medida en la COLUMNA, la
          foto de portada quedaba encajonada en 42rem con media pantalla vacía
          al lado. Poniéndosela a cada bloque de texto, el titular y los
          párrafos conservan sus ~70 caracteres y la portada se pasa de largo,
          que es justo lo que una foto tiene que hacer cuando hay sitio.

          La vuelta atrás y la ficha —fecha, minutos, etiquetas— se van al
          raíl: se quedan a la vista durante toda la lectura en vez de
          perderse en el primer scroll. Ver `Editorial.astro`. */}
      <Editorial medida={false}>
        <div slot="rail">
          <a
            href="/blog"
            class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink-brand hover:text-secondary-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <Icono nombre="flecha" class="size-3.5 shrink-0 rotate-180" grosor={2.5} />
            <T v={blogCopy.volver} />
          </a>

          <div
            class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-subtle lg:flex-col lg:items-start lg:gap-y-2"
          >
            <time datetime={articulo.data.fecha.toISOString().slice(0, 10)}>
              {formatearFecha(articulo.data.fecha, articulo.data.idioma)}
            </time>
            <span aria-hidden="true" class="lg:hidden">·</span>
            <span>
              {interpolar(blogCopy.minutos[articulo.data.idioma], { n: minutos })}
            </span>
            {
              articulo.data.etiquetas.length > 0 && (
                <>
                  <span aria-hidden="true" class="lg:hidden">·</span>
                  <span class="font-medium text-ink-brand">
                    {articulo.data.etiquetas.join(" · ")}
                  </span>
                </>
              )
            }
          </div>
        </div>

      <article>
        <header>
          <h1
            class="max-w-read text-3xl font-extrabold text-balance text-ink sm:text-4xl"
            lang={articulo.data.idioma}
          >
            {articulo.data.titulo}
          </h1>

          <p
            class="mt-4 max-w-read text-lg text-pretty text-ink-muted"
            lang={articulo.data.idioma}
          >
            {articulo.data.resumen}
          </p>

          {
            enOtroIdioma && (
              <p class="mt-5 max-w-read rounded-xl bg-surface-muted px-4 py-3 text-sm font-medium text-ink-muted">
                <T v={blogCopy.enOtroIdioma} />
              </p>
            )
          }
        </header>

        {
          articulo.data.portada && (
            <img
              src={articulo.data.portada}
              alt={articulo.data.portadaAlt ?? ""}
              class="mt-8 w-full rounded-2xl border border-line object-cover"
              loading="lazy"
              decoding="async"
            />
          )
        }

        {/* `prosa` da estilo a lo que sale del markdown, donde no se pueden
            poner clases. Ver el bloque de estilos de abajo.

            La medida va aquí y no en el artículo: es lo que deja que la
            portada de arriba se pase de largo. */}
        <div class="prosa mt-10 max-w-read" lang={articulo.data.idioma}>
          <Content />
        </div>
      </article>
      </Editorial>
    </div>
  </main>

  <Footer />
</BaseLayout>
