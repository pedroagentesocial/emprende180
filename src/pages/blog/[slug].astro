---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import {
  blogCopy,
  articulosPublicados,
  formatearFecha,
  minutosDeLectura,
} from "@lib/blog";
import { construirTxt } from "@i18n/idioma";
import { resolverIdiomaServidor } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";
import { sitio } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /blog/[slug] — el artículo
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ NO BUSCA EL ARTÍCULO POR SU CUENTA: lo pide a `articulosPublicados`, la
 * misma función que usa el listado. Es lo que garantiza que un borrador no sea
 * accesible escribiendo su URL a mano aunque no salga en la lista.
 *
 * ⚠️ Y NO LLEVA CTA DE COMPRA AL FINAL. Es deliberado y va contra el instinto:
 * quien llega a un artículo desde una búsqueda no viene a comprar, viene a
 * resolver una duda. Un botón de 490 dólares debajo de un texto que acaba de
 * ayudarte convierte el favor en un anzuelo. Lo que sí hay es una salida al
 * blog y el pie de siempre, con todo lo demás a un clic.
 */
export const prerender = false;

const { slug } = Astro.params;

const articulos = await articulosPublicados(getCollection);
const articulo = articulos.find((a) => a.id === slug);

if (!articulo) {
  return new Response(null, { status: 404, statusText: "Artículo no encontrado" });
}

const { Content } = await render(articulo);

const idiomaLector = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);
const enOtroIdioma = articulo.data.idioma !== idiomaLector;

const minutos = minutosDeLectura(articulo.body ?? "");

const tituloPagina = construirTxt(
  () => `${articulo.data.titulo} · ${sitio.nombre}`,
);
const descripcion = construirTxt(() => articulo.data.resumen);
---

<BaseLayout titulo={tituloPagina} descripcion={descripcion}>
  <Header />

  <main id="contenido" class="section-y">
    <div class="container-page">
      <article class="mx-auto max-w-read">
        <a
          href="/blog"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink-brand hover:text-secondary-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <Icono nombre="flecha" class="size-3.5 shrink-0 rotate-180" grosor={2.5} />
          <T v={blogCopy.volver} />
        </a>

        <header class="mt-6">
          <div
            class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-subtle"
          >
            <time datetime={articulo.data.fecha.toISOString().slice(0, 10)}>
              {formatearFecha(articulo.data.fecha, articulo.data.idioma)}
            </time>
            <span aria-hidden="true">·</span>
            <span>
              {interpolar(blogCopy.minutos[articulo.data.idioma], { n: minutos })}
            </span>
            {
              articulo.data.etiquetas.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="font-medium text-ink-brand">
                    {articulo.data.etiquetas.join(" · ")}
                  </span>
                </>
              )
            }
          </div>

          <h1
            class="mt-3 text-3xl font-extrabold text-balance text-ink sm:text-4xl"
            lang={articulo.data.idioma}
          >
            {articulo.data.titulo}
          </h1>

          <p class="mt-4 text-lg text-pretty text-ink-muted" lang={articulo.data.idioma}>
            {articulo.data.resumen}
          </p>

          {
            enOtroIdioma && (
              <p class="mt-5 rounded-xl bg-surface-muted px-4 py-3 text-sm font-medium text-ink-muted">
                <T v={blogCopy.enOtroIdioma} />
              </p>
            )
          }
        </header>

        {
          articulo.data.portada && (
            <img
              src={articulo.data.portada}
              alt={articulo.data.portadaAlt ?? ""}
              class="mt-8 w-full rounded-2xl border border-line object-cover"
              loading="lazy"
              decoding="async"
            />
          )
        }

        {/* `prosa` da estilo a lo que sale del markdown, donde no se pueden
            poner clases. Ver el bloque de estilos de abajo. */}
        <div class="prosa mt-10" lang={articulo.data.idioma}>
          <Content />
        </div>
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /**
   * El markdown no lleva clases, así que el estilo se aplica por etiqueta.
   *
   * ⚠️ `is:global` PORQUE EL HTML LO GENERA EL COMPILADOR DE MARKDOWN y no lleva
   * el marcador de ámbito de este archivo, igual que pasaba con los `<li>` de la
   * sección de aliados. Se acota con `.prosa`, que solo existe aquí.
   *
   * Medida de lectura: el contenedor ya es `max-w-read`, así que no se repite.
   */
  .prosa {
    color: var(--color-ink-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prosa > * + * {
    margin-top: 1.25em;
  }

  .prosa h2,
  .prosa h3 {
    color: var(--color-ink);
    font-weight: 800;
    text-wrap: balance;
    /* Más aire ARRIBA que abajo: un título pertenece al texto que le sigue, y
       separarlo por igual de los dos lados lo deja flotando en medio. */
    margin-top: 2.5em;
    margin-bottom: -0.25em;
  }

  .prosa h2 {
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .prosa h3 {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .prosa strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .prosa a {
    color: var(--color-ink-brand);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .prosa a:hover {
    color: var(--color-secondary-800);
  }

  .prosa ul,
  .prosa ol {
    padding-left: 1.5em;
  }

  .prosa ul {
    list-style: disc;
  }

  .prosa ol {
    list-style: decimal;
  }

  .prosa li + li {
    margin-top: 0.5em;
  }

  .prosa li::marker {
    color: var(--color-secondary-600);
  }

  /* Una cita se separa por el aire y por el color, no por una raya lateral:
     ver la guía de diseño, los bordes de acento están prohibidos. */
  .prosa blockquote {
    margin-block: 2em;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    background: var(--color-surface-muted);
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .prosa code {
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
    background: var(--color-surface-sunken);
    color: var(--color-ink);
    font-size: 0.9em;
  }

  .prosa pre {
    overflow-x: auto;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--color-primary-900);
    color: var(--color-neutral-0);
  }

  .prosa pre code {
    padding: 0;
    background: none;
    color: inherit;
  }

  .prosa img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid var(--color-line);
  }

  .prosa hr {
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
</style>
