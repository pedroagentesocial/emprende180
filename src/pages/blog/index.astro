---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import { blogCopy, articulosPublicados, formatearFecha } from "@lib/blog";
import { construirTxt } from "@i18n/idioma";
import { sitio } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /blog — el listado
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ SI NO HAY ARTÍCULOS, ESTA PÁGINA DEVUELVE 404, y no es un descuido.
 *
 * Un blog vacío hace daño donde más duele: el visitante está decidiendo si paga
 * un curso, entra en "Blog", encuentra "próximamente" y se lleva la impresión de
 * un proyecto a medio hacer. Vacío no resta si NO EXISTE; existir vacío sí
 * resta. Y por la misma razón el enlace del pie tampoco aparece hasta que hay
 * algo que leer: nadie llega a una puerta que no está pintada.
 *
 * En el momento en que se publica el primer artículo, la página y el enlace
 * aparecen solos. No hay ningún interruptor que acordarse de encender.
 */
export const prerender = false;

const articulos = await articulosPublicados(getCollection);

if (articulos.length === 0) {
  return new Response(null, { status: 404, statusText: "Todavía no hay artículos" });
}

const tituloPagina = construirTxt((l) => `${blogCopy.titulo[l]} · ${sitio.nombre}`);
---

<BaseLayout titulo={tituloPagina} descripcion={blogCopy.descripcion}>
  <Header />

  <main id="contenido" class="section-y">
    <div class="container-page">
      <div class="mx-auto max-w-read">
        <h1 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
          <T v={blogCopy.titulo} />
        </h1>
        <p class="mt-4 text-lg text-pretty text-ink-muted">
          <T v={blogCopy.entradilla} />
        </p>
      </div>

      {/* Una columna y no una rejilla de tarjetas: un listado de artículos se
          lee de arriba abajo, y en una sola columna el titular puede ser largo
          sin que la caja lo corte. Las rejillas de tres obligan a titulares de
          cuatro palabras, que es justo lo que no ayuda a decidir qué leer. */}
      <ul class="mx-auto mt-12 max-w-read divide-y divide-line border-t border-line">
        {
          articulos.map((a) => (
            <li>
              <a
                href={`/blog/${a.id}`}
                class="group block py-7 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-subtle">
                  <time datetime={a.data.fecha.toISOString().slice(0, 10)}>
                    {formatearFecha(a.data.fecha, a.data.idioma)}
                  </time>
                  {a.data.etiquetas.length > 0 && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="font-medium text-ink-brand">
                        {a.data.etiquetas.slice(0, 2).join(" · ")}
                      </span>
                    </>
                  )}
                </div>

                <h2 class="mt-2 text-xl font-bold text-balance text-ink transition-colors group-hover:text-ink-brand sm:text-2xl">
                  {a.data.titulo}
                </h2>

                <p class="mt-2 text-base text-pretty text-ink-muted">
                  {a.data.resumen}
                </p>

                <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-ink-brand">
                  <T v={blogCopy.leer} />
                  <Icono
                    nombre="flecha"
                    class="size-3.5 shrink-0 transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-soft)] group-hover:translate-x-1"
                    grosor={2.5}
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</BaseLayout>
