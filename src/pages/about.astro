---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import BotonRed from "@components/ui/BotonRed.astro";
import Lista from "@components/sections/03-Lista.astro";
import { copy, instructor, sitio } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import { articulosPublicados, formatearFecha, tituloBilingue } from "@lib/blog";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /about — quiénes somos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Reescrita entera el 14 de septiembre de 2026 sobre el brief del cliente:
 * nueve secciones en este orden, cada una con su texto aprobado antes de
 * escribirse. Ver `copy.about` para el porqué de cada texto.
 *
 *   1. Hero: la frase de misión, la línea de los años, el botón.
 *   2. Presentación de marca, con dos retratos.
 *   3. La barra de cuatro hechos.
 *   4. Las marcas del Ecosistema.
 *   5. Los seis valores del manifiesto.
 *   6. Propósito y los cuatro públicos.
 *   7. La carta de Pedro.
 *   8. El blog, en corto.
 *   9. La lista, tal cual está en la portada.
 *
 * ─── NO HAY SISTEMA VISUAL NUEVO, Y ESO ES LO QUE COSE LA PÁGINA ───────────
 *
 * Todo lo que se ve aquí ya existe en la portada: `Section` con sus cuatro
 * tonos, la escala de titulares, la Fraunces de los remates, el botón en
 * relieve, la caja de 52 px de los iconos, el bloque de autor del blog y la
 * sección de la lista entera. Cuando el /about y la portada comparten piezas,
 * se leen como dos páginas del mismo sitio y no como dos sitios.
 *
 * ─── LAS ZONAS DE FONDO ─────────────────────────────────────────────────────
 *
 *   blanco   hero + presentación            (una zona: quiénes somos)
 *   navy     la barra                       (el corte: lo comprobable)
 *   blanco   marcas                         (la prueba)
 *   suave    valores                        (el carácter)
 *   blanco   propósito + públicos           (para quién)
 *   hundido  la carta                       (la voz)
 *   blanco   el blog                        (lo que escribe)
 *   suave    la lista                       (la llamada, con su tarjeta navy)
 *
 * ⚠️ NINGÚN DATO SE ESCRIBE AQUÍ. Los cuatro de la barra, las tres empresas
 * y los textos viven en `copy.about`. Si algo falta, falta allí.
 */
export const prerender = false;

const { about } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const tituloPagina = construirTxt(
  (l) => `${about.kicker[l]} · ${sitio.nombre[l]}`,
);

/* Los dos últimos artículos publicados, y no tres: aquí el blog es una
   invitación, no una sección. `articulosPublicados` es la misma función que
   usan la portada y el listado, que es donde vive la regla de qué se
   publica. */
const articulos = (await articulosPublicados(getCollection)).slice(0, 2);

/* ⚠️ LAS CITAS PROPUESTAS SOLO SE VEN EN LOCAL. `import.meta.env.DEV` va en
   la misma expresión y no en una variable: Vite lo sustituye por `false` al
   compilar y la rama se pliega sola en producción. Una cita atribuida a una
   empresa real que no la ha aprobado no puede llegar a publicarse por un
   despiste. */
const enseñarPropuestas = import.meta.env.DEV;

/* La caja de los iconos, calcada de "Cómo se trabaja" en la portada: 52 px,
   esquina del sistema, fondo hundido, icono de 28 con el mismo grosor. */
const CAJA_ICONO =
  "grid size-[52px] shrink-0 place-items-center rounded-lg bg-surface-sunken text-ink-brand";
---

<BaseLayout titulo={tituloPagina} descripcion={about.descripcion}>
  <Header />

  <main id="contenido">
    {/* ─── 1 · EL HERO ───────────────────────────────────────────────────
        Texto solo, centrado, sobre blanco. Es la única página del sitio cuyo
        hero no lleva imagen, y es a propósito: la portada ya ha enseñado el
        vídeo y aquí lo que hay que leer es una frase. Una foto detrás la
        haría competir con lo único que tiene que hacer.

        La frase va entera en el `h1` y parte en dos por el `enfasis` del
        config: la primera mitad en Montserrat y la segunda en Fraunces, que
        es el remate de todo el sitio. */}
    <Section id="about-hero" tono="surface" ritmo="amplio" ariaLabel={about.aria}>
      <Reveal>
        <div class="mx-auto max-w-[64rem] text-center">
          <p class="text-sm font-semibold text-ink-brand sm:text-base lg:text-lg">
            <T v={about.kicker} />
          </p>

          <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-[-0.02em] text-balance text-ink sm:text-5xl lg:text-6xl">
            {about.hero.titulo.map((linea) => (
              <span class="block">
                {"enfasis" in linea && linea.enfasis ? (
                  <Enfasis v={linea} />
                ) : (
                  <T v={linea} />
                )}
              </span>
            ))}
          </h1>

          <p class="mx-auto mt-8 max-w-2xl text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
            <T v={about.hero.anos} />
          </p>

          <div class="mt-10 flex justify-center">
            <BotonRelieve href={about.hero.ctaHref} trackId="about-hero">
              <T v={about.hero.cta} />
            </BotonRelieve>
          </div>
        </div>
      </Reveal>
    </Section>

    {/* ─── 2 · LA PRESENTACIÓN ───────────────────────────────────────────
        Dos retratos verticales, lado a lado y desnivelados, y el texto al
        lado. Son las dos personas a las que habla el sitio —ella y él—, en
        los mismos dos originales que usa la portada.

        ⚠️ LADO A LADO Y NO SUPERPUESTOS. El montaje en diagonal de la portada
        se quitó cuando su columna se estrechó, y aquí no se resucita: dos
        verticales pegadas con un desnivel de 3rem se leen como una pareja sin
        que ninguna tape a la otra. El desnivel es lo que evita que parezcan
        dos celdas de una tabla. */}
    <Section id="about-intro" tono="surface" ariaLabel={about.aria}>
      <div class="grid items-center gap-12 md:grid-cols-[42fr_58fr] md:gap-10 lg:gap-16 xl:gap-24">
        <Reveal>
          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            {about.intro.fotos.map((foto, i) => (
              <img
                src={foto.src}
                alt={foto.alt[lang]}
                data-alt-es={foto.alt.es}
                data-alt-en={foto.alt.en}
                width={800}
                height={1040}
                loading="lazy"
                decoding="async"
                class:list={[
                  "aspect-[10/13] w-full rounded-lg border border-line object-cover",
                  i === 1 && "mt-12 sm:mt-16",
                ]}
              />
            ))}
          </div>
        </Reveal>

        <Reveal delay={0.12}>
          <div>
            <h2 class="text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink sm:text-5xl lg:text-6xl">
              <T v={about.intro.titulo} />
            </h2>
            <p class="mt-2 text-3xl leading-[1.15] text-balance sm:text-4xl lg:text-5xl">
              <Enfasis v={about.intro.subtitulo} />
            </p>

            {about.intro.parrafos.map((parrafo, i) => (
              <p
                class:list={[
                  "max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl",
                  i === 0 ? "mt-7" : "mt-4",
                ]}
              >
                <T v={parrafo} />
              </p>
            ))}
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 3 · LA BARRA ──────────────────────────────────────────────────
        Cuatro hechos con el formato de cuatro contadores, sobre navy: es el
        corte entre "quiénes somos" y "qué hay". El rótulo de arriba dice
        exactamente lo que son —lo que hay hoy, sin redondear— porque una
        barra de cifras en una empresa de meses solo se sostiene si no
        pretende ser otra cosa. Ver la nota de `copy.about`. */}
    <Section id="about-barra" tono="inverse" ritmo="compacto" ariaLabel={about.barra.kicker}>
      <Reveal>
        <p class="text-center text-sm font-semibold text-ink-on-inverse-brand sm:text-base">
          <T v={about.barra.kicker} />
        </p>

        {/* Dos por fila en el teléfono, cuatro desde `lg`. El filete entre
            celdas solo aparece cuando están en fila: apiladas, sería una
            raya vertical entre cosas que ya están separadas por el aire. */}
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-x-0">
          {about.barra.datos.map((dato, i) => (
            <div
              class:list={[
                "text-center lg:px-6",
                i > 0 && "lg:border-l lg:border-white/15",
              ]}
            >
              <dd class="text-5xl font-extrabold leading-none tracking-[-0.03em] text-ink-inverse lg:text-6xl">
                {dato.valor}
              </dd>
              <dt class="mx-auto mt-3 max-w-[14ch] text-base font-medium text-balance text-secondary-100 sm:text-lg">
                <T v={dato.etiqueta} />
              </dt>
            </div>
          ))}
        </dl>
      </Reveal>
    </Section>

    {/* ─── 4 · LAS MARCAS ────────────────────────────────────────────────
        Tres tarjetas iguales. Cada una lleva su logotipo, su rubro, lo que
        resuelve y —cuando exista— su cita.

        ⚠️ LA CITA NO ESTÁ Y NO SE INVENTA. Lo que hay en el config son tres
        PROPUESTAS para llevárselas a cada empresa, y solo se pintan en local,
        con su rótulo. En producción la tarjeta enseña lo que es verdad:
        logotipo, rubro, lo que resuelven y el enlace a su web. */}
    <Section id="about-marcas" tono="surface" ariaLabel={about.confian.kicker}>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold text-ink-brand sm:text-base">
            <T v={about.confian.kicker} />
          </p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
            <T v={about.confian.titulo} />
          </h2>
          <p class="mx-auto mt-5 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
            <T v={about.confian.texto} />
          </p>
        </div>
      </Reveal>

      <ul role="list" class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-8">
        {about.aliados.map((marca, i) => (
          <Reveal as="li" delay={i * 0.08} class="flex">
            <article class="flex w-full flex-col rounded-lg border-[0.5px] border-line bg-surface p-7">
              {/* La placa del logotipo: navy para el que está dibujado en
                  blanco, hundida para los demás. Ver `logoClaro`. */}
              <div
                class:list={[
                  "grid h-20 place-items-center rounded-lg px-6",
                  marca.logoClaro ? "bg-primary-950" : "bg-surface-sunken",
                ]}
              >
                <img
                  src={marca.logo}
                  alt={marca.nombre}
                  width={320}
                  height={96}
                  loading="lazy"
                  decoding="async"
                  class="max-h-10 w-auto max-w-[12rem] object-contain"
                />
              </div>

              <p class="mt-6 text-sm font-semibold text-ink-brand">
                <T v={marca.rubro} />
              </p>
              <h3 class="mt-1 text-xl font-extrabold text-ink">{marca.nombre}</h3>
              <p class="mt-3 text-base font-medium text-pretty text-ink-muted">
                <T v={marca.queResuelve} />
              </p>

              {marca.cita && marca.firma ? (
                <figure class="mt-6 border-t-[0.5px] border-line pt-5">
                  <blockquote class="font-acento text-xl italic leading-snug text-pretty text-ink">
                    <T v={marca.cita} />
                  </blockquote>
                  <figcaption class="mt-3 text-sm text-ink-muted">
                    <span class="font-semibold text-ink">{marca.firma.nombre}</span>
                    {" · "}
                    <T v={marca.firma.cargo} />
                  </figcaption>
                </figure>
              ) : (
                enseñarPropuestas && (
                  <figure class="mt-6 rounded-lg border border-dashed border-line bg-surface-muted p-4">
                    <blockquote class="font-acento text-lg italic leading-snug text-pretty text-ink-muted">
                      <T v={marca.citaPropuesta} />
                    </blockquote>
                    <figcaption class="mt-3 text-xs font-semibold tracking-wide text-ink-subtle uppercase">
                      <T v={about.confian.pendiente} />
                    </figcaption>
                  </figure>
                )
              )}

              {/* Al final y empujado abajo: las tres tarjetas acaban en el
                  mismo enlace a la misma altura, aunque el texto de encima
                  mida distinto. */}
              <a
                href={marca.url}
                target="_blank"
                rel="noopener"
                class="group mt-auto inline-flex min-h-11 items-center gap-2 pt-6 text-sm font-bold text-ink-brand hover:text-secondary-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
              >
                <T v={about.confian.visitar} />
                <Icono
                  nombre="flecha"
                  class="size-4 transition-transform duration-200 ease-out-soft group-hover:translate-x-1"
                />
              </a>
            </article>
          </Reveal>
        ))}
      </ul>
    </Section>

    {/* ─── 5 · LOS VALORES ───────────────────────────────────────────────
        Las seis palabras del manifiesto, con la caja de icono de "Cómo se
        trabaja". Tres en fila en escritorio, dos en tablet, una en el
        teléfono. Sin tarjetas: son seis ideas, no seis productos. */}
    <Section id="about-valores" tono="muted" ariaLabel={about.valores.titulo}>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
            <T v={about.valores.titulo} />
          </h2>
          <p class="mt-2 text-2xl leading-[1.15] text-balance sm:text-3xl lg:text-4xl">
            <Enfasis v={about.valores.subtitulo} />
          </p>
        </div>
      </Reveal>

      <ul role="list" class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-y-14">
        {about.valores.lista.map((valor, i) => (
          <Reveal as="li" delay={i * 0.06}>
            <div class="flex items-start gap-5">
              <span class={CAJA_ICONO}>
                <Icono nombre={valor.icono} class="size-7" grosor={1.6} />
              </span>
              <div class="min-w-0">
                <h3 class="text-xl font-extrabold text-ink sm:text-2xl">
                  <T v={valor.palabra} />
                </h3>
                <p class="mt-2 max-w-[34ch] text-base font-medium text-pretty text-ink-muted sm:text-lg">
                  <T v={valor.frase} />
                </p>
              </div>
            </div>
          </Reveal>
        ))}
      </ul>
    </Section>

    {/* ─── 6 · PROPÓSITO Y PÚBLICOS ──────────────────────────────────────
        Una frase grande y, debajo, cuatro bloques en dos por dos. Cada
        bloque empieza por "Si…" y lleva un filete arriba y no una tarjeta:
        el lector busca el suyo y se salta los otros tres, y cuatro cajas
        iguales le dirían que tiene que leer las cuatro. */}
    <Section id="about-proposito" tono="surface" ariaLabel={about.proposito.kicker}>
      <Reveal>
        <p class="text-sm font-semibold text-ink-brand sm:text-base">
          <T v={about.proposito.kicker} />
        </p>
        <h2 class="mt-4 max-w-5xl text-3xl font-semibold leading-[1.15] tracking-[-0.02em] text-balance text-ink sm:text-4xl lg:text-5xl">
          <T v={about.proposito.frase} />
        </h2>
      </Reveal>

      <Reveal delay={0.1}>
        <p class="mt-16 text-sm font-semibold text-ink-brand sm:text-base lg:mt-20">
          <T v={about.proposito.paraQuien} />
        </p>
      </Reveal>

      <ul role="list" class="mt-6 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:gap-x-16 lg:gap-y-12">
        {about.proposito.publicos.map((publico, i) => (
          <Reveal as="li" delay={i * 0.06}>
            <div class="border-t border-line pt-6">
              <h3 class="text-xl font-extrabold text-pretty text-ink sm:text-2xl">
                <T v={publico.titulo} />
              </h3>
              <p class="mt-3 max-w-prose text-base font-medium leading-relaxed text-pretty text-ink-muted sm:text-lg">
                <T v={publico.texto} />
              </p>
            </div>
          </Reveal>
        ))}
      </ul>
    </Section>

    {/* ─── 7 · LA CARTA ──────────────────────────────────────────────────
        El retrato a la izquierda, grande, y la carta a la derecha. Es la
        única sección de la página con la foto de Pedro, y por eso es la
        única donde la foto es la pieza central y no un sello: aquí el que
        habla es él.

        Fondo hundido y no navy: una carta se lee, y el texto largo en blanco
        sobre navy cansa. El hundido separa la sección sin cambiar de
        registro. */}
    <Section id="about-carta" tono="sunken" ariaLabel={about.carta.kicker}>
      <div class="grid gap-12 lg:grid-cols-[38fr_62fr] lg:gap-20 lg:items-start">
        <Reveal>
          <div class="lg:sticky lg:top-28">
            <img
              src={instructor.foto}
              alt={about.carta.fotoAlt[lang]}
              data-alt-es={about.carta.fotoAlt.es}
              data-alt-en={about.carta.fotoAlt.en}
              width={800}
              height={1000}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full max-w-md rounded-lg border border-line object-cover object-top lg:max-w-none"
            />
            <p class="mt-5 text-xl font-extrabold text-ink">{instructor.nombre}</p>
            <p class="mt-1 text-base font-medium text-ink-muted">
              <T v={instructor.rol} />
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.12}>
          <div>
            <p class="text-sm font-semibold text-ink-brand sm:text-base">
              <T v={about.carta.kicker} />
            </p>

            {/* Sin `max-w-prose`: la columna ya tiene su medida por la
                rejilla, y una carta con el ancho recortado dentro de una
                columna ya recortada se queda en un hilo. */}
            <div class="mt-6 space-y-5">
              {about.carta.parrafos.map((parrafo) => (
                <p class="text-lg font-medium leading-relaxed text-pretty text-ink sm:text-xl">
                  <T v={parrafo} />
                </p>
              ))}
            </div>

            {/* La firma, en la Fraunces de los remates. Es la única vez en
                toda la web que la itálica no remata una frase: firma una. */}
            <p class="mt-10 font-acento text-3xl italic text-ink sm:text-4xl">
              — <T v={about.carta.firma} />
            </p>
            <p class="mt-2 text-base font-medium text-ink-muted">
              <T v={instructor.rol} />
            </p>
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 8 · EL BLOG, EN CORTO ─────────────────────────────────────────
        El mismo bloque de autor que la portada —retrato pequeño, nombre y
        redes— y DOS artículos, no tres. Aquí el blog es una invitación al
        final de una página larga, no una sección con peso propio.

        Los títulos enlazan a la página del artículo y no abren el visor de
        la portada: ese visor vive en el script de la portada, y una página
        que dependiera de él sin cargarlo tendría botones que no hacen nada. */}
    <Section id="about-blog" tono="surface" ariaLabel={about.blog.titulo}>
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <Reveal>
          <div>
            <h2 class="text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
              <T v={about.blog.titulo} />
            </h2>
            <p class="mt-2 text-2xl leading-[1.15] text-balance sm:text-3xl lg:text-4xl">
              <Enfasis v={about.blog.subtitulo} />
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              <div class="flex items-center gap-3">
                <img
                  src={instructor.foto}
                  alt=""
                  width={800}
                  height={1000}
                  loading="lazy"
                  decoding="async"
                  class="size-12 shrink-0 rounded-full object-cover object-top"
                />
                <div>
                  <p class="text-base font-semibold text-ink">{instructor.nombre}</p>
                  <p class="text-sm font-medium text-ink-muted">
                    <T v={instructor.rol} />
                  </p>
                </div>
              </div>
              <BotonRed etiquetaPendiente={copy.ui.proximamente[lang]} />
            </div>
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          {articulos.length === 0 ? (
            <p class="text-lg font-medium text-ink-muted sm:text-xl">
              <T v={about.blog.vacio} />
            </p>
          ) : (
            <div>
              <ul class="border-t-[0.5px] border-line">
                {articulos.map((a) => (
                  <li class="border-b-[0.5px] border-line">
                    <a
                      href={`/blog/${a.id}`}
                      class="group flex min-h-11 items-center gap-4 py-5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                    >
                      <span class="min-w-0 flex-1">
                        <time
                          datetime={a.data.fecha.toISOString().slice(0, 10)}
                          class="block text-[0.8125rem] text-ink-subtle"
                        >
                          {formatearFecha(a.data.fecha, a.data.idioma)}
                        </time>
                        <span class="mt-1.5 block text-lg font-medium text-pretty text-ink group-hover:text-ink-brand sm:text-xl">
                          <T v={tituloBilingue(a)} />
                        </span>
                      </span>
                      <Icono
                        nombre="flecha"
                        class="size-5 shrink-0 text-ink-subtle transition-transform duration-200 ease-out-soft group-hover:translate-x-1 group-hover:text-ink-brand"
                      />
                    </a>
                  </li>
                ))}
              </ul>

              <div class="ml-1 mt-8">
                <BotonRelieve href="/blog" trackId="about-blog-todos">
                  <T v={about.blog.verTodos} />
                </BotonRelieve>
              </div>
            </div>
          )}
        </Reveal>
