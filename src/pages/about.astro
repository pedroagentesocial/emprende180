---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import BotonRed from "@components/ui/BotonRed.astro";
import Lista from "@components/sections/03-Lista.astro";
import { copy, contacto, instructor, sitio } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import { articulosPublicados, formatearFecha, tituloBilingue } from "@lib/blog";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /about — quiénes somos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Reescrita entera el 14 de septiembre de 2026 sobre el brief del cliente:
 * nueve secciones en este orden, cada una con su texto aprobado antes de
 * escribirse. Ver `copy.about` para el porqué de cada texto.
 *
 *   1. Hero: el vídeo de presentación de Pedro, sin texto (desde el 15-09-2026).
 *   2. La carta de Pedro: retrato y carta a dos columnas, elementos
 *      centrados, texto justificado.
 *   3. Presentación de marca, con dos retratos.
 *   4. La barra de cuatro hechos.
 *   5. Las marcas que representamos.
 *   6. Los seis valores del manifiesto.
 *   7. Propósito y los cuatro públicos.
 *   8. El blog, en corto.
 *   9. La lista, tal cual está en la portada.
 *
 * ⚠️ LA CARTA VA SEGUNDA, Y ESTUVO SÉPTIMA. En una página de "quiénes somos"
 * quién habla es lo primero que hay que enseñar, no lo último: el lector que
 * llega aquí viene a comprobar que detrás hay alguien. Se movió el 14-09-2026
 * a petición del cliente.
 *
 * ─── NO HAY SISTEMA VISUAL NUEVO, Y ESO ES LO QUE COSE LA PÁGINA ───────────
 *
 * Todo lo que se ve aquí ya existe en la portada: `Section` con sus cuatro
 * tonos, la escala de titulares, la Fraunces de los remates, el botón en
 * relieve, la caja de 52 px de los iconos, el bloque de autor del blog y la
 * sección de la lista entera. Cuando el /about y la portada comparten piezas,
 * se leen como dos páginas del mismo sitio y no como dos sitios.
 *
 * ─── LAS ZONAS DE FONDO ─────────────────────────────────────────────────────
 *
 *   navy     hero                           (la frase, sobre color y en movimiento)
 *   blanco   carta + presentación           (una zona: quién habla, y a quién)
 *   navy     la barra                       (el corte: lo comprobable)
 *   blanco   marcas                         (la prueba)
 *   suave    valores                        (el carácter)
 *   blanco   propósito + públicos + blog    (para quién, y lo que escribe)
 *   suave    la lista                       (la llamada, con su tarjeta navy)
 *
 * ⚠️ EL HERO ES NAVY Y LA CARTA BLANCA. El hundido de la primera versión no
 * se distinguía lo suficiente y se pidió "algo de fondo de color": el navy es
 * el color de zona que ya usa la barra y la tarjeta de la lista, así que no
 * entra ningún color nuevo. La carta sobre blanco es donde mejor se lee un
 * texto largo, y el corte navy -> blanco es el más limpio que hay.
 *
 * ⚠️ NINGÚN DATO SE ESCRIBE AQUÍ. Los cuatro de la barra, las tres empresas
 * y los textos viven en `copy.about`. Si algo falta, falta allí.
 */
export const prerender = false;

const { about, heroSlider } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const tituloPagina = construirTxt(
  (l) => `${about.kicker[l]} · ${sitio.nombre[l]}`,
);

/* Los dos últimos artículos publicados, y no tres: aquí el blog es una
   invitación, no una sección. `articulosPublicados` es la misma función que
   usan la portada y el listado, que es donde vive la regla de qué se
   publica. */
const articulos = (await articulosPublicados(getCollection)).slice(0, 2);

/* ⚠️ LAS CITAS PROPUESTAS SOLO SE VEN EN LOCAL. `import.meta.env.DEV` va en
   la misma expresión y no en una variable: Vite lo sustituye por `false` al
   compilar y la rama se pliega sola en producción. Una cita atribuida a una
   empresa real que no la ha aprobado no puede llegar a publicarse por un
   despiste. */
const enseñarPropuestas = import.meta.env.DEV;

/* La caja de los iconos, calcada de "Cómo se trabaja" en la portada: 52 px,
   esquina del sistema, fondo hundido, icono de 28 con el mismo grosor. */
const CAJA_ICONO =
  "grid size-[52px] shrink-0 place-items-center rounded-lg bg-surface-sunken text-ink-brand";
---

<BaseLayout titulo={tituloPagina} descripcion={about.descripcion}>
  {/* ─── LA BARRA, FLOTANDO SOBRE EL VÍDEO ────────────────────────────────
      El mismo montaje que la portada: la barra va en un envoltorio ABSOLUTO,
      transparente y con el logotipo en blanco, así que el hero empieza en el
      píxel cero y el vídeo se ve por detrás. En cuanto se baja un dedo, se
      ancla arriba y se pinta de navy (ver `Header.astro`, `sobreHero`). Lo pidió
      el cliente el 15-09-2026 al meter el vídeo: "el navegador déjalo
      transparente y se haga sólido al bajar". Hasta entonces esta página
      llevaba la barra blanca de las páginas sin foto. */}
  <div class="absolute inset-x-0 top-0 z-40">
    <Header sobreHero />
  </div>

  <main id="contenido">
    {/* ─── 1 · EL HERO ───────────────────────────────────────────────────
        EL VÍDEO DE PRESENTACIÓN, Y NADA MÁS. Lo pidió el cliente el
        15-09-2026: "mete el vídeo que teníamos de Pedro en el hero y quita el
        texto". Es el promocional que abrió el slider de la portada hasta ese
        mismo día (/video/prom.mp4): Pedro hablando, con la rotulación y los
        subtítulos quemados en la imagen. Aquí no compite con ningún titular,
        así que hace él de titular.

        ⚠️ EL TEXTO NO SE HA BORRADO. `copy.about.hero` sigue en el config con
        el título, el subtítulo y el botón aprobados; el cliente dijo "ya
        veremos qué hacemos con ese texto", así que se deja de pintar y se
        guarda. Si vuelve, la composición de la referencia (bossbabe) está en
        el historial: columna izquierda al 58 %, remate en Fraunces.

        ─── LLENA LA PANTALLA, CON LA BARRA ENCIMA ─────────────────────────
        El hero mide una pantalla (`h-svh`) y el vídeo la cubre con `cover`,
        igual que hacía como primera pantalla del slider de la portada. Con
        la barra flotando transparente encima, una caja 16:9 debajo de una
        barra blanca —que es lo que hubo un rato— dejaba el vídeo como un
        reproductor incrustado; a pantalla entera se lee como el hero de la
        portada, que es lo que se pidió con "el vídeo mejor acomodado".

        ⚠️ `cover` RECORTA, Y DÓNDE RECORTA ESTÁ MEDIDO. En escritorio (ventana
        más ancha que 16:9) recorta arriba y abajo, y el `center 62%` —medido
        sobre este fotograma, ver la nota larga de HeroVideo.astro— es lo
        único que salva a la vez la cara del presentador y los subtítulos
        quemados. En el teléfono (ventana vertical) recorta por los LADOS y
        se ve poco más de un tercio del ancho: ahí manda la coordenada
        horizontal, y el `50%` salva al presentador y casi todos los subtítulos
        a costa de la rotulación de la izquierda. Es el mismo par de encuadres
        que llevaba en el slider (`encuadreVertical: "50% 50%"`); la solución de
        verdad para el móvil sigue siendo un montaje vertical del promo.

        ⚠️ EL VÍDEO EMPIEZA DEBAJO DE LA BARRA, NO EN EL PÍXEL CERO. La barra
        flota transparente con el logotipo grande en el centro, y la cabeza
        del presentador arranca al 8 % del alto del fotograma: con el vídeo
        desde arriba, el logotipo le caía en la cara. El cliente lo vio y lo
        pidió: "baja el vídeo un poco". La caja lleva un relleno superior
        igual a la altura de la barra grande (`--header-h-grande`, 92 px; 128
        en `lg`) y el vídeo ocupa lo que queda, sobre el navy de la sección,
        que es lo que se ve detrás de la barra mientras está transparente. A
        900 de alto el vídeo mide 772 y recorta un 5 %; la cabeza queda unos
        40 px por debajo del borde de la caja, o sea 170 desde arriba: libre.

        ⚠️ Y SE ENCOGE AL BAJAR, como antes lo hacía el texto: la caja se
        escala del 100 al 92 % y se apaga según sale por arriba, guiada por el
        scroll (`animation-timeline: view()`) y sin un listener. El navy de la
        sección es lo que asoma por los bordes al encogerse. Las dos manchas
        de luz que había detrás del texto se fueron con él: detrás de un vídeo
        a sangre no se verían.

        ─── EL SONIDO ──────────────────────────────────────────────────────
        Arranca mudo y en bucle, que es lo único que un navegador deja
        arrancar solo, y con los subtítulos quemados se entiende sin voz. El
        botón de abajo a la derecha enciende la voz al 20 %: es el mismo botón
        y las mismas etiquetas que tenía en el slider. Va a la DERECHA porque
        los subtítulos ocupan el centro de la franja de abajo; en el teléfono
        se queda en el icono solo, que con el texto se le metía encima.

        Quien pide menos movimiento no ve el vídeo moverse solo: se queda en
        el primer fotograma y arranca solo si pulsa el botón de sonido, que
        es pedirlo. */}
    <Section
      id="about-hero"
      tono="inverse"
      ariaLabel={about.aria}
      sinContenedor
      class="relative isolate overflow-hidden py-0!"
    >
      <div
        data-hero-encoge
        class="relative isolate flex h-svh w-full flex-col bg-primary-950 pt-[var(--header-h-grande)] lg:pt-[var(--header-h-grande-lg)]"
      >
       {/* El hueco del vídeo: lo que queda de pantalla debajo de la barra. */}
       <div class="relative flex-1">
        {/* `aria-hidden` y sin controles nativos: los mandos son el botón de
            sonido, que es un `<button>` de verdad y sí se anuncia. `size-full`
            porque un `<video>` sin medida sale a su tamaño nativo. */}
        <video
          data-about-video
          aria-hidden="true"
          tabindex="-1"
          muted
          loop
          playsinline
          autoplay
          preload="auto"
          poster={about.hero.video.poster}
          src={about.hero.video.src}
          data-alt-es={about.hero.video.alt.es}
          data-alt-en={about.hero.video.alt.en}
          class="absolute inset-0 size-full object-cover [object-position:50%_50%] lg:[object-position:center_62%]"
        >
        </video>

        <div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-end px-4 sm:bottom-6 sm:px-6 lg:bottom-8 lg:px-[var(--gutter-page)]">
          <button
            type="button"
            data-about-sonido
            aria-pressed="false"
            aria-label={heroSlider.activarSonido[lang]}
            data-aria-es={heroSlider.activarSonido.es}
            data-aria-en={heroSlider.activarSonido.en}
            data-etiqueta-activar-es={heroSlider.activarSonido.es}
            data-etiqueta-activar-en={heroSlider.activarSonido.en}
            data-etiqueta-silenciar-es={heroSlider.silenciarSonido.es}
            data-etiqueta-silenciar-en={heroSlider.silenciarSonido.en}
            class="pointer-events-auto inline-flex min-h-11 min-w-11 items-center justify-center gap-2.5 rounded-full border border-white/40 bg-primary-950/40 px-3 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition-colors duration-200 hover:border-white hover:bg-primary-950/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-inverse sm:px-5"
          >
            <Icono nombre="megafono" class="size-4 shrink-0" grosor={1.8} data-icono-mudo />
            <Icono nombre="megafono" class="hidden size-4 shrink-0" grosor={2.4} data-icono-suena />
            <span data-etiqueta-sonido class="hidden sm:inline">
              <T v={heroSlider.activarSonido} />
            </span>
          </button>
        </div>
       </div>
      </div>
    </Section>

    {/* ─── 2 · LA CARTA ──────────────────────────────────────────────────
        El retrato a la izquierda, grande, y la carta a la derecha. Es la
        única sección de la página con la foto de Pedro, y por eso es la
        única donde la foto es la pieza central y no un sello: aquí el que
        habla es él.

        Va justo después del hero, y por eso el retrato es la primera imagen
        de la página: la primera cara que se ve es la de quien firma.

        Sobre blanco: el hero ya lleva el fondo hundido, y una carta se lee
        mejor sobre blanco que sobre cualquier otra cosa.

        ⚠️ `items-center` Y NO `items-start`. Las dos columnas no miden lo mismo
        —el retrato es un 4:5 y la carta son cinco párrafos— y con `start` el
        texto arrancaba pegado al borde de arriba mientras la foto bajaba más:
        el centro de una cosa no coincidía con el centro de la otra. Centradas,
        la que sea más corta se coloca a la altura del medio de la más larga.

        Y por eso el retrato dejó de ser `sticky`: `sticky` lo ancla arriba y
        `center` lo quiere al medio, y las dos cosas a la vez no existen. */}
    <Section id="about-carta" tono="surface" ariaLabel={about.carta.kicker}>
      {/* ⚠️ DOS COLUMNAS 30 / 70, CON LOS ELEMENTOS CENTRADOS Y EL TEXTO
          JUSTIFICADO. Lo pidió el cliente el 15-09-2026, y hubo que pedirlo
          dos veces: la primera lectura de "centrado imagen y texto" apiló el
          retrato encima de la carta en una sola columna, y no era eso. Era
          esto: el retrato a la izquierda y la carta a la derecha, como
          estaban, pero cada cosa centrada en su columna —el retrato con su
          nombre y su cargo debajo, el rótulo y la firma en el eje— y los
          párrafos justificados, que es lo que hace que un bloque centrado
          tenga los dos bordes rectos y no un lado dentado.

          ⚠️ JUSTIFICAR TRAE RÍOS DE BLANCO SI NO SE PARTEN PALABRAS, y en una
          medida de 65 caracteres se notan. Por eso va `hyphens-auto`: el
          navegador parte por sílabas según el `lang` de la página —que aquí
          cambia sin recargar, y la partición cambia con él— y los huecos se
          quedan en lo normal. Y se quita `text-pretty`, que ajusta el último
          renglón para que no quede una palabra huérfana: con el texto
          justificado ese ajuste pelea con el propio justificado.

          Las dos columnas van `items-center`: el retrato queda a media altura
          de la carta, que es lo que se ve cuando la carta es más alta que él.

          ⚠️ EL RETRATO VA PEGADO AL TEXTO, Y LOS DOS JUNTOS EN EL CENTRO. Con
          30 / 70 a todo el ancho del contenedor, la carta —que mide 65
          caracteres— quedaba centrada en su columna del 70 % y entre ella y
          el retrato se abría un hueco de casi 200 px. El cliente lo pidió
          así: "la imagen de Pedro acércala más al centro con el texto". La
          rejilla pasa a dos columnas de medida fija —el retrato a 24rem y la
          carta a lo que mide la prosa— con `justify-center`, así que el par
          se centra como una sola pieza y el aire sobra por fuera, no por
          dentro. `gap-16` entre los dos: cerca, pero sin que la carta se lea
          como pie de foto. */}
      <div class="grid justify-center gap-12 lg:grid-cols-[24rem_minmax(0,65ch)] lg:items-center lg:gap-16">
        <Reveal>
          <div class="flex flex-col items-center text-center">
            <img
              src={instructor.foto}
              alt={about.carta.fotoAlt[lang]}
              data-alt-es={about.carta.fotoAlt.es}
              data-alt-en={about.carta.fotoAlt.en}
              width={800}
              height={1000}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full max-w-sm rounded-lg border border-line object-cover object-top"
            />
            <p class="mt-5 text-xl font-extrabold text-ink">{instructor.nombre}</p>
            <p class="mt-1 text-base font-medium text-ink-muted">
              <T v={instructor.rol} />
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          <div class="mx-auto flex max-w-prose flex-col items-center">
            <p class="text-center text-sm font-semibold text-ink-brand sm:text-base">
              <T v={about.carta.kicker} />
            </p>

            <div class="mt-6 space-y-5 text-justify hyphens-auto">
              {about.carta.parrafos.map((parrafo) => (
                <p class="text-lg font-medium leading-relaxed text-ink sm:text-xl">
                  <T v={parrafo} />
                </p>
              ))}
            </div>

            {/* La firma, en la Fraunces de los remates. Es la única vez en
                toda la web que la itálica no remata una frase: firma una. */}
            <p class="mt-10 text-center font-acento text-3xl italic text-ink sm:text-4xl">
              — <T v={about.carta.firma} />
            </p>
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 3 · LA PRESENTACIÓN ───────────────────────────────────────────
        Dos retratos verticales, lado a lado y desnivelados, y el texto al
        lado. Son las dos personas a las que habla el sitio —ella y él—, en
        los mismos dos originales que usa la portada.

        ⚠️ LADO A LADO Y NO SUPERPUESTOS. El montaje en diagonal de la portada
        se quitó cuando su columna se estrechó, y aquí no se resucita: dos
        verticales pegadas con un desnivel de 3rem se leen como una pareja sin
        que ninguna tape a la otra. El desnivel es lo que evita que parezcan
        dos celdas de una tabla. */}
    <Section id="about-intro" tono="surface" ariaLabel={about.aria}>
      {/* ⚠️ 35 / 65, Y ERA 42 / 58. La diferencia de antes casi no se veía; con
          un tercio para las fotos y dos para el texto sí. No baja del 35 porque
          la columna lleva DOS retratos lado a lado: a 1440 son unos 430 px, o
          sea 205 por retrato, y por debajo de eso se leen como sellos. */}
      <div class="grid items-center gap-12 md:grid-cols-[35fr_65fr] md:gap-10 lg:gap-16 xl:gap-24">
        <Reveal>
          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            {about.intro.fotos.map((foto, i) => (
              <img
                src={foto.src}
                alt={foto.alt[lang]}
                data-alt-es={foto.alt.es}
                data-alt-en={foto.alt.en}
                width={800}
                height={1040}
                loading="lazy"
                decoding="async"
                class:list={[
                  "aspect-[10/13] w-full rounded-lg border border-line object-cover",
                  i === 1 && "mt-12 sm:mt-16",
                ]}
              />
            ))}
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          <div>
            <h2 class="text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink sm:text-5xl lg:text-6xl">
              <T v={about.intro.titulo} />
            </h2>
            <p class="mt-2 text-3xl leading-[1.15] text-balance sm:text-4xl lg:text-5xl">
              <Enfasis v={about.intro.subtitulo} />
            </p>

            {about.intro.parrafos.map((parrafo, i) => (
              <p
                class:list={[
                  "max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl",
                  i === 0 ? "mt-7" : "mt-4",
                ]}
              >
                <T v={parrafo} />
              </p>
            ))}
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 4 · LA BARRA ──────────────────────────────────────────────────
        Cuatro hechos con el formato de cuatro contadores, sobre navy: es el
        corte entre "quiénes somos" y "qué hay". El rótulo de arriba dice
        exactamente lo que son —lo que hay hoy, sin redondear— porque una
        barra de cifras en una empresa de meses solo se sostiene si no
        pretende ser otra cosa. Ver la nota de `copy.about`. */}
    <Section id="about-barra" tono="inverse" ritmo="compacto" ariaLabel={about.barra.kicker}>
      <Reveal>
        <p class="text-center text-sm font-semibold text-ink-on-inverse-brand sm:text-base">
          <T v={about.barra.kicker} />
        </p>

        {/* Dos por fila en el teléfono, cuatro desde `lg`. El filete entre
            celdas solo aparece cuando están en fila: apiladas, sería una
            raya vertical entre cosas que ya están separadas por el aire. */}
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4 lg:gap-x-0">
          {about.barra.datos.map((dato, i) => (
            <div
              class:list={[
                "text-center lg:px-6",
                i > 0 && "lg:border-l lg:border-white/15",
              ]}
            >
              <dd class="text-5xl font-extrabold leading-none tracking-[-0.03em] text-ink-inverse lg:text-6xl">
                {dato.valor}
              </dd>
              <dt class="mx-auto mt-3 max-w-[14ch] text-base font-medium text-balance text-secondary-100 sm:text-lg">
                <T v={dato.etiqueta} />
              </dt>
            </div>
          ))}
        </dl>
      </Reveal>
    </Section>

    {/* ─── 5 · LAS MARCAS ────────────────────────────────────────────────
        Tres tarjetas iguales. Cada una lleva su logotipo, su rubro, lo que
        resuelve y —cuando exista— su cita.

        ⚠️ LA CITA NO ESTÁ Y NO SE INVENTA. Lo que hay en el config son tres
        PROPUESTAS para llevárselas a cada empresa, y solo se pintan en local,
        con su rótulo. En producción la tarjeta enseña lo que es verdad:
        logotipo, rubro, lo que resuelven y el enlace a su web. */}
    <Section id="about-marcas" tono="surface" ariaLabel={about.confian.kicker}>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold text-ink-brand sm:text-base">
            <T v={about.confian.kicker} />
          </p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
            <T v={about.confian.titulo} />
          </h2>
          <p class="mx-auto mt-5 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
            <T v={about.confian.texto} />
          </p>
        </div>
      </Reveal>

      <ul role="list" class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-8">
        {about.aliados.map((marca, i) => (
          <Reveal as="li" delay={i * 0.08} class="flex">
            <article class="flex w-full flex-col rounded-lg border-[0.5px] border-line bg-surface p-7">
