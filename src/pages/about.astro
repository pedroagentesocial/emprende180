<script>
  /* ─── EL VÍDEO DEL HERO: SONIDO, VISIBILIDAD Y MOVIMIENTO ────────────────
     Tres cosas y ninguna más:

       · el botón de sonido enciende la voz al 20 % y la apaga; el rótulo dice
         lo que VA A PASAR, en el idioma de la página, y se repinta cuando
         cambia el idioma (`e180:idioma`);
       · el vídeo se para cuando sale de la vista o la pestaña se esconde
         —un `<video>` que no se ve sigue decodificando y gastando batería— y
         al volver arranca de nuevo. Si estaba sonando al irse, vuelve mudo:
         una voz que sigue hablando fuera de pantalla es un fallo;
       · quien pide menos movimiento no lo ve arrancar solo. Se queda en el
         primer fotograma y solo se mueve si pulsa el botón de sonido, que es
         pedirlo. */
  const hero = document.getElementById("about-hero");
  const video = hero?.querySelector<HTMLVideoElement>("[data-about-video]");
  const boton = hero?.querySelector<HTMLButtonElement>("[data-about-sonido]");

  if (hero && video && boton) {
    const VOLUMEN = 0.2;
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
    let sonando = false;

    const claveIdioma = (base: string) =>
      document.documentElement.lang === "en" ? `${base}En` : `${base}Es`;

    const pintar = () => {
      const etiqueta =
        boton.dataset[claveIdioma(sonando ? "etiquetaSilenciar" : "etiquetaActivar")];
      if (etiqueta) boton.setAttribute("aria-label", etiqueta);
      boton.setAttribute("aria-pressed", String(sonando));
      boton.querySelector("[data-icono-mudo]")?.classList.toggle("hidden", sonando);
      boton.querySelector("[data-icono-suena]")?.classList.toggle("hidden", !sonando);
      const texto = boton.querySelector("[data-etiqueta-sonido]");
      if (texto && etiqueta) texto.textContent = etiqueta;
    };

    const reproducir = () => {
      video.play().catch(() => {});
    };

    const callar = () => {
      video.muted = true;
      sonando = false;
      pintar();
    };

    if (menosMovimiento.matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }

    boton.addEventListener("click", () => {
      if (sonando) {
        callar();
        if (menosMovimiento.matches) video.pause();
        return;
      }
      video.volume = VOLUMEN;
      video.muted = false;
      reproducir();
      sonando = true;
      pintar();
    });

    /* Fuera de la vista, parado. La mitad de la caja basta: por debajo de
       eso lo que se ve es un trozo y no un vídeo. */
    const observador = new IntersectionObserver(
      ([entrada]) => {
        if (!entrada) return;
        if (entrada.isIntersecting) {
          if (!menosMovimiento.matches) reproducir();
        } else {
          if (sonando) callar();
          video.pause();
        }
      },
      { threshold: 0.5 },
    );
    observador.observe(video);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (sonando) callar();
        video.pause();
      } else if (!menosMovimiento.matches) {
        reproducir();
      }
    });

    window.addEventListener("e180:idioma", pintar);
  }
</script>

<style>
  /* ⚠️ AQUÍ HABÍA DOS MANCHAS DE LUZ (`about-luz-a/b`) que derivaban detrás
     del texto del hero. Se quitaron el 15-09-2026 con el texto: el hero es
     ahora un vídeo a sangre y detrás de él no se vería nada. Están en el
     historial si el texto vuelve. */

  /* ─── EL HERO SE ENCOGE AL SALIR ─────────────────────────────────────────
     Guiado por el scroll, no por el tiempo: `view()` sigue la posición del
     propio elemento en la ventana, y `exit` recorre el tramo en que va
     saliendo por arriba. Al 0 % de ese tramo aún se ve entero; al 100 % ya no
     se ve. Escala corta y opacidad, nada más: una caída más aparatosa se
     leería como un efecto y no como una salida. */
  @keyframes about-encoger {
    to {
      transform: scale(0.92) translateY(-1.5rem);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-hero-encoge] {
        transform-origin: 50% 100%;
        animation: about-encoger linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
</style>
