---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Button from "@components/ui/Button.astro";
import Icono from "@components/ui/Icono.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import FormAcceso from "@components/alumno/FormAcceso";
import { sitio, contacto, copy } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";
import {
  alumnoActual,
  entrarConClave,
  mandarEnlaceAcceso,
  rutaInterna,
} from "@lib/acceso";
import { CORREO_ACCESO } from "@lib/correoAcceso";
import { consumir, ipDe } from "@lib/rateLimit";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /acceso — la puerta del área de alumnos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ CORREO Y CONTRASEÑA, con "he olvidado mi contraseña" en el mismo
 * formulario y sin cambiar de página: quien pulsa ese enlace ya ha escrito su
 * correo, y hacerle teclearlo otra vez es fricción justo cuando ya está
 * frustrado. Ver `FormAcceso.tsx`.
 *
 * El enlace que llega al correo NO es la forma normal de entrar: sirve para
 * estrenar la cuenta y para recuperarla, que en el fondo son el mismo gesto.
 * Ver `src/lib/acceso.ts`.
 *
 * ─── ESTÁ ESCRITA PARA DOS PERSONAS ────────────────────────────────────────
 *
 * Quien llega aquí es una de dos, y necesitan cosas opuestas:
 *
 *   · YA ES ALUMNO → quiere entrar. Manda: el formulario va arriba y solo.
 *   · SE EQUIVOCÓ de botón → necesita volver a la venta sin sentirse perdido,
 *     y saber que esto se compra antes de poder entrar.
 *
 * ─── SI YA HA ENTRADO, NO SE LE ENSEÑA LA PUERTA ───────────────────────────
 *
 * Con sesión abierta esto redirige al tablero. Enseñarle un formulario de
 * acceso a quien ya está dentro es la forma más rápida de hacerle creer que se
 * ha caído su sesión.
 *
 * ─── `noindex` ─────────────────────────────────────────────────────────────
 *
 * Una pantalla de acceso no tiene nada que hacer en un buscador: no aporta
 * nada a quien busca y sí le da a un rastreador una lista de puertas.
 */
export const prerender = false;

/* Ya identificado: al tablero. Antes de pintar nada. */
if (await alumnoActual(Astro.cookies)) return Astro.redirect("/alumno", 302);

/* ─── EL FORMULARIO TAMBIÉN FUNCIONA SIN JAVASCRIPT ────────────────────────
 *
 * ⚠️ ESTO EMPEZÓ SIENDO UN FALLO DE SEGURIDAD, NO UNA MEJORA.
 *
 * El formulario era solo una isla de React que interceptaba el envío. Mientras
 * la isla no ha hidratado —red lenta, un error de JS, el script bloqueado— el
 * `<form>` seguía siendo un formulario normal SIN `method`, así que enviarlo
 * hacía un GET y la contraseña acababa EN LA URL: en la barra de direcciones,
 * en el historial y en la cabecera `Referer` de la siguiente petición.
 *
 * Ahora el formulario es `method="POST"` contra esta misma página y se procesa
 * aquí. La isla lo sigue interceptando para dar errores sin recargar, pero si
 * no llega, el envío es un POST correcto y no se filtra nada. Es lo mismo que
 * ya hacían el panel de altas y la pantalla de contraseña.
 */
let errorPost: "credenciales" | "limite" | "email" | null = null;
let enviadoPost = false;

if (Astro.request.method === "POST") {
  const datos = await Astro.request.formData();
  const modo = String(datos.get("modo") ?? "entrar");
  const email = String(datos.get("email") ?? "").trim().toLowerCase();
  const ip = ipDe(Astro.request, Astro.clientAddress);

  if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)) {
    errorPost = "email";
  } else if (modo === "recuperar") {
    if (!consumir(`acceso:${ip}`, 15, 10 * 60 * 1000).permitido) {
      /* El límite NO se le cuenta al visitante como error: decir "has pedido
         demasiados" para ese correo confirmaría que existe. Se le enseña el
         mismo "ya te lo hemos mandado" que a todo el mundo. */
      enviadoPost = true;
    } else {
      const idiomaPeticion = resolverIdiomaServidor(
        Astro.url,
        Astro.request.headers.get("accept-language"),
      );
      await mandarEnlaceAcceso(email, idiomaPeticion, Astro.url, CORREO_ACCESO);
      enviadoPost = true;
    }
  } else if (!consumir(`entrar-ip:${ip}`, 20, 10 * 60 * 1000).permitido) {
    errorPost = "limite";
  } else if (!consumir(`entrar-email:${email}`, 10, 15 * 60 * 1000).permitido) {
    errorPost = "limite";
  } else {
    const alumno = await entrarConClave(
      email,
      String(datos.get("clave") ?? ""),
      Astro.cookies,
      Astro.request.headers.get("user-agent"),
    );
    if (alumno) {
      return Astro.redirect(
        rutaInterna(String(datos.get("destino") ?? "")),
        303,
      );
    }
    errorPost = "credenciales";
  }
}

const tituloPagina = construirTxt(
  (l) => `${copy.acceso.titulo[l]} · ${sitio.nombre}`,
);

/* Mensajes que llegan por la URL desde `/acceso/entrar` y `/api/salir`. */
const error = Astro.url.searchParams.get("error");
const salida = Astro.url.searchParams.get("salida") === "1";

/* `destino` viaja al formulario para volver a donde el visitante iba. Pasa por
   el mismo filtro que `/acceso/entrar` —`rutaInterna`— porque acaba dentro del
   enlace que mandamos por correo, y ahí no puede colarse una URL de otro. */
const destino = rutaInterna(Astro.url.searchParams.get("destino"));

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* `?recuperar=1` arranca el formulario en modo recuperación. Es lo que hace que
   el enlace de "he olvidado mi contraseña" siga funcionando sin JavaScript.
   Tras un POST de recuperación se conserva el modo, para que el mensaje de
   "ya te lo hemos mandado" no aparezca sobre el formulario de entrar. */
/* El POST vuelve a esta misma página, y tiene que volver en el MISMO idioma:
   sin arrastrar `?lang=`, quien está leyendo en español recibe el error en
   inglés. Solo se conserva ese parámetro; los demás (`error`, `salida`) son
   respuestas y no tienen por qué sobrevivir a un envío. */
const langUrl = Astro.url.searchParams.get("lang");
const accionForm = langUrl ? `/acceso?lang=${encodeURIComponent(langUrl)}` : "/acceso";

const modoInicial =
  Astro.url.searchParams.get("recuperar") === "1" || enviadoPost
    ? ("recuperar" as const)
    : ("entrar" as const);
---

<BaseLayout
  titulo={tituloPagina}
  descripcion={copy.acceso.entradilla}
  noindex
>
  <Header />

  <main id="contenido" class="relative isolate overflow-hidden bg-surface-muted section-y">
    <MarcaAgua variante="color" posicion="derecha" class="opacity-[0.04]" />

    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-bold tracking-wide text-ink-subtle uppercase"
        >
          <span aria-hidden="true" class="marca-linea">
            <Icono nombre="usuario" class="size-3.5" grosor={2} />
          </span>
          <T v={copy.acceso.kicker} />
        </p>

        <h1 class="mt-5 text-4xl font-extrabold text-balance text-ink sm:text-5xl">
          <T v={copy.acceso.formTitulo} />
        </h1>

        <p class="mx-auto mt-5 max-w-md text-lg text-pretty text-ink-muted">
          <T v={copy.acceso.formTexto} />
        </p>
      </div>

      {/* ─── El formulario ─────────────────────────────────────────────────── */}
      <div class="mx-auto mt-10 max-w-md">
        {/* Los avisos van ENCIMA del formulario y no debajo: quien vuelve aquí
            con un enlace caducado necesita saber por qué antes de teclear otra
            vez su correo, no después. */}
        {
          error && (
            <p
              role="alert"
              class="mb-5 rounded-xl border border-warning-500 bg-warning-50 px-4 py-3 text-sm text-pretty text-ink"
            >
              <T v={copy.acceso.errorCaducado} />
            </p>
          )
        }
        {
          salida && (
            <p class="mb-5 rounded-xl border border-line bg-surface px-4 py-3 text-center text-sm text-ink-muted">
              <T v={copy.acceso.salida} />
            </p>
          )
        }

        {/* Lo que responde el POST sin JavaScript. Con la isla hidratada estos
            mensajes los pinta ella sin recargar; esto es lo que se ve cuando
            no ha llegado. */}
        {
          errorPost && (
            <p
              role="alert"
              class="mb-5 rounded-xl border border-error-500 bg-error-50 px-4 py-3 text-sm font-medium text-error-700"
            >
              <T
                v={
                  errorPost === "limite"
                    ? copy.acceso.formErrorLimite
                    : errorPost === "email"
                      ? copy.acceso.formErrorEmail
                      : copy.acceso.formErrorCredenciales
                }
              />
            </p>
          )
        }
        {
          enviadoPost && (
            <p class="mb-5 rounded-xl border border-secondary-300 bg-secondary-50 px-4 py-3 text-sm text-pretty text-ink">
              <T v={copy.acceso.formEnviado} />
            </p>
          )
        }

        <div class="rounded-3xl border border-line bg-surface p-6 shadow-sm sm:p-8">
          <FormAcceso
            client:load
            lang={lang}
            destino={destino}
            modoInicial={modoInicial}
            accion={accionForm}
          />
        </div>
      </div>

      {/* ─── Para quien se equivocó de botón ──────────────────────────────────
          Va debajo, pequeño y sin competir: es el caso menos frecuente de los
          dos, pero dejarlo sin salida convierte esta pantalla en un callejón
          para quien todavía no ha comprado. */}
      <div class="mx-auto mt-10 max-w-md rounded-2xl border border-line bg-surface-muted p-6 text-center">
        <h2 class="text-base font-bold text-balance text-ink">
          <T v={copy.acceso.noCompre.titulo} />
        </h2>
        <p class="mt-2 text-sm text-pretty text-ink-muted">
          <T v={copy.acceso.noCompre.texto} />
        </p>

        <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button
            href="/"
            variant="secondary"
            trackId="acceso-volver"
            class="w-full sm:w-auto"
          >
            <T v={copy.acceso.noCompre.cta} />
          </Button>

          {
            contacto.telefono && (
              <Button
                href={`tel:${contacto.telefono}`}
                variant="secondary"
                trackId="acceso-llamada"
                class="w-full sm:w-auto"
              >
                <Icono nombre="telefono" class="size-4 shrink-0" grosor={2} />
                <T v={copy.instructor.llamame} />
              </Button>
            )
          }
        </div>
      </div>

      {/* ─── Qué hay dentro ────────────────────────────────────────────────
          No es relleno: quien está esperando el enlace en su bandeja mira esta
          pantalla mientras tanto, y quien no ha comprado necesita saber qué se
          compra. Son las mismas tres promesas de la página de venta, sin una
          de más. */}
      <div class="mx-auto mt-12 max-w-2xl border-t border-line pt-10">
        <h2
          class="text-center text-xs font-bold tracking-[0.16em] text-ink-subtle uppercase"
        >
          <T v={copy.acceso.queHabra.titulo} />
        </h2>

        <ul class="mx-auto mt-6 grid max-w-xl gap-3">
          {
            copy.acceso.queHabra.puntos.map((p) => (
              <li class="flex items-start gap-3 text-base text-ink">
                <span aria-hidden="true" class="marca-linea shrink-0 text-secondary-600">
                  <Icono nombre="check" class="size-5" grosor={2.5} />
                </span>
                <T v={p} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
