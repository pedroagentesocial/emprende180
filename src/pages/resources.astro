---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import MarcaAgua from "@components/ui/MarcaAgua.astro";
import LeadForm from "@components/ui/LeadForm";
import HeroPagina from "@components/hero/HeroPagina.astro";
import BlogPortada from "@components/sections/06-Blog.astro";
import Faq from "@components/sections/06-Faq.astro";
import { copy, sitio } from "@config/curso.config";
import { articulosPublicados, formatearFecha } from "@lib/blog";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /resources
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Existe porque ya la enlazaban dos sitios: "Recursos" en el menú y la franja
 * oscura de la portada. Un enlace del menú a un 404 es de las pocas cosas que
 * hacen dudar de todo lo demás que hay en la página.
 *
 * ─── QUÉ HAY AQUÍ DE VERDAD ────────────────────────────────────────────────
 *
 * Rehecha el 15-09-2026 a petición del cliente ("hay que darle amor,
 * contenido, mejorar mucho esta página"). Era el bloque del blog y, debajo,
 * la misma lista de artículos otra vez y un formulario. Ahora, en este orden:
 *
 *   1. Hero de página interior, con un índice de lo que hay debajo.
 *   2. El blog: quién escribe y los tres últimos artículos (`06-Blog`).
 *   3. Más artículos: SOLO los que no caben en los tres de arriba. Con tres
 *      publicados no se pinta nada; con el cuarto aparece. Así la lista no
 *      repite lo que acaba de verse, que era lo que pasaba antes.
 *   4. El plan de 90 días, de un vistazo: el día en tres bloques, las cuatro
 *      fases a escala y los tres hitos. Es `copy.plan90`, escrito sobre el
 *      documento del cliente, y estuvo en la portada hasta que se
 *      simplificó. Aquí es lo que es: material para mirar.
 *   5. Las preguntas frecuentes, las mismas de la portada.
 *   6. El aviso del siguiente artículo, con el formulario.
 *
 * ⚠️ NI PLANTILLAS, NI PDF, NI "CONTENIDO EXCLUSIVO": no existen. Todo lo que
 * hay aquí ya existía y estaba aprobado; lo que ha cambiado es que ahora está
 * junto. El día que haya algo más, se añade y el índice del hero cambia con
 * ello (`copy.recursos.indice`).
 *
 * ⚠️ Y NO SE MUERE SI NO HAY ARTÍCULOS. A diferencia de `/blog`, que devuelve
 * 404 vacío, esta página tiene sentido con la lista vacía: el plan, las
 * preguntas y el formulario siguen siendo un motivo para estar aquí.
 */
export const prerender = false;

const { recursos, guias, plan90 } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

/* Los tres primeros los pinta `06-Blog`; aquí van los demás. */
const restantes = (await articulosPublicados(getCollection)).slice(3);

const tituloPagina = construirTxt(
  (l) => `${recursos.paginaTitulo[l]} · ${sitio.nombre[l]}`,
);

/**
 * La barra de fases es el calendario a escala: cada tramo mide los días que
 * dura su fase (20, 25, 25, 20 de 90). Tailwind no puede construir la clase
 * a partir de los datos, así que va escrita a mano y en desarrollo se
 * comprueba que siga cuadrando con el config.
 */
const PROPORCION = "20fr_25fr_25fr_20fr";
if (import.meta.env.DEV) {
  const real = plan90.fases.map((f) => `${f.dias}fr`).join("_");
  if (real !== PROPORCION) {
    console.warn(
      `[resources] Los días de las fases cambiaron (${real}) y la barra sigue ` +
        `repartida como ${PROPORCION}. Hay que actualizar lg:grid-cols-[…] a mano.`,
    );
  }
}

/** El color de cada tramo, de más claro a más oscuro: el plan se va asentando. */
const TRAMOS = ["bg-secondary-200", "bg-secondary-400", "bg-secondary-600", "bg-primary-900"];
---

<BaseLayout titulo={tituloPagina} descripcion={recursos.paginaDescripcion}>
  <Header />

  <main id="contenido">
    {/* ─── 1 · EL HERO ───────────────────────────────────────────────────
        Sin botón: lo que hay que hacer aquí es leer, y el índice de debajo
        del párrafo ya dice qué hay y lleva a cada cosa. Son enlaces de texto
        con la flecha hacia abajo, no botones: cuatro pastillas teal en fila
        serían cuatro llamadas a la acción y ninguna lo es. */}
    <HeroPagina
      id="recursos-hero"
      aria={recursos.aria}
      kicker={recursos.kicker}
      titulo={recursos.titulo[0]}
      remate={recursos.titulo[1]}
      texto={recursos.texto}
    >
      <nav
        aria-label={recursos.paginaTitulo[lang]}
        data-aria-es={recursos.paginaTitulo.es}
        data-aria-en={recursos.paginaTitulo.en}
        class="mt-8 lg:mt-10"
      >
        <ul role="list" class="flex flex-wrap gap-x-7 gap-y-3">
          {recursos.indice.map((item) => (
            <li>
              <a
                href={item.ancla}
                class="group inline-flex min-h-11 items-center gap-2 text-base font-semibold text-white/85 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-inverse sm:text-lg"
              >
                <T v={item.texto} />
                <Icono
                  nombre="flecha"
                  class="size-4 shrink-0 rotate-90 text-secondary-300 transition-transform duration-200 ease-out-soft group-hover:translate-y-0.5"
                />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </HeroPagina>

    {/* ─── 2 · EL BLOG ───────────────────────────────────────────────────
        La sección entera —el bloque de autor, los tres últimos artículos y
        su foto— vivía en la portada y se mudó aquí el 15-09-2026. Sin el
        botón de "ver todos": lo que falte está justo debajo. */}
    <BlogPortada botonTodos={false} />

    {/* ─── 3 · MÁS ARTÍCULOS ─────────────────────────────────────────────
        Solo si hay más de tres. Una columna: un titular largo se lee entero
        y no hay que cortarlo para que quepa en una tarjeta. */}
    {restantes.length > 0 && (
      <Section id="recursos-mas" tono="surface" ritmo="compacto" ariaLabel={recursos.masArticulos} class="pt-0!">
        <Reveal>
          <h2 class="text-sm font-bold tracking-[0.18em] text-ink-muted uppercase">
            <T v={recursos.masArticulos} />
          </h2>
          <ul class="mt-6 divide-y divide-line border-t border-line">
            {restantes.map((a) => (
              <li>
                <a
                  href={`/blog/${a.id}`}
                  class="group flex items-start gap-4 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                >
                  <span class="min-w-0 flex-1">
                    <time
                      datetime={a.data.fecha.toISOString().slice(0, 10)}
                      class="block text-sm font-medium text-ink-subtle"
                    >
                      {formatearFecha(a.data.fecha, a.data.idioma)}
                    </time>
                    <span class="mt-1 block text-xl font-extrabold text-pretty text-ink group-hover:text-ink-brand sm:text-2xl">
                      {a.data.titulo}
                    </span>
                    <span class="mt-2 block max-w-prose text-base font-medium text-pretty text-ink-muted sm:text-lg">
                      {a.data.resumen}
                    </span>
                  </span>
                  <Icono
                    nombre="flecha"
                    class="mt-7 size-5 shrink-0 text-ink-subtle transition-transform duration-200 ease-out-soft group-hover:translate-x-1 group-hover:text-ink-brand"
                  />
                </a>
              </li>
            ))}
          </ul>
        </Reveal>
      </Section>
    )}

    {/* ─── 4 · EL PLAN DE 90 DÍAS, DE UN VISTAZO ─────────────────────────
        Tres filas. Arriba, la tarjeta navy con las dos horas al día y las
        tres frases que no cambian, y al lado el día en tres bloques. En
        medio, las cuatro fases sobre la barra a escala. Abajo, los tres
        hitos. Todo escrito para MIRARSE: cada frase cabe en una o dos líneas
        a propósito, y si alguien las alarga la rejilla se descuadra (ver la
        nota de `copy.plan90`).

        ⚠️ NI UNA CIFRA DE RESULTADOS, igual que en el resto del sitio: las
        únicas cifras son de tiempo (minutos, días). */}
    <Section id="plan" tono="surface" ariaLabel={plan90.aria}>
      <Reveal>
        <h2 class="text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
          <T v={recursos.planTitulo} />{" "}
          <Enfasis v={recursos.planRemate} />
        </h2>
        <p class="mt-4 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
          <T v={plan90.entradilla} />
        </p>
      </Reveal>

      {/* ─── FILA 1 · LAS DOS HORAS Y EL DÍA ─────────────────────────── */}
      <div class="mt-10 grid items-stretch gap-6 lg:mt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-8">
        <Reveal>
          <div class="relative isolate flex h-full flex-col justify-center overflow-hidden rounded-3xl bg-primary-950 p-8 sm:p-10">
            <MarcaAgua posicion="derecha" class="opacity-[0.06]" />

            {/* Las dos horas, solas y grandes. Es el dato que más cualifica:
                espanta a quien no puede darlas y tranquiliza a quien sí. */}
            <p class="text-xs font-bold tracking-[0.18em] text-secondary-300 uppercase">
              <T v={plan90.compromiso.etiqueta} />
            </p>
            <p class="mt-2 text-5xl font-extrabold leading-none tracking-[-0.03em] text-ink-inverse sm:text-6xl">
              <T v={plan90.compromiso.valor} />
            </p>
            <p class="mt-3 text-base font-medium text-secondary-100 sm:text-lg">
              <T v={plan90.compromiso.nota} />
            </p>

            <p class="mt-8 border-t border-primary-800 pt-6 text-xs font-bold tracking-[0.18em] text-secondary-300 uppercase">
              <T v={recursos.planReglas} />
            </p>
            <ul role="list" class="mt-3 grid gap-2.5">
              <li class="text-lg font-semibold text-ink-inverse sm:text-xl">
                <T v={plan90.regla} />
              </li>
              <li class="text-lg font-semibold text-ink-inverse sm:text-xl">
                <T v={plan90.limite} />
              </li>
              <li class="text-base font-medium text-secondary-100 sm:text-lg">
                <T v={plan90.acompanamiento} />
              </li>
            </ul>
          </div>
        </Reveal>

        {/* El día en tres bloques. Los minutos en su propia columna y
            alineados: tres cifras en columna se leen como un reparto. */}
        <Reveal delay={0.08} class="lg:h-full">
          <div class="flex h-full flex-col justify-center rounded-3xl border border-line bg-surface p-7 shadow-sm sm:p-8">
            <h3 class="text-xl font-extrabold text-balance text-ink sm:text-2xl">
              <T v={plan90.dia.titulo} />
            </h3>

            <ul role="list" class="mt-6 grid gap-4">
              {plan90.dia.bloques.map((b) => (
                <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-t border-line pt-4 first:border-t-0 first:pt-0">
                  <p class="text-lg font-extrabold tabular-nums text-ink-brand sm:text-xl">
                    <T v={b.minutos} />
                  </p>
                  <div class="min-w-0">
                    <p class="text-base font-bold text-ink sm:text-lg">
                      <T v={b.nombre} />
                    </p>
                    <p class="mt-0.5 text-sm font-medium text-pretty text-ink-muted sm:text-base">
                      <T v={b.para} />
                    </p>
                  </div>
                </li>
              ))}
            </ul>

            <p class="mt-6 border-t border-line pt-4 text-sm font-medium text-pretty text-ink-muted sm:text-base">
              <T v={plan90.dia.cambia} />
            </p>
          </div>
        </Reveal>
      </div>

      {/* ─── FILA 2 · LAS CUATRO FASES, A ESCALA ─────────────────────── */}
      <Reveal delay={0.12}>
        <div class="mt-12 lg:mt-14">
          <h3 class="text-sm font-bold tracking-[0.18em] text-ink-muted uppercase">
            <T v={plan90.fasesTitulo} />
          </h3>

          <ol class="mt-5 grid gap-8 sm:grid-cols-2 lg:grid-cols-[20fr_25fr_25fr_20fr] lg:gap-6">
            {plan90.fases.map((fase, i) => (
              <li>
                {/* El tramo de barra. `aria-hidden` porque el rango de días
                    está escrito justo debajo: la barra es la misma información
                    en forma de proporción. */}
                <div aria-hidden="true" class:list={["h-1.5 rounded-full", TRAMOS[i] ?? "bg-secondary-400"]} />
                <p class="mt-4 text-sm font-bold tracking-[0.18em] text-ink-muted uppercase">
                  <T v={fase.rango} />
                </p>
                <p class="mt-1 font-acento text-2xl italic leading-tight text-ink sm:text-3xl">
                  <T v={fase.nombre} />
                </p>
                <p class="mt-2 text-base font-medium text-pretty text-ink-muted sm:text-lg">
                  <T v={fase.objetivo} />
                </p>
              </li>
            ))}
          </ol>
        </div>
      </Reveal>

      {/* ─── FILA 3 · LOS TRES HITOS ─────────────────────────────────────
          Son lo que hace creíble el resto: un plan que admite que a la mitad
          te puede decir "esto no es para ti" no está vendiendo humo. */}
      <Reveal delay={0.16}>
        <div class="mt-12 rounded-3xl bg-surface-muted p-7 ring-1 ring-line ring-inset sm:p-8 lg:mt-14 lg:p-10">
          <h3 class="text-xl font-extrabold text-balance text-ink sm:text-2xl">
            <T v={plan90.hitosTitulo} />
          </h3>
          <ol class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8">
            {plan90.hitos.map((h) => (
              <li class="border-t border-line pt-4">
                <p class="text-sm font-bold tracking-[0.18em] text-ink-brand uppercase">
                  <T v={h.dia} />
                </p>
                <p class="mt-2 text-base font-medium text-pretty text-ink sm:text-lg">
                  <T v={h.texto} />
                </p>
              </li>
            ))}
          </ol>
        </div>
      </Reveal>
    </Section>

    {/* ─── 5 · PREGUNTAS FRECUENTES ──────────────────────────────────────
        Las mismas de la portada, con su filtro de preguntas del curso. */}
    <Faq />

    {/* ─── 6 · EL AVISO DEL SIGUIENTE ────────────────────────────────────
        La misma anatomía que el cierre de la portada (`09-Cierre`, el bloque
        de encima del pie): dos columnas 52 / 48 sobre blanco, a la izquierda
        la columna centrada —ceja, título con el remate en Fraunces, el porqué
        y el formulario compacto— y a la derecha tres fotos montadas, una
        grande y dos acompañantes. El cliente lo pidió así el 15-09-2026, "que
        se parezca más al del índex que está arriba del footer", después de
        una versión en tarjeta navy y otra a dos columnas con caja gris.

        Lo que cambia respecto al cierre es lo que tiene que cambiar: el texto
        (aquí se avisa de un artículo, no se pide entrar), el origen del
        correo ("guías") y las fotos, que son las de banco del hero y no las
        del cierre, para que quien venga de la portada no vea el mismo cuadro
        dos veces. El montaje de las fotos y sus porcentajes son los del
        cierre tal cual; ver allí el porqué de cada número. */}
    <Section id="avisame" tono="surface" ariaLabel={guias.aria}>
      <div class="grid items-center gap-10 md:grid-cols-[52fr_48fr] md:gap-10 lg:gap-16 xl:gap-20">
        <Reveal>
          <div class="text-center">
            <p class="text-sm font-semibold text-ink-brand sm:text-base lg:text-lg">
              <T v={guias.aria} />
            </p>

            {/* El remate va EN MEDIO de la frase y no debajo como en el cierre:
                "Guías cortas para / mover tu red / sin incomodar a nadie" no
                se puede partir en dos renglones sin romper la gramática. */}
            <h2 class="mx-auto mt-4 max-w-2xl text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink sm:text-5xl">
              <T v={guias.titulo[0]} />{" "}
              <Enfasis v={guias.titulo[1]} />{" "}
              <T v={guias.titulo[2]} />
            </h2>

            <p class="mx-auto mt-6 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
              <T v={guias.texto} />
            </p>

            <div class="mx-auto mt-8 max-w-xl">
              <LeadForm
                client:visible
                lang={lang}
                origen="guias"
                variante="lista"
                compacto
                sinEtiquetas
                cta={guias.cta}
                aviso={guias.aviso}
                exitoTitulo={guias.exitoTitulo}
                exitoTexto={guias.exitoTexto}
              />
            </div>
          </div>
        </Reveal>

        <Reveal delay={0.12}>
          <div class="relative h-[320px] sm:h-[400px] md:h-[340px] lg:h-[440px]">
            <img
              src={recursos.fotos.principal.src}
              alt={recursos.fotos.principal.alt[lang]}
              data-alt-es={recursos.fotos.principal.alt.es}
              data-alt-en={recursos.fotos.principal.alt.en}
              width={1400}
              height={1800}
              loading="lazy"
              decoding="async"
              class="absolute left-0 top-0 h-[56%] w-[68%] rounded-lg border border-line object-cover object-[center_30%]"
            />
            <img
              src={recursos.fotos.secundaria.src}
              alt={recursos.fotos.secundaria.alt[lang]}
              data-alt-es={recursos.fotos.secundaria.alt.es}
              data-alt-en={recursos.fotos.secundaria.alt.en}
              width={1400}
              height={1800}
              loading="lazy"
              decoding="async"
              class="absolute right-0 top-[16%] z-10 h-[50%] w-[46%] rounded-lg border-4 border-surface object-cover object-[center_35%]"
            />
            <img
              src={recursos.fotos.terciaria.src}
              alt={recursos.fotos.terciaria.alt[lang]}
              data-alt-es={recursos.fotos.terciaria.alt.es}
              data-alt-en={recursos.fotos.terciaria.alt.en}
              width={1400}
              height={1800}
              loading="lazy"
              decoding="async"
              class="absolute bottom-0 left-[8%] z-20 h-[40%] w-[52%] rounded-lg border-4 border-surface object-cover object-[center_30%]"
            />
          </div>
        </Reveal>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>
