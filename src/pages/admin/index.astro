---
import AlumnoLayout from "@layouts/AlumnoLayout.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import { copy } from "@config/curso.config";
import { repo, normalizarEmail } from "@lib/datos";
import { crearEnlaceAcceso, rolDe } from "@lib/acceso";
import { resolverIdiomaServidor, LOCALES } from "@i18n/idioma";
import { contacto, sitio } from "@config/curso.config";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /admin — dar de alta alumnos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Mientras no haya pasarela, esto ES el alta: se cobra por teléfono y aquí se
 * escribe el correo. El día que el pago dé de alta solo, esta pantalla se queda
 * igual y sirve para las altas manuales que siempre hacen falta (un regalo, una
 * reposición, una prueba).
 *
 * ⚠️ QUIÉN PUEDE ENTRAR. Lo decide el middleware por el rol, y a un alumno le
 * responde 404 en lugar de 403: un 403 confirma que este panel existe.
 *
 * ⚠️ SIN JAVASCRIPT. Formularios normales con POST a esta misma ruta. Un panel
 * de administración que necesita hidratar React para dar de alta a alguien es
 * una isla de 130 KB para tres campos, y encima deja de funcionar si falla la
 * red a mitad. Aquí, si la página carga, el panel funciona.
 *
 * ⚠️ EL POST REDIRIGE (303). Sin eso, recargar después de dar de alta
 * reenviaría el formulario y saldría un error de email duplicado sobre un alta
 * que sí funcionó.
 */
export const prerender = false;

const admin = Astro.locals.alumno!;
const r = repo();

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

let aviso: { tipo: "ok" | "error"; texto: string } | null = null;

if (Astro.request.method === "POST") {
  const datos = await Astro.request.formData();
  const accion = String(datos.get("accion") ?? "");

  if (accion === "alta") {
    const email = normalizarEmail(String(datos.get("email") ?? ""));
    const nombre = String(datos.get("nombre") ?? "").trim() || null;
    const enviar = datos.get("enviar") === "1";

    if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)) {
      aviso = { tipo: "error", texto: "Ese correo no es válido." };
    } else if (await r.alumnoPorEmail(email)) {
      aviso = { tipo: "error", texto: `${email} ya estaba dado de alta.` };
    } else {
      const nuevo = await r.crearAlumno({
        email,
        nombre,
        rol: rolDe(email),
        idioma: lang,
      });

      let extra = "";
      if (enviar) {
        /* El enlace se manda por el mismo camino que el de la pantalla de
           acceso. Si no hay Resend configurado, sale por consola: en desarrollo
           es la única forma de probar el circuito completo. */
        const enlace = await crearEnlaceAcceso(nuevo, Astro.url);
        const apiKey = import.meta.env.RESEND_API_KEY;
        const from = import.meta.env.NOTIFY_EMAIL_FROM;

        if (!apiKey || !from) {
          console.warn(`[admin] MODO DEMO — enlace para ${email}:\n  ${enlace}`);
          extra = " El enlace está en la consola del servidor (falta Resend).";
        } else {
          try {
            const resp = await fetch("https://api.resend.com/emails", {
              method: "POST",
              headers: {
                Authorization: `Bearer ${apiKey}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                from,
                to: [email],
                reply_to: contacto.email,
                subject: `Ya tienes acceso a ${sitio.nombre}`,
                text: [
                  `Ya estás dentro. Entra desde aquí:`,
                  ``,
                  enlace,
                  ``,
                  `El enlace caduca en 20 minutos. Si se te pasa, pide otro en`,
                  `${new URL("/acceso", Astro.url).href}`,
                  ``,
                  `— ${sitio.nombre}`,
                ].join("\n"),
              }),
            });
            extra = resp.ok
              ? " Le hemos mandado el enlace."
              : " Pero el correo NO salió: revisa Resend.";
            if (!resp.ok) console.error("[admin] Resend:", await resp.text());
          } catch (e) {
            extra = " Pero el correo NO salió: revisa Resend.";
            console.error("[admin] Resend:", e);
          }
        }
      }
      aviso = { tipo: "ok", texto: `${email} dado de alta.${extra}` };
    }
  }

  if (accion === "activo") {
    const id = String(datos.get("id") ?? "");
    const activo = datos.get("activo") === "1";

    /* Un admin no puede darse de baja a sí mismo. No es una regla de negocio:
       es evitar que el último administrador se cierre la puerta desde dentro y
       ya no haya nadie que pueda reactivar a nadie. */
    if (id === admin.id) {
      aviso = { tipo: "error", texto: "No puedes darte de baja a ti mismo." };
    } else {
      await r.cambiarActivo(id, activo);
      /* Dar de baja cierra sus sesiones abiertas. Si no, seguiría dentro hasta
         que caducara la cookie: la baja tiene que ser inmediata. */
      if (!activo) await r.borrarSesionesDe(id);
      aviso = { tipo: "ok", texto: activo ? "Reactivado." : "Dado de baja." };
    }
  }

  /* Se redirige con el aviso en la URL para que recargar no reenvíe nada. */
  const destino = new URL("/admin", Astro.url);
  if (aviso) {
    destino.searchParams.set("t", aviso.tipo);
    destino.searchParams.set("m", aviso.texto);
  }
  return Astro.redirect(destino.pathname + destino.search, 303);
}

const tipoUrl = Astro.url.searchParams.get("t");
const mensajeUrl = Astro.url.searchParams.get("m");
if (mensajeUrl && (tipoUrl === "ok" || tipoUrl === "error")) {
  aviso = { tipo: tipoUrl, texto: mensajeUrl };
}

const alumnos = await r.listarAlumnos();

const fecha = (d: Date | null) =>
  d
    ? new Intl.DateTimeFormat(LOCALES[lang], {
        day: "numeric",
        month: "short",
        year: "numeric",
      }).format(d)
    : null;

const celda = "px-4 py-3 text-sm";
---

<AlumnoLayout titulo={copy.acceso.panel.titulo} alumno={admin}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-3xl font-extrabold text-ink sm:text-4xl">
      <T v={copy.acceso.panel.titulo} />
    </h1>
    <p class="mt-3 max-w-xl text-base text-pretty text-ink-muted">
      <T v={copy.acceso.panel.entradilla} />
    </p>

    {/* El aviso de "esto no persiste" solo aparece cuando de verdad no
        persiste. Sin él, alguien daría de alta a diez alumnos en desarrollo y
        no entendería por qué desaparecen. */}
    {
      !r.persistente && (
        <p class="mt-6 rounded-xl border border-warning-500/50 bg-warning-500/10 px-4 py-3 text-sm text-pretty text-warning-50">
          ⚠ <T v={copy.acceso.panel.sinBase} />
        </p>
      )
    }

    {
      aviso && (
        <p
          role="status"
          class:list={[
            "mt-6 rounded-xl border px-4 py-3 text-sm text-pretty",
            aviso.tipo === "ok"
              ? "border-secondary-300 bg-secondary-50 text-ink"
              : "border-error-500 bg-error-50 text-error-700",
          ]}
        >
          {aviso.texto}
        </p>
      )
    }

    {/* ─── Alta ─────────────────────────────────────────────────────────── */}
    <form
      id="form-alta"
      method="POST"
      class="mt-8 rounded-2xl border border-line bg-surface p-6"
    >
      <input type="hidden" name="accion" value="alta" />

      <h2 class="text-lg font-bold text-ink">
        <T v={copy.acceso.panel.nuevoTitulo} />
      </h2>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label
            for="admin-email"
            class="block text-sm font-semibold text-ink-muted"
          >
            <T v={copy.acceso.panel.campoEmail} />
          </label>
          <input
            id="admin-email"
            name="email"
            type="email"
            required
            autocomplete="off"
            placeholder="maria@email.com"
            class="mt-2 min-h-12 w-full rounded-xl border border-line-strong bg-surface px-4 py-3 text-base text-ink placeholder:text-ink-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          />
        </div>

        <div>
          <label
            for="admin-nombre"
            class="block text-sm font-semibold text-ink-muted"
          >
            <T v={copy.acceso.panel.campoNombre} />
          </label>
          <input
            id="admin-nombre"
            name="nombre"
            type="text"
            autocomplete="off"
            placeholder="María"
            class="mt-2 min-h-12 w-full rounded-xl border border-line-strong bg-surface px-4 py-3 text-base text-ink placeholder:text-ink-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          />
        </div>
      </div>

      {/* Dos botones y un `value` distinto para el mismo campo: dar de alta a
          secas (para preparar altas antes de cobrar) o dar de alta y mandarle
          ya el enlace, que es el caso normal. */}
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button
          type="submit"
          name="enviar"
          value="1"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-secondary-500 px-6 text-sm font-bold text-primary-950 transition-colors hover:bg-secondary-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <Icono nombre="conversacion" class="size-4 shrink-0" grosor={2} />
          <T v={copy.acceso.panel.altaYEnviar} />
        </button>

        <button
          type="submit"
          name="enviar"
          value="0"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-line-strong px-6 text-sm font-bold text-ink-muted transition-colors hover:border-secondary-400 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <T v={copy.acceso.panel.alta} />
        </button>
      </div>
    </form>

    {/* ─── La lista ─────────────────────────────────────────────────────── */}
    <div class="mt-10">
      {
        alumnos.length === 0 ? (
          <p class="text-base text-ink-muted">
            <T v={copy.acceso.panel.vacio} />
          </p>
        ) : (
          /* `overflow-x-auto` en el envoltorio y no en la tabla: una tabla con
             cuatro columnas no cabe en 320 px y lo correcto es que se deslice
             ella sola, no que la página entera tenga scroll horizontal. */
          <div class="overflow-x-auto rounded-2xl border border-line">
            <table class="w-full min-w-[38rem] border-collapse text-left">
              <thead class="bg-primary-900/60">
                <tr class="text-xs font-bold tracking-wide text-ink-subtle uppercase">
                  <th scope="col" class={celda}>
                    <T v={copy.acceso.panel.columnaAlumno} />
                  </th>
                  <th scope="col" class={celda}>
                    <T v={copy.acceso.panel.columnaEstado} />
                  </th>
                  <th scope="col" class={celda}>
                    <T v={copy.acceso.panel.columnaAcceso} />
                  </th>
                  <th scope="col" class={celda}>
                    <span class="sr-only">Acciones</span>
                  </th>
                </tr>
              </thead>

              <tbody>
                {alumnos.map((a) => (
                  <tr class="border-t border-line">
                    <td class={celda}>
                      <span class="block font-semibold text-ink">
                        {a.nombre ?? "—"}
                      </span>
                      <span class="block text-ink-subtle">{a.email}</span>
                      {a.rol === "admin" && (
                        <span class="mt-1 inline-flex rounded-full bg-secondary-100 px-2 py-0.5 text-xs font-bold text-ink-muted">
                          admin
                        </span>
                      )}
                    </td>

                    <td class={celda}>
                      <span
                        class:list={[
                          "inline-flex rounded-full px-2.5 py-1 text-xs font-bold",
                          a.activo
                            ? "bg-secondary-100 text-secondary-800"
                            : "bg-surface-muted text-ink-muted",
                        ]}
                      >
                        <T
                          v={
                            a.activo
                              ? copy.acceso.panel.activo
                              : copy.acceso.panel.inactivo
                          }
                        />
                      </span>
                    </td>

                    <td class={`${celda} text-ink-subtle`}>
                      {fecha(a.ultimoAcceso) ?? (
                        <T v={copy.acceso.panel.nunca} />
                      )}
                    </td>

                    <td class={`${celda} text-right`}>
                      {a.id !== admin.id && (
                        <form method="POST">
                          <input type="hidden" name="accion" value="activo" />
                          <input type="hidden" name="id" value={a.id} />
                          <input
                            type="hidden"
                            name="activo"
                            value={a.activo ? "0" : "1"}
                          />
                          <button
                            type="submit"
                            class="inline-flex min-h-11 items-center rounded-full border border-line-strong px-3.5 text-xs font-bold text-ink-muted transition-colors hover:border-secondary-400 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                          >
                            <T
                              v={
                                a.activo
                                  ? copy.acceso.panel.darBaja
                                  : copy.acceso.panel.reactivar
                              }
                            />
                          </button>
                        </form>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</AlumnoLayout>
