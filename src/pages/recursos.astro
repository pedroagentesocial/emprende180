---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import LeadForm from "@components/ui/LeadForm";
import { copy, sitio } from "@config/curso.config";
import { articulosPublicados, formatearFecha } from "@lib/blog";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /recursos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Existe porque ya la enlazaban dos sitios: "Recursos" en el menú y la franja
 * oscura de la portada. Un enlace del menú a un 404 es de las pocas cosas que
 * hacen dudar de todo lo demás que hay en la página.
 *
 * ─── QUÉ HAY AQUÍ DE VERDAD ────────────────────────────────────────────────
 *
 * Los artículos publicados y el formulario para que avisen del siguiente. Ni
 * plantillas, ni PDF, ni "contenido exclusivo": no existen. El día que haya
 * algo más, se añade y el texto cambia con él.
 *
 * ⚠️ Y NO SE MUERE SI NO HAY ARTÍCULOS. A diferencia de `/blog`, que devuelve
 * 404 vacío, esta página tiene sentido con la lista vacía: el formulario sigue
 * siendo un motivo para estar aquí, y el menú tiene que llevar a algún sitio.
 */
export const prerender = false;

const { recursos, guias } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const articulos = await articulosPublicados(getCollection);

const tituloPagina = construirTxt(
  (l) => `${recursos.paginaTitulo[l]} · ${sitio.nombre}`,
);
---

<BaseLayout titulo={tituloPagina} descripcion={recursos.paginaDescripcion}>
  <Header />

  <main id="contenido" class="section-y">
    <div class="container-page">
      <div class="mx-auto max-w-read">
        <h1 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
          <T v={recursos.paginaTitulo} />
        </h1>
        <p class="mt-4 text-lg text-pretty text-ink-muted">
          <T v={recursos.paginaEntradilla} />
        </p>
      </div>

      {/* ─── Los artículos ───────────────────────────────────────────────
          El mismo listado de `/blog`, en una columna: un titular largo se lee
          entero y no hay que cortarlo para que quepa en una tarjeta. */}
      <section class="mx-auto mt-14 max-w-read" aria-labelledby="recursos-articulos">
        <h2
          id="recursos-articulos"
          class="text-xs font-bold tracking-[0.18em] text-ink-subtle uppercase"
        >
          <T v={recursos.paginaArticulos} />
        </h2>

        {
          articulos.length === 0 ? (
            <p class="mt-6 text-base text-pretty text-ink-muted">
              <T v={recursos.paginaVacio} />
            </p>
          ) : (
            <ul class="mt-6 divide-y divide-line border-t border-line">
              {articulos.map((a) => (
                <li>
                  <a
                    href={`/blog/${a.id}`}
                    class="group flex items-start gap-4 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                  >
                    <span class="min-w-0 flex-1">
                      <time
                        datetime={a.data.fecha.toISOString().slice(0, 10)}
                        class="block text-sm text-ink-subtle"
                      >
                        {formatearFecha(a.data.fecha, a.data.idioma)}
                      </time>
                      <span class="mt-1 block text-lg font-bold text-pretty text-ink group-hover:text-ink-brand">
                        {a.data.titulo}
                      </span>
                      <span class="mt-2 block text-base text-pretty text-ink-muted">
                        {a.data.resumen}
                      </span>
                    </span>
                    <Icono
                      nombre="flecha"
                      class="mt-6 size-5 shrink-0 text-ink-subtle group-hover:text-ink-brand"
                    />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      {/* ─── El aviso del siguiente ──────────────────────────────────────
          El mismo formulario de la portada, con el mismo origen: lo que se
          mide es de dónde salió el correo, y desde aquí sigue siendo "guías". */}
      <section
        class="mx-auto mt-16 max-w-read rounded-3xl bg-surface-muted p-8 sm:p-10"
        aria-labelledby="recursos-avisame"
      >
        <h2
          id="recursos-avisame"
          class="text-2xl font-extrabold text-balance text-ink sm:text-3xl"
        >
          <T v={guias.titulo[0]} /> <T v={guias.titulo[1]} /> <T v={guias.titulo[2]} />
        </h2>

        <div class="mt-6 max-w-md">
          <LeadForm
            client:visible
            lang={lang}
            origen="guias"
            variante="lista"
            cta={guias.cta}
            aviso={guias.aviso}
            exitoTitulo={guias.exitoTitulo}
            exitoTexto={guias.exitoTexto}
          />
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
