---
import AmbassadorLayout from "@layouts/AmbassadorLayout.astro";
import T from "@components/i18n/T.astro";
import { ambassadorCopy } from "@config/ambassadorArea";
import { loadBook } from "@lib/ambassadorBook";
import { money, shortDate } from "@lib/ambassadorFormat";
import { isAmbassador } from "@lib/permissions";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /student/ambassador/payouts: lo que te pagamos y lo que te descontamos
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Los pagos los anota el admin (en dinero o en crédito de Revivi). Los
 * descuentos son reembolsos que llegaron después de pagarte la comisión: se
 * enseñan aquí, en la misma lista, porque es aquí donde alguien busca por qué
 * su saldo es menor de lo que esperaba.
 */
export const prerender = false;

const me = Astro.locals.student!;
if (!isAmbassador(me)) return new Response(null, { status: 404 });

const c = ambassadorCopy;
const book = await loadBook(me, { viewer: me, withNames: false });
const { summary } = book;

type Row =
  | { kind: "payout"; at: Date; cents: number; method: "cash" | "revivi_credit"; pendingCredit: boolean; note: string | null }
  | { kind: "deduction"; at: Date; cents: number; business: string };

const businessName = new Map(book.businesses.map((b) => [b.id, b.name]));
const rows: Row[] = [
  ...book.payouts.map((p) => ({
    kind: "payout" as const,
    at: p.paidAt,
    cents: p.amountCents,
    method: p.method,
    pendingCredit: p.method === "revivi_credit" && !p.clinicsRef,
    note: p.note,
  })),
  ...book.lines
    .filter((l) => l.status === "deduction")
    .map((l) => ({ kind: "deduction" as const, at: l.occurredAt, cents: l.amountCents, business: businessName.get(l.businessId) ?? "" })),
].sort((a, b) => b.at.getTime() - a.at.getTime());
---

<AmbassadorLayout title={c.payouts.title} student={me} tab="payouts">
  <h1 class="text-2xl font-extrabold text-ink"><T v={c.payouts.title} /></h1>
  <p class="mt-2 text-sm text-pretty text-ink-muted"><T v={c.payouts.intro} /></p>

  <section class="mt-5 grid grid-cols-3 gap-2">
    <div class="rounded-2xl border border-line bg-surface px-3 py-3">
      <p class="text-xs font-semibold text-ink-muted"><T v={summary.availableCents < 0 ? c.home.owed : c.home.available} /></p>
      <p class="mt-0.5 font-bold tabular-nums text-ink"><T v={money(Math.abs(summary.availableCents))} /></p>
    </div>
    <div class="rounded-2xl border border-line bg-surface px-3 py-3">
      <p class="text-xs font-semibold text-ink-muted"><T v={c.home.waiting} /></p>
      <p class="mt-0.5 font-bold tabular-nums text-ink"><T v={money(summary.waitingCents)} /></p>
    </div>
    <div class="rounded-2xl border border-line bg-surface px-3 py-3">
      <p class="text-xs font-semibold text-ink-muted"><T v={c.home.paid} /></p>
      <p class="mt-0.5 font-bold tabular-nums text-ink"><T v={money(summary.paidCents)} /></p>
    </div>
  </section>

  <h2 class="mt-6 px-1 text-base font-bold text-ink"><T v={c.payouts.movements} /></h2>
  {
    rows.length === 0 ? (
      <p class="mt-3 rounded-3xl border border-line bg-surface p-6 text-center text-sm text-ink-muted">
        <T v={c.payouts.empty} />
      </p>
    ) : (
      <ul class="mt-3 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface">
        {rows.map((r) => (
          <li class="flex items-center justify-between gap-3 px-5 py-3.5">
            <span class="min-w-0">
              <span class="block font-semibold text-ink">
                {r.kind === "payout" ? <T v={c.method[r.method]} /> : <T v={c.status.deduction} />}
              </span>
              <span class="block truncate text-xs text-ink-muted">
                <T v={shortDate(r.at)} />
                {r.kind === "deduction" && r.business && <> · {r.business}</>}
                {r.kind === "payout" && r.pendingCredit && <> · <T v={c.payouts.pendingCredit} /></>}
              </span>
            </span>
            <span class:list={["shrink-0 font-bold tabular-nums", r.kind === "deduction" ? "text-error-700" : "text-ink"]}>
              <T v={money(r.cents)} />
            </span>
          </li>
        ))}
      </ul>
    )
  }
</AmbassadorLayout>
