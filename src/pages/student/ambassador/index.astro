---
import { isAmbassador } from "@lib/permissions";

/**
 * /student/ambassador: el viejo inicio del portal del Embajador.
 *
 * Desde el 12-11-2026 la plataforma tiene UN inicio (`/student`), que para un
 * Embajador es este mismo contenido (`AmbassadorHome`). La dirección se
 * conserva y lleva allí, para que un acceso guardado en la pantalla de inicio
 * del teléfono o un enlace viejo sigan funcionando.
 *
 * ⚠️ QUIEN NO ES EMBAJADOR SIGUE RECIBIENDO UN 404, como el resto del portal:
 * una redirección le confirmaría que la sección existe.
 */
export const prerender = false;

const me = Astro.locals.student!;
if (!isAmbassador(me)) return new Response(null, { status: 404 });
return Astro.redirect("/student", 302);
---
