---
import StudentLayout from "@layouts/StudentLayout.astro";
import T from "@components/i18n/T.astro";
import Icono, { type NombreIcono } from "@components/ui/Icono.astro";
import { studentCopy } from "@config/studentArea";
import { plataformas } from "@config/curso.config";
import { repo } from "@lib/data";
import { canAdminister } from "@lib/permissions";
import { ghlConectado } from "@lib/ghl";
import { captchaEnabled } from "@lib/captcha";
import type { Txt } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /student/settings — qué está conectado y qué no
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * ⚠️ ESTA PANTALLA NO CONFIGURA NADA, MIRA. No hay ni un campo donde escribir:
 * las claves viven en las variables de entorno del proyecto, que es donde tienen
 * que vivir. Un panel que deja pegar una clave de API es un panel que tiene que
 * guardarla, y eso es un sitio más del que se puede escapar.
 *
 * Lo que hace es contestar la pregunta que se hace todos los días quien está
 * montando esto: "¿qué me falta?". Hoy esa respuesta está repartida entre un
 * `.env.example`, cuatro comentarios y la memoria de quien lo escribió.
 *
 * ⚠️ NO SE ENSEÑA NI UN VALOR, SOLO SI ESTÁ O NO ESTÁ. Ni siquiera los cuatro
 * últimos caracteres de una clave: eso ya es información sobre un secreto, y
 * esta pantalla la ve cualquiera que sea admin desde cualquier ordenador.
 *
 * ⚠️ SOLO EL ADMIN. Un agente no necesita saber qué integraciones existen, y
 * recibe el mismo 404 que quien no puede entrar aquí.
 */
export const prerender = false;

const me = Astro.locals.student!;
if (!canAdminister(me)) return new Response(null, { status: 404 });

const s = studentCopy.settings;

interface Conexion {
  icon: NombreIcono;
  title: Txt;
  text: Txt;
  ok: boolean;
  /** Las variables que hay que poner. Solo el nombre, nunca el valor. */
  vars: string[];
}

/* `repo().persistent` es la respuesta honesta a "¿hay base de datos?": lo dice
   la propia tienda, no una comprobación aparte que podría desincronizarse. */
const conexiones: Conexion[] = [
  {
    icon: "lista",
    title: s.dbTitle,
    text: s.dbText,
    ok: repo().persistent,
    vars: ["DATABASE_URL"],
  },
  {
    icon: "sobre",
    title: s.mailTitle,
    text: s.mailText,
    ok: !!import.meta.env.RESEND_API_KEY && !!import.meta.env.NOTIFY_EMAIL_FROM,
    vars: ["RESEND_API_KEY", "NOTIFY_EMAIL_FROM"],
  },
  {
    icon: "red",
    title: s.ghlTitle,
    text: s.ghlText,
    ok: ghlConectado(),
    vars: ["GHL_ALUMNOS_WEBHOOK_URL"],
  },
  {
    icon: "escudo",
    title: s.captchaTitle,
    text: s.captchaText,
    ok: captchaEnabled(),
    vars: ["TURNSTILE_SITE_KEY", "TURNSTILE_SECRET_KEY"],
  },
  {
    icon: "play",
    title: s.crmTitle,
    text: s.crmText,
    ok: !!plataformas.crm.url && !!plataformas.academia.url,
    vars: ["plataformas.crm.url", "plataformas.academia.url"],
  },
];

const pendientes = conexiones.filter((c) => !c.ok).length;
---

<StudentLayout title={s.title} student={me} heading={s.title}>
  <div class="max-w-3xl">
    <p class="text-base text-pretty text-ink-muted">
      <T v={s.intro} />
    </p>

    <ul class="mt-8 grid gap-4">
      {
        conexiones.map((c) => (
          <li
            class:list={[
              "rounded-2xl border p-5",
              c.ok ? "border-line bg-surface" : "border-warning-500/60 bg-warning-50",
            ]}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="flex min-w-0 gap-3">
                <span
                  aria-hidden="true"
                  class:list={[
                    "grid size-10 shrink-0 place-items-center rounded-xl",
                    c.ok
                      ? "bg-secondary-100 text-secondary-700"
                      : "bg-warning-500/20 text-warning-700",
                  ]}
                >
                  <Icono nombre={c.icon} class="size-5" grosor={1.9} />
                </span>

                <div class="min-w-0">
                  <h2 class="text-base font-bold text-ink">
                    <T v={c.title} />
                  </h2>
                  <p class="mt-1 max-w-xl text-sm text-pretty text-ink-muted">
                    <T v={c.text} />
                  </p>
                </div>
              </div>

              {/* El estado, con punto de color: se lee sin leer. */}
              <span
                class:list={[
                  "inline-flex shrink-0 items-center gap-2 rounded-full px-3 py-1 text-xs font-bold",
                  c.ok
                    ? "bg-secondary-100 text-secondary-800"
                    : "bg-warning-500/20 text-warning-700",
                ]}
              >
                <span
                  aria-hidden="true"
                  class:list={[
                    "size-1.5 rounded-full",
                    c.ok ? "bg-secondary-600" : "bg-warning-500",
                  ]}
                />
                <T v={c.ok ? s.on : s.off} />
              </span>
            </div>

            {/* Los NOMBRES de las variables, nunca los valores. Es lo que hay que
                copiar en Vercel, y basta con eso para saber dónde tocar. */}
            {!c.ok && (
              <p class="mt-3 flex flex-wrap items-center gap-2 pl-13 text-xs text-ink-muted">
                <span class="font-bold uppercase tracking-wide text-ink-subtle">
                  <T v={s.varLabel} />
                </span>
                {c.vars.map((v) => (
                  <code class="rounded-md bg-surface px-2 py-1 font-mono text-[0.6875rem] text-ink">
                    {v}
                  </code>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    {/* El recuento, abajo y sin dramatismo: cinco de cinco es lo normal cuando
        esto esté montado, y entonces esta línea desaparece sola. */}
    {
      pendientes > 0 && (
        <p class="mt-6 text-sm text-ink-subtle">
          {pendientes} / {conexiones.length}
        </p>
      )
    }
  </div>
</StudentLayout>
