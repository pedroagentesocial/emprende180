---
import StudentLayout from "@layouts/StudentLayout.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import StaffSummary from "@components/student/StaffSummary.astro";
import CourseDoors from "@components/student/CourseDoors.astro";
import { studentCopy } from "@config/studentArea";
import { construirTxt, resolverIdiomaServidor, LOCALES } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";
import { repo } from "@lib/data";
import {
  canAdminister,
  canOpenStaffPanel,
  seesCourseDoors,
  visibleStudentsFilter,
} from "@lib/permissions";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /student — the portal's home
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * The first screen after signing in, and it is the SAME screen for everybody:
 * the sidebar, the greeting, and then whatever that person's role puts under
 * it. There is no `/admin`, and administering is not somewhere else you go.
 *
 * What lands here:
 *
 *   · STUDENT — the two doors, the CRM and the Academy, and nothing else.
 *   · AGENT   — no doors: their summary, and their people one click away.
 *   · ADMIN   — no doors either, and the summary of everybody.
 *
 * ⚠️ WHOEVER OPENS THIS TO WORK DOESN'T GET THE DOORS. Neither the agent nor
 * Pedro comes here to watch video 7, and two big cards about the course sitting
 * above their tools is two thirds of the screen spent on somebody else's
 * homework. See `seesCourseDoors` in `@lib/permissions`.
 *
 * ⚠️ NOTHING IS QUERIED FOR A PLAIN STUDENT. The whole staff half is skipped, so
 * their home doesn't run a single query about anybody else.
 *
 * The roster, the add form and the four actions live in `/student/people`.
 */
export const prerender = false;

const me = Astro.locals.student!;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const isStaff = canOpenStaffPanel(me);
const isAdmin = canAdminister(me);
const showDoors = seesCourseDoors(me);

/* Los números del resumen, solo para quien tiene a quién contar. */
const everyone = isStaff
  ? await repo().listStudents(visibleStudentsFilter(me) ?? {})
  : [];

/* Los alumnos, sin contarse a uno mismo ni a los agentes: las métricas de "cómo
   va" son sobre la gente que compró, no sobre la plantilla. */
const suyos = everyone.filter((s) => s.role === "student");
const haceUnMes = Date.now() - 30 * 86_400_000;

const counts = {
  all: everyone.length,
  signedIn: everyone.filter((s) => s.lastSignIn && s.active).length,
  neverIn: everyone.filter((s) => !s.lastSignIn && s.active).length,
  agents: everyone.filter((s) => s.role === "agent").length,
  inactive: everyone.filter((s) => !s.active).length,
  lastMonth: suyos.filter((s) => +s.createdAt >= haceUnMes).length,
};

/* El alta más reciente. `listStudents` ya devuelve por fecha descendente, así
   que es la primera; se busca igualmente por si algún día cambia el orden. */
const latest = suyos.reduce<Date | null>(
  (masReciente, s) =>
    !masReciente || s.createdAt > masReciente ? s.createdAt : masReciente,
  null,
);

const t = studentCopy.dashboard;

/**
 * "Tu última visita fue el…", con la fecha de la conexión ANTERIOR a esta.
 *
 * ⚠️ NO SE USA `lastSignIn`: esa se sella al entrar, así que a quien acaba de
 * llegar le diría "tu última visita: hace un segundo". Ver `previousSignIn` en
 * `@lib/data`. Quien entra por primera vez lee otra frase, no una fecha vacía.
 */
const visita = me.previousSignIn
  ? construirTxt((l) =>
      interpolar(t.lastVisit[l], {
        fecha: new Intl.DateTimeFormat(LOCALES[l], {
          day: "numeric",
          month: "long",
          hour: "2-digit",
          minute: "2-digit",
        }).format(me.previousSignIn!),
      }),
    )
  : t.firstVisit;

/* El saludo con el nombre si lo hay. Un "Hola, null" es peor que no saludar. */
const greeting = me.name
  ? construirTxt((l) => interpolar(t.greeting[l], { name: me.name! }))
  : t.greetingNoName;

---

<StudentLayout title={t.aria} student={me}>
  {/* ─── SIN CONTRASEÑA TODAVÍA ────────────────────────────────────────────
      Solo lo ve quien entró por el enlace del correo y se saltó la pantalla de
      ponerse contraseña. No se le fuerza —ya demostró que el buzón es suyo—,
      pero sí se le dice lo que le pasará si no lo hace: pedir un enlace cada vez
      que quiera entrar. */}
  {
    !me.hasPassword && (
      <div class="mb-8 flex flex-col gap-4 rounded-2xl border border-warning-500 bg-warning-50 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex gap-3">
          <span
            aria-hidden="true"
            class="mt-0.5 hidden size-9 shrink-0 place-items-center rounded-xl bg-warning-500/20 text-warning-700 sm:grid"
          >
            <Icono nombre="candado" class="size-5" grosor={1.9} />
          </span>
          <div>
            <p class="text-base font-bold text-balance text-ink">
              <T v={studentCopy.password.pendingTitle} />
            </p>
            <p class="mt-1 text-sm text-pretty text-ink-muted">
              <T v={studentCopy.password.pendingText} />
            </p>
          </div>
        </div>

        <a
          href="/login/password"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full bg-cta px-5 text-sm font-bold text-ink-inverse shadow-cta transition-colors hover:bg-cta-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          <T v={studentCopy.password.pendingCta} />
        </a>
      </div>
    )
  }

  {/* ─── La bienvenida ───────────────────────────────────────────────────────
      Sin titular: "Ya estás dentro" le contaba a alguien algo que acababa de
      hacer. El saludo lleva su nombre, y debajo va lo único que aquí es
      información de verdad: cuándo estuvo la última vez.

      El del alumno va centrado porque su pantalla es simétrica —dos puertas y
      tres tarjetas de ayuda—; el de quien trabaja va a la izquierda, alineado
      con la lista que viene debajo. */}
  <div class:list={["max-w-2xl", showDoors && "mx-auto text-center"]}>
    <h1 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
      <T v={greeting} />
    </h1>

    <p class="mt-3 text-base text-pretty text-ink-muted sm:text-lg">
      <T v={showDoors ? t.welcomeText : t.welcomeTextAgent} />
    </p>

    <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm text-ink-muted">
      <span aria-hidden="true" class="marca-linea text-secondary-600">
        <Icono nombre="reloj" class="size-4" grosor={2} />
      </span>
      <T v={visita} />
    </p>
  </div>

  {/* ─── Las dos puertas, y debajo dónde pedir ayuda ──────────────────────── */}
  {
    showDoors && (
      <>
        <CourseDoors />
      </>
    )
  }

  {/* ─── Y, para quien vende, sus números ─────────────────────────────────── */}
  {isStaff && <StaffSummary counts={counts} latest={latest} isAdmin={isAdmin} lang={lang} />}
</StudentLayout>
