---
import StudentLayout from "@layouts/StudentLayout.astro";
import T from "@components/i18n/T.astro";
import Icono from "@components/ui/Icono.astro";
import Avatar from "@components/ambassador/Avatar.astro";
import ProfileGuide from "@components/student/ProfileGuide.astro";
import { repo, normaliseEmail, type Student } from "@lib/data";
import { displayName, photoUrl } from "@lib/profile";
import { isAmbassador } from "@lib/permissions";
import { linkInClinics } from "@lib/makeAmbassador";
import { enviarCorreoCodigo, sha256 } from "@lib/auth";
import { EMAIL_CHANGE_EMAIL } from "@lib/loginEmail";
import { seal, unseal } from "@lib/sealed";
import { consume } from "@lib/rateLimit";
import { DEMO_CODE, FIXED_CODE } from "@lib/previewDemo";
import { shortDate } from "@lib/ambassadorFormat";
import { studentCopy } from "@config/studentArea";
import type { Txt } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /student/profile: Mi perfil (12-11-2026)
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Lo que cada alumno puede cambiar de sí mismo: foto, nombre y apellido,
 * teléfono, si usa WhatsApp, el idioma de sus correos y su correo de acceso.
 * Al lado, la guía de "ten tu información al día" (`ProfileGuide`).
 *
 * ─── LA FOTO ───────────────────────────────────────────────────────────────
 * El navegador la recorta al cuadrado y la reduce a 320 px en JPEG antes de
 * mandarla (unos 30 KB). Sin JavaScript se manda el archivo tal cual y aquí se
 * acepta solo si ya es pequeño. Nunca se guarda más de 200 KB.
 *
 * ─── EL CORREO ─────────────────────────────────────────────────────────────
 * Es con el que se entra, así que cambiarlo exige demostrar que el buzón
 * nuevo es suyo: se manda un código de seis dígitos a la dirección NUEVA y el
 * cambio solo ocurre al escribirlo. Lo pendiente (a qué correo, el hash del
 * código y cuándo caduca) viaja en una cookie CIFRADA y solo de servidor, así
 * que no hace falta otra tabla. Intentos y envíos van limitados.
 *
 * ⚠️ UN EMBAJADOR CON CORREO NUEVO SE ACTUALIZA EN CLINICS, porque allí el
 * correo es la llave de su crédito de Revivi. Igual con el nombre.
 */
export const prerender = false;

const me = Astro.locals.student!;
const r = repo();
const t = (es: string, en: string): Txt => ({ es, en });

const copy = {
  title: t("Mi perfil", "My profile"),
  intro: t("Tu foto, tus datos y tu correo. Tenerlos al día es lo que nos deja avisarte y pagarte sin tropiezos.", "Your photo, your details and your email. Keeping them current is what lets us reach you and pay you smoothly."),
  photoTitle: t("Foto de perfil", "Profile photo"),
  photoHint: t("Cuadrada y de frente queda mejor. JPG o PNG.", "Square and facing forward looks best. JPG or PNG."),
  upload: t("Subir foto", "Upload photo"),
  change: t("Cambiar foto", "Change photo"),
  remove: t("Quitar", "Remove"),
  dataTitle: t("Datos personales", "Personal details"),
  name: t("Nombre", "First name"),
  lastName: t("Apellido", "Last name"),
  phone: t("Teléfono", "Phone"),
  phoneHint: t("Con lada, por ejemplo +1 801 555 0142.", "With country code, for example +1 801 555 0142."),
  whatsapp: t("¿Usas WhatsApp en ese número?", "Do you use WhatsApp on that number?"),
  yes: t("Sí", "Yes"),
  no: t("No", "No"),
  language: t("Idioma de tus correos y avisos", "Language of your emails and notices"),
  save: t("Guardar cambios", "Save changes"),
  emailTitle: t("Correo de acceso", "Sign-in email"),
  emailHint: t("Es con el que entras y donde te llegan los códigos. Para cambiarlo te mandamos un código al correo nuevo.", "It is how you sign in and where codes arrive. To change it we send a code to the new address."),
  current: t("Correo actual:", "Current email:"),
  newEmail: t("Correo nuevo", "New email"),
  sendCode: t("Enviar código", "Send code"),
  sentTo: t("Te mandamos un código a {correo}. Escríbelo aquí para terminar.", "We sent a code to {correo}. Type it here to finish."),
  code: t("Código de 6 dígitos", "6-digit code"),
  verify: t("Confirmar", "Confirm"),
  cancel: t("Cancelar", "Cancel"),
  accountTitle: t("Tu cuenta", "Your account"),
  role: t("Tipo de cuenta", "Account type"),
  since: t("Alumno desde", "Student since"),
  ambCode: t("Código de Embajador", "Ambassador code"),
  signOut: studentCopy.dashboard.signOut,
  ok: {
    profile: t("Listo, guardamos tus datos.", "Done, your details are saved."),
    photo: t("Tu foto ya está puesta.", "Your photo is up."),
    photoRemoved: t("Quitamos tu foto.", "Your photo was removed."),
    sent: t("Código enviado. Revisa el correo nuevo (y la carpeta de spam).", "Code sent. Check the new inbox (and the spam folder)."),
    email: t("Listo: desde ahora entras con tu correo nuevo.", "Done: from now on you sign in with your new email."),
  },
  err: {
    invalid: t("Revisa los datos marcados: hay algo que no se pudo guardar.", "Check the highlighted details: something could not be saved."),
    phone: t("Ese teléfono no parece válido. Usa solo números, espacios y el +.", "That phone doesn't look valid. Use only numbers, spaces and +."),
    photo: t("No pudimos usar esa imagen. Prueba con una foto JPG o PNG.", "We couldn't use that image. Try a JPG or PNG photo."),
    email: t("Ese correo no parece válido.", "That email doesn't look valid."),
    same: t("Ese ya es tu correo.", "That is already your email."),
    taken: t("Ese correo ya es de otra cuenta.", "That email belongs to another account."),
    tooMany: t("Demasiados intentos. Espera unos minutos y vuelve a probar.", "Too many attempts. Wait a few minutes and try again."),
    code: t("El código no es correcto o ya caducó.", "The code is wrong or has expired."),
    noKey: t("El cambio de correo no está disponible ahora mismo.", "Email changes are not available right now."),
  },
};
type Ok = keyof typeof copy.ok;
type Err = keyof typeof copy.err;

const COOKIE = "e180_correo_nuevo";
const CODE_MS = 10 * 60_000;

/* ─── Las acciones ──────────────────────────────────────────────────────── */
const clean = (v: FormDataEntryValue | null, max: number): string | null => {
  const s = String(v ?? "")
    .replace(/[\u0000-\u001f\u007f]/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, max);
  return s || null;
};
const DATA_URL = /^data:image\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$/;
const MAX_PHOTO = 280_000;
/* La firma de los primeros bytes: un "image/png" que no empieza como un PNG
   no es una imagen, diga lo que diga su tipo. */
const isRealImage = (dataUrl: string): boolean => {
  const b = Buffer.from(dataUrl.slice(dataUrl.indexOf(",") + 1, dataUrl.indexOf(",") + 1 + 24), "base64");
  const png = b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47;
  const jpg = b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff;
  const webp = b.subarray(0, 4).toString("latin1") === "RIFF" && b.subarray(8, 12).toString("latin1") === "WEBP";
  return png || jpg || webp;
};
const back = (q: string) => Astro.redirect(`/student/profile?${q}`, 303);

/** Pone al día clinics si el Embajador cambió de nombre o de correo. */
async function relink(id: string) {
  const fresh = await r.studentById(id);
  if (fresh && isAmbassador(fresh) && (await linkInClinics(fresh, fresh.id))) {
    console.warn(`[perfil] ${id}: no se pudo actualizar en clinics`);
  }
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  /* El botón que se pulsó manda su propio `action` DESPUÉS del oculto
     (Quitar, Cancelar): manda el último. */
  const action = String(form.getAll("action").at(-1) ?? "");

  if (action === "profile") {
    const phone = clean(form.get("phone"), 25);
    if (phone && (!/^[+()\-.\s0-9]+$/.test(phone) || (phone.match(/\d/g)?.length ?? 0) < 7 || (phone.match(/\d/g)?.length ?? 0) > 15)) {
      return back("error=phone#datos");
    }
    const wa = String(form.get("whatsapp") ?? "");
    const lang = form.get("language") === "en" ? "en" : "es";
    const next = {
      name: clean(form.get("name"), 60),
      lastName: clean(form.get("lastName"), 80),
      phone,
      whatsapp: wa === "yes" ? true : wa === "no" ? false : me.whatsapp,
      language: lang,
    } as const;
    await r.updateProfile(me.id, next);
    if (next.name !== me.name || next.lastName !== me.lastName) await relink(me.id);
    return back("ok=profile#datos");
  }

  if (action === "photo") {
    let data = String(form.get("photo") ?? "");
    const file = form.getAll("file").find((f) => f instanceof File && f.size > 0);
    if (!data && file instanceof File && file.size > 0) {
      if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size > 200_000) return back("error=photo#foto");
      data = `data:${file.type};base64,${Buffer.from(await file.arrayBuffer()).toString("base64")}`;
    }
    if (!DATA_URL.test(data) || data.length > MAX_PHOTO || !isRealImage(data)) return back("error=photo#foto");
    await r.setPhoto(me.id, data);
    return back("ok=photo#foto");
  }

  if (action === "photo-remove") {
    await r.setPhoto(me.id, null);
    return back("ok=photoRemoved#foto");
  }

  if (action === "email-request") {
    const email = normaliseEmail(String(form.get("email") ?? ""));
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) || email.length > 254) return back("error=email#correo");
    if (email === me.email) return back("error=same#correo");
    if (await r.studentByEmail(email)) return back("error=taken#correo");
    if (!consume(`perfil-correo:${me.id}`, 3, 60 * 60_000).allowed) return back("error=tooMany#correo");
    const code = FIXED_CODE ? DEMO_CODE : String(crypto.getRandomValues(new Uint32Array(1))[0]! % 1_000_000).padStart(6, "0");
    const sealed = seal(JSON.stringify({ id: me.id, email, hash: await sha256(code), exp: Date.now() + CODE_MS }));
    if (!sealed) return back("error=noKey#correo");
    Astro.cookies.set(COOKIE, sealed, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
      path: "/student/profile",
      maxAge: CODE_MS / 1000,
    });
    await enviarCorreoCodigo(email, me.language, code, EMAIL_CHANGE_EMAIL);
    return back("ok=sent#correo");
  }

  if (action === "email-verify") {
    if (!consume(`perfil-codigo:${me.id}`, 5, CODE_MS).allowed) return back("error=tooMany#correo");
    let pending: { id: string; email: string; hash: string; exp: number } | null = null;
    try {
      pending = JSON.parse(unseal(Astro.cookies.get(COOKIE)?.value) ?? "null");
    } catch {
      pending = null;
    }
    const code = String(form.get("code") ?? "").replace(/\D/g, "");
    if (!pending || pending.id !== me.id || pending.exp < Date.now() || (await sha256(code)) !== pending.hash) {
      return back("error=code#correo");
    }
    if (!(await r.changeEmail(me.id, pending.email))) return back("error=taken#correo");
    Astro.cookies.delete(COOKIE, { path: "/student/profile" });
    await relink(me.id);
    return back("ok=email#correo");
  }

  if (action === "email-cancel") {
    Astro.cookies.delete(COOKIE, { path: "/student/profile" });
    return back("#correo");
  }

  return back("");
}

/* ─── Lo que se pinta ───────────────────────────────────────────────────── */
const ok = Astro.url.searchParams.get("ok") as Ok | null;
const err = Astro.url.searchParams.get("error") as Err | null;
let pendingEmail: string | null = null;
try {
  const p = JSON.parse(unseal(Astro.cookies.get(COOKIE)?.value) ?? "null") as { id: string; email: string; exp: number } | null;
  if (p && p.id === me.id && p.exp > Date.now()) pendingEmail = p.email;
} catch {
  pendingEmail = null;
}

const student: Student = me;
const photo = photoUrl(student);
const lang = me.language;
const roleLabel: Record<Student["role"], Txt> = {
  student: studentCopy.admin.roleStudent,
  agent: studentCopy.admin.roleAgent,
  admin: studentCopy.admin.roleAdmin,
};

const card = "scroll-mt-24 rounded-3xl border border-line bg-surface p-5 sm:p-6";
const label = "block text-sm font-semibold text-ink";
const input =
  "mt-1.5 block min-h-12 w-full rounded-xl border border-line-strong bg-surface px-3.5 text-base text-ink placeholder:text-ink-subtle focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus";
const primary =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary-900 px-6 text-sm font-bold text-white transition-colors hover:bg-primary-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
const secondary =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-line-strong bg-surface px-4 text-sm font-semibold text-ink transition-colors hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
---

<StudentLayout title={copy.title} student={me}>
  <h1 class="text-3xl text-balance text-ink sm:text-4xl"><T v={copy.title} /></h1>
  <p class="mt-2 max-w-2xl text-base text-pretty text-ink-muted"><T v={copy.intro} /></p>

  {
    (ok || err) && (
      <p
        role="status"
        class:list={[
          "mt-5 flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-semibold",
          ok ? "bg-secondary-100 text-secondary-800" : "bg-error-50 text-error-700",
        ]}
      >
        <Icono nombre={ok ? "check" : "cruz"} class="size-4 shrink-0" grosor={2.4} />
        <T v={ok ? copy.ok[ok] ?? copy.ok.profile : copy.err[err!] ?? copy.err.invalid} />
      </p>
    )
  }

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    {/* La guía: arriba en el teléfono, a la derecha en escritorio. */}
    <aside class="lg:sticky lg:top-24 lg:order-2">
      <ProfileGuide student={student} />
    </aside>

    <div class="grid min-w-0 gap-6 lg:order-1">
      {/* ─── La foto ──────────────────────────────────────────────────── */}
      <section id="foto" class={card}>
        <h2 class="text-lg text-ink"><T v={copy.photoTitle} /></h2>
        <form method="POST" enctype="multipart/form-data" data-photo-form class="mt-4 flex flex-wrap items-center gap-5">
          <input type="hidden" name="action" value="photo" />
          <input type="hidden" name="photo" value="" />
          <span class="relative">
            <span data-preview>
              <Avatar name={displayName(student)} photo={photo} size="xl" />
            </span>
            <label class="absolute -right-1 -bottom-1 grid size-9 cursor-pointer place-items-center rounded-full bg-primary-900 text-white ring-4 ring-surface transition-colors hover:bg-primary-800">
              <Icono nombre="camara" class="size-4.5" grosor={2} />
              <span class="sr-only"><T v={photo ? copy.change : copy.upload} /></span>
              <input type="file" name="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-photo-input />
            </label>
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm text-pretty text-ink-muted"><T v={copy.photoHint} /></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <label class={`${primary} cursor-pointer`}>
                <Icono nombre="camara" class="size-4" grosor={2.2} />
                <T v={photo ? copy.change : copy.upload} />
                <input type="file" name="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-photo-input />
              </label>
              <noscript>
                <button type="submit" class={secondary}><T v={copy.save} /></button>
              </noscript>
              {photo && (
                <button type="submit" name="action" value="photo-remove" formnovalidate class={secondary}>
                  <T v={copy.remove} />
                </button>
              )}
            </div>
          </div>
        </form>
      </section>

      {/* ─── Los datos ────────────────────────────────────────────────── */}
      <section id="datos" class={card}>
        <h2 class="text-lg text-ink"><T v={copy.dataTitle} /></h2>
        <form method="POST" class="mt-4 grid gap-4 sm:grid-cols-2">
          <input type="hidden" name="action" value="profile" />
          <label class={label}>
            <T v={copy.name} />
            <input name="name" value={me.name ?? ""} maxlength="60" autocomplete="given-name" class={input} />
          </label>
          <label class={label}>
            <T v={copy.lastName} />
            <input name="lastName" value={me.lastName ?? ""} maxlength="80" autocomplete="family-name" class={input} />
          </label>
          <label class:list={[label, "sm:col-span-2"]}>
            <T v={copy.phone} />
            <input
              name="phone"
              type="tel"
              inputmode="tel"
              value={me.phone ?? ""}
              maxlength="25"
              autocomplete="tel"
              placeholder="+1 801 555 0142"
              aria-invalid={err === "phone" ? "true" : undefined}
              class:list={[input, err === "phone" && "border-error-600"]}
            />
            <span class="mt-1 block text-xs font-normal text-ink-muted"><T v={copy.phoneHint} /></span>
          </label>
          <fieldset class="sm:col-span-2">
            <legend class={label}><T v={copy.whatsapp} /></legend>
            <div class="mt-2 flex gap-2">
              {(["yes", "no"] as const).map((v) => (
                <label class="relative">
                  <input
                    type="radio"
                    name="whatsapp"
                    value={v}
                    checked={(v === "yes" && me.whatsapp === true) || (v === "no" && me.whatsapp === false)}
                    class="peer sr-only"
                  />
                  <span class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-line-strong px-5 text-sm font-semibold text-ink transition-colors peer-checked:border-primary-900 peer-checked:bg-primary-900 peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus">
                    <T v={v === "yes" ? copy.yes : copy.no} />
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class:list={[label, "sm:col-span-2"]}>
            <T v={copy.language} />
            <select name="language" class:list={[input, "sm:max-w-xs"]}>
              <option value="es" selected={lang === "es"}>Español</option>
              <option value="en" selected={lang === "en"}>English</option>
            </select>
          </label>
          <div class="sm:col-span-2">
            <button type="submit" class={primary}><T v={copy.save} /></button>
          </div>
        </form>
      </section>

      {/* ─── El correo ────────────────────────────────────────────────── */}
      <section id="correo" class={card}>
        <h2 class="text-lg text-ink"><T v={copy.emailTitle} /></h2>
        <p class="mt-1 text-sm text-pretty text-ink-muted"><T v={copy.emailHint} /></p>
        <p class="mt-4 text-sm">
          <span class="text-ink-muted"><T v={copy.current} /></span>
          <span class="font-semibold break-all text-ink">{me.email}</span>
        </p>
        {
          pendingEmail ? (
            <form method="POST" class="mt-4">
              <input type="hidden" name="action" value="email-verify" />
              <p class="rounded-2xl bg-secondary-50 px-4 py-3 text-sm text-pretty text-ink">
                <T v={copy.sentTo} vars={{ correo: pendingEmail }} />
              </p>
              <label class:list={[label, "mt-4 max-w-xs"]}>
                <T v={copy.code} />
                <input
                  name="code"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  pattern="[0-9 ]{6,7}"
                  maxlength="7"
                  required
                  class:list={[input, "font-mono text-lg tracking-[0.3em]"]}
                />
              </label>
              <div class="mt-4 flex flex-wrap gap-2">
                <button type="submit" class={primary}><T v={copy.verify} /></button>
                <button type="submit" name="action" value="email-cancel" formnovalidate class={secondary}>
                  <T v={copy.cancel} />
                </button>
              </div>
            </form>
          ) : (
            <form method="POST" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
              <input type="hidden" name="action" value="email-request" />
              <label class:list={[label, "min-w-0 flex-1"]}>
                <T v={copy.newEmail} />
                <input
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  aria-invalid={err === "email" || err === "taken" || err === "same" ? "true" : undefined}
                  class={input}
                />
              </label>
              <button type="submit" class={primary}><T v={copy.sendCode} /></button>
            </form>
          )
        }
      </section>

      {/* ─── La cuenta ────────────────────────────────────────────────── */}
      <section class={card}>
        <h2 class="text-lg text-ink"><T v={copy.accountTitle} /></h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="text-xs font-semibold text-ink-muted"><T v={copy.role} /></dt>
            <dd class="mt-0.5 font-semibold text-ink"><T v={roleLabel[me.role]} /></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold text-ink-muted"><T v={copy.since} /></dt>
            <dd class="mt-0.5 font-semibold text-ink"><T v={shortDate(me.createdAt)} /></dd>
          </div>
          {me.ambassadorCode && (
            <div>
              <dt class="text-xs font-semibold text-ink-muted"><T v={copy.ambCode} /></dt>
              <dd class="mt-0.5 font-mono font-bold text-ink">{me.ambassadorCode}</dd>
            </div>
          )}
        </dl>
        <form method="POST" action="/api/logout" class="mt-5 border-t border-line pt-5">
          <button type="submit" class={secondary}>
            <T v={copy.signOut} />
          </button>
        </form>
      </section>
    </div>
  </div>
</StudentLayout>

<script>
  /* La foto se recorta al cuadrado y se reduce a 320 px en el navegador, y se
     manda sola al elegirla. Si algo falla, se manda el archivo tal cual y el
     servidor decide. */
  const SIZE = 320;
  document.querySelectorAll<HTMLFormElement>("form[data-photo-form]").forEach((form) => {
    const hidden = form.querySelector<HTMLInputElement>('input[name="photo"]')!;
    form.querySelectorAll<HTMLInputElement>("[data-photo-input]").forEach((input) => {
      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;
        try {
          const bitmap = await createImageBitmap(file);
          const side = Math.min(bitmap.width, bitmap.height);
          const canvas = document.createElement("canvas");
          canvas.width = SIZE;
          canvas.height = SIZE;
          const ctx = canvas.getContext("2d")!;
          ctx.drawImage(bitmap, (bitmap.width - side) / 2, (bitmap.height - side) / 2, side, side, 0, 0, SIZE, SIZE);
          hidden.value = canvas.toDataURL("image/jpeg", 0.85);
          form.querySelectorAll<HTMLInputElement>("[data-photo-input]").forEach((i) => (i.value = ""));
          const preview = form.querySelector<HTMLElement>("[data-preview]");
          if (preview) preview.innerHTML = `<img src="${hidden.value}" alt="" class="size-24 rounded-full object-cover" />`;
        } catch {
          /* El navegador no pudo leerla: va el archivo original. */
        }
        form.requestSubmit();
      });
    });
  });
</script>
