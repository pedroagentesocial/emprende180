---
import StudentLayout from "@layouts/StudentLayout.astro";
import T from "@components/i18n/T.astro";
import PasswordField from "@components/student/PasswordField.astro";
import { studentCopy } from "@config/studentArea";
import { currentStudent, changePassword, internalPath } from "@lib/auth";
import Icono from "@components/ui/Icono.astro";
import { validatePassword, MIN_PASSWORD, type FalloClave } from "@lib/passwords";
import { construirTxt } from "@i18n/idioma";
import { interpolar } from "@i18n/formato";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /login/password — set or change the password
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * This is where the emailed link leads, and it serves the two things that are
 * really one: starting an account and recovering it. In both cases the student
 * has just proved the inbox is theirs, and what's left is choosing a password.
 *
 * ⚠️ IT ASKS FOR A SESSION, NOT A TOKEN. The token was already consumed by
 * `/login/verify`, which is what opened the session. If this page also accepted
 * a token through the URL there would be two different places able to redeem
 * one, and two places to keep safe.
 *
 * ⚠️ IT IS NOT BEHIND THE MIDDLEWARE'S AUTH GATE. `/login/*` is the public zone
 * — the sign-in form lives there — so the session check is done by this page
 * itself. It is the project's only exception and that is why it is written here,
 * in full, instead of hidden between the lines.
 *
 * ⚠️ NO JAVASCRIPT. `<form method="POST">` to itself. The screen where somebody
 * chooses their password is the worst possible place to depend on a script
 * loading.
 */
export const prerender = false;

const student = await currentStudent(Astro.cookies);

/* With no session there is nothing to do here: to the door, keeping where they
   were headed so they can come back after identifying themselves. */
if (!student) {
  return Astro.redirect("/login?next=%2Flogin%2Fpassword", 302);
}

let error: FalloClave | "mismatch" | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = String(form.get("password") ?? "");
  const repeated = String(form.get("repeated") ?? "");

  error = validatePassword(password);
  if (!error && password !== repeated) error = "mismatch";

  if (!error) {
    await changePassword(
      student,
      password,
      Astro.cookies,
      Astro.request.headers.get("user-agent"),
    );
    return Astro.redirect(internalPath(Astro.url.searchParams.get("next")), 303);
  }
}

/* The title changes depending on whether there is a password: "set one" for
   somebody starting the account and "change it" for somebody recovering it. */
const title = student.hasPassword
  ? studentCopy.password.titleChange
  : studentCopy.password.titleNew;

const text = studentCopy.password.text;

const errorMessage =
  error === "short"
    ? construirTxt((l) =>
        interpolar(studentCopy.password.errorShort[l], { min: MIN_PASSWORD }),
      )
    : error === "long"
      ? studentCopy.password.errorLong
      : error === "upper"
        ? studentCopy.password.errorUpper
        : error === "symbol"
          ? studentCopy.password.errorSymbol
          : error === "mismatch"
            ? studentCopy.password.errorMismatch
            : null;

/**
 * Las tres reglas, para pintarlas ANTES de que nadie falle.
 *
 * ⚠️ `regla` ES LA MISMA PALABRA QUE COMPRUEBA EL SERVIDOR, y por eso viaja en
 * un `data-` en vez de repetirse en el script: si algún día cambia una regla en
 * `@lib/passwords`, aquí solo hay una lista que actualizar, no una lógica
 * duplicada que se olvide.
 */
const reglas = [
  {
    id: "length",
    txt: construirTxt((l) =>
      interpolar(studentCopy.password.ruleLength[l], { min: MIN_PASSWORD }),
    ),
  },
  { id: "upper", txt: studentCopy.password.ruleUpper },
  { id: "symbol", txt: studentCopy.password.ruleSymbol },
];
---

<StudentLayout title={studentCopy.password.aria} student={student}>
  <div class="mx-auto max-w-md">
    <h1 class="text-3xl font-extrabold text-balance text-ink sm:text-4xl">
      <T v={title} />
    </h1>

    <p class="mt-4 text-base text-pretty text-ink-muted">
      <T v={text} />
    </p>

    {/* Its own `id`: this page holds another `<form method="POST">` — the
        sign-out one, in the area's header — and without an identifier there is
        no way to refer to this one in particular. */}
    <form
      id="password-form"
      method="POST"
      class="mt-8 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-7"
    >
      {
        errorMessage && (
          <p
            role="alert"
            class="mb-5 flex items-start gap-2.5 rounded-xl border border-error-500/45 bg-error-50 px-4 py-3 text-sm font-medium text-error-700"
          >
            <Icono nombre="cruz" class="mt-0.5 size-4.5 shrink-0" grosor={2.5} />
            <span><T v={errorMessage} /></span>
          </p>
        )
      }

      {/* `new-password` makes the password manager OFFER to generate one instead
          of filling in the old one. With `current-password` here, the browser
          would insist on putting in the very password being changed.

          Both fields carry an eye to reveal them. See `PasswordField.astro`:
          asking for ten characters and not letting people check what they typed
          is what makes them try three times and leave. */}
      <PasswordField
        id="password"
        name="password"
        label={studentCopy.password.label}
        autocomplete="new-password"
        minlength={MIN_PASSWORD}
        autofocus
      />

      {/* ⚠️ LAS REGLAS SE ENSEÑAN ANTES DE FALLAR, y ese es todo el propósito.
          Un formulario que solo dice qué está mal DESPUÉS de enviar convierte
          poner una contraseña en tres intentos, y el tercero es donde la gente
          se va. Sin JavaScript siguen leyéndose como lista; con él se van
          marcando en teal según se escribe. */}
      <div class="mt-5 rounded-xl bg-surface-muted px-4 py-3.5">
        <p class="text-xs font-semibold tracking-wide text-ink-subtle uppercase">
          <T v={studentCopy.password.rulesTitle} />
        </p>
        <ul id="reglas-clave" class="mt-2.5 space-y-2">
          {
            reglas.map((r) => (
              <li
                data-regla={r.id}
                data-ok="false"
                class="group flex items-center gap-2.5 text-sm text-ink-muted transition-colors data-[ok=true]:font-semibold data-[ok=true]:text-ink"
              >
                <span class="grid size-5 shrink-0 place-items-center rounded-full border border-line-strong text-transparent transition-colors duration-200 group-data-[ok=true]:border-cta group-data-[ok=true]:bg-cta group-data-[ok=true]:text-ink-inverse">
                  <Icono nombre="check" class="size-3" grosor={3} />
                </span>
                <T v={r.txt} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-4">
        <PasswordField
          id="repeated"
          name="repeated"
          label={studentCopy.password.repeat}
          autocomplete="new-password"
          minlength={MIN_PASSWORD}
        />
      </div>

      <button
        type="submit"
        class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-cta px-6 text-base font-bold text-ink-inverse shadow-cta transition-colors hover:bg-cta-hover hover:shadow-cta-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        <T v={studentCopy.password.save} />
      </button>
    </form>
  </div>
</StudentLayout>

{/* ⚠️ LAS MISMAS TRES COMPROBACIONES QUE HACE EL SERVIDOR, y esto es una copia
    a sabiendas: el navegador no puede ser la autoridad, así que `validatePassword`
    vuelve a comprobarlo todo en `@lib/passwords` pase lo que pase aquí. Esto solo
    pinta. Si alguna regla cambia allí, hay que tocar estas tres líneas. */}
<script is:inline define:vars={{ min: MIN_PASSWORD }}>
  const campo = document.getElementById("password");
  const lista = document.getElementById("reglas-clave");

  if (campo && lista) {
    const pruebas = {
      length: (v) => v.length >= min,
      upper: (v) => /\p{Lu}/u.test(v),
      symbol: (v) => /[^\p{L}\p{N}]/u.test(v),
    };

    const pintar = () => {
      const v = campo.value.normalize("NFKC");
      for (const li of lista.querySelectorAll("[data-regla]")) {
        const prueba = pruebas[li.dataset.regla];
        li.dataset.ok = String(prueba ? prueba(v) : false);
      }
    };

    campo.addEventListener("input", pintar);
    pintar();
  }
</script>
