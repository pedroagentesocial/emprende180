---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import VideoVsl from "@components/hero/VideoVsl.astro";
import Cierre from "@components/sections/09-Cierre.astro";
import { copy, sitio } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /programs — las tres piezas, enteras
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nueva el 14 de septiembre de 2026. "Programas" en el menú llevaba al ancla
 * de "Cómo se trabaja" en la portada, que resume las tres piezas en tres
 * tarjetas; esta página las cuenta enteras: hero, un índice de tres enlaces,
 * y una sección por pieza con su imagen y su botón.
 *
 * ─── NO HAY SISTEMA VISUAL NUEVO ───────────────────────────────────────────
 *
 * El hero es el del about de antes (a la izquierda, columna estrecha, remate
 * en Fraunces, navy con las dos luces y el encogimiento al bajar). Las tres
 * piezas van en el MOSAICO de la portada —el de "Los 90 días" y el del
 * propósito del about—: filas alternas foto/texto a todo el ancho, pegadas
 * entre sí, y el lado de la foto alterna para que tres filas con la misma
 * anatomía no se lean como tres copias. Ver `01-Plan90.astro` para el porqué
 * de cada decisión del mosaico.
 *
 * ⚠️ ANTES ERAN TRES SECCIONES CON LA FOTO DESNIVELADA (la foto arrancaba 96
 * px más abajo que el texto, como en el blog de la portada). El cliente las
 * vio el 15-09-2026 y pidió el mosaico: "arregla el que parece mosaico como
 * lo veníamos haciendo".
 *
 * ─── LAS ZONAS DE FONDO ─────────────────────────────────────────────────────
 *
 *   navy       hero
 *   blanco     índice + las tres piezas   (una zona: el programa entero)
 *   azul suave el método de los 90 días, con los datos y el vídeo vertical
 *   blanco     el formulario (la misma sección de cierre de la portada)
 *
 * Las tres piezas van sobre el MISMO fondo a propósito: son tres partes de
 * una cosa, y un cambio de color entre ellas diría que son tres cosas.
 *
 * ⚠️ EL FORMULARIO ESTÁ EN ESTA PÁGINA desde el 15-09-2026 ("falta agregar un
 * captador de leads"). Es `09-Cierre` tal cual, con su `id="empezar"`, así que
 * los botones de las tres piezas bajan a `#empezar` aquí mismo en vez de
 * mandar a la portada, que era un salto de página para rellenar un formulario.
 *
 * ⚠️ LAS TRES REGLAS DE TONO viven en `copy.programas`: sin precios, sin
 * "para quién sí / para quién no", sin guion largo en español.
 */
export const prerender = false;

const { programas } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const tituloPagina = construirTxt(
  (l) => `${programas.kicker[l]} · ${sitio.nombre[l]}`,
);
---

<BaseLayout titulo={tituloPagina} descripcion={programas.descripcion}>
  <Header />

  <main id="contenido">
    {/* ─── 1 · EL HERO ───────────────────────────────────────────────────
        Calcado del about: a la izquierda, columna del 58 %, título con el
        remate en Fraunces, un párrafo y el botón. Aquí el botón no vende:
        baja a la primera sección, que es lo que hace "ver cómo funciona".
        Las dos luces y el encogimiento al bajar son los del about y llevan
        los mismos seguros: `prefers-reduced-motion` y capas separadas para
        que el encogimiento y el `Reveal` no animen el mismo `transform`. */}
    <Section
      id="programas-hero"
      tono="inverse"
      ritmo="compacto"
      ariaLabel={programas.aria}
      class="relative isolate overflow-hidden lg:py-24"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div
          data-hero-luz="a"
          class="absolute -right-[10%] -top-[35%] size-[64vw] max-h-[48rem] max-w-[48rem] rounded-full bg-primary-800/60 blur-3xl"
        />
        <div
          data-hero-luz="b"
          class="absolute -bottom-[40%] right-[8%] size-[52vw] max-h-[40rem] max-w-[40rem] rounded-full bg-secondary-500/20 blur-3xl"
        />
      </div>

      <div data-hero-encoge>
        <Reveal>
          <div class="max-w-[58%] max-lg:max-w-none text-left">
            <p class="text-sm font-semibold text-ink-on-inverse-brand sm:text-base lg:text-lg">
              <T v={programas.kicker} />
            </p>

            <h1 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink-inverse sm:text-4xl lg:text-5xl">
              <span class="block"><T v={programas.hero.titulo} /></span>
              <span class="block"><Enfasis v={programas.hero.remate} tono="inverso" /></span>
            </h1>

            <p class="mt-5 max-w-prose text-base font-medium leading-relaxed text-pretty text-secondary-100 sm:text-lg lg:mt-6 lg:text-xl">
              <T v={programas.hero.texto} />
            </p>

            <div class="ml-1 mt-8 lg:mt-10">
              <BotonRelieve href={programas.hero.ctaHref} sobre="oscuro" trackId="programas-hero">
                <T v={programas.hero.cta} />
              </BotonRelieve>
            </div>
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 2 · EL ÍNDICE ─────────────────────────────────────────────────
        Tres enlaces en fila, entre dos filetes. Cada tarjeta es UN enlace
        entero —número, título y frase— y no un título con un "ver más"
        debajo: el destino es el mismo y la diana grande se pulsa mejor.

        Sin fondo propio: va sobre el blanco de las secciones que enlaza, y
        los dos filetes son lo único que la separa. Un fondo de color aquí la
        convertiría en una tercera zona entre el hero y el contenido. */}
    <Section id="programas-indice" tono="surface" ritmo="compacto" ariaLabel={programas.kicker}>
      <Reveal>
        <nav aria-label={programas.kicker[lang]} data-aria-es={programas.kicker.es} data-aria-en={programas.kicker.en}>
          <ul role="list" class="grid border-y-[0.5px] border-line sm:grid-cols-3">
            {programas.indice.map((item) => (
              <li
                class:list={[
                  /* El filete entre tarjetas: abajo en el teléfono (apiladas)
                     y a la izquierda desde `sm` (en fila). Nunca los dos. */
                  "border-line max-sm:border-b-[0.5px] max-sm:last:border-b-0 sm:border-l-[0.5px] sm:first:border-l-0",
                ]}
              >
                <a
                  href={item.ancla}
                  class="group flex h-full flex-col gap-2 px-1 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus sm:px-6 sm:py-8 lg:px-8"
                >
                  <span class="text-sm font-bold tracking-[0.18em] text-ink-brand">
                    {item.numero}
                  </span>
                  <span class="flex items-center gap-2 text-xl font-extrabold text-ink group-hover:text-ink-brand sm:text-2xl">
                    <T v={item.titulo} />
                    <Icono
                      nombre="flecha"
                      class="size-5 shrink-0 rotate-90 text-ink-subtle transition-transform duration-200 ease-out-soft group-hover:translate-y-1 group-hover:text-ink-brand"
                    />
                  </span>
                  <span class="text-base font-medium text-pretty text-ink-muted sm:text-lg">
                    <T v={item.texto} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Reveal>
    </Section>

    {/* ─── 3 · LAS TRES PIEZAS, EN MOSAICO ──────────────────────────────
        Una plantilla, tres veces, y lo único que cambia entre filas es el
        LADO de la foto. Se pinta con un bucle y no con tres copias del
        marcado: si mañana hay que tocar la altura mínima, se toca en un sitio.

        ⚠️ CADA FILA LLEVA EL `id` DE SU PIEZA (academia, crm, seguimiento):
        son los destinos del índice de arriba y del botón del hero. Antes lo
        llevaba cada `<Section>`; ahora las tres filas comparten una y el ancla
        baja a la fila. `scroll-mt-20` para que la barra pegajosa no la tape.

        ⚠️ EL LADO SE CAMBIA CON `order`, NO CAMBIANDO EL MARCADO. La foto va
        siempre primera en el HTML —en el teléfono, apilado, la foto encima del
        texto es lo que se quiere— y en escritorio `md:order-last` la pasa a la
        derecha cuando `imagenLado` lo dice.

        ⚠️ ALTURA MÍNIMA EN ESCRITORIO, como en el propósito del about: aquí
        cada pieza trae dos párrafos y un botón, y sin el mínimo la foto de la
        pieza corta quedaba en una tira. */}
    <Section
      id="programas-piezas"
      tono="surface"
      ariaLabel={programas.kicker}
      sinContenedor
      class="relative pt-0! pb-0!"
    >
      {programas.secciones.map((sec) => (
        <Reveal delay={0.05}>
          <div id={sec.id} class="grid scroll-mt-20 md:grid-cols-2">
            <div
              class:list={[
                "relative min-h-[260px] sm:min-h-[320px] md:min-h-[26rem] lg:min-h-[30rem]",
                sec.imagenLado === "derecha" && "md:order-last",
              ]}
            >
              <img
                src={sec.imagen.src}
                alt={sec.imagen.alt[lang]}
                data-alt-es={sec.imagen.alt.es}
                data-alt-en={sec.imagen.alt.en}
                width={sec.imagen.ancho}
                height={sec.imagen.alto}
                loading="lazy"
                decoding="async"
                style={`object-position:${sec.imagen.encuadre}`}
                class="absolute inset-0 size-full object-cover"
              />
            </div>

            <div
              class:list={[
                "flex flex-col justify-center bg-surface py-10 sm:py-12 lg:py-16",
                sec.imagenLado === "derecha"
                  ? "pl-[var(--gutter-page)] pr-[var(--gutter-page)] md:pr-10 lg:pr-16 xl:pr-24"
                  : "pl-[var(--gutter-page)] pr-[var(--gutter-page)] md:pl-10 lg:pl-16 xl:pl-24",
              ]}
            >
              <div class="max-w-[40rem]">
                {/* El número grande en Montserrat teal y la categoría en
                    versalitas debajo, como el número y el rango de fase del
                    plan de la portada. */}
                <p class="text-4xl font-extrabold leading-none tracking-[-0.03em] text-ink-brand sm:text-5xl">
                  {sec.numero}
                </p>
                <p class="mt-4 text-sm font-bold tracking-[0.18em] text-ink-muted uppercase">
                  <T v={sec.categoria} />
                </p>
                <h2 class="mt-2 font-acento text-3xl italic leading-tight text-ink sm:text-4xl lg:text-5xl">
                  <T v={sec.titulo} />
                </h2>

                {sec.parrafos.map((parrafo, j) => (
                  <p
                    class:list={[
                      "text-base font-medium leading-relaxed text-pretty text-ink-muted sm:text-lg",
                      j === 0 ? "mt-5" : "mt-4",
                    ]}
                  >
                    <T v={parrafo} />
                  </p>
                ))}

                <div class="ml-1 mt-8">
                  <BotonRelieve href={sec.ctaHref} trackId={`programas-${sec.id}`}>
                    <T v={sec.cta} />
                  </BotonRelieve>
                </div>
              </div>
            </div>
          </div>
        </Reveal>
      ))}
    </Section>

    {/* ─── 4 · EL MÉTODO DE LOS 90 DÍAS ──────────────────────────────────
        Título con el remate en Fraunces, el párrafo del programa y los
        cuatro datos de la portada (90 días, 2 horas, 4 fases, el CRM), y al
        lado el vídeo vertical de introducción. Texto y datos son los de
        `copy.identidad`: la misma verdad en las dos páginas.

        ⚠️ EL VÍDEO NO SE AUTORREPRODUCE Y SÍ LLEVA SONIDO: es `VideoVsl`, la
        fachada de póster y botón que solo crea el `<video>` al pulsar. Es un
        vídeo de 3,6 MB en el que alguien habla; lo contrario del bucle mudo
        del hero. Se le pone un ancho tope (22rem) porque en una columna del
        40 % a 1280 mediría 512 de ancho y 910 de alto, más que la pantalla.

        Sobre azul suave para separarlo de las piezas de arriba, que van en
        blanco, y del formulario de abajo, que también. */}
    <Section id="programas-metodo" tono="muted" ariaLabel={programas.metodo.aria}>
      <div class="grid items-center gap-12 lg:grid-cols-[60fr_40fr] lg:gap-20">
        <Reveal>
          <div>
            <h2 class="text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
              <T v={programas.metodo.titulo} />{" "}
              <Enfasis v={programas.metodo.remate} />
            </h2>

            {copy.identidad.cuerpo.map((parrafo) => (
              <p class="mt-6 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl">
                <T v={parrafo} />
              </p>
            ))}

            {/* Los cuatro datos, como en la portada: dos por fila en el
                teléfono, cuatro en fila desde `sm` (aquí la columna es ancha). */}
            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-t-[0.5px] border-line pt-7 sm:grid-cols-4">
              {copy.identidad.datos.map((d) => (
                <div>
                  <dd class="text-3xl font-extrabold leading-none tracking-[-0.02em] text-ink sm:text-4xl">
                    <T v={d.valor} />
                  </dd>
                  <dt class="mt-2 max-w-[16ch] text-sm font-medium text-pretty text-ink-muted sm:text-base">
                    <T v={d.etiqueta} />
                  </dt>
                </div>
              ))}
            </dl>
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          <div class="mx-auto w-full max-w-[22rem]">
            <VideoVsl />
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 5 · EL FORMULARIO ─────────────────────────────────────────────
        La sección de cierre de la portada, tal cual, con su `id="empezar"`:
        es a donde bajan los tres botones de las piezas. */}
    <Cierre />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Las mismas dos luces y el mismo encogimiento que el hero del about. Se
     repiten aquí y no se sacan a un componente todavía: son dos páginas, y
     dos copias se leen; el día que haya una tercera, se extrae. */
  @keyframes programas-luz-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(8%, 12%) scale(1.12);
    }
  }

  @keyframes programas-luz-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-10%, -8%) scale(1.08);
    }
  }

  @keyframes programas-encoger {
    to {
      transform: scale(0.92) translateY(-1.5rem);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-hero-luz="a"] {
      animation: programas-luz-a 28s ease-in-out infinite;
    }

    [data-hero-luz="b"] {
      animation: programas-luz-b 34s ease-in-out infinite;
    }

    @supports (animation-timeline: view()) {
      [data-hero-encoge] {
        transform-origin: 50% 100%;
        animation: programas-encoger linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
</style>
