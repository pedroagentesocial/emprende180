---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import Reveal from "@components/motion/Reveal.astro";
import Icono from "@components/ui/Icono.astro";
import BotonRelieve from "@components/ui/BotonRelieve.astro";
import { copy, sitio } from "@config/curso.config";
import { construirTxt, resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /programs — las tres piezas, enteras
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nueva el 14 de septiembre de 2026. "Programas" en el menú llevaba al ancla
 * de "Cómo se trabaja" en la portada, que resume las tres piezas en tres
 * tarjetas; esta página las cuenta enteras: hero, un índice de tres enlaces,
 * y una sección por pieza con su imagen y su botón.
 *
 * ─── NO HAY SISTEMA VISUAL NUEVO ───────────────────────────────────────────
 *
 * El hero es el del about (a la izquierda, columna estrecha, remate en
 * Fraunces, navy con las dos luces y el encogimiento al bajar). Las tres
 * secciones usan el patrón de imagen con DESNIVEL del blog de la portada: la
 * foto arranca 96 px más abajo que el texto y se estira hasta su misma línea
 * de abajo. Y el lado de la foto alterna —derecha, izquierda, derecha— para
 * que tres secciones con la misma anatomía no se lean como tres copias.
 *
 * ─── LAS ZONAS DE FONDO ─────────────────────────────────────────────────────
 *
 *   navy     hero
 *   blanco   índice + las tres secciones   (una zona: el programa entero)
 *
 * Las tres secciones van sobre el MISMO fondo a propósito: son tres partes
 * de una cosa, y un cambio de color entre ellas diría que son tres cosas. Lo
 * que las separa es el filete del índice arriba y el desnivel de cada foto.
 *
 * ⚠️ LAS TRES REGLAS DE TONO viven en `copy.programas`: sin precios, sin
 * "para quién sí / para quién no", sin guion largo en español.
 */
export const prerender = false;

const { programas } = copy;

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const tituloPagina = construirTxt(
  (l) => `${programas.kicker[l]} · ${sitio.nombre[l]}`,
);
---

<BaseLayout titulo={tituloPagina} descripcion={programas.descripcion}>
  <Header />

  <main id="contenido">
    {/* ─── 1 · EL HERO ───────────────────────────────────────────────────
        Calcado del about: a la izquierda, columna del 58 %, título con el
        remate en Fraunces, un párrafo y el botón. Aquí el botón no vende:
        baja a la primera sección, que es lo que hace "ver cómo funciona".
        Las dos luces y el encogimiento al bajar son los del about y llevan
        los mismos seguros: `prefers-reduced-motion` y capas separadas para
        que el encogimiento y el `Reveal` no animen el mismo `transform`. */}
    <Section
      id="programas-hero"
      tono="inverse"
      ritmo="compacto"
      ariaLabel={programas.aria}
      class="relative isolate overflow-hidden lg:py-24"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div
          data-hero-luz="a"
          class="absolute -right-[10%] -top-[35%] size-[64vw] max-h-[48rem] max-w-[48rem] rounded-full bg-primary-800/60 blur-3xl"
        />
        <div
          data-hero-luz="b"
          class="absolute -bottom-[40%] right-[8%] size-[52vw] max-h-[40rem] max-w-[40rem] rounded-full bg-secondary-500/20 blur-3xl"
        />
      </div>

      <div data-hero-encoge>
        <Reveal>
          <div class="max-w-[58%] max-lg:max-w-none text-left">
            <p class="text-sm font-semibold text-ink-on-inverse-brand sm:text-base lg:text-lg">
              <T v={programas.kicker} />
            </p>

            <h1 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink-inverse sm:text-4xl lg:text-5xl">
              <span class="block"><T v={programas.hero.titulo} /></span>
              <span class="block"><Enfasis v={programas.hero.remate} tono="inverso" /></span>
            </h1>

            <p class="mt-5 max-w-prose text-base font-medium leading-relaxed text-pretty text-secondary-100 sm:text-lg lg:mt-6 lg:text-xl">
              <T v={programas.hero.texto} />
            </p>

            <div class="ml-1 mt-8 lg:mt-10">
              <BotonRelieve href={programas.hero.ctaHref} sobre="oscuro" trackId="programas-hero">
                <T v={programas.hero.cta} />
              </BotonRelieve>
            </div>
          </div>
        </Reveal>
      </div>
    </Section>

    {/* ─── 2 · EL ÍNDICE ─────────────────────────────────────────────────
        Tres enlaces en fila, entre dos filetes. Cada tarjeta es UN enlace
        entero —número, título y frase— y no un título con un "ver más"
        debajo: el destino es el mismo y la diana grande se pulsa mejor.

        Sin fondo propio: va sobre el blanco de las secciones que enlaza, y
        los dos filetes son lo único que la separa. Un fondo de color aquí la
        convertiría en una tercera zona entre el hero y el contenido. */}
    <Section id="programas-indice" tono="surface" ritmo="compacto" ariaLabel={programas.kicker}>
      <Reveal>
        <nav aria-label={programas.kicker[lang]} data-aria-es={programas.kicker.es} data-aria-en={programas.kicker.en}>
          <ul role="list" class="grid border-y-[0.5px] border-line sm:grid-cols-3">
            {programas.indice.map((item) => (
              <li
                class:list={[
                  /* El filete entre tarjetas: abajo en el teléfono (apiladas)
                     y a la izquierda desde `sm` (en fila). Nunca los dos. */
                  "border-line max-sm:border-b-[0.5px] max-sm:last:border-b-0 sm:border-l-[0.5px] sm:first:border-l-0",
                ]}
              >
                <a
                  href={item.ancla}
                  class="group flex h-full flex-col gap-2 px-1 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus sm:px-6 sm:py-8 lg:px-8"
                >
                  <span class="text-sm font-bold tracking-[0.18em] text-ink-brand">
                    {item.numero}
                  </span>
                  <span class="flex items-center gap-2 text-xl font-extrabold text-ink group-hover:text-ink-brand sm:text-2xl">
                    <T v={item.titulo} />
                    <Icono
                      nombre="flecha"
                      class="size-5 shrink-0 rotate-90 text-ink-subtle transition-transform duration-200 ease-out-soft group-hover:translate-y-1 group-hover:text-ink-brand"
                    />
                  </span>
                  <span class="text-base font-medium text-pretty text-ink-muted sm:text-lg">
                    <T v={item.texto} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Reveal>
    </Section>

    {/* ─── 3 · LAS TRES SECCIONES ────────────────────────────────────────
        Una plantilla, tres veces, y lo único que cambia entre ellas es el
        LADO de la foto. Se pinta con un bucle y no con tres copias del
        marcado: si mañana hay que tocar el desnivel, se toca en un sitio.

        ⚠️ EL DESNIVEL ES EL DEL BLOG DE LA PORTADA. La celda de la foto lleva
        `md:mt-24` —arranca 96 px más abajo que el texto— y `md:self-stretch`
        con la imagen a `md:h-full`, así que baja hasta la misma línea donde
        acaba el texto de al lado. Dos columnas empezando a la vez son la
        simetría que estas secciones no quieren.

        ⚠️ EL LADO SE CAMBIA CON `order`, NO CAMBIANDO EL MARCADO. La foto va
        siempre la última en el HTML —en el teléfono, apilado, la foto antes
        del titular solo tapa la entrada— y en escritorio `md:order-first` la
        pasa a la izquierda cuando toca. */}
    {programas.secciones.map((sec, i) => (
      <Section
        id={sec.id}
        tono="surface"
        ritmo={i === 0 ? "normal" : "compacto"}
        ariaLabel={sec.categoria}
      >
        <div class="grid items-start gap-10 md:grid-cols-2 md:gap-10 lg:gap-16 xl:gap-20">
          <Reveal>
            <div>
              <p class="text-sm font-bold tracking-[0.18em] text-ink-brand uppercase">
                {sec.numero} · <T v={sec.categoria} />
              </p>

              <h2 class="mt-4 text-3xl font-extrabold leading-tight text-balance text-ink sm:text-4xl lg:text-5xl">
                <T v={sec.titulo} />
              </h2>

              {sec.parrafos.map((parrafo, j) => (
                <p
                  class:list={[
                    "max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl",
                    j === 0 ? "mt-6" : "mt-4",
                  ]}
                >
                  <T v={parrafo} />
                </p>
              ))}

              <div class="ml-1 mt-8">
                <BotonRelieve href={sec.ctaHref} trackId={`programas-${sec.id}`}>
                  <T v={sec.cta} />
                </BotonRelieve>
              </div>
            </div>
          </Reveal>

          <Reveal
            delay={0.15}
            class:list={[
              "md:mt-24 md:self-stretch",
              sec.imagenLado === "izquierda" && "md:order-first",
            ]}
          >
            <img
              src={sec.imagen.src}
              alt={sec.imagen.alt[lang]}
              data-alt-es={sec.imagen.alt.es}
              data-alt-en={sec.imagen.alt.en}
              width={sec.imagen.ancho}
              height={sec.imagen.alto}
              loading="lazy"
              decoding="async"
              style={`object-position:${sec.imagen.encuadre}`}
              class="h-[260px] w-full rounded-lg border border-line object-cover sm:h-[320px] md:h-full md:min-h-[360px]"
            />
          </Reveal>
        </div>
      </Section>
    ))}
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Las mismas dos luces y el mismo encogimiento que el hero del about. Se
     repiten aquí y no se sacan a un componente todavía: son dos páginas, y
     dos copias se leen; el día que haya una tercera, se extrae. */
  @keyframes programas-luz-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(8%, 12%) scale(1.12);
    }
  }

  @keyframes programas-luz-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-10%, -8%) scale(1.08);
    }
  }

  @keyframes programas-encoger {
    to {
      transform: scale(0.92) translateY(-1.5rem);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-hero-luz="a"] {
      animation: programas-luz-a 28s ease-in-out infinite;
    }

    [data-hero-luz="b"] {
      animation: programas-luz-b 34s ease-in-out infinite;
    }

    @supports (animation-timeline: view()) {
      [data-hero-encoge] {
        transform-origin: 50% 100%;
        animation: programas-encoger linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
</style>
