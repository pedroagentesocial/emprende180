---
import BaseLayout from "@layouts/BaseLayout.astro";
import T from "@components/i18n/T.astro";
import LanguageSwitch from "@components/i18n/LanguageSwitch";
import Enfasis from "@components/ui/Enfasis.astro";
import RegistroForm from "@components/ui/RegistroForm";
import { copy, sitio } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /subscribe — el alta en la plataforma
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nació el 13-10-2026 como una página de captación de un día para otro, con el
 * `LeadForm` de la landing. Ese mismo día pasó a ser lo que es ahora: EL ALTA
 * EN LA PLATAFORMA. Quien rellena esto no deja un recado, se crea una cuenta
 * en `alumnos` y entra.
 *
 * ⚠️ POR ESO NO USA `LeadForm`. Un lead va a GoHighLevel para que alguien
 * llame; esto escribe en la base y abre sesión. Si algún día alguien los
 * vuelve a juntar "porque se parecen", un cambio pensado para la landing dará
 * de alta a gente sin querer. Ver la cabecera de `RegistroForm.tsx`.
 *
 * ─── LA COMPOSICIÓN ────────────────────────────────────────────────────────
 *
 * Dos lados: una franja de color a la izquierda y el formulario sobre blanco a
 * la derecha. Es el patrón de cualquier alta seria, y el cliente lo pidió con
 * una referencia delante.
 *
 * ⚠️ LA FRANJA ES CSS, NO UNA IMAGEN. Son cuatro manchas de color
 * superpuestas con un desenfoque encima. Una foto de 300 KB para pintar un
 * fondo que nadie mira es lo primero que habría que quitar después, y además
 * esto se adapta a cualquier alto sin recortes ni pixelado.
 *
 * ⚠️ Y VA FIJA EN ESCRITORIO. No se mueve al bajar: lo pidió el cliente y es
 * lo que permite que el formulario sea largo sin que la página se quede en
 * blanco por un lado.
 *
 * ⚠️ EN MÓVIL LA FRANJA PASA ARRIBA, y no es una renuncia: a 390 px una franja
 * lateral se come el ancho que necesitan los campos. Arriba hace el mismo
 * trabajo —poner la marca sobre color— sin robar sitio.
 *
 * ─── POR QUÉ NO HAY BARRA NI PIE ───────────────────────────────────────────
 *
 * Los quitó el cliente. Es lo correcto: aquí se llega con una intención única
 * y cada enlace es una puerta para irse antes de terminar.
 *
 * ⚠️ PERO EL AVISO DE PRIVACIDAD Y LOS TÉRMINOS TIENEN QUE SEGUIR ALCANZABLES,
 * y sin pie los enlaza SOLO el consentimiento del formulario. Si algún día
 * alguien toca ese texto, que sepa que aquí es el único camino a lo legal.
 *
 * ⚠️ EL SELECTOR DE IDIOMA SE QUEDA porque el sitio es bilingüe y esta es la
 * única pantalla del embudo: sin él, quien entra en inglés no puede cambiar.
 *
 * ─── LAS DOS ILUSTRACIONES ─────────────────────────────────────────────────
 *
 * Un libro entra por la izquierda y una bombilla por la derecha, y la bombilla
 * se enciende al llegar.
 *
 * ⚠️ VAN `fixed`, NO `absolute`. El cliente pidió que se vean siempre, también
 * al bajar por el formulario. Van detrás del contenido y con opacidad baja: a
 * ese tamaño, por delante, competirían con los campos.
 *
 * ⚠️ VAN EN SVG AQUÍ Y NO EN `Icono.astro`. Ese set es cerrado y es de iconos
 * de interfaz: piezas de 24×24 que acompañan a un texto. Esto son
 * ilustraciones de esta pantalla, con su animación y su tamaño.
 *
 * ⚠️ `?ref=CODIGO` ES LO QUE HACE QUE CADA EMBAJADOR PUEDA IMPRIMIR SU QR.
 * Llega aquí, baja al formulario y marca el canal solo. Si alguien quita este
 * parámetro, cada Embajador pierde la atribución de la gente que trae.
 *
 * ⚠️ `noindex`: la puerta de alta no tiene que competir en el buscador con la
 * portada, que es la que cuenta qué es esto.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const r = copy.registro;

/* El logotipo sustituye a las palabras "la plataforma" dentro del titular, así
   que necesita el archivo del idioma que toque: el horizontal lleva el nombre
   escrito y en inglés es otro. */
const logo = lang === "en" ? sitio.logoHorizontalEn : sitio.logoHorizontal;
const logoBlanco =
  lang === "en" ? sitio.logoHorizontalBlancoEn : sitio.logoHorizontalBlanco;
const nombre = lang === "en" ? "Entrepreneur180" : "Emprende180";

/* ⚠️ EL ENLACE AL INICIO LLEVA "Ir a" DELANTE DEL LOGOTIPO, Y NO ES ADORNO.
   Con el logotipo solo, el cliente no entendió que aquello fuera un enlace a
   ninguna parte (13-10-2026): una marca en una esquina se lee como membrete,
   no como salida. Dos palabras lo convierten en una frase que se entiende sin
   pensar, "Ir a Emprende180", y de paso es lo que oye un lector de pantalla. */
const irA = lang === "en" ? "Go to" : "Ir a";
const irAlInicio = lang === "en" ? "Go to the home page" : "Ir al inicio";
const entrar = lang === "en" ? "Log in" : "Entrar";
const yaTienes = lang === "en" ? "Already have an account?" : "¿Ya tienes cuenta?";

const refInicial = (Astro.url.searchParams.get("ref") ?? "")
  .trim()
  .slice(0, 40)
  .toUpperCase();
---

<BaseLayout titulo={r.meta.titulo} descripcion={r.meta.descripcion} noindex>
  <div class="alta">
    {/* ─── LA FRANJA ────────────────────────────────────────────────────── */}
    <aside class="franja">
      <div class="franja-fondo" aria-hidden="true"></div>
      {/* El logotipo de arriba a la izquierda devuelve al inicio. Es la única
          salida de la página, y en una pantalla de alta eso es justo lo que
          tiene que ser: una sola, y que se vea. */}
      <a href="/" class="franja-logo" aria-label={irAlInicio}>
        <span class="franja-logo-texto">{irA}</span>
        <img
          src={logoBlanco.src}
          width={logoBlanco.w}
          height={logoBlanco.h}
          alt={nombre}
          fetchpriority="high"
        />
      </a>
    </aside>

    {/* ─── EL CONTENIDO ─────────────────────────────────────────────────── */}
    <main id="contenido" class="panel">
      {/* ⚠️ LA BARRA SUPERIOR DEL LADO BLANCO. Lleva las dos únicas cosas que
          esta pantalla necesita además del formulario: la puerta de quien YA
          tiene cuenta y el cambio de idioma. Las dos estaban abajo, debajo del
          botón, y el cliente las subió el 13-10-2026. Tiene razón: quien se
          equivocó de puerta no debería tener que leerse el formulario entero
          para descubrirlo, y quien entra en inglés no debería tener que bajar
          a por el selector.

          Va dentro del panel y no sobre la franja: ahí es donde mira quien
          llega, y sobre el degradado el contraste del texto dependería de en
          qué punto del fondo cayera. */}
      <div class="barra">
        <a href="/login" class="barra-entrar">
          <span class="barra-entrar-previo">{yaTienes}</span>
          <span class="barra-entrar-enlace">{entrar}</span>
        </a>
        <LanguageSwitch client:load lang={lang} tono="claro" />
      </div>

      <div class="ilustras" aria-hidden="true">
        {/* EL LIBRO — entra por la izquierda.
            Dibujado de nuevo el 13-10-2026: el anterior era un garabato. Este
            tiene lomo, las dos tapas con su grosor y los renglones siguiendo
            la curva de la página, que es lo que hace que se lea como un libro
            abierto y no como dos triángulos. */}
        <svg class="ilustra libro" viewBox="0 0 120 100" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 26c-9-7.5-21-11-36-10.5a4 4 0 0 0-4 4v51a4 4 0 0 0 4.2 4c14-.5 25.6 2.8 35.8 10" />
          <path d="M60 26c9-7.5 21-11 36-10.5a4 4 0 0 1 4 4v51a4 4 0 0 1-4.2 4c-14-.5-25.6 2.8-35.8 10" />
          <path d="M60 26v58.5" />
          <path d="M30 34.5c6 .2 11.6 1.3 16.8 3.2M30 48c6 .2 11.6 1.3 16.8 3.2M30 61.5c4.3.2 8.4.9 12.3 2" opacity=".55" />
          <path d="M90 34.5c-6 .2-11.6 1.3-16.8 3.2M90 48c-6 .2-11.6 1.3-16.8 3.2M90 61.5c-4.3.2-8.4.9-12.3 2" opacity=".55" />
        </svg>

        {/* LA BOMBILLA — entra por la derecha y se enciende al llegar.
            El encendido son tres cosas a la vez: los rayos aparecen, el
            filamento se dibuja y el cristal se llena de luz. Una sola no se
            lee como "se prende". */}
        <svg class="ilustra bombilla" viewBox="0 0 100 120" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <g class="rayos">
            <path d="M50 8v9M78 20l-6.4 6.4M92 48h-9M22 20l6.4 6.4M8 48h9" />
          </g>
          <path class="vidrio" d="M50 24a24 24 0 0 0-14 43.5c2.6 1.9 4 4.9 4 8.1V79h20v-3.4c0-3.2 1.4-6.2 4-8.1A24 24 0 0 0 50 24Z" />
          <path d="M40 88h20M44 97h12" />
          <path class="filamento" d="M43 59c2.6-4 4.6-6.5 7-6.5s4.4 2.5 7 6.5" />
        </svg>
      </div>

      <div class="panel-interior">
        <div class="cabecera">
          {/* ⚠️ EL LOGOTIPO ESTÁ DENTRO DEL TITULAR, NO AL LADO. Lo pidió el
              cliente: "Entra a" y debajo la marca, que sustituye a las
              palabras "la plataforma". Por eso el <h1> incluye la imagen y su
              `alt` es el nombre: para un lector de pantalla la frase se sigue
              leyendo entera, "Entra a Emprende180". */}
          <h1 class="titular">
            <span class="titular-texto"><T v={r.titulo} /></span>
            <img
              class="titular-logo"
              src={logo.src}
              width={logo.w}
              height={logo.h}
              alt={nombre}
              fetchpriority="high"
            />
          </h1>

          <p class="remate"><Enfasis v={r.remate} /></p>
          <p class="entradilla"><T v={r.texto} /></p>
        </div>

        <div class="formulario">
          <RegistroForm client:load lang={lang} refInicial={refInicial} />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     LA REJILLA
     ═══════════════════════════════════════════════════════════════════════
     Móvil primero: la franja arriba y el contenido debajo. A partir de 64rem
     se parte en dos columnas y la franja se fija al lado izquierdo. */
  .alta {
    min-height: 100dvh;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  /* ─── LA FRANJA ─────────────────────────────────────────────────────── */
  .franja {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 7.5rem;
    display: flex;
    align-items: center;
    padding: 1.25rem 1.25rem;
  }

  /* El fondo líquido: cuatro manchas de color desenfocadas sobre el navy. Se
     mueven muy despacio, lo justo para que no parezca una imagen fija. */
  .franja-fondo {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(42% 38% at 22% 18%, oklch(0.62 0.13 255 / 0.95), transparent 70%),
      radial-gradient(38% 42% at 78% 32%, oklch(0.55 0.1 196 / 0.85), transparent 70%),
      radial-gradient(46% 40% at 32% 76%, oklch(0.42 0.12 268 / 0.9), transparent 72%),
      radial-gradient(40% 36% at 72% 88%, oklch(0.5 0.09 210 / 0.8), transparent 70%),
      oklch(0.287 0.0718 253.9);
    filter: blur(28px);
    animation: fluir 28s ease-in-out infinite alternate;
  }

  @keyframes fluir {
    to { transform: scale(1.12) translate3d(2%, -3%, 0); }
  }

  .franja-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    color: #fff;
  }
  .franja-logo-texto {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }
  .franja-logo img {
    height: 2.5rem;
    width: auto;
  }
  .franja-logo:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  /* ─── EL PANEL BLANCO ───────────────────────────────────────────────── */
  .panel {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 1.25rem 3rem;
  }

  /* ─── LA BARRA DE ARRIBA ────────────────────────────────────────────── */
  .barra {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }
  .barra-entrar {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-ink-subtle);
  }
  /* "¿Ya tienes cuenta?" desaparece en pantallas estrechas y se queda sólo
     "Entrar": a 390 px la frase entera empuja al selector de idioma fuera. */
  .barra-entrar-previo { display: none; }
  .barra-entrar-enlace {
    font-weight: 700;
    color: var(--color-ink-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .barra-entrar:hover .barra-entrar-enlace { color: var(--color-cta); }
  .barra-entrar:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .panel-interior {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
  }

  /* ⚠️ TODO VA ALINEADO A LA IZQUIERDA, incluido el titular. Lo pidió el
     cliente ("carga más a la izquierda el formulario con sus elementos"), y
     centrar el titular sobre un formulario alineado a la izquierda habría
     dejado dos ejes distintos en la misma columna. Un formulario se lee por su
     borde izquierdo: ahí es donde empieza cada etiqueta. */
  .cabecera { text-align: left; }

  .titular {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .titular-texto {
    font-size: clamp(2rem, 7vw, 2.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  /* Más grande, que es lo que se pidió, y sin pasar del ancho del panel. */
  .titular-logo {
    height: clamp(2.75rem, 9vw, 4rem);
    width: auto;
    max-width: 100%;
  }

  .remate {
    margin-top: 0.85rem;
    font-size: clamp(1.6rem, 5.5vw, 2.1rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .entradilla {
    margin-top: 0.9rem;
    max-width: 30rem;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .formulario {
    margin-top: 2rem;
    text-align: left;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     LAS DOS ILUSTRACIONES
     ═══════════════════════════════════════════════════════════════════════
     `fixed` para que no se vayan al bajar, detrás del contenido y con poca
     opacidad: a este tamaño, por delante, competirían con los campos. */
  .ilustras {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ilustra {
    position: absolute;
    height: auto;
    color: var(--color-ink-brand);
    opacity: 0;
  }

  .libro {
    width: clamp(7rem, 26vw, 15rem);
    left: -3%;
    bottom: 6%;
    translate: -140% 0;
    rotate: -10deg;
    animation: entra-izq 1s cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }

  .bombilla {
    width: clamp(5.5rem, 20vw, 11rem);
    right: -2%;
    top: 10%;
    translate: 140% 0;
    rotate: 10deg;
    animation: entra-der 1s cubic-bezier(0.22, 1, 0.36, 1) 350ms forwards;
  }

  @keyframes entra-izq { to { translate: 0 0; opacity: 0.16; } }
  @keyframes entra-der { to { translate: 0 0; opacity: 0.2; } }

  /* El encendido espera a que la bombilla haya llegado: prenderse a mitad de
     camino se lee como un parpadeo, no como un interruptor. */
  .rayos,
  .filamento { opacity: 0; }
  .rayos { animation: prende 700ms ease-out 1200ms forwards; }
  .filamento { animation: prende 500ms ease-out 1100ms forwards; }
  .vidrio { animation: prende-vidrio 800ms ease-out 1100ms forwards; }

  @keyframes prende { to { opacity: 1; } }
  @keyframes prende-vidrio {
    /* Ámbar cálido: el único color de la página fuera de la paleta, y es a
       propósito. Una bombilla encendida en teal no se lee como encendida. */
    to { fill: oklch(0.86 0.15 88 / 0.85); }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     TABLETA — a partir de 40 rem
     ═══════════════════════════════════════════════════════════════════════
     La franja crece y el panel respira, pero siguen apilados: en vertical una
     tableta tiene el ancho de un móvil grande, y partir en dos columnas
     dejaría los campos en una tira estrecha. */
  @media (min-width: 40rem) {
    .franja { min-height: 9rem; padding-inline: 2rem; }
    .franja-logo img { height: 3rem; }
    .panel { padding: 1.5rem 2rem 4rem; }
    .panel-interior { max-width: 30rem; }
    .barra-entrar-previo { display: inline; }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     ESCRITORIO — a partir de 64 rem
     ═══════════════════════════════════════════════════════════════════════ */
  @media (min-width: 64rem) {
    .alta { flex-direction: row; }

    /* Fija y a toda la altura: no se mueve al bajar por el formulario. */
    .franja {
      position: fixed;
      inset-block: 0;
      left: 0;
      width: clamp(18rem, 30vw, 30rem);
      min-height: 0;
      align-items: flex-start;
      padding: 2.5rem;
    }
    .franja-logo img { height: 3.25rem; }

    .panel {
      margin-left: clamp(18rem, 30vw, 30rem);
      flex: 1;
      min-height: 100dvh;
      padding: 1.75rem 3rem 4rem;
    }

    /* El bloque deja de estar centrado en el lado blanco y se apoya contra la
       franja, que es lo que pidió el cliente. El tope evita que en un monitor
       muy ancho se quede pegado al borde del color. */
    .panel-interior {
      margin-inline: 0 auto;
      margin-left: min(6vw, 5rem);
    }
    /* La barra arranca en el MISMO borde que el titular. Con la barra pegada
       al padding del panel y el bloque desplazado, los dos bordes izquierdos
       quedaban a distinta altura y se leía como un descuadre. */
    .barra { padding-left: min(6vw, 5rem); }

    /* Las ilustraciones se quedan dentro del lado blanco, no debajo de la
       franja: ahí no se verían y además ensuciarían el degradado. */
    .ilustras { left: clamp(18rem, 30vw, 30rem); }
    .libro { left: 1%; bottom: 8%; }
    .bombilla { right: 3%; top: 14%; }
  }

  /* ⚠️ CON MOVIMIENTO REDUCIDO NO SE QUITA NADA, SE QUITA EL VIAJE. Aparecen
     ya colocadas y encendidas, y el fondo deja de moverse: quien pide menos
     movimiento quiere ver lo mismo sin que se mueva, no ver menos. */
  @media (prefers-reduced-motion: reduce) {
    .franja-fondo { animation: none; }
    .ilustra,
    .rayos,
    .filamento {
      animation: none;
      translate: 0 0;
      opacity: 1;
    }
    .libro { opacity: 0.16; }
    .bombilla { opacity: 0.2; }
    .vidrio { animation: none; fill: oklch(0.86 0.15 88 / 0.85); }
  }
</style>
