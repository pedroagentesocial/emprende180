---
import BaseLayout from "@layouts/BaseLayout.astro";
import T from "@components/i18n/T.astro";
import LanguageSwitch from "@components/i18n/LanguageSwitch";
import Enfasis from "@components/ui/Enfasis.astro";
import RegistroForm from "@components/ui/RegistroForm";
import { copy, sitio } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /subscribe — el alta en la plataforma
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nació el 13-10-2026 como una página de captación de un día para otro, con el
 * `LeadForm` de la landing. Ese mismo día pasó a ser lo que es ahora: EL ALTA
 * EN LA PLATAFORMA. Quien rellena esto no deja un recado, se crea una cuenta
 * en `alumnos` y entra.
 *
 * ⚠️ POR ESO NO USA `LeadForm`. Un lead va a GoHighLevel para que alguien
 * llame; esto escribe en la base y abre sesión. Si algún día alguien los
 * vuelve a juntar "porque se parecen", un cambio pensado para la landing dará
 * de alta a gente sin querer. Ver la cabecera de `RegistroForm.tsx`.
 *
 * ─── LA COMPOSICIÓN ────────────────────────────────────────────────────────
 *
 * Dos lados: una franja de color a la izquierda y el formulario sobre blanco a
 * la derecha, centrado en su lado.
 *
 * ⚠️ LA FRANJA ES CSS, NO UNA IMAGEN. Son cuatro manchas de color
 * superpuestas con un desenfoque encima. Una foto de 300 KB para pintar un
 * fondo que nadie mira es lo primero que habría que quitar después, y además
 * esto se adapta a cualquier alto sin recortes ni pixelado.
 *
 * ⚠️ Y VA FIJA EN ESCRITORIO. No se mueve al bajar, que es lo que permite que
 * el formulario sea largo sin que la página se quede en blanco por un lado.
 *
 * ⚠️ EN MÓVIL LA FRANJA PASA ARRIBA, y no es una renuncia: a 390 px una franja
 * lateral se come el ancho que necesitan los campos.
 *
 * ⚠️ SIN PÁRRAFO DE ENTRADA. Lo había y el cliente lo quitó el 13-10-2026 para
 * dejarle sitio al titular. El texto sigue escrito en `copy.registro.texto`
 * por si vuelve; hoy no se pinta. Lo que queda dice lo mismo en dos líneas:
 * "Entra a Emprende180 · Empieza el Día 1."
 *
 * ─── POR QUÉ NO HAY BARRA NI PIE ───────────────────────────────────────────
 *
 * Los quitó el cliente. Es lo correcto: aquí se llega con una intención única
 * y cada enlace es una puerta para irse antes de terminar.
 *
 * ⚠️ PERO EL AVISO DE PRIVACIDAD Y LOS TÉRMINOS TIENEN QUE SEGUIR ALCANZABLES,
 * y sin pie los enlaza SOLO el consentimiento del formulario. Si algún día
 * alguien toca ese texto, que sepa que aquí es el único camino a lo legal.
 *
 * ─── LAS ANIMACIONES ───────────────────────────────────────────────────────
 *
 * Las pidió el cliente una por una (13-10-2026): el logotipo entra desde
 * arriba y no para de moverse, los campos aparecen en cascada, la bombilla se
 * enciende y se apaga cada pocos segundos, y el libro entra, se abre, hojea,
 * se cierra y vuelve a empezar.
 *
 * ⚠️ TODO ES CSS Y NADA ES JAVASCRIPT. Son transformaciones y opacidad, que
 * las resuelve el compositor: en un teléfono esto no provoca un solo
 * recálculo de maquetación. Una librería de animación aquí serían 30 KB para
 * mover dos dibujos.
 *
 * ⚠️ LOS BUCLES SE PARAN ENTEROS CON `prefers-reduced-motion`, no se
 * suavizan. Un libro hojeando sin parar es exactamente lo que esa preferencia
 * existe para apagar.
 *
 * ⚠️ `?ref=CODIGO` ES LO QUE HACE QUE CADA EMBAJADOR PUEDA IMPRIMIR SU QR.
 * Llega aquí, baja al formulario y marca el canal solo.
 *
 * ⚠️ `noindex`: la puerta de alta no tiene que competir en el buscador con la
 * portada, que es la que cuenta qué es esto.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const r = copy.registro;

/**
 * ⚠️ LOS DOS LOGOTIPOS SE PINTAN SIEMPRE Y EL CSS ESCONDE EL QUE NO TOCA. Ver
 * la nota larga en `login.astro`: elegir uno en el servidor sacaba el inglés
 * con la página en español, porque el idioma se cambia en el navegador sin
 * recargar y una imagen ya pintada no se entera.
 */
const LOGOS = {
  es: sitio.logoHorizontal,
  en: sitio.logoHorizontalEn,
} as const;
const LOGOS_BLANCO = {
  es: sitio.logoHorizontalBlanco,
  en: sitio.logoHorizontalBlancoEn,
} as const;
const NOMBRE = { es: "Emprende180", en: "Entrepreneur180" } as const;

/* ⚠️ EL ENLACE AL INICIO LLEVA "Ir a" DELANTE DEL LOGOTIPO. Solo, el cliente
   no entendió que aquello fuera un enlace a ninguna parte: una marca en una
   esquina se lee como membrete, no como salida. */
const irA = lang === "en" ? "Go to" : "Ir a";
const irAlInicio = lang === "en" ? "Go to the home page" : "Ir al inicio";
const entrar = lang === "en" ? "Log in" : "Entrar";

const refInicial = (Astro.url.searchParams.get("ref") ?? "")
  .trim()
  .slice(0, 40)
  .toUpperCase();
---

<BaseLayout titulo={r.meta.titulo} descripcion={r.meta.descripcion} noindex>
  <div class="alta">
    {/* ─── LA FRANJA ────────────────────────────────────────────────────── */}
    <aside class="franja">
      <div class="franja-fondo" aria-hidden="true"></div>
      <a href="/" class="franja-logo" aria-label={irAlInicio}>
        <span class="franja-logo-texto">{irA}</span>
        {(["es", "en"] as const).map((l) => (
          <img
            data-t={l}
            lang={l}
            src={LOGOS_BLANCO[l].src}
            width={LOGOS_BLANCO[l].w}
            height={LOGOS_BLANCO[l].h}
            alt={NOMBRE[l]}
            fetchpriority="high"
          />
        ))}
      </a>
    </aside>

    {/* ─── EL CONTENIDO ─────────────────────────────────────────────────── */}
    <main id="contenido" class="panel">
      <div class="barra">
        {/* Sólo el verbo y sin subrayar: lo pidió el cliente. Se distingue por
            el color de marca y por el peso, y al pasar por encima sí se
            subraya, que es lo que confirma que es un enlace. */}
        <a href="/login" class="barra-entrar">{entrar}</a>
        <LanguageSwitch client:load lang={lang} tono="claro" />
      </div>

      <div class="ilustras" aria-hidden="true">
        {/* ─── EL LIBRO ─────────────────────────────────────────────────
            Entra por la izquierda, se abre, hojea tres veces, se cierra,
            se abre y hojea dos más. Y vuelta a empezar.

            Cómo funciona: las dos tapas comparten una animación de `scaleX`
            con el origen en el lomo, así que al encogerse se juntan contra él
            y el libro se "cierra". La hoja que pasa es otra tapa que va de
            `scaleX(1)` a `scaleX(-1)` sobre ese mismo eje: al cruzarlo se lee
            como una página que se vuelve.

            ⚠️ `transform-box: view-box` ES LO QUE HACE QUE ESTO FUNCIONE. Sin
            él, el origen de la transformación es la caja de cada trazo y cada
            tapa giraría sobre su propio centro en vez de sobre el lomo. */}
        <svg class="ilustra libro" viewBox="0 0 120 100" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          {/* CERRADO. Es un libro de verdad, no el hueco que deja uno abierto
              al plegarse: cubierta, lomo, el canto de las hojas y dos líneas
              de título. Antes el cierre se hacía encogiendo las dos tapas
              contra el lomo y lo que quedaba era una raya: el libro
              desaparecía. */}
          <g class="cerrado">
            <rect x="36" y="15" width="48" height="70" rx="6" />
            <path d="M46 15v70" opacity=".6" />
            <path d="M84 25v50" opacity=".45" />
            <path d="M56 38h18M56 48h13" opacity=".55" />
          </g>

          {/* ABIERTO, con una hoja que cruza el lomo. */}
          <g class="abierto">
            <path d="M60 26c-9-7.5-21-11-36-10.5a4 4 0 0 0-4 4v51a4 4 0 0 0 4.2 4c14-.5 25.6 2.8 35.8 10" />
            <path d="M60 26c9-7.5 21-11 36-10.5a4 4 0 0 1 4 4v51a4 4 0 0 1-4.2 4c-14-.5-25.6 2.8-35.8 10" />
            <path d="M30 34.5c6 .2 11.6 1.3 16.8 3.2M30 48c6 .2 11.6 1.3 16.8 3.2M30 61.5c4.3.2 8.4.9 12.3 2" opacity=".55" />
            <path d="M90 34.5c-6 .2-11.6 1.3-16.8 3.2M90 48c-6 .2-11.6 1.3-16.8 3.2M90 61.5c-4.3.2-8.4.9-12.3 2" opacity=".55" />
            <path class="hoja" d="M60 26c9-7.5 21-11 36-10.5a4 4 0 0 1 4 4v51a4 4 0 0 1-4.2 4c-14-.5-25.6 2.8-35.8 10" />
            <path d="M60 26v58.5" />
          </g>
        </svg>

        {/* ─── LA BOMBILLA ──────────────────────────────────────────────
            Entra por la derecha y a partir de ahí se enciende y se apaga sola.
            El encendido son tres cosas a la vez: los rayos, el filamento y la
            luz dentro del cristal. Una sola no se lee como "se prende". */}
        <svg class="ilustra bombilla" viewBox="0 0 100 120" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <g class="rayos">
            <path d="M50 8v9M78 20l-6.4 6.4M92 48h-9M22 20l6.4 6.4M8 48h9" />
          </g>
          <path class="vidrio" d="M50 24a24 24 0 0 0-14 43.5c2.6 1.9 4 4.9 4 8.1V79h20v-3.4c0-3.2 1.4-6.2 4-8.1A24 24 0 0 0 50 24Z" />
          <path d="M40 88h20M44 97h12" />
          <path class="filamento" d="M43 59c2.6-4 4.6-6.5 7-6.5s4.4 2.5 7 6.5" />
        </svg>
      </div>

      <div class="panel-interior">
        <div class="cabecera">
          {/* ⚠️ EL LOGOTIPO ESTÁ DENTRO DEL TITULAR. Lo pidió el cliente:
              "Entra a" y debajo la marca, que sustituye a las palabras "la
              plataforma". Por eso el <h1> incluye la imagen y su `alt` es el
              nombre: para un lector de pantalla la frase se sigue leyendo
              entera, "Entra a Emprende180". */}
          <h1 class="titular">
            <span class="titular-texto"><T v={r.titulo} /></span>
            {(["es", "en"] as const).map((l) => (
              <img
                class="titular-logo"
                data-t={l}
                lang={l}
                src={LOGOS[l].src}
                width={LOGOS[l].w}
                height={LOGOS[l].h}
                alt={NOMBRE[l]}
                fetchpriority="high"
              />
            ))}
          </h1>

          <p class="remate"><Enfasis v={r.remate} /></p>
        </div>

        <div class="formulario">
          <RegistroForm client:load lang={lang} refInicial={refInicial} />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

{/* ⚠️ LA CASCADA DE LOS CAMPOS VA EN `is:global` A LA FUERZA. Los campos los
    pinta un island de React, y el CSS con ámbito de Astro marca sólo el HTML
    que genera Astro: una regla `.entra` con ámbito no alcanzaría ni un campo.
    Por eso vive aquí, y por eso el nombre es específico. */}
<style is:global>
  .entra {
    opacity: 0;
    animation: entra-campo 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    /* Cada bloque lleva su `--i` puesto desde el componente. El 70 ms es lo
       que separa una cascada de un parpadeo colectivo. */
    animation-delay: calc(420ms + var(--i, 0) * 70ms);
  }
  @keyframes entra-campo {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .entra { animation: none; opacity: 1; transform: none; }
  }
</style>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     LA REJILLA
     ═══════════════════════════════════════════════════════════════════════ */
  .alta {
    min-height: 100dvh;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  /* ─── LA FRANJA ─────────────────────────────────────────────────────── */
  .franja {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 7.5rem;
    display: flex;
    align-items: center;
    padding: 1.25rem;
  }

  .franja-fondo {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(42% 38% at 22% 18%, oklch(0.62 0.13 255 / 0.95), transparent 70%),
      radial-gradient(38% 42% at 78% 32%, oklch(0.55 0.1 196 / 0.85), transparent 70%),
      radial-gradient(46% 40% at 32% 76%, oklch(0.42 0.12 268 / 0.9), transparent 72%),
      radial-gradient(40% 36% at 72% 88%, oklch(0.5 0.09 210 / 0.8), transparent 70%),
      oklch(0.287 0.0718 253.9);
    filter: blur(28px);
    animation: fluir 28s ease-in-out infinite alternate;
  }
  @keyframes fluir {
    to { transform: scale(1.12) translate3d(2%, -3%, 0); }
  }

  /* El enlace entra desde arriba; el logotipo de dentro no para nunca. Son dos
     elementos distintos a propósito: una sola capa no puede llevar la entrada
     y el balanceo sin que uno pise al otro. */
  .franja-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    color: #fff;
    opacity: 0;
    animation: logo-entra 760ms cubic-bezier(0.22, 1, 0.36, 1) 120ms forwards;
  }
  @keyframes logo-entra {
    from { opacity: 0; transform: translateY(-28px); }
    to { opacity: 1; transform: none; }
  }

  .franja-logo-texto {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }
  .franja-logo img {
    height: 2.5rem;
    width: auto;
    /* Un balanceo de 5 px en seis segundos: se nota que está vivo y no
       distrae. Más recorrido, en algo que no para nunca, cansa. */
    animation: logo-flota 6s ease-in-out 900ms infinite;
  }
  @keyframes logo-flota {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .franja-logo:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  /* ─── EL PANEL BLANCO ───────────────────────────────────────────────── */
  .panel {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 1.25rem 3rem;
  }

  .barra {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }
  .barra-entrar {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink-brand);
    text-decoration: none;
  }
  /* Sin subrayado en reposo, con subrayado al pasar: es lo que confirma que
     es un enlace sin ensuciar la esquina. */
  .barra-entrar:hover { text-decoration: underline; text-underline-offset: 4px; }
  .barra-entrar:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .panel-interior {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
  }

  .cabecera { text-align: center; }

  .titular {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  /* Más grande desde que se fue el párrafo de entrada: el sitio que ocupaba
     pasa entero al titular y al logotipo, que es lo que se pidió. */
  .titular-texto {
    font-size: clamp(2.4rem, 9vw, 3.5rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .titular-logo {
    height: clamp(3.25rem, 12vw, 5.25rem);
    width: auto;
    max-width: 100%;
  }

  .remate {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 6vw, 2.4rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .formulario {
    margin-top: 2.25rem;
    text-align: left;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     LAS DOS ILUSTRACIONES
     ═══════════════════════════════════════════════════════════════════════ */
  .ilustras {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ilustra {
    position: absolute;
    height: auto;
    color: var(--color-ink-brand);
    opacity: 0;
  }

  .libro {
    width: clamp(7rem, 26vw, 15rem);
    left: -3%;
    bottom: 6%;
    translate: -140% 0;
    rotate: -10deg;
    animation: entra-izq 1s cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }
  .bombilla {
    width: clamp(5.5rem, 20vw, 11rem);
    right: -2%;
    top: 10%;
    translate: 140% 0;
    rotate: 10deg;
    animation: entra-der 1s cubic-bezier(0.22, 1, 0.36, 1) 350ms forwards;
  }
  @keyframes entra-izq { to { translate: 0 0; opacity: 0.16; } }
  @keyframes entra-der { to { translate: 0 0; opacity: 0.2; } }

  /* ─── EL LIBRO: cerrado → abierto → hojea → cerrado ──────────────────
     ⚠️ EL CIERRE ES UN RELEVO ENTRE DOS DIBUJOS, NO UN PLEGADO. La primera
     versión cerraba encogiendo las dos tapas contra el lomo, y lo que quedaba
     en pantalla era una raya vertical: el libro desaparecía. Ahora hay un
     libro cerrado dibujado aparte y los dos se turnan, así que SIEMPRE hay un
     libro a la vista.

     Las dos animaciones duran lo mismo y arrancan a la vez: si alguien cambia
     una duración, que cambie las tres. */
  .libro .cerrado,
  .libro .abierto,
  .libro .hoja {
    transform-box: view-box;
    transform-origin: 60px 55px;
  }
  .libro .cerrado { animation: libro-cerrado 13s ease-in-out 1.2s infinite; }
  .libro .abierto { opacity: 0; animation: libro-abierto 13s ease-in-out 1.2s infinite; }
  .libro .hoja { animation: libro-hojear 13s ease-in-out 1.2s infinite; opacity: 0; }

  /* Se relevan con un pequeño solape y un cambio de escala: el cerrado se
     encoge mientras el abierto crece, que es lo que da la sensación de que se
     abre en vez de parecer dos dibujos intercambiados. */
  @keyframes libro-cerrado {
    0%, 8% { opacity: 1; transform: scale(1); }
    13% { opacity: 0; transform: scale(1.06); }
    13.01%, 50% { opacity: 0; transform: scale(0.94); }
    56% { opacity: 1; transform: scale(1); }
    64% { opacity: 1; transform: scale(1); }
    69% { opacity: 0; transform: scale(1.06); }
    69.01%, 96% { opacity: 0; transform: scale(0.94); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes libro-abierto {
    0%, 9% { opacity: 0; transform: scale(0.94); }
    14%, 50% { opacity: 1; transform: scale(1); }
    55% { opacity: 0; transform: scale(0.94); }
    55.01%, 65% { opacity: 0; transform: scale(0.94); }
    70%, 95% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.94); }
  }

  /* Cinco pasadas: tres en el primer tramo abierto y dos en el segundo. Cada
     una cruza el lomo de `scaleX(1)` a `scaleX(-1)` y desaparece al llegar,
     para poder volver al punto de partida sin que se vea el salto. */
  @keyframes libro-hojear {
    0%, 17% { transform: scaleX(1); opacity: 0; }
    18% { opacity: 0.9; }
    26% { transform: scaleX(-1); opacity: 0.9; }
    27% { transform: scaleX(-1); opacity: 0; }
    28% { transform: scaleX(1); opacity: 0; }
    29% { opacity: 0.9; }
    37% { transform: scaleX(-1); opacity: 0.9; }
    38% { transform: scaleX(-1); opacity: 0; }
    39% { transform: scaleX(1); opacity: 0; }
    40% { opacity: 0.9; }
    47% { transform: scaleX(-1); opacity: 0.9; }
    48%, 73% { transform: scaleX(-1); opacity: 0; }
    74% { transform: scaleX(1); opacity: 0; }
    75% { opacity: 0.9; }
    83% { transform: scaleX(-1); opacity: 0.9; }
    84% { transform: scaleX(-1); opacity: 0; }
    85% { transform: scaleX(1); opacity: 0; }
    86% { opacity: 0.9; }
    93% { transform: scaleX(-1); opacity: 0.9; }
    94%, 100% { transform: scaleX(-1); opacity: 0; }
  }

  /* ─── LA BOMBILLA: prende y apaga ───────────────────────────────────── */
  .rayos,
  .filamento { opacity: 0; }
  .rayos { animation: foco 7s ease-in-out 1.4s infinite; }
  .filamento { animation: foco 7s ease-in-out 1.35s infinite; }
  .vidrio { animation: foco-vidrio 7s ease-in-out 1.35s infinite; }

  @keyframes foco {
    0%, 6% { opacity: 0; }
    13%, 44% { opacity: 1; }
    51%, 60% { opacity: 0; }
    67%, 93% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes foco-vidrio {
    /* Ámbar cálido: el único color de la página fuera de la paleta, y es a
       propósito. Una bombilla encendida en teal no se lee como encendida. */
    0%, 6% { fill: oklch(0.86 0.15 88 / 0); }
    13%, 44% { fill: oklch(0.86 0.15 88 / 0.85); }
    51%, 60% { fill: oklch(0.86 0.15 88 / 0); }
    67%, 93% { fill: oklch(0.86 0.15 88 / 0.85); }
    100% { fill: oklch(0.86 0.15 88 / 0); }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     TABLETA — a partir de 40 rem
