---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import T from "@components/i18n/T.astro";
import Section from "@components/ui/Section.astro";
import Enfasis from "@components/ui/Enfasis.astro";
import RegistroForm from "@components/ui/RegistroForm";
import { copy } from "@config/curso.config";
import { resolverIdiomaServidor } from "@i18n/idioma";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * /subscribe — la página del código QR
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Nació el 13-10-2026 como una página de captación de un día para otro, con
 * el `LeadForm` de la landing. Ese mismo día pasó a ser lo que es ahora: EL
 * ALTA EN LA PLATAFORMA. Quien rellena esto no deja un recado, se crea una
 * cuenta en `alumnos` y entra.
 *
 * ⚠️ POR ESO NO USA `LeadForm`. Un lead va a GoHighLevel para que alguien
 * llame; esto escribe en la base y abre sesión. Si algún día alguien los
 * vuelve a juntar "porque se parecen", un cambio pensado para la landing dará
 * de alta a gente sin querer. Ver la cabecera de `RegistroForm.tsx`.
 *
 * ⚠️ NACIÓ COMO `/registro` Y DURÓ UNAS HORAS. El cliente la pidió en
 * `/subscribe` el mismo día, antes de imprimir nada, y es la ruta buena: las
 * demás del sitio ya son `/about`, `/programs` y `/resources`, así que la
 * castellana era la rara. `/registro` sigue viva como 301 en
 * `astro.config.mjs` por si el enlace corto llegó a salir de aquí.
 *
 * ⚠️ LA URL ES EL ENTREGABLE, NO LA PÁGINA. Un QR se imprime, y el papel no se
 * puede reeditar: cuando llegue el rediseño se cambia lo que hay DENTRO de
 * `/subscribe`, nunca la ruta. Si alguien quiere moverla otra vez, que deje
 * antes una redirección permanente desde aquí, como se hizo con `/registro`.
 *
 * ⚠️ EL CONSENTIMIENTO SIGUE SIENDO EL DE `legal.config`, leído y no copiado.
 * Es la regla del cliente para todos los formularios del sitio y aquí vale
 * igual: un texto a medida sería un sitio más donde se queda sin actualizar el
 * día que cambie.
 *
 * ⚠️ `?ref=CODIGO` ES LO QUE HACE QUE CADA EMBAJADOR PUEDA IMPRIMIR SU QR.
 * Llega aquí, baja al formulario y marca el canal solo. Si alguien quita este
 * parámetro, cada Embajador pierde la atribución de la gente que trae, que es
 * lo que se va a mirar el día que haya comisiones.
 *
 * ⚠️ `noindex`: la puerta de alta no tiene que competir en el buscador con la
 * portada, que es la que cuenta qué es esto.
 */

const lang = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const r = copy.registro;

/* El código del Embajador, si el QR lo trae. Se recorta y se sube a mayúsculas
   aquí para que el campo nazca ya con el valor bueno: los códigos se guardan en
   mayúsculas (ver `cupones` en el esquema). */
const refInicial = (Astro.url.searchParams.get("ref") ?? "")
  .trim()
  .slice(0, 40)
  .toUpperCase();
---

<BaseLayout titulo={r.meta.titulo} descripcion={r.meta.descripcion} noindex>
  <Header />

  <main id="contenido">
    <Section id="subscribe" tono="surface" ritmo="amplio">
      <div class="mx-auto max-w-xl text-center">
        <p
          class="text-sm font-bold tracking-[0.18em] text-ink-brand uppercase"
        >
          <T v={r.kicker} />
        </p>

        <h1
          class="mt-4 text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-balance text-ink sm:text-5xl"
        >
          <T v={r.titulo} />
        </h1>

        <p class="mt-2 text-3xl leading-[1.15] text-balance sm:text-4xl">
          <Enfasis v={r.remate} />
        </p>

        <p
          class="mx-auto mt-6 max-w-prose text-lg font-medium leading-relaxed text-pretty text-ink-muted sm:text-xl"
        >
          <T v={r.texto} />
        </p>

        <div class="mx-auto mt-10 max-w-md text-left">
          <RegistroForm client:load lang={lang} refInicial={refInicial} />
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>
