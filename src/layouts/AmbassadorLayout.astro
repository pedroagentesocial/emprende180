---
import StudentLayout from "@layouts/StudentLayout.astro";
import type { Txt } from "@i18n/idioma";
import type { Student } from "@lib/data";

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * LAS PÁGINAS DEL EMBAJADOR, DENTRO DEL MARCO ÚNICO (12-11-2026)
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Esto era un marco aparte, pensado para el teléfono: barra arriba, una
 * columna estrecha y cinco pestañas abajo, también en escritorio. En una
 * pantalla grande parecía un móvil en medio de la nada, y al pasar a Cursos se
 * cambiaba de producto. Ahora todo alumno es Embajador, así que es una sola
 * plataforma con un solo marco: `StudentLayout`, que en escritorio pinta la
 * columna lateral (con las secciones del Embajador) y en teléfono y tablet las
 * pestañas de abajo (`PortalTabs`).
 *
 * Se conserva como envoltura para que las páginas no cambien de import, y
 * `tab` se sigue aceptando aunque la sección actual ya se lee de la URL.
 *
 * ⚠️ VIVE BAJO `/student/ambassador`, Y ESO ES SEGURIDAD: el middleware protege
 * todo `/student` con la sesión.
 */
export type AmbassadorTab = "home" | "referrals" | "team" | "payouts" | "share";

interface Props {
  title: Txt;
  student: Student;
  tab?: AmbassadorTab;
}

const { title, student } = Astro.props;
---

<StudentLayout title={title} student={student}>
  <slot />
</StudentLayout>
