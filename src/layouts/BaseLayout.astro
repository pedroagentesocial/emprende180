---
import "@/styles/global.css";
import montserratLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import { sitio, curso, instructor, cifras, contacto, copy } from "@config/curso.config";
import LegalModal from "@components/legal/LegalModal";
import CookieBanner from "@components/legal/CookieBanner";
import {
  IDIOMAS,
  LOCALES,
  OG_LOCALES,
  CLAVE_IDIOMA,
  resolverIdiomaServidor,
  type Idioma,
  type Txt,
} from "@i18n/idioma";
import { formatMoney } from "@i18n/formato";
import { MARCA_COMPLETAR } from "@lib/pendientes";

interface Props {
  /** Sobrescribe el <title>. Debe venir en los dos idiomas. */
  titulo?: Txt;
  descripcion?: Txt;
  /**
   * Deja la página fuera del índice de los buscadores.
   *
   * Para páginas que existen porque hacen falta, no porque haya que
   * encontrarlas: hoy, `/acceso`. Nadie debería aterrizar ahí desde una
   * búsqueda, y menos leyendo un aviso que quedará caducado en cuanto exista el
   * login de verdad.
   *
   * Se emite `noindex, follow`: que no se indexe NO significa que los enlaces
   * de dentro dejen de contar.
   */
  noindex?: boolean;
}

const {
  titulo = sitio.titulo,
  descripcion = sitio.descripcion,
  noindex = false,
} = Astro.props;

/**
 * Idioma resuelto en el SERVIDOR: `?lang=` y, si no, `Accept-Language`.
 * Así el primer pintado ya sale bien y cada URL con `?lang` es una versión
 * distinta e indexable. La preferencia guardada del visitante la aplica el
 * script de <head>, antes del primer pintado.
 */
const lang: Idioma = resolverIdiomaServidor(
  Astro.url,
  Astro.request.headers.get("accept-language"),
);

const base = Astro.site ?? new URL(sitio.url);
const canonicalUrl = new URL(Astro.url.pathname, base);
canonicalUrl.searchParams.set("lang", lang);
const canonical = canonicalUrl.href;

/** Una URL por idioma, para hreflang. */
const alternativas = IDIOMAS.map((l) => {
  const u = new URL(Astro.url.pathname, base);
  u.searchParams.set("lang", l);
  return { lang: l, href: u.href, locale: LOCALES[l] };
});

/** x-default apunta al idioma principal, no a una tercera URL sin `lang`. */
const xDefault = alternativas.find((a) => a.lang === "es")!.href;

const ogImagen = new URL(sitio.ogImagen, base).href;

/* ───────────────────────────────────────────────────────────────────────────
   Schema.org · Course
   Se emite SOLO en el idioma activo: un JSON-LD con dos idiomas mezclados no
   es válido, y `inLanguage` tiene que coincidir con lo que se está sirviendo.
   ─────────────────────────────────────────────────────────────────────────── */
const schemaCourse = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: curso.nombre[lang],
  description: curso.promesa[lang],
  url: canonical,
  inLanguage: LOCALES[lang],
  image: ogImagen,
  provider: {
    "@type": "Organization",
    name: sitio.nombre,
    url: sitio.url,
    email: contacto.email,
  },
  /* `author` solo cuando el nombre es real: un autor con un placeholder
     dentro es peor que no declarar autor. */
  ...(!instructor.nombre.includes(MARCA_COMPLETAR) && {
    author: {
      "@type": "Person",
      name: instructor.nombre,
      description: instructor.rol[lang],
    },
  }),
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    inLanguage: LOCALES[lang],
    ...(curso.formato.declararDuracion && curso.formato.horas
      ? { courseWorkload: `PT${curso.formato.horas}H` }
      : {}),
    offers: {
      "@type": "Offer",
      /* El precio que se paga HOY, no el ancla. Poner aquí la referencia sería
         declarar a Google un precio que nadie paga: los resultados enriquecidos
         mostrarían una cifra distinta de la de la página. */
      price: curso.precio.actual,
      priceCurrency: curso.precio.moneda,
      availability: curso.fechas.inscripcionAbierta
        ? "https://schema.org/InStock"
        : "https://schema.org/PreOrder",
      url: canonical,
      /* `priceValidUntil` solo si hay una fecha de cierre REAL: es una promesa
         a Google de hasta cuándo vale ese precio. */
      ...(curso.precio.urgencia.fechaCierre
        ? { priceValidUntil: curso.precio.urgencia.fechaCierre }
        : {}),
    },
  },
  ...(cifras.sonReales && cifras.numeroValoraciones > 0
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: cifras.valoracionMedia,
          reviewCount: cifras.numeroValoraciones,
          bestRating: 5,
        },
      }
    : {}),
  teaches: curso.resultados.map((r) => r[lang]),
};

/* Se pasan al script de <head> para que pueda reescribir <title> y la meta
   description al cambiar de idioma sin recargar. */
const titulos = { es: titulo.es, en: titulo.en };
const descripciones = { es: descripcion.es, en: descripcion.en };
const precioFormateado = {
  es: formatMoney(curso.precio.actual, "es", curso.precio.moneda),
  en: formatMoney(curso.precio.actual, "en", curso.precio.moneda),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{titulo[lang]}</title>
    <meta name="description" content={descripcion[lang]} />

    {/* hreflang: una entrada por idioma más x-default. Sin esto, Google trata
        `?lang=en` como contenido duplicado del español en vez de como su
        versión en inglés. */}
    {
      alternativas.map((a) => (
        <link rel="alternate" hreflang={a.lang} href={a.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {/* Precarga del subconjunto latino de Montserrat.
        Sin esto, la fuente llega DESPUÉS del primer pintado: el texto se dibuja
        con la tipografía del sistema y salta al cambiar. Lighthouse lo medía
        como 0,147 de CLS, atribuido literalmente a «Web font loaded».
        Solo el latino: los demás subconjuntos (cirílico, vietnamita) tienen su
        propio `unicode-range` y el navegador no llega a pedirlos. */}
    <link
      rel="preload"
      href={montserratLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/identidad/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {
      IDIOMAS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))
    }
    <meta property="og:title" content={titulo[lang]} />
    <meta property="og:description" content={descripcion[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${curso.nombre[lang]}: ${curso.promesa[lang]}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo[lang]} />
    <meta name="twitter:description" content={descripcion[lang]} />
    <meta name="twitter:image" content={ogImagen} />

    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={sitio.themeColor} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemaCourse)}
      is:inline
    />

    {/* Antes del primer pintado, y en este orden:
        1. Aplica la preferencia guardada del visitante si difiere de lo que
           resolvió el servidor. Sin esto se vería un parpadeo de idioma.
           `?lang=` en la URL gana: sirve para compartir el enlace ya traducido.
        2. Marca el documento para que el CSS pueda ocultar los bloques de
           entrada al scroll.
        3. Marca el documento para que el CSS pueda plegar los detalles en
           táctil. Va aquí y no en el script del final del <body> por lo mismo
           que el anterior: si se aplicara después del primer pintado, en un
           teléfono se vería la página con los cinco párrafos desplegados y un
           instante después encogiéndose de golpe. Y va SIN condición de media
           query: la clase solo autoriza, es el CSS quien decide en qué
           pantallas pliega algo.
        Los tres van aquí porque al final del <body> ya sería tarde. */}
    <script is:inline define:vars={{ CLAVE_IDIOMA, titulos, descripciones }}>
      (function () {
        var raiz = document.documentElement;

        try {
          var enUrl = new URLSearchParams(location.search).get("lang");
          var guardado = localStorage.getItem(CLAVE_IDIOMA);
          var elegido =
            enUrl === "es" || enUrl === "en"
              ? enUrl
              : guardado === "es" || guardado === "en"
                ? guardado
                : null;

          if (elegido && elegido !== raiz.lang) {
            raiz.lang = elegido;
            if (titulos[elegido]) document.title = titulos[elegido];
            var d = document.querySelector('meta[name="description"]');
            if (d && descripciones[elegido]) d.setAttribute("content", descripciones[elegido]);
          }
        } catch (e) {
          /* Sin almacenamiento: se queda el idioma que resolvió el servidor. */
        }

        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          raiz.classList.add("js-reveal");
        }

        raiz.classList.add("js-detalle");
      })();
    </script>

    {/* GA4 NO se carga aquí a propósito: lo inyecta `CookieBanner` solo si el
        visitante acepta las cookies de medición (ver src/lib/consent.ts). */}
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only-focusable absolute left-4 top-4 z-[70] inline-flex min-h-11 items-center rounded-lg bg-surface px-4 py-2 font-semibold shadow-md"
    >
      <span data-t="es">{copy.ui.saltarAlContenido.es}</span>
      <span data-t="en">{copy.ui.saltarAlContenido.en}</span>
    </a>
    <slot />

    {/* Uno por página: escuchan eventos de todo el documento. */}
    <LegalModal client:idle lang={lang} />
    <CookieBanner client:idle lang={lang} />

    {/* Mantiene <title> y la meta description en sincronía con el idioma
        cuando se cambia sin recargar. El resto del texto lo resuelve el CSS. */}
    {/* Al cambiar de idioma sin recargar hay tres cosas que el CSS no puede
        arreglar, porque son atributos y no nodos de texto:
          · <title> y la meta description
          · los `aria-label` (marcados con data-aria-es / data-aria-en)
          · los `alt` de las imágenes (data-alt-es / data-alt-en)
        Un `aria-label` que se queda en el idioma anterior deja la página a
        medio traducir justo para quien la navega con lector de pantalla. */}
    <script is:inline define:vars={{ titulos, descripciones, precioFormateado }}>
      (function () {
        function aplicar(l) {
          if (titulos[l]) {
            document.title = titulos[l];
            var d = document.querySelector('meta[name="description"]');
            if (d) d.setAttribute("content", descripciones[l]);
          }
          document.querySelectorAll("[data-aria-" + l + "]").forEach(function (el) {
            el.setAttribute("aria-label", el.getAttribute("data-aria-" + l));
          });
          document.querySelectorAll("[data-alt-" + l + "]").forEach(function (el) {
            el.setAttribute("alt", el.getAttribute("data-alt-" + l));
          });
        }

        window.addEventListener("e180:idioma", function (e) {
          aplicar(e.detail);
        });

        // El script de <head> pudo cambiar el idioma antes de que existiera el
        // DOM: se aplica una vez al arrancar para no dejar atributos desfasados.
        aplicar(document.documentElement.lang);
      })();

      window.__e180Precio = precioFormateado;
    </script>

    <!-- Entrada al scroll: UN solo IntersectionObserver para toda la página. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        var raiz = document.documentElement;

        var mostrar = function (el) {
          el.classList.add("reveal-visible");
        };

        if (reduce.matches || !raiz.classList.contains("js-reveal")) return;

        if (!("IntersectionObserver" in window)) {
          document.querySelectorAll("[data-reveal]").forEach(mostrar);
          return;
        }

        var obs = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (e) {
              if (!e.isIntersecting) return;
              mostrar(e.target);
              obs.unobserve(e.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );

        document.querySelectorAll("[data-reveal]").forEach(function (el) {
          obs.observe(el);
        });

        reduce.addEventListener("change", function (e) {
          if (!e.matches) return;
          obs.disconnect();
          document.querySelectorAll("[data-reveal]").forEach(mostrar);
        });
      })();
    </script>

    {/* ─────────────────────────────────────────────────────────────────────
        DETALLE QUE SE DESPLIEGA AL TOCAR  (ver `[data-revelar]` en global.css)

        UN SOLO LISTENER DELEGADO para toda la página, y no uno por bloque. En
        la portada hay quince `[data-revelar]`: quince listeners es quince veces
        el mismo trabajo, y además obligaría a recorrer el DOM al arrancar justo
        cuando el hilo principal tiene cosas mejores que hacer. Delegado, el
        coste al cargar es cero y solo se paga cuando alguien toca.

        El `id` del detalle se asigna aquí, en el primer toque, y no en el
        marcado: las tres secciones pintan sus bloques dentro de un `.map()` y
        obligarlas a inventar identificadores únicos sería acoplar el contenido
        a este mecanismo. `aria-controls` necesita un id; el visitante, no.
        ───────────────────────────────────────────────────────────────────── */}
    <script is:inline>
      (function () {
        var n = 0;

        document.addEventListener("click", function (e) {
          var boton =
            e.target instanceof Element
              ? e.target.closest("[data-detalle-toggle]")
              : null;
          if (!boton) return;

          var bloque = boton.closest("[data-revelar]");
          var detalle = bloque && bloque.querySelector("[data-detalle]");
          if (!bloque || !detalle) return;

          if (!detalle.id) detalle.id = "detalle-" + ++n;
          boton.setAttribute("aria-controls", detalle.id);

          var abierto = bloque.hasAttribute("data-abierto");
          if (abierto) bloque.removeAttribute("data-abierto");
          else bloque.setAttribute("data-abierto", "");

          boton.setAttribute("aria-expanded", String(!abierto));

          /* Los dos rótulos existen en el DOM y se alternan con `hidden`. No se
             reescribe el texto: cada rótulo son DOS nodos, uno por idioma, y
             machacarlos con textContent dejaría el botón sin traducir en cuanto
             alguien cambiara de idioma. */
          var mas = boton.querySelector("[data-detalle-mas]");
          var menos = boton.querySelector("[data-detalle-menos]");
          if (mas) mas.classList.toggle("hidden", !abierto);
          if (menos) menos.classList.toggle("hidden", abierto);
        });
      })();
    </script>

    <!-- Seguimiento de CTA: un único listener delegado. -->
    <script is:inline>
      document.addEventListener("click", (e) => {
        const el = e.target instanceof Element ? e.target.closest("[data-track]") : null;
        if (!el || typeof window.gtag !== "function") return;
        window.gtag("event", "cta_click", {
          cta_id: el.getAttribute("data-track"),
          cta_text: el.textContent?.trim().slice(0, 60),
          idioma: document.documentElement.lang,
        });
      });
    </script>
  </body>
</html>
